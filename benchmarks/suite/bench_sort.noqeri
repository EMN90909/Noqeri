function bench_sort(): int {
    let N: int = 2000
    let arr: [int; 2000]
    let seed: int = 12345
    let i: int = 0
    while i < N {
        seed = (seed * 1103515245 + 12345) % 2147483648
        arr[i] = seed % 100000
        i = i + 1
    }
    let j: int = 1
    while j < N {
        let key: int = arr[j]
        let k: int = j - 1
        while k >= 0 && arr[k] > key {
            arr[k + 1] = arr[k]
            k = k - 1
        }
        arr[k + 1] = key
        j = j + 1
    }
    return arr[N - 1]
}
print(bench_sort())
