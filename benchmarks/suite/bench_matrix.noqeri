function bench_matrix(): int {
    let N: int = 256
    let A: [int; 65536]
    let B: [int; 65536]
    let C: [int; 65536]
    let i: int = 0
    while i < N {
        let j: int = 0
        while j < N {
            A[i * 256 + j] = (i + j) % 100
            B[i * 256 + j] = (i * j + 1) % 100
            C[i * 256 + j] = 0
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < N {
        let k: int = 0
        while k < N {
            let r: int = A[i * 256 + k]
            let j: int = 0
            while j < N {
                C[i * 256 + j] = C[i * 256 + j] + r * B[k * 256 + j]
                j = j + 1
            }
            k = k + 1
        }
        i = i + 1
    }
    let total: int = 0
    let idx: int = 0
    while idx < 65536 {
        total = total + C[idx]
        idx = idx + 1
    }
    return total
}
print(bench_matrix())
