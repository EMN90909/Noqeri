function bench_matrix(): void {
    let N: int = 256
    let A: [int; 65536]
    let B: [int; 65536]
    let C: [int; 65536]
    let i: int = 0
    while i < N {
        let j: int = 0
        while j < N {
            A[i * 256 + j] = (i + j) % 100
            B[i * 256 + j] = (i * j + 1) % 100
            C[i * 256 + j] = 0
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < N {
        let i_offset: int = i * 256
        let k: int = 0
        while k < N {
            let r: int = A[i_offset + k]
            let k_offset: int = k * 256
            let j: int = 0
            while j < N {
                let c_idx: int = i_offset + j
                let b_idx: int = k_offset + j
                C[c_idx] = C[c_idx] + r * B[b_idx]
                j = j + 1
            }
            k = k + 1
        }
        i = i + 1
    }
}
bench_matrix()
