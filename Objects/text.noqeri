module noqeri.objects.text

record ByteString {
    data: *u8
    length: usize
}

export function bytesEqual(left: []u8, right: []u8): bool {
    if len(left) != len(right) {
        return false
    }
    let index: usize = 0
    while index < len(left) {
        if left[index] != right[index] {
            return false
        }
        index = index + 1
    }
    return true
}

export function bytesCompare(left: []u8, right: []u8): isize {
    let shared: usize = len(left)
    if len(right) < shared {
        shared = len(right)
    }
    let index: usize = 0
    while index < shared {
        if left[index] < right[index] {
            return -1
        }
        if left[index] > right[index] {
            return 1
        }
        index = index + 1
    }
    if len(left) < len(right) {
        return -1
    }
    if len(left) > len(right) {
        return 1
    }
    return 0
}

export function bytesStartsWith(value: []u8, prefix: []u8): bool {
    if len(prefix) > len(value) {
        return false
    }
    let index: usize = 0
    while index < len(prefix) {
        if value[index] != prefix[index] {
            return false
        }
        index = index + 1
    }
    return true
}
