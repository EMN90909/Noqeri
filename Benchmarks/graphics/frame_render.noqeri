import "../../Lib/std/render2d.noqeri"

// Benchmarks the repository's actual Noqeri CPU renderer.
// The host owns only the buffer, high-resolution clock and optional PPM capture.
extern function nq_bench_framebuffer(): *u32
extern function nq_bench_width(): usize
extern function nq_bench_height(): usize
extern function nq_bench_frames(): usize
extern function nq_bench_mode(): int
extern function nq_bench_clock_start(): void
extern function nq_bench_clock_stop(): void
extern function nq_bench_frame_marker(pixels: *u32, pixel_count: usize): void
extern function nq_bench_fail(): void

function nqRenderFractal(pixels: []u32, width: usize, height: usize): bool {
    if width == 0 as usize || height == 0 as usize { return false }
    if height > len(pixels) / width { return false }
    let i: usize = 0 as usize
    while i < width * height {
        let x: i64 = (i % width) as i64
        let y: i64 = (i / width) as i64
        // Integer fixed-point Mandelbrot, scale=1024. Same math as C reference.
        let cx: i64 = (x * 3072 as i64) / (width as i64) - 2048 as i64
        let cy: i64 = (y * 2458 as i64) / (height as i64) - 1229 as i64
        let zx: i64 = 0 as i64
        let zy: i64 = 0 as i64
        let step: i64 = 0 as i64
        while step < 32 as i64 && zx * zx + zy * zy <= 4194304 as i64 {
            let next_x: i64 = (zx * zx - zy * zy) / 1024 as i64 + cx
            let next_y: i64 = (2 as i64 * zx * zy) / 1024 as i64 + cy
            zx = next_x
            zy = next_y
            step = step + 1 as i64
        }
        let color: u32 = 4278190080 as u32
        if step < 32 as i64 {
            let red: u32 = ((step * 9 as i64) % 256 as i64) as u32
            let green: u32 = ((step * 5 as i64) % 256 as i64) as u32
            let blue: u32 = ((step * 13 as i64) % 256 as i64) as u32
            color = nqArgb8888(red, green, blue)
        }
        pixels[i] = color
        i = i + 1 as usize
    }
    return true
}

let width: usize = nq_bench_width()
let height: usize = nq_bench_height()
let count: usize = width * height
let pointer: *u32 = nq_bench_framebuffer()
let pixels: []u32 = slice(pointer, count)
let frames: usize = nq_bench_frames()
let mode: int = nq_bench_mode()
let frame: usize = 0 as usize

nq_bench_clock_start()
while frame < frames {
    let worked: bool = false
    if mode == 0 {
        worked = nqRenderGradient(pixels, width, height)
    } else if mode == 1 {
        worked = nqRenderChecker(
            pixels, width, height, 16 as usize,
            4279383126 as u32, 4294892730 as u32
        )
    } else {
        worked = nqRenderFractal(pixels, width, height)
    }
    if !worked {
        nq_bench_fail()
    }
    // The host samples pixels after EVERY frame. Prevents dead-store elimination
    // and forces both implementations to perform every rendering pass.
    nq_bench_frame_marker(pointer, count)
    frame = frame + 1 as usize
}
nq_bench_clock_stop()
