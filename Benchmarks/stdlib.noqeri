import "../Lib/std/slice_i64.nqr"
import "../Lib/std/sort.nqr"
import "../Lib/std/search.nqr"

let values: [i64; 16] = [16 as i64, 3 as i64, 11 as i64, 8 as i64, 1 as i64, 15 as i64, 6 as i64, 4 as i64, 14 as i64, 2 as i64, 10 as i64, 7 as i64, 12 as i64, 5 as i64, 13 as i64, 9 as i64]
let view: []i64 = slice(values)
let round: int = 0
while round < 200 {
    nqInsertionSortI64(view)
    nqBinarySearchI64(view, 12 as i64)
    nqSliceSumI64(view)
    round = round + 1
}
print(values[0])
print(values[15])
