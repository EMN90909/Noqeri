import "../../Lib/std/text.nqr"

let left: [u8; 16] = [110 as u8,111 as u8,113 as u8,101 as u8,114 as u8,105 as u8,45 as u8,98 as u8,101 as u8,110 as u8,99 as u8,104 as u8,45 as u8,48 as u8,49 as u8,50 as u8]
let right: [u8; 16] = [110 as u8,111 as u8,113 as u8,101 as u8,114 as u8,105 as u8,45 as u8,98 as u8,101 as u8,110 as u8,99 as u8,104 as u8,45 as u8,48 as u8,49 as u8,51 as u8]
let total: usize = 0 as usize
let round: usize = 0 as usize
while round < 500000 as usize {
    if text_equal_ascii_ignore_case(slice(left), slice(left)) { total = total + 1 as usize }
    if !text_equal_ascii_ignore_case(slice(left), slice(right)) { total = total + 1 as usize }
    round = round + 1 as usize
}
print(total)
