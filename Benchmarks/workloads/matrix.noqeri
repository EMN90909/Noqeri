let a: [int; 256]
let b: [int; 256]
let c: [int; 256]
let i: usize = 0 as usize
while i < 256 as usize {
    a[i] = ((i * 17 as usize + 3 as usize) % 97 as usize) as int
    b[i] = ((i * 29 as usize + 11 as usize) % 89 as usize) as int
    c[i] = 0
    i = i + 1 as usize
}
let repeat: usize = 0 as usize
while repeat < 20 as usize {
    let row: usize = 0 as usize
    while row < 16 as usize {
        let col: usize = 0 as usize
        while col < 16 as usize {
            let sum: int = 0
            let k: usize = 0 as usize
            while k < 16 as usize {
                sum = sum + a[row * 16 as usize + k] * b[k * 16 as usize + col]
                k = k + 1 as usize
            }
            c[row * 16 as usize + col] = sum
            col = col + 1 as usize
        }
        row = row + 1 as usize
    }
    repeat = repeat + 1 as usize
}
print(c[0])
print(c[255])
