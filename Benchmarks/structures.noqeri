import "../Lib/std/bitset.nqr"
import "../Lib/std/bloom.nqr"
import "../Lib/std/deque.nqr"
import "../Lib/std/heap.nqr"
import "../Lib/std/priority_queue.nqr"

// Foundational-structure workload. This file is a benchmark fixture, not a
// checked-in performance claim: suite.json keeps these workloads `unmeasured`
// until a runner records environment metadata and raw samples.
function main(): int {
    let bitsetStateBytes: [u8; 32] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let bitBytes: [u8; 8] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let bits: *BitSet = (&bitsetStateBytes[0 as usize]) as *BitSet
    if !bitset_init(bits, &bitBytes[0 as usize], 64 as usize, 8 as usize) { return 1 }

    let bloomStateBytes: [u8; 64] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let bloomBytes: [u8; 8] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let filter: *BloomFilter = (&bloomStateBytes[0 as usize]) as *BloomFilter
    if !bloom_init(filter, &bloomBytes[0 as usize], 64 as usize, 8 as usize, 4 as usize, 23 as u64) { return 2 }

    let dequeStateBytes: [u8; 64] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let dequeValues: [i64; 8] = [0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64]
    let deque: *Deque<i64> = (&dequeStateBytes[0 as usize]) as *Deque<i64>
    if !deque_init(deque, &dequeValues[0 as usize], 8 as usize) { return 3 }

    let heapStateBytes: [u8; 64] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let heapValues: [i64; 8] = [0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64]
    let heap: *Heap<i64> = (&heapStateBytes[0 as usize]) as *Heap<i64>
    if !heap_init(heap, &heapValues[0 as usize], 8 as usize, true) { return 4 }

    let queueStateBytes: [u8; 96] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let queueValues: [i64; 8] = [0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64]
    let queuePriorities: [i64; 8] = [0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64,0 as i64]
    let queueSequences: [u64; 8] = [0 as u64,0 as u64,0 as u64,0 as u64,0 as u64,0 as u64,0 as u64,0 as u64]
    let queue: *PriorityQueue<i64> = (&queueStateBytes[0 as usize]) as *PriorityQueue<i64>
    if !priority_queue_init(queue, &queueValues[0 as usize], &queuePriorities[0 as usize], &queueSequences[0 as usize], 8 as usize, false) { return 5 }

    let round: usize = 0 as usize
    while round < 1000 as usize {
        let i: usize = 0 as usize
        while i < 8 as usize {
            bitset_assign(bits, (round * 13 as usize + i * 7 as usize) % 64 as usize, (i % 3 as usize) == 0 as usize)
            bloom_add_u64(filter, (round * 8 as usize + i) as u64)
            deque_push_back(deque, i as i64)
            heap_push(heap, (7 as usize - i) as i64)
            priority_queue_push(queue, i as i64, (i % 5 as usize) as i64)
            i = i + 1 as usize
        }

        i = 0 as usize
        while i < 8 as usize {
            bloom_might_contain_u64(filter, (round * 8 as usize + i) as u64)
            deque_pop_front_or(deque, -1 as i64)
            heap_pop_or(heap, -1 as i64)
            priority_queue_pop_or(queue, -1 as i64)
            i = i + 1 as usize
        }
        round = round + 1 as usize
    }

    print(bitset_count_ones(bits))
    print(bloom_count_set_bits(filter))
    return 0
}
