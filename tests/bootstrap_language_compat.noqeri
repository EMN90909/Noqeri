function later(value: int): int

function callForward(): int {
    return later(39)
}

function later(value: int): int {
    return value + 3
}

export function contextualNames(): int {
    let record: int = 1
    let function: int = 2
    let module: int = 3
    record = record + function
    return callForward() + record + module
}


export function castComparison(): int {
    let index: usize = 1 as usize
    let limit: usize = 2 as usize
    if index as usize < limit { return 1 }
    return 0
}


export function integerLiteralPromotion(): usize {
    let index: usize = 4 as usize
    let doubled: usize = index * 2
    let advanced: usize = doubled + 1
    let narrowedLiteral: u32 = 3 as u32
    let widened: u32 = narrowedLiteral + 2
    return advanced + widened as usize
}

export function zeroLengthArrayContext(): usize {
    let empty: [u8; 0] = []
    return len(empty)
}
