import "../Database/noesql_api.nqr"
function require(valid: bool): void {
    if !valid {
        let bad: *u8 = 0 as *u8
        print(bad[0])
    }
}
let ctx: NoeQueryContext
ctx.abiVersion = noeApiVersion()
ctx.schemaVersion = 1 as u32
ctx.tenant = 5 as u64
ctx.principal.userId = 4 as u64
ctx.principal.authenticated = true
ctx.principal.disabled = false
