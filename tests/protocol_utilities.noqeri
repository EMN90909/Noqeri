import "../Lib/std/semver.nqr"
import "../Lib/std/uuid.nqr"
import "../Lib/std/querystring.nqr"
import "../Lib/std/glob.nqr"

function test_semver(): int {
    let stable: [u8; 5] = [49 as u8,46 as u8,50 as u8,46 as u8,51 as u8]
    let pre: [u8; 13] = [49 as u8,46 as u8,50 as u8,46 as u8,51 as u8,45 as u8,97 as u8,108 as u8,112 as u8,104 as u8,97 as u8,46 as u8,50 as u8]
    let pre10: [u8; 14] = [49 as u8,46 as u8,50 as u8,46 as u8,51 as u8,45 as u8,97 as u8,108 as u8,112 as u8,104 as u8,97 as u8,46 as u8,49 as u8,48 as u8]
    let build: [u8; 13] = [49 as u8,46 as u8,50 as u8,46 as u8,51 as u8,43 as u8,98 as u8,117 as u8,105 as u8,108 as u8,100 as u8,46 as u8,55 as u8]
    let badZero: [u8; 6] = [48 as u8,49 as u8,46 as u8,50 as u8,46 as u8,51 as u8]
    let badPre: [u8; 14] = [49 as u8,46 as u8,50 as u8,46 as u8,51 as u8,45 as u8,97 as u8,108 as u8,112 as u8,104 as u8,97 as u8,46 as u8,48 as u8,49 as u8]
    if !semver_valid(slice(stable)) || !semver_is_stable(slice(stable)) { return 1 }
    if !semver_valid(slice(pre)) || !semver_has_prerelease(slice(pre)) { return 2 }
    if semver_compare(slice(pre), slice(stable)) != -1 { return 3 }
    if semver_compare(slice(pre10), slice(pre)) != 1 { return 4 }
    if !semver_valid(slice(build)) || !semver_has_build(slice(build)) { return 5 }
    if semver_valid(slice(badZero)) || semver_valid(slice(badPre)) { return 6 }
    if semver_major(slice(stable), 99 as u64) != 1 as u64 || semver_minor(slice(stable), 99 as u64) != 2 as u64 || semver_patch(slice(stable), 99 as u64) != 3 as u64 { return 7 }
    return 0
}

function test_uuid(): int {
    let text: [u8; 36] = [53 as u8,53 as u8,48 as u8,101 as u8,56 as u8,52 as u8,48 as u8,48 as u8,45 as u8,101 as u8,50 as u8,57 as u8,98 as u8,45 as u8,52 as u8,49 as u8,100 as u8,52 as u8,45 as u8,97 as u8,55 as u8,49 as u8,54 as u8,45 as u8,52 as u8,52 as u8,54 as u8,54 as u8,53 as u8,53 as u8,52 as u8,52 as u8,48 as u8,48 as u8,48 as u8,48 as u8]
    let compact: [u8; 32] = [53 as u8,53 as u8,48 as u8,101 as u8,56 as u8,52 as u8,48 as u8,48 as u8,101 as u8,50 as u8,57 as u8,98 as u8,52 as u8,49 as u8,100 as u8,52 as u8,97 as u8,55 as u8,49 as u8,54 as u8,52 as u8,52 as u8,54 as u8,54 as u8,53 as u8,53 as u8,52 as u8,52 as u8,48 as u8,48 as u8,48 as u8,48 as u8]
    let nilText: [u8; 36] = [48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,45 as u8,48 as u8,48 as u8,48 as u8,48 as u8,45 as u8,48 as u8,48 as u8,48 as u8,48 as u8,45 as u8,48 as u8,48 as u8,48 as u8,48 as u8,45 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8,48 as u8]
    if !uuid_text_valid(slice(text)) || uuid_version(slice(text)) != 4 || uuid_variant(slice(text)) != 1 { return 1 }
    if !uuid_compact_valid(slice(compact)) || !uuid_equal_text(slice(text), slice(compact)) { return 2 }
    if !uuid_is_nil(slice(nilText)) || uuid_is_nil(slice(text)) { return 3 }
    let bytes: [u8; 16] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let rendered: [u8; 36] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    if !uuid_parse(slice(text), slice(bytes)) || !uuid_format(slice(bytes), slice(rendered), false) || !uuid_equal_text(slice(text), slice(rendered)) { return 4 }
    return 0
}

function test_query(): int {
    let raw: [u8; 13] = [104 as u8,101 as u8,108 as u8,108 as u8,111 as u8,32 as u8,119 as u8,111 as u8,114 as u8,108 as u8,100 as u8,47 as u8,43 as u8]
    let query: [u8; 29] = [63 as u8,110 as u8,97 as u8,109 as u8,101 as u8,61 as u8,78 as u8,111 as u8,113 as u8,101 as u8,114 as u8,105 as u8,38 as u8,109 as u8,111 as u8,100 as u8,101 as u8,61 as u8,102 as u8,97 as u8,115 as u8,116 as u8,38 as u8,101 as u8,109 as u8,112 as u8,116 as u8,121 as u8,61 as u8]
    let nameKey: [u8; 4] = [110 as u8,97 as u8,109 as u8,101 as u8]
    let pattern: [u8; 9] = [115 as u8,114 as u8,99 as u8,47 as u8,42 as u8,46 as u8,110 as u8,113 as u8,114 as u8]
    let pathGood: [u8; 12] = [115 as u8,114 as u8,99 as u8,47 as u8,109 as u8,97 as u8,105 as u8,110 as u8,46 as u8,110 as u8,113 as u8,114 as u8]
    let pathBad: [u8; 19] = [115 as u8,114 as u8,99 as u8,47 as u8,110 as u8,101 as u8,115 as u8,116 as u8,101 as u8,100 as u8,47 as u8,109 as u8,97 as u8,105 as u8,110 as u8,46 as u8,110 as u8,113 as u8,114 as u8]
    let encoded: [u8; 64] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let decoded: [u8; 64] = [0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8,0 as u8]
    let written: usize = querystring_encode_component(slice(raw), slice(encoded), true)
    if written != 17 as usize { return 1 }
    let result: QueryDecodeResult
    if !querystring_decode_component(slice(encoded), slice(decoded), true, true, &result) || result.written != len(raw) { return 2 }
    let i: usize = 0 as usize
    while i < len(raw) { if decoded[i] != raw[i] { return 3 } i = i + 1 as usize }
    if querystring_pair_count(slice(query)) != 3 as usize { return 4 }
    let pair: QueryPair
    if !querystring_find_raw(slice(query), slice(nameKey), &pair) || pair.valueLength != 6 as usize { return 5 }
    if !glob_match_path(slice(pattern), slice(pathGood)) || glob_match_path(slice(pattern), slice(pathBad)) { return 6 }
    return 0
}

function main(): int {
    let result: int = test_semver()
    if result != 0 { return 10 + result }
    result = test_uuid()
    if result != 0 { return 30 + result }
    result = test_query()
    if result != 0 { return 50 + result }
    return 0
}
