// Beginner: no explicit capacity, buffer, FFI, imports or type annotation.
let numbers = [5, 10]
numbers.append(15)
print(numbers.length())

function verify(): int {
    let local = [1, 2]
    local.append(3)
    local.append(-7)
    if local.length() != 4 as usize { return 1 }
    if local[0] != 1 || local[2] != 3 || local[3] != -7 { return 4 }
    local[1] = 12
    if local[1] != 12 { return 8 }
    let sum: int = 0
    for element in local {
        sum = sum + element
    }
    if sum != 9 { return 6 }
    let another = [9]
    another.append(8)
    if another.length() != 2 as usize { return 2 }
    // Empty literal adopts List<int> only because same-scope append
    // supplies its missing element type.
    let empty = []
    empty.append(31)
    empty.append(32)
    if empty.length() != 2 as usize { return 3 }
    if empty[0] != 31 || empty[1] != 32 { return 5 }
    let evenTotal: int = 0
    for entry in empty {
        evenTotal = evenTotal + entry
    }
    if evenTotal != 63 { return 7 }
    return 0
}
print(verify())
