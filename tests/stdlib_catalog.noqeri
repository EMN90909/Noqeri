function main(): int {
    if abs_int(-9) != 9 { return 1 }
    if min_int(4,7) != 4 || max_int(4,7) != 7 { return 2 }
    if clamp_int(99,0,10) != 10 { return 3 }
    if gcd_int(84,30) != 6 || lcm_int(12,18) != 36 { return 4 }
    if pow_int(3,4 as u32) != 81 || sqrt_int(81) != 9 { return 5 }
    if !date_is_leap_year(2024) || date_is_leap_year(2100) { return 6 }
    if date_days_in_month(2024,2) != 29 { return 7 }
    if !net_valid_port(443 as u32) || net_valid_port(0 as u32) { return 8 }
    if !http_status_is_success(204) || http_status_is_success(404) { return 9 }
    if !aes_key_size_valid(256 as usize) || aes_key_size_valid(512 as usize) { return 10 }
    if !rsa_key_size_valid(3072 as usize) || rsa_key_size_valid(1024 as usize) { return 11 }
    if !ed25519_signature_length_valid(64 as usize) { return 12 }
    if !sql_identifier_valid(slice([117 as u8,115 as u8,101 as u8,114 as u8,95 as u8,105 as u8,100 as u8])) { return 13 }
    return 0
}
