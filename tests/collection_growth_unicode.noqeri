// List descriptor invariants and Unicode scalar runtime regression.
// Unsafe escape of borrowed stack storage is deliberately NOT used here.
import "../Lib/std/list.noqeri"
import "../Lib/std/iterator.noqeri"

// These signatures instantiate the checked rebind helpers only with
// caller-owned storage. Lifetimes are the caller's responsibility.
export function compile_checked_growth(list: *List<int>, storage: *int): bool {
    return list_grow_into(list,storage,4 as usize)
}
function verify(): int {
    let storage: [int; 2] = [10,20]
    let list: List<int>
    list.data = &storage[0 as usize]
    list.length = 2 as usize
    list.capacity = 2 as usize
    if !list_invariant(&list) { return 1 }
    if list_push(&list,30) { return 2 }
    if list_length(&list) != 2 as usize { return 3 }
    let iterator: Iterator<int>
    iterator.data = &storage[0 as usize]
    iterator.length = 2 as usize
    iterator.front = 0 as usize
    iterator.back = 2 as usize
    if iterator_next_or(&iterator,-1) != 10 { return 4 }
    if iterator_next_or(&iterator,-1) != 20 { return 5 }
    if iterator_next_or(&iterator,-1) != -1 { return 6 }
    if !iterator_reset(&iterator) { return 7 }
    if iterator_next_or(&iterator,-1) != 10 { return 8 }

    let bytes: [u8; 8] = [65 as u8,226 as u8,130 as u8,172 as u8,
                         240 as u8,159 as u8,140 as u8,141 as u8]
    let unicode: Utf8Iterator
    unicode.bytes = slice(bytes)
    unicode.position = 0 as usize
    let scalar: u32 = 0 as u32
    if utf8_iterator_next(&unicode,&scalar) != 1 as isize || scalar != 65 as u32 { return 9 }
    if utf8_iterator_next(&unicode,&scalar) != 1 as isize || scalar != 8364 as u32 { return 10 }
    if utf8_iterator_next(&unicode,&scalar) != 1 as isize || scalar != 127757 as u32 { return 11 }
    if utf8_iterator_next(&unicode,&scalar) != 0 as isize { return 12 }
    if utf8_iterator_position(&unicode) != 8 as usize { return 13 }
    if !utf8_iterator_reset(&unicode) || utf8_iterator_position(&unicode) != 0 as usize { return 14 }
    let invalid: [u8; 2] = [192 as u8,175 as u8]
    unicode.bytes = slice(invalid)
    unicode.position = 0 as usize
    scalar = 777 as u32
    if utf8_iterator_next(&unicode,&scalar) != -1 as isize { return 15 }
    if scalar != 777 as u32 || utf8_iterator_position(&unicode) != 0 as usize { return 16 }
    return 0
}
print(verify())
