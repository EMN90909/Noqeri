// Stage-2 self-hosted parser + semantic inference qualification.
// Independently run by Stage-0 reference interpreter (not a textual proxy).
import "../Compiler/selfhost/parser_stmt.noqeri"
import "../Compiler/selfhost/semantic_program.noqeri"
import "../Compiler/selfhost/ast.noqeri"

function test_int_expression(): int {
    let source: [u8; 30] = [102 as u8, 117 as u8, 110 as u8, 99 as u8, 116 as u8, 105 as u8, 111 as u8, 110 as u8, 32 as u8, 116 as u8, 119 as u8, 105 as u8, 99 as u8, 101 as u8, 40 as u8, 120 as u8, 58 as u8, 32 as u8, 105 as u8, 110 as u8, 116 as u8, 41 as u8, 32 as u8, 61 as u8, 32 as u8, 120 as u8, 32 as u8, 42 as u8, 32 as u8, 50 as u8]
    let nodes: [NqAstNode; 128]
    let count: usize = 0 as usize
    let first: isize = nqAstNoNode()
    if nqParserParseProgram(slice(source),slice(nodes),&count,&first) != 0 as isize { return 1 }
    let status: isize = nqSemanticAnalyzeProgram(slice(source),slice(nodes),&count,first,false)
    if status < 0 as isize { return 2 }
    let body: isize = nodes[first as usize].extra
    let returned: isize = nodes[body as usize].left
    let value: isize = nodes[returned as usize].left
    if value < 0 as isize || nodes[value as usize].typeCode != nqAstTypeInt() { return 3 }
    return 0
}

