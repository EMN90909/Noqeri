import "../Lib/std/duration.nqr"
import "../Lib/std/calendar.nqr"
import "../Lib/std/clock.nqr"

function main(): int {
    // Duration: amount-of-time arithmetic and normalization.
    let negativeQuarter: Duration
    if !duration_from_millis(&negativeQuarter, -250 as i64) { return 1 }
    if negativeQuarter.seconds != -1 as i64 || negativeQuarter.nanoseconds != 750000000 as i64 { return 2 }
    if duration_whole_millis(&negativeQuarter) != -250 as i64 { return 3 }

    let oneAndHalf: Duration
    if !duration_from_millis(&oneAndHalf, 1500 as i64) { return 4 }
    if oneAndHalf.seconds != 1 as i64 || oneAndHalf.nanoseconds != 500000000 as i64 { return 5 }
    if duration_whole_millis(&oneAndHalf) != 1500 as i64 { return 6 }

    let combined: Duration
    if !duration_add_into(&combined, &oneAndHalf, &negativeQuarter) { return 7 }
    if duration_whole_millis(&combined) != 1250 as i64 { return 8 }
    if duration_compare(&combined, &oneAndHalf) >= 0 { return 9 }
    if duration_ratio_per_mille(&negativeQuarter, &oneAndHalf) != -166 as i64 { return 10 }

    let twoHours: Duration
    if !duration_from_hours(&twoHours, 2 as i64) { return 11 }
    if duration_whole_minutes(&twoHours) != 120 as i64 { return 12 }
    if duration_hours_to_seconds(2 as i64) != 7200 as i64 { return 13 }
    if duration_days_to_seconds(2 as i64) != 172800 as i64 { return 14 }

    let clamped: Duration
    let zero: Duration
    duration_set_zero(&zero)
    if !duration_clamp_into(&clamped, &negativeQuarter, &zero, &twoHours) { return 15 }
    if !duration_is_zero(&clamped) { return 16 }

    // Calendar: civil-date rules, month grids and useful planning helpers.
    let leapDay: CalendarDate
    if !calendar_set(&leapDay, 2024, 2, 29) { return 20 }
    if !calendar_value_valid(&leapDay) { return 21 }
    if calendar_day_of_year(2024, 2, 29) != 60 { return 22 }
    if calendar_iso_weekday(2024, 2, 29) != 4 { return 23 }
    if calendar_days_in_month(2024, 2) != 29 || calendar_days_in_month(2025, 2) != 28 { return 24 }
    if calendar_quarter(11) != 4 || calendar_month_in_quarter(11) != 2 { return 25 }
    if calendar_first_weekday_of_month(2024, 2) != 4 { return 26 }
    if calendar_leading_days_monday(2024, 2) != 3 { return 27 }
    if calendar_weeks_in_month_grid(2024, 2) != 5 { return 28 }
    if calendar_nth_weekday_of_month(2024, 2, 1, 3) != 19 { return 29 }
    if calendar_last_weekday_day_of_month(2024, 2, 5) != 23 { return 30 }
    if calendar_business_days_in_month(2024, 2) != 21 { return 31 }

    let nextMonth: CalendarDate
    calendar_copy(&nextMonth, &leapDay)
    if !calendar_add_months_in_place(&nextMonth, 1) { return 32 }
    if nextMonth.year != 2024 || nextMonth.month != 3 || nextMonth.day != 29 { return 33 }

    let nextYear: CalendarDate
    calendar_copy(&nextYear, &leapDay)
    if !calendar_add_years_in_place(&nextYear, 1) { return 34 }
    if nextYear.year != 2025 || nextYear.month != 2 || nextYear.day != 28 { return 35 }
    if calendar_days_between(&leapDay, &nextYear) != 365 as i64 { return 36 }
    if calendar_fiscal_month(7, 7) != 1 || calendar_fiscal_quarter(12, 7) != 2 { return 37 }

    // Clock: time-of-day arithmetic including midnight wrap.
    let late: ClockTime
    if !clock_set(&late, 23, 59, 30, 500) { return 40 }
    if clock_to_millis(&late) != 86370500 as i64 { return 41 }
    if clock_hour_12(&late) != 11 || !clock_is_pm(&late) { return 42 }
    let crossed: i64 = clock_add_seconds_in_place(&late, 60 as i64)
    if crossed != 1 as i64 { return 43 }
    if late.hour != 0 || late.minute != 0 || late.second != 30 || late.millisecond != 500 { return 44 }

    let start: ClockTime
    let finish: ClockTime
    let inside: ClockTime
    clock_set(&start, 23, 0, 0, 0)
    clock_set(&finish, 1, 0, 0, 0)
    clock_set(&inside, 0, 30, 0, 0)
    if !clock_between(&inside, &start, &finish) { return 45 }
    if clock_forward_elapsed_millis(&start, &finish) != 7200000 as i64 { return 46 }

    let morning: ClockTime
    clock_set(&morning, 9, 30, 45, 600)
    if clock_minute_of_day(&morning) != 570 { return 47 }
    if clock_progress_hour_per_mille(&morning) < 512 || clock_progress_hour_per_mille(&morning) > 513 { return 48 }
    if clock_round_down_to_minute(&morning) == false { return 49 }
    if morning.second != 0 || morning.millisecond != 0 { return 50 }

    let normalized: ClockTime
    if !clock_from_seconds(&normalized, -1 as i64) { return 51 }
    if normalized.hour != 23 || normalized.minute != 59 || normalized.second != 59 { return 52 }

    return 0
}
