database "noqeridb-test.nqdb"

table users {
    id: int key,
    name: text required,
    active: bool required
}

delete users where id = 1
delete users where id = 2
insert users { id: 1, name: "Ada", active: true }
insert users { id: 2, name: "Grace", active: true }
update users set { name: "Grace Hopper" } where id = 2
select users where active = true
