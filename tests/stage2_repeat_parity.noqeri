// Check the real self-hosted Stage-2 parser, semantic checker and
// lowerer rather than merely grepping for the repeat keyword.
import "../Compiler/selfhost/main.noqeri"
import "../Compiler/selfhost/targets.noqeri"

function validateRepeat(): int {
    let source: [u8; 102] = [102 as u8, 117 as u8, 110 as u8, 99 as u8, 116 as u8, 105 as u8, 111 as u8, 110 as u8, 32 as u8, 109 as u8, 97 as u8, 105 as u8, 110 as u8, 40 as u8, 41 as u8, 58 as u8, 32 as u8, 105 as u8, 110 as u8, 116 as u8, 32 as u8, 123 as u8, 32 as u8, 108 as u8, 101 as u8, 116 as u8, 32 as u8, 110 as u8, 58 as u8, 32 as u8, 105 as u8, 110 as u8, 116 as u8, 32 as u8, 61 as u8, 32 as u8, 51 as u8, 32 as u8, 114 as u8, 101 as u8, 112 as u8, 101 as u8, 97 as u8, 116 as u8, 32 as u8, 110 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 112 as u8, 101 as u8, 97 as u8, 116 as u8, 32 as u8, 50 as u8, 32 as u8, 123 as u8, 32 as u8, 105 as u8, 102 as u8, 32 as u8, 110 as u8, 32 as u8, 62 as u8, 32 as u8, 48 as u8, 32 as u8, 123 as u8, 32 as u8, 99 as u8, 111 as u8, 110 as u8, 116 as u8, 105 as u8, 110 as u8, 117 as u8, 101 as u8, 32 as u8, 125 as u8, 32 as u8, 125 as u8, 32 as u8, 98 as u8, 114 as u8, 101 as u8, 97 as u8, 107 as u8, 32 as u8, 125 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8, 48 as u8, 32 as u8, 125 as u8]
    if stage2SyntaxCheck(slice(source)) != 0 as isize { return 1 }
    if stage2SemanticCheckMerged(slice(source), false) != 0 as isize { return 2 }
    if stage2CompileCheck(slice(source), nqTargetLinuxX64(), false) != 0 as isize { return 3 }
    return 0
}
function rejectWrongRepeatCount(): int {
    let source: [u8; 50] = [102 as u8, 117 as u8, 110 as u8, 99 as u8, 116 as u8, 105 as u8, 111 as u8, 110 as u8, 32 as u8, 109 as u8, 97 as u8, 105 as u8, 110 as u8, 40 as u8, 41 as u8, 58 as u8, 32 as u8, 105 as u8, 110 as u8, 116 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 112 as u8, 101 as u8, 97 as u8, 116 as u8, 32 as u8, 34 as u8, 98 as u8, 97 as u8, 100 as u8, 34 as u8, 32 as u8, 123 as u8, 32 as u8, 125 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8, 48 as u8, 32 as u8, 125 as u8]
    if stage2SyntaxCheck(slice(source)) != 0 as isize { return 4 }
    if stage2SemanticCheckMerged(slice(source), false) >= 0 as isize { return 5 }
    return 0
}
function rejectUnclosedRepeat(): int {
    let source: [u8; 44] = [102 as u8, 117 as u8, 110 as u8, 99 as u8, 116 as u8, 105 as u8, 111 as u8, 110 as u8, 32 as u8, 109 as u8, 97 as u8, 105 as u8, 110 as u8, 40 as u8, 41 as u8, 58 as u8, 32 as u8, 105 as u8, 110 as u8, 116 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 112 as u8, 101 as u8, 97 as u8, 116 as u8, 32 as u8, 51 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8, 48 as u8, 32 as u8, 125 as u8]
    if stage2SyntaxCheck(slice(source)) >= 0 as isize { return 6 }
    return 0
}
print(validateRepeat())
print(rejectWrongRepeatCount())
print(rejectUnclosedRepeat())
