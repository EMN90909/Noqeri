import "../Compiler/selfhost/elf_writer.noqeri"
import "../Compiler/selfhost/nir.noqeri"
import "../Compiler/selfhost/ast.noqeri"
import "../Compiler/selfhost/targets.noqeri"

// Execute via the Noqeri-written NIR -> ELF64 emitter under the NQRI VM.
// Linux can link the emitted bytes as a relocatable object. This test checks
// actual Noqeri-generated bytes; it does not claim native self-hosting.
export function nativeElfObjectSmoke(): int {
    let code: [NqNirInstruction; 2]
    nqNirMakeConst(&code[0], 0 as isize, 42 as i64, nqAstTypeI64())
    nqNirInstructionInit(&code[1], nqNirReturn(), nqNirNoValue())
    code[1].left = 0 as isize

    let bytes: [u8; 497]
    if nqElfWriteConstReturnObject(slice(bytes), nqTargetLinuxX64(), slice(code)) != 497 as isize { return 1 }
    if bytes[0] != 127 as u8 || bytes[1] != 69 as u8 || bytes[2] != 76 as u8 || bytes[3] != 70 as u8 { return 2 }
    if bytes[18] != 62 as u8 || bytes[60] != 5 as u8 || bytes[62] != 4 as u8 { return 3 }
    if bytes[384] != 0x48 as u8 || bytes[385] != 0xb8 as u8 || bytes[386] != 42 as u8 || bytes[394] != 0xc3 as u8 { return 4 }
    if bytes[440] != 1 as u8 || bytes[444] != 0x12 as u8 || bytes[446] != 1 as u8 || bytes[456] != 11 as u8 { return 5 }
    if bytes[401] != 110 as u8 || bytes[464] != 0 as u8 || bytes[465] != 46 as u8 { return 6 }

    code[0].immediate = -79 as i64
    if nqElfWriteConstReturnObject(slice(bytes), nqTargetLinuxX64(), slice(code)) != 497 as isize { return 7 }
    if bytes[386] != 177 as u8 || bytes[387] != 255 as u8 || bytes[393] != 255 as u8 { return 8 }
    let shortOutput: [u8; 496]
    if nqElfWriteConstReturnObject(slice(shortOutput), nqTargetLinuxX64(), slice(code)) != -2 as isize { return 9 }
    if nqElfWriteConstReturnObject(slice(bytes), nqTargetMacX64(), slice(code)) != -1 as isize { return 10 }
    code[1].left = 1 as isize
    if nqElfWriteConstReturnObject(slice(bytes), nqTargetLinuxX64(), slice(code)) != -1 as isize { return 11 }
    return 0
}


// A narrow writable-buffer ABI for the NQRI VM host adapter. All ELF syntax,
// machine-code bytes and relocation policy remain in elf_writer.noqeri.
export function nativeElfWriteFixture(out: []u8): isize {
    let code: [NqNirInstruction; 2]
    nqNirMakeConst(&code[0], 0 as isize, 42 as i64, nqAstTypeI64())
    nqNirInstructionInit(&code[1], nqNirReturn(), nqNirNoValue())
    code[1].left = 0 as isize
    return nqElfWriteConstReturnObject(out, nqTargetLinuxX64(), slice(code))
}
