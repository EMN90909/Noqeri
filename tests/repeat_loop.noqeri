function repeat_add(count: int): int {
    let total: int = 0
    repeat count {
        total = total + 3
    }
    return total
}

function function_count_test(): int {
    let value: int = 1
    repeat 4 {
        value = value * 2
    }
    if value != 16 { return 4 }
    return 0
}

function main(): int {
    if repeat_add(5) != 15 { return 1 }
    if repeat_add(0) != 0 { return 2 }
    if repeat_add(-2) != 0 { return 3 }
    if function_count_test() != 0 { return 4 }
    return 0
}
