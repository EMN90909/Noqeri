export function nativeElfSourceSmoke(): int {
    let source: [u8; 41] = [102 as u8, 117 as u8, 110 as u8, 99 as u8, 116 as u8, 105 as u8, 111 as u8, 110 as u8, 32 as u8, 109 as u8, 97 as u8, 105 as u8, 110 as u8, 40 as u8, 41 as u8, 58 as u8, 32 as u8, 105 as u8, 54 as u8, 52 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8, 52 as u8, 50 as u8, 32 as u8, 97 as u8, 115 as u8, 32 as u8, 105 as u8, 54 as u8, 52 as u8, 32 as u8, 125 as u8]
