// Literal-constrained private parameter inference: deterministic, no dynamic types.
function add(a,b) = a + b
function negated(value) = !value
function verify(): int {
    if add(19,23) != 42 { return 1 }
    if add(4,5) != 9 { return 2 }
    if negated(false) != true { return 3 }
    if negated(true) != false { return 4 }
    return 0
}
print(verify())
