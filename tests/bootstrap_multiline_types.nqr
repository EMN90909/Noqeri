module noqeri.tests.bootstrap_multiline_types

record NqBootstrapToken {
    kind: int
    start: usize
    end: usize
    first: u8
}

function typedValue(input: usize): usize {
    let current: usize = input
    if (current == 0 as usize) || (current > 0 as usize) { return current }
    return 0 as usize
}

function main(): int {
    let token: NqBootstrapToken
    if token.kind != 0 { return 10 }
    if token.start != 0 as usize { return 11 }
    let values: [u8; 4]
    if values[2 as usize] != 0 as u8 { return 12 }
    return typedValue(1 as usize) as int - 1
}
