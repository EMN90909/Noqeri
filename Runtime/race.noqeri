module noqeri.runtime.race

// Noqeri-native race detector core. The compiler/runtime supplies one event for
// each instrumented shared-memory access. Storage is caller-owned so race mode
// does not need a hidden allocator and remains usable in freestanding builds.
record NqRaceSlot {
    address: u64
    size: usize
    task: u64
    epoch: u64
    syncEpoch: u64
    source: u64
    write: bool
    atomicAccess: bool
    occupied: bool
}

record NqRaceReport {
    address: u64
    size: usize
    firstTask: u64
    secondTask: u64
    firstSource: u64
    secondSource: u64
    firstWrite: bool
    secondWrite: bool
}

record NqRaceClock {
    task: u64
    epoch: u64
    syncEpoch: u64
}

export function nqRaceOk(): isize { return 0 as isize }
export function nqRaceDetected(): isize { return -1 as isize }
export function nqRaceCapacity(): isize { return -2 as isize }
export function nqRaceInvalid(): isize { return -3 as isize }

export function nqRaceClockInit(clock: *NqRaceClock, task: u64): void {
    if clock == null { return }
    clock.task = task
    clock.epoch = 1 as u64
    clock.syncEpoch = 0 as u64
}

export function nqRaceClockTick(clock: *NqRaceClock): u64 {
    if clock == null { return 0 as u64 }
    if clock.epoch < 18446744073709551614 as u64 { clock.epoch = clock.epoch + 1 as u64 }
    return clock.epoch
}

// A synchronization operation creates a shared happens-before generation. Local
// task progress never changes syncEpoch, so ordinary computation cannot hide a
// race. Task join, channel hand-off and lock release/acquire call this routine.
export function nqRaceSynchronize(left: *NqRaceClock, right: *NqRaceClock): u64 {
    if left == null || right == null { return 0 as u64 }
    let next: u64 = left.syncEpoch
    if right.syncEpoch > next { next = right.syncEpoch }
    if next < 18446744073709551614 as u64 { next = next + 1 as u64 }
    left.syncEpoch = next
    right.syncEpoch = next
    nqRaceClockTick(left)
    nqRaceClockTick(right)
    return next
}

export function nqRaceSlotsClear(slots: []NqRaceSlot): void {
    let index: usize = 0 as usize
    while index < len(slots) {
        slots[index].address = 0 as u64
        slots[index].size = 0 as usize
        slots[index].task = 0 as u64
        slots[index].epoch = 0 as u64
        slots[index].syncEpoch = 0 as u64
        slots[index].source = 0 as u64
        slots[index].write = false
        slots[index].atomicAccess = false
        slots[index].occupied = false
        index = index + 1 as usize
    }
}

function nqRaceRangeEnd(address: u64, size: usize): u64 {
    if size == 0 as usize { return address }
    let amount: u64 = size as u64
    if amount - 1 as u64 > 18446744073709551615 as u64 - address { return 18446744073709551615 as u64 }
    return address + amount - 1 as u64
}

export function nqRaceRangesOverlap(a: u64, aSize: usize, b: u64, bSize: usize): bool {
    if aSize == 0 as usize || bSize == 0 as usize { return false }
    let aEnd: u64 = nqRaceRangeEnd(a, aSize)
    let bEnd: u64 = nqRaceRangeEnd(b, bSize)
    return a <= bEnd && b <= aEnd
}

export function nqRaceConflicts(previous: *NqRaceSlot, address: u64, size: usize, task: u64, syncEpoch: u64, write: bool, atomicAccess: bool): bool {
    if previous == null || !previous.occupied { return false }
    if !nqRaceRangesOverlap(previous.address, previous.size, address, size) { return false }
    if previous.task == task { return false }
    if previous.atomicAccess && atomicAccess { return false }
    if !previous.write && !write { return false }
    if syncEpoch > previous.syncEpoch { return false }
    return true
}

function nqRaceFillReport(previous: *NqRaceSlot, address: u64, size: usize, task: u64, source: u64, write: bool, report: *NqRaceReport): void {
    if report == null { return }
    report.address = address
    report.size = size
    report.firstTask = previous.task
    report.secondTask = task
    report.firstSource = previous.source
    report.secondSource = source
    report.firstWrite = previous.write
    report.secondWrite = write
}

function nqRaceChooseSlot(slots: []NqRaceSlot, address: u64): isize {
    if len(slots) == 0 as usize { return nqRaceCapacity() }
    let empty: isize = -1 as isize
    let index: usize = 0 as usize
    while index < len(slots) {
        if !slots[index].occupied && empty < 0 as isize { empty = index as isize }
        if slots[index].occupied && slots[index].address == address { return index as isize }
        index = index + 1 as usize
    }
    if empty >= 0 as isize { return empty }
    return (address % len(slots) as u64) as isize
}

// Records an access and reports a conflict against any overlapping tracked
// access. Bounded storage may evict old history but observed conflicting pairs
// are never converted into success.
export function nqRaceAccess(slots: []NqRaceSlot, clock: *NqRaceClock, address: u64, size: usize, write: bool, atomicAccess: bool, source: u64, report: *NqRaceReport): isize {
    if clock == null || clock.task == 0 as u64 || address == 0 as u64 || size == 0 as usize { return nqRaceInvalid() }
    let index: usize = 0 as usize
    while index < len(slots) {
        if nqRaceConflicts(&slots[index], address, size, clock.task, clock.syncEpoch, write, atomicAccess) {
            nqRaceFillReport(&slots[index], address, size, clock.task, source, write, report)
            return nqRaceDetected()
        }
        index = index + 1 as usize
    }
    let selected: isize = nqRaceChooseSlot(slots, address)
    if selected < 0 as isize { return selected }
    let slot: *NqRaceSlot = &slots[selected as usize]
    slot.address = address
    slot.size = size
    slot.task = clock.task
    slot.epoch = clock.epoch
    slot.syncEpoch = clock.syncEpoch
    slot.source = source
    slot.write = write
    slot.atomicAccess = atomicAccess
    slot.occupied = true
    nqRaceClockTick(clock)
    return nqRaceOk()
}

export function nqRaceRead(slots: []NqRaceSlot, clock: *NqRaceClock, address: u64, size: usize, source: u64, report: *NqRaceReport): isize {
    return nqRaceAccess(slots, clock, address, size, false, false, source, report)
}

export function nqRaceWrite(slots: []NqRaceSlot, clock: *NqRaceClock, address: u64, size: usize, source: u64, report: *NqRaceReport): isize {
    return nqRaceAccess(slots, clock, address, size, true, false, source, report)
}

export function nqRaceAtomicRead(slots: []NqRaceSlot, clock: *NqRaceClock, address: u64, size: usize, source: u64, report: *NqRaceReport): isize {
    return nqRaceAccess(slots, clock, address, size, false, true, source, report)
}

export function nqRaceAtomicWrite(slots: []NqRaceSlot, clock: *NqRaceClock, address: u64, size: usize, source: u64, report: *NqRaceReport): isize {
    return nqRaceAccess(slots, clock, address, size, true, true, source, report)
}
