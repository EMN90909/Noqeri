# Noqeri preview native server: HTTPS reverse-proxy boundary.
# Template: replace example.com and certificate paths before using.
# Include this file INSIDE the Nginx http {} context, not server {}.
# Start the native app on 127.0.0.1:8080 only. Do not expose that port.
#
# The native app still needs domain-specific authentication/authorization,
# production observability, multi-instance session storage and load qualification.
limit_req_zone $binary_remote_addr zone=noqeri_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=noqeri_connections:10m;

server {
    listen 80;
    server_name example.com;
    return 308 https://example.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com;
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    client_max_body_size 4k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    send_timeout 10s;
    keepalive_timeout 15s;
    limit_req zone=noqeri_requests burst=25 nodelay;
    limit_req_status 429;
    limit_conn noqeri_connections 8;
    limit_conn_status 429;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "close";
        proxy_set_header X-Forwarded-Proto "https";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 2s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_redirect off;
    }
}
