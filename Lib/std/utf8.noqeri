module noqeri.std.utf8

export function nqUtf8IsContinuation(value: u8): bool { return value >= 128 as u8 && value <= 191 as u8 }
export function nqUtf8ScalarValid(value: u32): bool { return value <= 1114111 as u32 && !(value >= 55296 as u32 && value <= 57343 as u32) }

export function nqUtf8SequenceLength(first: u8): usize {
    if first <= 127 as u8 { return 1 as usize }
    if first >= 194 as u8 && first <= 223 as u8 { return 2 as usize }
    if first >= 224 as u8 && first <= 239 as u8 { return 3 as usize }
    if first >= 240 as u8 && first <= 244 as u8 { return 4 as usize }
    return 0 as usize
}

export function nqUtf8DecodeAt(value: []u8, index: usize, out: *u32): isize {
    if index >= len(value) || out == null { return -1 as isize }
    let first: u8 = value[index]
    let length: usize = nqUtf8SequenceLength(first)
    if length == 0 as usize || index + length > len(value) { return -1 as isize }
    if length == 1 as usize { out[0 as usize] = first as u32 return 1 as isize }

    let second: u8 = value[index + 1 as usize]
    if !nqUtf8IsContinuation(second) { return -1 as isize }
    if length == 2 as usize {
        out[0 as usize] = (first - 192 as u8) as u32 * 64 as u32 + (second - 128 as u8) as u32
        return 2 as isize
    }

    let third: u8 = value[index + 2 as usize]
    if !nqUtf8IsContinuation(third) { return -1 as isize }
    if length == 3 as usize {
        let scalar: u32 = (first - 224 as u8) as u32 * 4096 as u32 + (second - 128 as u8) as u32 * 64 as u32 + (third - 128 as u8) as u32
        if scalar < 2048 as u32 || !nqUtf8ScalarValid(scalar) { return -1 as isize }
        out[0 as usize] = scalar
        return 3 as isize
    }

    let fourth: u8 = value[index + 3 as usize]
    if !nqUtf8IsContinuation(fourth) { return -1 as isize }
    let scalar: u32 = (first - 240 as u8) as u32 * 262144 as u32 + (second - 128 as u8) as u32 * 4096 as u32 + (third - 128 as u8) as u32 * 64 as u32 + (fourth - 128 as u8) as u32
    if scalar < 65536 as u32 || !nqUtf8ScalarValid(scalar) { return -1 as isize }
    out[0 as usize] = scalar
    return 4 as isize
}

export function nqUtf8Valid(value: []u8): bool {
    let index: usize = 0 as usize
    let scalar: u32 = 0 as u32
    while index < len(value) {
        let consumed: isize = nqUtf8DecodeAt(value, index, &scalar)
        if consumed <= 0 as isize { return false }
        index = index + consumed as usize
    }
    return true
}

export function nqUtf8CodeUnitCount(value: []u8): usize {
    let count: usize = 0 as usize
    let index: usize = 0 as usize
    while index < len(value) { if !nqUtf8IsContinuation(value[index]) { count = count + 1 as usize } index = index + 1 as usize }
    return count
}

export function nqUtf8ScalarCount(value: []u8): isize {
    let count: usize = 0 as usize
    let index: usize = 0 as usize
    let scalar: u32 = 0 as u32
    while index < len(value) {
        let consumed: isize = nqUtf8DecodeAt(value, index, &scalar)
        if consumed <= 0 as isize { return -1 as isize }
        count = count + 1 as usize
        index = index + consumed as usize
    }
    return count as isize
}

export function nqUtf8EncodedLength(scalar: u32): usize {
    if !nqUtf8ScalarValid(scalar) { return 0 as usize }
    if scalar <= 127 as u32 { return 1 as usize }
    if scalar <= 2047 as u32 { return 2 as usize }
    if scalar <= 65535 as u32 { return 3 as usize }
    return 4 as usize
}

export function nqUtf8EncodeInto(scalar: u32, destination: []u8): isize {
    let required: usize = nqUtf8EncodedLength(scalar)
    if required == 0 as usize || len(destination) < required { return -1 as isize }
    if required == 1 as usize { destination[0 as usize] = scalar as u8 return 1 as isize }
    if required == 2 as usize {
        destination[0 as usize] = (192 as u32 + scalar / 64 as u32) as u8
        destination[1 as usize] = (128 as u32 + scalar % 64 as u32) as u8
        return 2 as isize
    }
    if required == 3 as usize {
        destination[0 as usize] = (224 as u32 + scalar / 4096 as u32) as u8
        destination[1 as usize] = (128 as u32 + (scalar / 64 as u32) % 64 as u32) as u8
        destination[2 as usize] = (128 as u32 + scalar % 64 as u32) as u8
        return 3 as isize
    }
    destination[0 as usize] = (240 as u32 + scalar / 262144 as u32) as u8
    destination[1 as usize] = (128 as u32 + (scalar / 4096 as u32) % 64 as u32) as u8
    destination[2 as usize] = (128 as u32 + (scalar / 64 as u32) % 64 as u32) as u8
    destination[3 as usize] = (128 as u32 + scalar % 64 as u32) as u8
    return 4 as isize
}

export function nqUtf8NextIndex(value: []u8, index: usize): isize {
    if index >= len(value) { return -1 as isize }
    let scalar: u32 = 0 as u32
    let consumed: isize = nqUtf8DecodeAt(value, index, &scalar)
    if consumed <= 0 as isize { return -1 as isize }
    return (index + consumed as usize) as isize
}
