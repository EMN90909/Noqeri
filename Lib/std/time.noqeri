module noqeri.std.time

// Time values in this module are integer durations/timestamps. Wall-clock and
// monotonic clock acquisition remain host/runtime capabilities.
export function nqElapsedMillis(start: i64, finish: i64): i64 { if finish <= start { return 0 as i64 } return finish - start }
export function nqMillisToSecondsFloor(milliseconds: i64): i64 { if milliseconds <= 0 as i64 { return 0 as i64 } return milliseconds / 1000 as i64 }
export function nqSecondsToMillis(seconds: i64): i64 { if seconds <= 0 as i64 { return 0 as i64 } return seconds * 1000 as i64 }
export function nqDeadlineReached(now: i64, deadline: i64): bool { return now >= deadline }

export function time_millis_per_second(): i64 { return 1000 as i64 }
export function time_seconds_per_minute(): i64 { return 60 as i64 }
export function time_minutes_per_hour(): i64 { return 60 as i64 }
export function time_hours_per_day(): i64 { return 24 as i64 }
export function time_seconds_per_hour(): i64 { return 3600 as i64 }
export function time_seconds_per_day(): i64 { return 86400 as i64 }

export function time_seconds_to_millis(value: i64): i64 { return value * time_millis_per_second() }
export function time_millis_to_seconds_floor(value: i64): i64 { return value / time_millis_per_second() }
export function time_minutes_to_seconds(value: i64): i64 { return value * time_seconds_per_minute() }
export function time_hours_to_seconds(value: i64): i64 { return value * time_seconds_per_hour() }
export function time_days_to_seconds(value: i64): i64 { return value * time_seconds_per_day() }
export function time_minutes_to_millis(value: i64): i64 { return time_seconds_to_millis(time_minutes_to_seconds(value)) }
export function time_hours_to_millis(value: i64): i64 { return time_seconds_to_millis(time_hours_to_seconds(value)) }
export function time_days_to_millis(value: i64): i64 { return time_seconds_to_millis(time_days_to_seconds(value)) }

export function time_elapsed(start: i64, finish: i64): i64 { if finish <= start { return 0 as i64 } return finish - start }
export function time_deadline_reached(now: i64, deadline: i64): bool { return now >= deadline }
export function time_deadline_remaining(now: i64, deadline: i64): i64 { if now >= deadline { return 0 as i64 } return deadline - now }
export function time_between(value: i64, start: i64, finish: i64): bool { return value >= start && value <= finish }
export function time_clamp(value: i64, start: i64, finish: i64): i64 { if value < start { return start } if value > finish { return finish } return value }

export function time_add_saturating_nonnegative(base: i64, duration: i64): i64 {
    if duration <= 0 as i64 { return base }
    let max: i64 = 9223372036854775807 as i64
    if base > max - duration { return max }
    return base + duration
}

export function time_sub_saturating_nonnegative(base: i64, duration: i64): i64 {
    if duration <= 0 as i64 { return base }
    if base <= duration { return 0 as i64 }
    return base - duration
}

export function time_compare(left: i64, right: i64): int { if left < right { return -1 } if left > right { return 1 } return 0 }
export function time_min(left: i64, right: i64): i64 { if left < right { return left } return right }
export function time_max(left: i64, right: i64): i64 { if left > right { return left } return right }

export function time_whole_minutes(seconds: i64): i64 { return seconds / 60 as i64 }
export function time_whole_hours(seconds: i64): i64 { return seconds / 3600 as i64 }
export function time_whole_days(seconds: i64): i64 { return seconds / 86400 as i64 }
export function time_second_part(seconds: i64): i64 { let part: i64 = seconds % 60 as i64 if part < 0 as i64 { part = part + 60 as i64 } return part }
export function time_minute_part(seconds: i64): i64 { let part: i64 = (seconds / 60 as i64) % 60 as i64 if part < 0 as i64 { part = part + 60 as i64 } return part }
export function time_hour_part(seconds: i64): i64 { let part: i64 = (seconds / 3600 as i64) % 24 as i64 if part < 0 as i64 { part = part + 24 as i64 } return part }
