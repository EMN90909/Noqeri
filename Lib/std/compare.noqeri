export function compare_max_u8(a:u8,b:u8):u8{if a>=b{return a} return b}
export function compare_clamp_u8(v:u8,lo:u8,hi:u8):u8{if hi<lo{return lo} if v<lo{return lo} if v>hi{return hi} return v}
export function compare_between_u8(v:u8,lo:u8,hi:u8):bool{return hi>=lo&&v>=lo&&v<=hi}
export function compare_outside_u8(v:u8,lo:u8,hi:u8):bool{return !compare_between_u8(v,lo,hi)}
export function compare_ordered_u8(a:u8,b:u8,c:u8):bool{return a<=b&&b<=c}
export function compare_strict_u8(a:u8,b:u8,c:u8):bool{return a<b&&b<c}
