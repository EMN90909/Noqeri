export function compare_strict_float(a:float,b:float,c:float):bool{return a<b&&b<c}

export function compare_bytes(a:[]u8,b:[]u8):int{let count:usize=len(a) if len(b)<count{count=len(b)} let index:usize=0 as usize while index<count{if a[index]<b[index]{return-1} if a[index]>b[index]{return 1} index=index+1 as usize} return compare_usize(len(a),len(b))}
export function compare_bytes_equal(a:[]u8,b:[]u8):bool{return compare_bytes(a,b)==0}
export function compare_bytes_less(a:[]u8,b:[]u8):bool{return compare_bytes(a,b)<0}
export function compare_bytes_greater(a:[]u8,b:[]u8):bool{return compare_bytes(a,b)>0}
export function compare_bytes_starts_with(value:[]u8,prefix:[]u8):bool{if len(prefix)>len(value){return false} let i:usize=0 as usize while i<len(prefix){if value[i]!=prefix[i]{return false} i=i+1 as usize} return true}
export function compare_bytes_ends_with(value:[]u8,suffix:[]u8):bool{if len(suffix)>len(value){return false} let offset:usize=len(value)-len(suffix) let i:usize=0 as usize while i<len(suffix){if value[offset+i]!=suffix[i]{return false} i=i+1 as usize} return true}
export function compare_bytes_prefix_length(a:[]u8,b:[]u8):usize{let count:usize=len(a) if len(b)<count{count=len(b)} let i:usize=0 as usize while i<count&&a[i]==b[i]{i=i+1 as usize} return i}
export function compare_bytes_first_difference(a:[]u8,b:[]u8):isize{let count:usize=len(a) if len(b)<count{count=len(b)} let i:usize=0 as usize while i<count{if a[i]!=b[i]{return i as isize} i=i+1 as usize} if len(a)!=len(b){return count as isize} return-1 as isize}

export function compare_i64_slice(a:[]i64,b:[]i64):int{let count:usize=len(a) if len(b)<count{count=len(b)} let i:usize=0 as usize while i<count{let order:int=compare_i64(a[i],b[i]) if order!=0{return order} i=i+1 as usize} return compare_usize(len(a),len(b))}
export function compare_u64_slice(a:[]u64,b:[]u64):int{let count:usize=len(a) if len(b)<count{count=len(b)} let i:usize=0 as usize while i<count{let order:int=compare_u64(a[i],b[i]) if order!=0{return order} i=i+1 as usize} return compare_usize(len(a),len(b))}
export function compare_u8_slice(a:[]u8,b:[]u8):int{return compare_bytes(a,b)}

export function compare_i64_slice_equal(a:[]i64,b:[]i64):bool{if len(a)!=len(b){return false} let i:usize=0 as usize while i<len(a){if a[i]!=b[i]{return false} i=i+1 as usize} return true}
export function compare_u64_slice_equal(a:[]u64,b:[]u64):bool{if len(a)!=len(b){return false} let i:usize=0 as usize while i<len(a){if a[i]!=b[i]{return false} i=i+1 as usize} return true}
export function compare_u8_slice_equal(a:[]u8,b:[]u8):bool{return compare_bytes_equal(a,b)}
export function compare_usize_slice_equal(a:[]usize,b:[]usize):bool{if len(a)!=len(b){return false} let i:usize=0 as usize while i<len(a){if a[i]!=b[i]{return false} i=i+1 as usize} return true}

export function compare_i64_slice_sorted_ascending(values:[]i64):bool{let i:usize=1 as usize while i<len(values){if values[i]<values[i-1 as usize]{return false} i=i+1 as usize} return true}
export function compare_i64_slice_sorted_descending(values:[]i64):bool{let i:usize=1 as usize while i<len(values){if values[i]>values[i-1 as usize]{return false} i=i+1 as usize} return true}
export function compare_u64_slice_sorted_ascending(values:[]u64):bool{let i:usize=1 as usize while i<len(values){if values[i]<values[i-1 as usize]{return false} i=i+1 as usize} return true}
export function compare_u64_slice_sorted_descending(values:[]u64):bool{let i:usize=1 as usize while i<len(values){if values[i]>values[i-1 as usize]{return false} i=i+1 as usize} return true}
export function compare_u8_slice_sorted_ascending(values:[]u8):bool{let i:usize=1 as usize while i<len(values){if values[i]<values[i-1 as usize]{return false} i=i+1 as usize} return true}
export function compare_u8_slice_sorted_descending(values:[]u8):bool{let i:usize=1 as usize while i<len(values){if values[i]>values[i-1 as usize]{return false} i=i+1 as usize} return true}
export function compare_usize_slice_sorted_ascending(values:[]usize):bool{let i:usize=1 as usize while i<len(values){if values[i]<values[i-1 as usize]{return false} i=i+1 as usize} return true}
export function compare_usize_slice_sorted_descending(values:[]usize):bool{let i:usize=1 as usize while i<len(values){if values[i]>values[i-1 as usize]{return false} i=i+1 as usize} return true}

export function compare_i64_slice_all_between(values:[]i64,lo:i64,hi:i64):bool{if hi<lo{return false} let i:usize=0 as usize while i<len(values){if values[i]<lo||values[i]>hi{return false} i=i+1 as usize} return true}
export function compare_u64_slice_all_between(values:[]u64,lo:u64,hi:u64):bool{if hi<lo{return false} let i:usize=0 as usize while i<len(values){if values[i]<lo||values[i]>hi{return false} i=i+1 as usize} return true}
export function compare_u8_slice_all_between(values:[]u8,lo:u8,hi:u8):bool{if hi<lo{return false} let i:usize=0 as usize while i<len(values){if values[i]<lo||values[i]>hi{return false} i=i+1 as usize} return true}
export function compare_usize_slice_all_between(values:[]usize,lo:usize,hi:usize):bool{if hi<lo{return false} let i:usize=0 as usize while i<len(values){if values[i]<lo||values[i]>hi{return false} i=i+1 as usize} return true}

export function compare_i64_slice_count_equal(values:[]i64,target:i64):usize{let count:usize=0 as usize let i:usize=0 as usize while i<len(values){if values[i]==target{count=count+1 as usize} i=i+1 as usize} return count}
export function compare_u64_slice_count_equal(values:[]u64,target:u64):usize{let count:usize=0 as usize let i:usize=0 as usize while i<len(values){if values[i]==target{count=count+1 as usize} i=i+1 as usize} return count}
export function compare_u8_slice_count_equal(values:[]u8,target:u8):usize{let count:usize=0 as usize let i:usize=0 as usize while i<len(values){if values[i]==target{count=count+1 as usize} i=i+1 as usize} return count}
export function compare_usize_slice_count_equal(values:[]usize,target:usize):usize{let count:usize=0 as usize let i:usize=0 as usize while i<len(values){if values[i]==target{count=count+1 as usize} i=i+1 as usize} return count}

export function compare_i64_lower_bound(values:[]i64,target:i64):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_i64_upper_bound(values:[]i64,target:i64):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<=target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_i64_binary_search(values:[]i64,target:i64):isize{let at:usize=compare_i64_lower_bound(values,target) if at<len(values)&&values[at]==target{return at as isize} return-1 as isize}
export function compare_u64_lower_bound(values:[]u64,target:u64):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_u64_upper_bound(values:[]u64,target:u64):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<=target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_u64_binary_search(values:[]u64,target:u64):isize{let at:usize=compare_u64_lower_bound(values,target) if at<len(values)&&values[at]==target{return at as isize} return-1 as isize}
export function compare_u8_lower_bound(values:[]u8,target:u8):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_u8_upper_bound(values:[]u8,target:u8):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<=target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_u8_binary_search(values:[]u8,target:u8):isize{let at:usize=compare_u8_lower_bound(values,target) if at<len(values)&&values[at]==target{return at as isize} return-1 as isize}
export function compare_usize_lower_bound(values:[]usize,target:usize):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_usize_upper_bound(values:[]usize,target:usize):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<=target{low=mid+1 as usize}else{high=mid}} return low}
export function compare_usize_binary_search(values:[]usize,target:usize):isize{let at:usize=compare_usize_lower_bound(values,target) if at<len(values)&&values[at]==target{return at as isize} return-1 as isize}

export function compare_i64_distance(a:i64,b:i64):u64{if a>=b{return(a-b)as u64} return(b-a)as u64}
export function compare_u64_distance(a:u64,b:u64):u64{if a>=b{return a-b} return b-a}
export function compare_usize_distance(a:usize,b:usize):usize{if a>=b{return a-b} return b-a}
export function compare_float_abs(value:float):float{if value<0.0{return-value} return value}
export function compare_float_almost_equal(a:float,b:float,epsilon:float):bool{return compare_float_abs(a-b)<=compare_float_abs(epsilon)}
export function compare_float_relative_equal(a:float,b:float,epsilon:float):bool{let scale:float=compare_max_float(compare_float_abs(a),compare_float_abs(b)) if scale<1.0{scale=1.0} return compare_float_abs(a-b)<=compare_float_abs(epsilon)*scale}

export function compare_select_min_i64(a:i64,b:i64):i64{return compare_min_i64(a,b)}
export function compare_select_max_i64(a:i64,b:i64):i64{return compare_max_i64(a,b)}
export function compare_select_min_u64(a:u64,b:u64):u64{return compare_min_u64(a,b)}
export function compare_select_max_u64(a:u64,b:u64):u64{return compare_max_u64(a,b)}
export function compare_select_min_usize(a:usize,b:usize):usize{return compare_min_usize(a,b)}
export function compare_select_max_usize(a:usize,b:usize):usize{return compare_max_usize(a,b)}

export function compare_pair_i64(a0:i64,a1:i64,b0:i64,b1:i64):int{let first:int=compare_i64(a0,b0) if first!=0{return first} return compare_i64(a1,b1)}
export function compare_pair_u64(a0:u64,a1:u64,b0:u64,b1:u64):int{let first:int=compare_u64(a0,b0) if first!=0{return first} return compare_u64(a1,b1)}
export function compare_pair_usize(a0:usize,a1:usize,b0:usize,b1:usize):int{let first:int=compare_usize(a0,b0) if first!=0{return first} return compare_usize(a1,b1)}
export function compare_triplet_i64(a0:i64,a1:i64,a2:i64,b0:i64,b1:i64,b2:i64):int{let first:int=compare_i64(a0,b0) if first!=0{return first} let second:int=compare_i64(a1,b1) if second!=0{return second} return compare_i64(a2,b2)}
export function compare_triplet_u64(a0:u64,a1:u64,a2:u64,b0:u64,b1:u64,b2:u64):int{let first:int=compare_u64(a0,b0) if first!=0{return first} let second:int=compare_u64(a1,b1) if second!=0{return second} return compare_u64(a2,b2)}

export function nqCompareI64(a:i64,b:i64):int{return compare_i64(a,b)}
export function nqCompareU64(a:u64,b:u64):int{return compare_u64(a,b)}
