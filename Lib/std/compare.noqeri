module noqeri.std.compare

export function compare_less():int{return-1}
export function compare_equal():int{return 0}
export function compare_greater():int{return 1}
export function compare_reverse(order:int):int{if order<0{return 1} if order>0{return-1} return 0}
export function compare_normalize(order:int):int{if order<0{return-1} if order>0{return 1} return 0}
export function compare_is_less(order:int):bool{return order<0}
export function compare_is_equal(order:int):bool{return order==0}
export function compare_is_greater(order:int):bool{return order>0}
export function compare_is_less_or_equal(order:int):bool{return order<=0}
export function compare_is_greater_or_equal(order:int):bool{return order>=0}

export function compare_i8(a:i8,b:i8):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_u8(a:u8,b:u8):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_i16(a:i16,b:i16):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_u16(a:u16,b:u16):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_i32(a:i32,b:i32):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_u32(a:u32,b:u32):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_i64(a:i64,b:i64):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_u64(a:u64,b:u64):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_isize(a:isize,b:isize):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_usize(a:usize,b:usize):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_int(a:int,b:int):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_float(a:float,b:float):int{if a<b{return-1} if a>b{return 1} return 0}
export function compare_bool(a:bool,b:bool):int{if a==b{return 0} if !a&&b{return-1} return 1}

export function compare_min_i8(a:i8,b:i8):i8{if a<=b{return a} return b}
export function compare_max_i8(a:i8,b:i8):i8{if a>=b{return a} return b}
export function compare_clamp_i8(v:i8,lo:i8,hi:i8):i8{if hi<lo{return lo} if v<lo{return lo} if v>hi{return hi} return v}
export function compare_between_i8(v:i8,lo:i8,hi:i8):bool{return hi>=lo&&v>=lo&&v<=hi}
export function compare_outside_i8(v:i8,lo:i8,hi:i8):bool{return !compare_between_i8(v,lo,hi)}
export function compare_ordered_i8(a:i8,b:i8,c:i8):bool{return a<=b&&b<=c}
export function compare_strict_i8(a:i8,b:i8,c:i8):bool{return a<b&&b<c}
