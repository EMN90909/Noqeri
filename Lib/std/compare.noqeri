export function compare_between_u64(v:u64,lo:u64,hi:u64):bool{return hi>=lo&&v>=lo&&v<=hi}
export function compare_outside_u64(v:u64,lo:u64,hi:u64):bool{return !compare_between_u64(v,lo,hi)}
