export function compare_between_i16(v:i16,lo:i16,hi:i16):bool{return hi>=lo&&v>=lo&&v<=hi}
export function compare_outside_i16(v:i16,lo:i16,hi:i16):bool{return !compare_between_i16(v,lo,hi)}
export function compare_ordered_i16(a:i16,b:i16,c:i16):bool{return a<=b&&b<=c}
export function compare_strict_i16(a:i16,b:i16,c:i16):bool{return a<b&&b<c}
