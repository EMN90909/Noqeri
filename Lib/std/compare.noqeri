export function compare_max_u32(a:u32,b:u32):u32{if a>=b{return a} return b}
export function compare_clamp_u32(v:u32,lo:u32,hi:u32):u32{if hi<lo{return lo} if v<lo{return lo} if v>hi{return hi} return v}
export function compare_between_u32(v:u32,lo:u32,hi:u32):bool{return hi>=lo&&v>=lo&&v<=hi}
export function compare_outside_u32(v:u32,lo:u32,hi:u32):bool{return !compare_between_u32(v,lo,hi)}
