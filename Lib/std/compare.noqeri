export function compare_between_u16(v:u16,lo:u16,hi:u16):bool{return hi>=lo&&v>=lo&&v<=hi}
export function compare_outside_u16(v:u16,lo:u16,hi:u16):bool{return !compare_between_u16(v,lo,hi)}
export function compare_ordered_u16(a:u16,b:u16,c:u16):bool{return a<=b&&b<=c}
export function compare_strict_u16(a:u16,b:u16,c:u16):bool{return a<b&&b<c}
