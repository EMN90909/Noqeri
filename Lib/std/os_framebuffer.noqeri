module noqeri.std.os_framebuffer

// Noqeri kernel/OS framebuffer rasterizer. The OS maps a valid framebuffer
// into memory; all drawing loops are in Noqeri. These functions never create
// a mapping, discover PCI/GPU devices or manage a display controller.
// Pixel format is caller-owned packed 32-bit ARGB; pitch is in pixels.
// Raw pointers must point to writable memory covering height * pitch.

export function nqOsFbClear(pixels: *volatile u32, width: usize, height: usize, pitch: usize, color: u32): bool {
    if pixels == null { return false }
    if width == 0 as usize || height == 0 as usize { return false }
    if pitch < width || width > 4096 as usize || height > 4096 as usize { return false }
    if pitch > 65536 as usize { return false }
    let y: usize = 0 as usize
    while y < height {
        let x: usize = 0 as usize
        while x < width {
            unsafe { pixels[y * pitch + x] = color }
            x = x + 1 as usize
        }
        y = y + 1 as usize
    }
    return true
}

export function nqOsFbChecker(pixels: *volatile u32, width: usize, height: usize, pitch: usize, cell: usize): bool {
    if pixels == null { return false }
    if width == 0 as usize || height == 0 as usize || cell == 0 as usize { return false }
    if pitch < width || width > 4096 as usize || height > 4096 as usize { return false }
    if pitch > 65536 as usize { return false }
    let y: usize = 0 as usize
    while y < height {
        let x: usize = 0 as usize
        while x < width {
            let pattern: usize = ((x / cell) + (y / cell)) % 2 as usize
            if pattern == 0 as usize {
                unsafe { pixels[y * pitch + x] = 4278255360 as u32 }
            } else {
                unsafe { pixels[y * pitch + x] = 4294901760 as u32 }
            }
            x = x + 1 as usize
        }
        y = y + 1 as usize
    }
    return true
}
