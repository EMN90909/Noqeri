module noqeri.std.env

extern function envHas(name: string): bool
extern function envGet(name: string): string
extern function envSet(name: string, value: string): isize
extern function envUnset(name: string): isize

export function env_name_valid(name: string): bool {
    if textLength(name) == 0 as usize || name == "=" { return false }
    return true
}

export function env_has(name: string): bool { if !env_name_valid(name) { return false } return envHas(name) }
export function env_get(name: string): string { if !env_name_valid(name) { return "" } return envGet(name) }
export function env_get_or(name: string, fallback: string): string { if !env_has(name) { return fallback } return env_get(name) }
export function env_set(name: string, value: string): isize { if !env_name_valid(name) { return -2 as isize } return envSet(name, value) }
export function env_unset(name: string): isize { if !env_name_valid(name) { return -2 as isize } return envUnset(name) }
export function env_set_if_missing(name: string, value: string): isize { if !env_name_valid(name) { return -2 as isize } if envHas(name) { return 0 as isize } return envSet(name, value) }
export function env_replace_if_present(name: string, value: string): isize { if !env_name_valid(name) { return -2 as isize } if !envHas(name) { return -3 as isize } return envSet(name, value) }
export function env_bool(name: string, fallback: bool): bool { let value: string = env_get_or(name, "") if value == "1" || value == "true" || value == "TRUE" || value == "yes" || value == "YES" { return true } if value == "0" || value == "false" || value == "FALSE" || value == "no" || value == "NO" { return false } return fallback }
