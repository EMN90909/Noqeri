module noqeri.std.pgas

// Experimental PGAS host ABI: node-local slots are i64, and transport is
// loopback-only TCP. All operations use negative errno-style status codes.
// A global address is (owner node, local slot), never a raw remote pointer.
extern function nq_pgas_location(index: u64, elements: u64, nodes: u32, strategy: u32, owner: *u32, local: *u32): int
extern function nq_pgas_client_connect(host: string, port: u16, token: string, timeout_ms: u32, out: *usize): int
extern function nq_pgas_client_close(client: usize): int
extern function nq_pgas_client_set_epoch(client: usize, epoch: u32): int
extern function nq_pgas_server_get_epoch(server: usize, out: *u32): int
extern function nq_pgas_server_promote_epoch(server: usize, newer_epoch: u32): int
export function pgas_fence_promote(server: usize, newer_epoch: u32): int { return nq_pgas_server_promote_epoch(server, newer_epoch) }
export function pgas_client_epoch(client: usize, epoch: u32): int { return nq_pgas_client_set_epoch(client, epoch) }
extern function nq_pgas_ping(client: usize): int
extern function nq_pgas_read(client: usize, local: u32, out: *i64): int
extern function nq_pgas_write(client: usize, local: u32, value: i64): int
extern function nq_pgas_compare_exchange(client: usize, local: u32, expected: i64, desired: i64, observed: *i64): int
extern function nq_pgas_fetch_add(client: usize, local: u32, delta: i64, previous: *i64): int
extern function nq_pgas_barrier(client: usize): int
extern function nq_pgas_run_task(client: usize, task_id: u32, argument: i64, out: *i64): int
extern function nq_pgas_execute_program(client: usize, bytecode: *u8, length: usize, argument: i64, fuel: u32, out: *i64): int

// Bytecode instructions: 0 NOP, 1 argument, 2 signed 8-bit immediate,
// 3 add, 4 subtract, 5 multiply, 6 divide, 7 dup, 8 swap, 9 drop,
// 10 relative jump, 11 jump-if-zero, 12 equal, 13 less-than,
// 14 return, 15 constant zero. No host capabilities.
export function pgas_run_sandbox(client: usize, bytecode: []u8, argument: i64, fuel: u32, out: *i64): int {
    if out == null || len(bytecode) == 0 as usize || len(bytecode) > 256 as usize || fuel == 0 as u32 || fuel > 4096 as u32 { return -22 }
    return nq_pgas_execute_program(client, &bytecode[0 as usize], len(bytecode), argument, fuel, out)
}

record PgasLocation {
    node: u32
    slot: u32
}

export function pgas_block(): u32 { return 0 as u32 }
export function pgas_cyclic(): u32 { return 1 as u32 }
export function pgas_strategy_valid(strategy: u32): bool { return strategy == pgas_block() || strategy == pgas_cyclic() }
export function pgas_partition_valid(elements: u64, nodes: u32, strategy: u32): bool { return elements > 0 as u64 && nodes > 0 as u32 && pgas_strategy_valid(strategy) }

export function pgas_locate(index: u64, elements: u64, nodes: u32, strategy: u32, result: *PgasLocation): int {
    if result == null || !pgas_partition_valid(elements, nodes, strategy) || index >= elements { return -22 }
    unsafe { return nq_pgas_location(index, elements, nodes, strategy, &result.node, &result.slot) }
}

// The caller owns all node connections, and must provision each node's local
// slot capacity according to its selected block/cyclic mapping.
export function pgas_read_i64(client: usize, slot: u32, out: *i64): int { return nq_pgas_read(client, slot, out) }
export function pgas_write_i64(client: usize, slot: u32, value: i64): int { return nq_pgas_write(client, slot, value) }
export function pgas_cas_i64(client: usize, slot: u32, expected: i64, desired: i64, observed: *i64): int { return nq_pgas_compare_exchange(client, slot, expected, desired, observed) }
export function pgas_add_i64(client: usize, slot: u32, delta: i64, previous: *i64): int { return nq_pgas_fetch_add(client, slot, delta, previous) }
export function pgas_sync(client: usize): int { return nq_pgas_barrier(client) }
export function pgas_health(client: usize): int { return nq_pgas_ping(client) }
export function pgas_remote_registered_task(client: usize, task_id: u32, argument: i64, out: *i64): int {
    if out == null || task_id == 0 as u32 { return -22 }
    return nq_pgas_run_task(client, task_id, argument, out)
}

 
// Node lifecycle and global-address operations. The ABI is opt-in: consumers
// must link the native noqeri_pgas_runtime host library.
extern function nq_pgas_server_start(port: u16, token: string, slots: u32, participants: u32, out: *usize): int
extern function nq_pgas_server_start_durable(port: u16, token: string, slots: u32, participants: u32, wal_path: string, out: *usize): int
extern function nq_pgas_server_port(server: usize): u16
extern function nq_pgas_server_stop(server: usize): int

export function pgas_serve(port: u16, token: string, slots: u32, participants: u32, out: *usize): int {
    if slots == 0 as u32 || out == null { return -22 }
    return nq_pgas_server_start(port, token, slots, participants, out)
}
// The WAL path must be absolute; requires private mode-0600 permissions.
export function pgas_serve_durable(port: u16, token: string, slots: u32, participants: u32, wal_path: string, out: *usize): int {
    if slots == 0 as u32 || out == null || textLength(wal_path) == 0 as usize { return -22 }
    return nq_pgas_server_start_durable(port, token, slots, participants, wal_path, out)
}
export function pgas_bound_port(server: usize): u16 { return nq_pgas_server_port(server) }
export function pgas_stop(server: usize): int { return nq_pgas_server_stop(server) }
export function pgas_connect(port: u16, token: string, timeout_ms: u32, out: *usize): int {
    if out == null || port == 0 as u16 { return -22 }
    return nq_pgas_client_connect("127.0.0.1", port, token, timeout_ms, out)
}
export function pgas_close(client: usize): int { return nq_pgas_client_close(client) }

// All clients must be in node-id order. Individual node capacities must be
// sized to the selected distribution. A failure returns a negative status and
// never falls back to a different node, which would risk corrupting ownership.
export function pgas_read_global_i64(clients: []usize, index: u64, elements: u64, strategy: u32, out: *i64): int {
    if out == null || len(clients) == 0 as usize { return -22 }
    let node: u32 = 0 as u32
    let slot: u32 = 0 as u32
    let status: int = nq_pgas_location(index, elements, len(clients) as u32, strategy, &node, &slot)
    if status != 0 { return status }
    return nq_pgas_read(clients[node as usize], slot, out)
}
export function pgas_write_global_i64(clients: []usize, index: u64, elements: u64, strategy: u32, value: i64): int {
    if len(clients) == 0 as usize { return -22 }
    let node: u32 = 0 as u32
    let slot: u32 = 0 as u32
    let status: int = nq_pgas_location(index, elements, len(clients) as u32, strategy, &node, &slot)
    if status != 0 { return status }
    return nq_pgas_write(clients[node as usize], slot, value)
}
export function pgas_cas_global_i64(clients: []usize, index: u64, elements: u64, strategy: u32, expected: i64, desired: i64, observed: *i64): int {
    if observed == null || len(clients) == 0 as usize { return -22 }
    let node: u32 = 0 as u32
    let slot: u32 = 0 as u32
    let status: int = nq_pgas_location(index, elements, len(clients) as u32, strategy, &node, &slot)
    if status != 0 { return status }
    return nq_pgas_compare_exchange(clients[node as usize], slot, expected, desired, observed)
}
export function pgas_add_global_i64(clients: []usize, index: u64, elements: u64, strategy: u32, delta: i64, previous: *i64): int {
    if previous == null || len(clients) == 0 as usize { return -22 }
    let node: u32 = 0 as u32
    let slot: u32 = 0 as u32
    let status: int = nq_pgas_location(index, elements, len(clients) as u32, strategy, &node, &slot)
    if status != 0 { return status }
    return nq_pgas_fetch_add(clients[node as usize], slot, delta, previous)
}
