module noqeri.std.math

// Noqeri standard math: allocation-free scalar, integer, floating point,
// combinatoric, number-theory and small-vector helpers.
// Functions avoid hidden heap allocation and make exceptional cases explicit.

export function nqAbsInt(value: int): int { if value < 0 { return -value } return value }
export function nqMinInt(a: int, b: int): int { if a < b { return a } return b }
export function nqMaxInt(a: int, b: int): int { if a > b { return a } return b }
export function nqClampInt(value: int, low: int, high: int): int { if value < low { return low } if value > high { return high } return value }
export function nqSignInt(value: int): int { if value < 0 { return -1 } if value > 0 { return 1 } return 0 }
export function nqIsEven(value: int): bool { return value % 2 == 0 }
export function nqIsOdd(value: int): bool { return value % 2 != 0 }
export function nqSquareInt(value: int): int { return value * value }
export function nqCubeInt(value: int): int { return value * value * value }
export function nqDistanceInt(a: int, b: int): int { return nqAbsInt(a - b) }
export function nqMidpointInt(a: int, b: int): int { return a + (b - a) / 2 }
export function nqAverage2Int(a: int, b: int): int { return nqMidpointInt(a, b) }
export function nqAverage3Int(a: int, b: int, c: int): int { return (a + b + c) / 3 }
export function nqPercentInt(value: int, percent: int): int { return value * percent / 100 }
export function nqRatioInt(part: int, whole: int, scale: int): int { if whole == 0 { return 0 } return part * scale / whole }
export function nqLerpInt(a: int, b: int, numerator: int, denominator: int): int { if denominator == 0 { return a } return a + (b - a) * numerator / denominator }
export function nqMapRangeInt(value: int, inLow: int, inHigh: int, outLow: int, outHigh: int): int { if inHigh == inLow { return outLow } return outLow + (value - inLow) * (outHigh - outLow) / (inHigh - inLow) }
export function nqCeilDivPositive(value: int, divisor: int): int { if divisor <= 0 || value <= 0 { return 0 } return (value + divisor - 1) / divisor }
export function nqPositiveMod(value: int, modulus: int): int { if modulus <= 0 { return 0 } let r: int = value % modulus if r < 0 { r = r + modulus } return r }
export function nqWrapInt(value: int, low: int, highExclusive: int): int { let width: int = highExclusive - low if width <= 0 { return low } return low + nqPositiveMod(value - low, width) }

export function nqAbsI64(value: i64): i64 { if value < 0 as i64 { return -value } return value }
export function nqMinI64(a: i64, b: i64): i64 { if a < b { return a } return b }
export function nqMaxI64(a: i64, b: i64): i64 { if a > b { return a } return b }
export function nqClampI64(value: i64, low: i64, high: i64): i64 { if value < low { return low } if value > high { return high } return value }
export function nqSignI64(value: i64): i64 { if value < 0 as i64 { return -1 as i64 } if value > 0 as i64 { return 1 as i64 } return 0 as i64 }
export function nqSquareI64(value: i64): i64 { return value * value }
export function nqCubeI64(value: i64): i64 { return value * value * value }

export function nqGcdI64(a: i64, b: i64): i64 {
    let x: i64 = nqAbsI64(a)
    let y: i64 = nqAbsI64(b)
    while y != 0 as i64 { let next: i64 = x % y x = y y = next }
    return x
}

export function nqLcmI64(a: i64, b: i64): i64 {
    if a == 0 as i64 || b == 0 as i64 { return 0 as i64 }
    return nqAbsI64((a / nqGcdI64(a, b)) * b)
}

export function nqPowI64(base: i64, exponent: u32): i64 {
    let result: i64 = 1 as i64
    let factor: i64 = base
    let power: u32 = exponent
    while power > 0 as u32 {
        if power % 2 as u32 == 1 as u32 { result = result * factor }
        power = power / 2 as u32
        if power > 0 as u32 { factor = factor * factor }
    }
    return result
}

export function nqPowModI64(base: i64, exponent: u64, modulus: i64): i64 {
    if modulus <= 1 as i64 { return 0 as i64 }
    let result: i64 = 1 as i64
    let factor: i64 = nqPositiveMod(base as int, modulus as int) as i64
    let power: u64 = exponent
    while power > 0 as u64 {
        if power % 2 as u64 == 1 as u64 { result = (result * factor) % modulus }
        power = power / 2 as u64
        factor = (factor * factor) % modulus
    }
    return result
}

export function nqFactorialU64(value: u32): u64 {
    if value > 20 as u32 { return 0 as u64 }
    let result: u64 = 1 as u64
    let index: u32 = 2 as u32
    while index <= value { result = result * index as u64 index = index + 1 as u32 }
    return result
}

export function nqFibonacciU64(index: u32): u64 {
    if index == 0 as u32 { return 0 as u64 }
    let a: u64 = 0 as u64
    let b: u64 = 1 as u64
    let i: u32 = 1 as u32
    while i < index { let next: u64 = a + b a = b b = next i = i + 1 as u32 }
    return b
}

export function nqTriangularU64(value: u64): u64 { return value * (value + 1 as u64) / 2 as u64 }
export function nqPermutationU64(n: u32, r: u32): u64 { if r > n || n > 20 as u32 { return 0 as u64 } let result: u64 = 1 as u64 let i: u32 = 0 as u32 while i < r { result = result * (n - i) as u64 i = i + 1 as u32 } return result }

export function nqBinomialU64(n: u32, k: u32): u64 {
    if k > n || n > 66 as u32 { return 0 as u64 }
    let choose: u32 = k
    if choose > n - choose { choose = n - choose }
    let result: u64 = 1 as u64
    let i: u32 = 1 as u32
    while i <= choose { result = result * (n - choose + i) as u64 / i as u64 i = i + 1 as u32 }
    return result
}

export function nqIsPrimeI64(value: i64): bool {
    if value < 2 as i64 { return false }
    if value == 2 as i64 || value == 3 as i64 { return true }
    if value % 2 as i64 == 0 as i64 || value % 3 as i64 == 0 as i64 { return false }
    let candidate: i64 = 5 as i64
    while candidate <= value / candidate {
        if value % candidate == 0 as i64 || value % (candidate + 2 as i64) == 0 as i64 { return false }
        candidate = candidate + 6 as i64
    }
    return true
}

export function nqNextPrimeI64(value: i64): i64 {
    let candidate: i64 = value + 1 as i64
    if candidate <= 2 as i64 { return 2 as i64 }
    if candidate % 2 as i64 == 0 as i64 { candidate = candidate + 1 as i64 }
    while !nqIsPrimeI64(candidate) { candidate = candidate + 2 as i64 }
    return candidate
}

export function nqIntegerSqrtU64(value: u64): u64 {
    if value < 2 as u64 { return value }
    let low: u64 = 1 as u64
    let high: u64 = value / 2 as u64 + 1 as u64
    let answer: u64 = 1 as u64
    while low <= high {
        let mid: u64 = low + (high - low) / 2 as u64
        if mid <= value / mid { answer = mid low = mid + 1 as u64 } else { high = mid - 1 as u64 }
    }
    return answer
}

export function nqIsPerfectSquareU64(value: u64): bool { let root: u64 = nqIntegerSqrtU64(value) return root * root == value }
export function nqDigitCountU64(value: u64): u32 { if value == 0 as u64 { return 1 as u32 } let count: u32 = 0 as u32 let current: u64 = value while current > 0 as u64 { current = current / 10 as u64 count = count + 1 as u32 } return count }
export function nqReverseDigitsU64(value: u64): u64 { let current: u64 = value let result: u64 = 0 as u64 while current > 0 as u64 { result = result * 10 as u64 + current % 10 as u64 current = current / 10 as u64 } return result }
export function nqIsPalindromeU64(value: u64): bool { return value == nqReverseDigitsU64(value) }
export function nqSumDigitsU64(value: u64): u64 { let current: u64 = value let result: u64 = 0 as u64 while current > 0 as u64 { result = result + current % 10 as u64 current = current / 10 as u64 } return result }

export function nqAbsFloat(value: float): float { if value < 0.0 { return -value } return value }
export function nqMinFloat(a: float, b: float): float { if a < b { return a } return b }
export function nqMaxFloat(a: float, b: float): float { if a > b { return a } return b }
export function nqClampFloat(value: float, low: float, high: float): float { if value < low { return low } if value > high { return high } return value }
export function nqSaturate(value: float): float { return nqClampFloat(value, 0.0, 1.0) }
export function nqSignFloat(value: float): float { if value < 0.0 { return -1.0 } if value > 0.0 { return 1.0 } return 0.0 }
export function nqSquareFloat(value: float): float { return value * value }
export function nqCubeFloat(value: float): float { return value * value * value }
export function nqLerpFloat(a: float, b: float, t: float): float { return a + (b - a) * t }
export function nqInverseLerpFloat(a: float, b: float, value: float): float { if a == b { return 0.0 } return (value - a) / (b - a) }
export function nqRemapFloat(value: float, inLow: float, inHigh: float, outLow: float, outHigh: float): float { return nqLerpFloat(outLow, outHigh, nqInverseLerpFloat(inLow, inHigh, value)) }
export function nqAlmostEqualFloat(a: float, b: float, epsilon: float): bool { return nqAbsFloat(a - b) <= nqAbsFloat(epsilon) }
export function nqSmoothStep(edge0: float, edge1: float, value: float): float { let t: float = nqSaturate(nqInverseLerpFloat(edge0, edge1, value)) return t * t * (3.0 - 2.0 * t) }
export function nqSmootherStep(edge0: float, edge1: float, value: float): float { let t: float = nqSaturate(nqInverseLerpFloat(edge0, edge1, value)) return t * t * t * (t * (t * 6.0 - 15.0) + 10.0) }
export function nqEaseInQuad(t: float): float { let x: float = nqSaturate(t) return x * x }
export function nqEaseOutQuad(t: float): float { let x: float = nqSaturate(t) return x * (2.0 - x) }
export function nqEaseInOutQuad(t: float): float { let x: float = nqSaturate(t) if x < 0.5 { return 2.0 * x * x } return -1.0 + (4.0 - 2.0 * x) * x }
export function nqEaseInCubic(t: float): float { let x: float = nqSaturate(t) return x * x * x }
export function nqEaseOutCubic(t: float): float { let x: float = nqSaturate(t) - 1.0 return x * x * x + 1.0 }

export function nqPi(): float { return 3.141592653589793 }
export function nqTau(): float { return 6.283185307179586 }
export function nqE(): float { return 2.718281828459045 }
export function nqDegreesToRadians(value: float): float { return value * nqPi() / 180.0 }
export function nqRadiansToDegrees(value: float): float { return value * 180.0 / nqPi() }

export function nqSqrtFloat(value: float): float {
    if value <= 0.0 { return 0.0 }
    let estimate: float = value
    if estimate < 1.0 { estimate = 1.0 }
    let iteration: int = 0
    while iteration < 24 { estimate = 0.5 * (estimate + value / estimate) iteration = iteration + 1 }
    return estimate
}

export function nqHypot2(x: float, y: float): float { return nqSqrtFloat(x * x + y * y) }
export function nqHypot3(x: float, y: float, z: float): float { return nqSqrtFloat(x * x + y * y + z * z) }
export function nqDistance2(x1: float, y1: float, x2: float, y2: float): float { return nqHypot2(x2 - x1, y2 - y1) }
export function nqDot2(ax: float, ay: float, bx: float, by: float): float { return ax * bx + ay * by }
export function nqDot3(ax: float, ay: float, az: float, bx: float, by: float, bz: float): float { return ax * bx + ay * by + az * bz }
export function nqCross2(ax: float, ay: float, bx: float, by: float): float { return ax * by - ay * bx }
export function nqLength2(x: float, y: float): float { return nqHypot2(x, y) }
export function nqLength3(x: float, y: float, z: float): float { return nqHypot3(x, y, z) }

export function nqNormalizeAngleRadians(value: float): float {
    let angle: float = value
    while angle > nqPi() { angle = angle - nqTau() }
    while angle < -nqPi() { angle = angle + nqTau() }
    return angle
}

export function nqSinFloat(value: float): float {
    let x: float = nqNormalizeAngleRadians(value)
    let x2: float = x * x
    return x * (1.0 - x2 / 6.0 + x2 * x2 / 120.0 - x2 * x2 * x2 / 5040.0 + x2 * x2 * x2 * x2 / 362880.0)
}

export function nqCosFloat(value: float): float {
    let x: float = nqNormalizeAngleRadians(value)
    let x2: float = x * x
    return 1.0 - x2 / 2.0 + x2 * x2 / 24.0 - x2 * x2 * x2 / 720.0 + x2 * x2 * x2 * x2 / 40320.0
}

export function nqTanFloat(value: float): float { let cosine: float = nqCosFloat(value) if nqAbsFloat(cosine) < 0.0000001 { return 0.0 } return nqSinFloat(value) / cosine }

export function nqExpFloat(value: float): float {
    if value < -40.0 { return 0.0 }
    let x: float = value
    let scale: int = 0
    while nqAbsFloat(x) > 0.5 { x = x / 2.0 scale = scale + 1 }
    let term: float = 1.0
    let sum: float = 1.0
    let index: int = 1
    while index <= 20 { term = term * x / index as float sum = sum + term index = index + 1 }
    while scale > 0 { sum = sum * sum scale = scale - 1 }
    return sum
}

export function nqLnFloat(value: float): float {
    if value <= 0.0 { return 0.0 }
    let x: float = value
    let shifts: int = 0
    while x > 2.0 { x = x / 2.0 shifts = shifts + 1 }
    while x < 0.5 { x = x * 2.0 shifts = shifts - 1 }
    let z: float = (x - 1.0) / (x + 1.0)
    let z2: float = z * z
    let term: float = z
    let sum: float = 0.0
    let denominator: int = 1
    let iteration: int = 0
    while iteration < 18 { sum = sum + term / denominator as float term = term * z2 denominator = denominator + 2 iteration = iteration + 1 }
    return 2.0 * sum + shifts as float * 0.6931471805599453
}

export function nqPowFloat(base: float, exponent: float): float { if base <= 0.0 { return 0.0 } return nqExpFloat(exponent * nqLnFloat(base)) }
export function nqLog10Float(value: float): float { return nqLnFloat(value) / 2.302585092994046 }
export function nqLog2Float(value: float): float { return nqLnFloat(value) / 0.6931471805599453 }

export function nqSumI64(values: *i64, count: usize): i64 { let total: i64 = 0 as i64 let i: usize = 0 as usize while i < count { total = total + values[i] i = i + 1 as usize } return total }
export function nqMeanI64(values: *i64, count: usize): i64 { if count == 0 as usize { return 0 as i64 } return nqSumI64(values, count) / count as i64 }
export function nqMinArrayI64(values: *i64, count: usize): i64 { if count == 0 as usize { return 0 as i64 } let best: i64 = values[0 as usize] let i: usize = 1 as usize while i < count { if values[i] < best { best = values[i] } i = i + 1 as usize } return best }
export function nqMaxArrayI64(values: *i64, count: usize): i64 { if count == 0 as usize { return 0 as i64 } let best: i64 = values[0 as usize] let i: usize = 1 as usize while i < count { if values[i] > best { best = values[i] } i = i + 1 as usize } return best }
export function nqRangeI64(values: *i64, count: usize): i64 { if count == 0 as usize { return 0 as i64 } return nqMaxArrayI64(values, count) - nqMinArrayI64(values, count) }
export function nqCountPositiveI64(values: *i64, count: usize): usize { let result: usize = 0 as usize let i: usize = 0 as usize while i < count { if values[i] > 0 as i64 { result = result + 1 as usize } i = i + 1 as usize } return result }
export function nqCountNegativeI64(values: *i64, count: usize): usize { let result: usize = 0 as usize let i: usize = 0 as usize while i < count { if values[i] < 0 as i64 { result = result + 1 as usize } i = i + 1 as usize } return result }
export function nqCountZeroI64(values: *i64, count: usize): usize { let result: usize = 0 as usize let i: usize = 0 as usize while i < count { if values[i] == 0 as i64 { result = result + 1 as usize } i = i + 1 as usize } return result }

export function nqSumFloat(values: *float, count: usize): float { let total: float = 0.0 let i: usize = 0 as usize while i < count { total = total + values[i] i = i + 1 as usize } return total }
export function nqMeanFloat(values: *float, count: usize): float { if count == 0 as usize { return 0.0 } return nqSumFloat(values, count) / count as float }
export function nqMinArrayFloat(values: *float, count: usize): float { if count == 0 as usize { return 0.0 } let best: float = values[0 as usize] let i: usize = 1 as usize while i < count { if values[i] < best { best = values[i] } i = i + 1 as usize } return best }
export function nqMaxArrayFloat(values: *float, count: usize): float { if count == 0 as usize { return 0.0 } let best: float = values[0 as usize] let i: usize = 1 as usize while i < count { if values[i] > best { best = values[i] } i = i + 1 as usize } return best }
export function nqVarianceFloat(values: *float, count: usize): float { if count == 0 as usize { return 0.0 } let mean: float = nqMeanFloat(values, count) let total: float = 0.0 let i: usize = 0 as usize while i < count { let delta: float = values[i] - mean total = total + delta * delta i = i + 1 as usize } return total / count as float }
export function nqStdDevFloat(values: *float, count: usize): float { return nqSqrtFloat(nqVarianceFloat(values, count)) }
export function nqRmsFloat(values: *float, count: usize): float { if count == 0 as usize { return 0.0 } let total: float = 0.0 let i: usize = 0 as usize while i < count { total = total + values[i] * values[i] i = i + 1 as usize } return nqSqrtFloat(total / count as float) }

// Compatibility aliases retained for existing programs.
export function abs_int(value: int): int { return nqAbsInt(value) }
export function min_int(a: int, b: int): int { return nqMinInt(a, b) }
