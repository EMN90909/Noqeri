module noqeri.std.rate

export function rate_status_ok(status: isize): bool { return status >= 0 as isize }
export function rate_status_error(status: isize): bool { return status < 0 as isize }
export function rate_error_code(status: isize): isize { if status < 0 as isize { return -status } return 0 as isize }
export function rate_attempt_allowed(attempt: usize, max_attempts: usize): bool { return attempt < max_attempts }
