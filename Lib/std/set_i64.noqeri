module noqeri.std.set_i64

export function nqSetContainsI64(values: *i64, count: usize, target: i64): bool {
    let index: usize = 0 as usize
    while index < count {
        if values[index] == target { return true }
        index = index + 1
    }
    return false
}

export function nqSetInsertI64(values: *i64, count: usize, capacity: usize, value: i64): isize {
    if count >= capacity { return -1 }
    if nqSetContainsI64(values, count, value) { return -2 }
    values[count] = value
    return (count + 1) as isize
}

export function nqSetDeleteI64(values: *i64, count: usize, value: i64): isize {
    let index: usize = 0 as usize
    while index < count {
        if values[index] == value {
            let cursor: usize = index
            while cursor + 1 < count {
                values[cursor] = values[cursor + 1]
                cursor = cursor + 1
            }
            return (count - 1) as isize
        }
        index = index + 1
    }
    return -1
}
