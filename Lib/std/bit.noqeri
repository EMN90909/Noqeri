module noqeri.std.bit

function bit_pow2_u64(index: usize): u64 {
    if index >= 64 as usize { return 0 as u64 }
    let value: u64 = 1 as u64
    let i: usize = 0 as usize
    while i < index { value = value * 2 as u64 i = i + 1 as usize }
    return value
}
export function bit_mask_u64(index: usize): u64 { return bit_pow2_u64(index) }
export function bit_is_set_u64(value: u64, index: usize): bool { let mask:u64=bit_pow2_u64(index) if mask==0 as u64{return false} return value/mask%2 as u64==1 as u64 }
export function bit_set_u64(value:u64,index:usize):u64 { let mask:u64=bit_pow2_u64(index) if mask==0 as u64||bit_is_set_u64(value,index){return value} return value+mask }
export function bit_clear_u64(value:u64,index:usize):u64 { let mask:u64=bit_pow2_u64(index) if mask==0 as u64||!bit_is_set_u64(value,index){return value} return value-mask }
export function bit_toggle_u64(value:u64,index:usize):u64 { if bit_is_set_u64(value,index){return bit_clear_u64(value,index)} return bit_set_u64(value,index) }
export function bit_assign_u64(value:u64,index:usize,state:bool):u64 { if state{return bit_set_u64(value,index)} return bit_clear_u64(value,index) }
export function bit_popcount_u64(value:u64):usize { let current:u64=value let count:usize=0 as usize while current>0 as u64{if current%2 as u64==1 as u64{count=count+1 as usize} current=current/2 as u64} return count }
export function bit_parity_u64(value:u64):bool{return bit_popcount_u64(value)%2 as usize==1 as usize}
export function bit_is_power_of_two_u64(value:u64):bool{return value!=0 as u64&&bit_popcount_u64(value)==1 as usize}
export function bit_lowest_set_u64(value:u64):isize { if value==0 as u64{return-1 as isize} let index:usize=0 as usize while index<64 as usize{if bit_is_set_u64(value,index){return index as isize} index=index+1 as usize} return-1 as isize }
export function bit_highest_set_u64(value:u64):isize { if value==0 as u64{return-1 as isize} let index:usize=64 as usize while index>0 as usize{index=index-1 as usize if bit_is_set_u64(value,index){return index as isize}} return-1 as isize }
export function bit_trailing_zeros_u64(value:u64):usize{let at:isize=bit_lowest_set_u64(value) if at<0 as isize{return 64 as usize} return at as usize}
export function bit_leading_zeros_u64(value:u64):usize{let at:isize=bit_highest_set_u64(value) if at<0 as isize{return 64 as usize} return 63 as usize-at as usize}
export function bit_width_u64(value:u64):usize{let at:isize=bit_highest_set_u64(value) if at<0 as isize{return 0 as usize} return at as usize+1 as usize}
export function bit_extract_u64(value:u64,start:usize,width:usize):u64 { if start>=64 as usize||width==0 as usize{return 0 as u64} let actual:usize=width if actual>64 as usize-start{actual=64 as usize-start} let divisor:u64=bit_pow2_u64(start) let shifted:u64=value/divisor if actual==64 as usize{return shifted} return shifted%bit_pow2_u64(actual) }
export function bit_insert_u64(value:u64,start:usize,width:usize,field:u64):u64 { if start>=64 as usize||width==0 as usize{return value} let actual:usize=width if actual>64 as usize-start{actual=64 as usize-start} let result:u64=value let index:usize=0 as usize while index<actual{result=bit_assign_u64(result,start+index,bit_is_set_u64(field,index)) index=index+1 as usize} return result }
export function bit_clear_range_u64(value:u64,start:usize,width:usize):u64{return bit_insert_u64(value,start,width,0 as u64)}
export function bit_set_range_u64(value:u64,start:usize,width:usize):u64 { let result:u64=value let index:usize=0 as usize while index<width&&start+index<64 as usize{result=bit_set_u64(result,start+index) index=index+1 as usize} return result }
export function bit_count_range_u64(value:u64,start:usize,width:usize):usize{return bit_popcount_u64(bit_extract_u64(value,start,width))}
export function bit_shift_left_u64(value:u64,count:usize):u64 { if count>=64 as usize{return 0 as u64} let result:u64=value let i:usize=0 as usize while i<count{result=result*2 as u64 i=i+1 as usize} return result }
export function bit_shift_right_u64(value:u64,count:usize):u64 { if count>=64 as usize{return 0 as u64} return value/bit_pow2_u64(count) }
export function bit_rotate_left_u64(value:u64,count:usize):u64 { let shift:usize=count%64 as usize if shift==0 as usize{return value} let result:u64=0 as u64 let index:usize=0 as usize while index<64 as usize{if bit_is_set_u64(value,index){result=bit_set_u64(result,(index+shift)%64 as usize)} index=index+1 as usize} return result }
export function bit_rotate_right_u64(value:u64,count:usize):u64{return bit_rotate_left_u64(value,(64 as usize-count%64 as usize)%64 as usize)}
export function bit_reverse_u64(value:u64):u64 { let result:u64=0 as u64 let index:usize=0 as usize while index<64 as usize{if bit_is_set_u64(value,index){result=bit_set_u64(result,63 as usize-index)} index=index+1 as usize} return result }
export function bit_reverse_bytes_u64(value:u64):u64 { let result:u64=0 as u64 let index:usize=0 as usize while index<8 as usize{let byte:u64=bit_extract_u64(value,index*8 as usize,8 as usize) result=bit_insert_u64(result,(7 as usize-index)*8 as usize,8 as usize,byte) index=index+1 as usize} return result }
export function bit_next_power_of_two_u64(value:u64):u64 { if value<=1 as u64{return 1 as u64} let highest:isize=bit_highest_set_u64(value-1 as u64) if highest<0 as isize||highest>=63 as isize{return 0 as u64} return bit_pow2_u64(highest as usize+1 as usize) }
export function bit_previous_power_of_two_u64(value:u64):u64 { let highest:isize=bit_highest_set_u64(value) if highest<0 as isize{return 0 as u64} return bit_pow2_u64(highest as usize) }
export function bit_align_down_u64(value:u64,alignment:u64):u64{if alignment==0 as u64{return value} return value-value%alignment}
export function bit_align_up_u64(value:u64,alignment:u64):u64 { if alignment==0 as u64{return value} let remainder:u64=value%alignment if remainder==0 as u64{return value} let delta:u64=alignment-remainder if delta>18446744073709551615 as u64-value{return 0 as u64} return value+delta }
export function bit_is_aligned_u64(value:u64,alignment:u64):bool{return alignment!=0 as u64&&value%alignment==0 as u64}

export function bit_mask_u8(index:usize):u8{if index>=8 as usize{return 0 as u8} return bit_mask_u64(index) as u8}
export function bit_is_set_u8(value:u8,index:usize):bool{return index<8 as usize&&bit_is_set_u64(value as u64,index)}
export function bit_set_u8(value:u8,index:usize):u8{return bit_set_u64(value as u64,index) as u8}
export function bit_clear_u8(value:u8,index:usize):u8{return bit_clear_u64(value as u64,index) as u8}
export function bit_toggle_u8(value:u8,index:usize):u8{return bit_toggle_u64(value as u64,index) as u8}
export function bit_assign_u8(value:u8,index:usize,state:bool):u8{return bit_assign_u64(value as u64,index,state) as u8}
export function bit_popcount_u8(value:u8):usize{return bit_popcount_u64(value as u64)}
export function bit_parity_u8(value:u8):bool{return bit_parity_u64(value as u64)}
export function bit_is_power_of_two_u8(value:u8):bool{return bit_is_power_of_two_u64(value as u64)}
export function bit_lowest_set_u8(value:u8):isize{return bit_lowest_set_u64(value as u64)}
export function bit_highest_set_u8(value:u8):isize{return bit_highest_set_u64(value as u64)}
export function bit_trailing_zeros_u8(value:u8):usize{let at:isize=bit_lowest_set_u8(value) if at<0 as isize{return 8 as usize} return at as usize}
export function bit_leading_zeros_u8(value:u8):usize{let at:isize=bit_highest_set_u8(value) if at<0 as isize{return 8 as usize} return 7 as usize-at as usize}
export function bit_width_u8(value:u8):usize{let at:isize=bit_highest_set_u8(value) if at<0 as isize{return 0 as usize} return at as usize+1 as usize}
export function bit_extract_u8(value:u8,start:usize,width:usize):u8{return bit_extract_u64(value as u64,start,width) as u8}
export function bit_insert_u8(value:u8,start:usize,width:usize,field:u8):u8{return bit_insert_u64(value as u64,start,width,field as u64) as u8}
export function bit_clear_range_u8(value:u8,start:usize,width:usize):u8{return bit_clear_range_u64(value as u64,start,width) as u8}
export function bit_set_range_u8(value:u8,start:usize,width:usize):u8{if start>=8 as usize{return value} let actual:usize=width if actual>8 as usize-start{actual=8 as usize-start} return bit_set_range_u64(value as u64,start,actual) as u8}
export function bit_reverse_u8(value:u8):u8{let result:u64=0 as u64 let index:usize=0 as usize while index<8 as usize{if bit_is_set_u64(value as u64,index){result=bit_set_u64(result,7 as usize-index)} index=index+1 as usize} return result as u8}
export function bit_rotate_left_u8(value:u8,count:usize):u8{let shift:usize=count%8 as usize let result:u64=0 as u64 let index:usize=0 as usize while index<8 as usize{if bit_is_set_u64(value as u64,index){result=bit_set_u64(result,(index+shift)%8 as usize)} index=index+1 as usize} return result as u8}
export function bit_rotate_right_u8(value:u8,count:usize):u8{return bit_rotate_left_u8(value,(8 as usize-count%8 as usize)%8 as usize)}
export function bit_next_power_of_two_u8(value:u8):u8{let next:u64=bit_next_power_of_two_u64(value as u64) if next>255 as u64{return 0 as u8} return next as u8}
export function bit_previous_power_of_two_u8(value:u8):u8{return bit_previous_power_of_two_u64(value as u64) as u8}

export function bit_mask_u16(index:usize):u16{if index>=16 as usize{return 0 as u16} return bit_mask_u64(index) as u16}
export function bit_is_set_u16(value:u16,index:usize):bool{return index<16 as usize&&bit_is_set_u64(value as u64,index)}
export function bit_set_u16(value:u16,index:usize):u16{return bit_set_u64(value as u64,index) as u16}
export function bit_clear_u16(value:u16,index:usize):u16{return bit_clear_u64(value as u64,index) as u16}
export function bit_toggle_u16(value:u16,index:usize):u16{return bit_toggle_u64(value as u64,index) as u16}
export function bit_assign_u16(value:u16,index:usize,state:bool):u16{return bit_assign_u64(value as u64,index,state) as u16}
export function bit_popcount_u16(value:u16):usize{return bit_popcount_u64(value as u64)}
export function bit_parity_u16(value:u16):bool{return bit_parity_u64(value as u64)}
export function bit_is_power_of_two_u16(value:u16):bool{return bit_is_power_of_two_u64(value as u64)}
export function bit_lowest_set_u16(value:u16):isize{return bit_lowest_set_u64(value as u64)}
export function bit_highest_set_u16(value:u16):isize{return bit_highest_set_u64(value as u64)}
export function bit_trailing_zeros_u16(value:u16):usize{let at:isize=bit_lowest_set_u16(value) if at<0 as isize{return 16 as usize} return at as usize}
export function bit_leading_zeros_u16(value:u16):usize{let at:isize=bit_highest_set_u16(value) if at<0 as isize{return 16 as usize} return 15 as usize-at as usize}
export function bit_width_u16(value:u16):usize{let at:isize=bit_highest_set_u16(value) if at<0 as isize{return 0 as usize} return at as usize+1 as usize}
export function bit_extract_u16(value:u16,start:usize,width:usize):u16{return bit_extract_u64(value as u64,start,width) as u16}
export function bit_insert_u16(value:u16,start:usize,width:usize,field:u16):u16{return bit_insert_u64(value as u64,start,width,field as u64) as u16}
export function bit_clear_range_u16(value:u16,start:usize,width:usize):u16{return bit_clear_range_u64(value as u64,start,width) as u16}
export function bit_set_range_u16(value:u16,start:usize,width:usize):u16{if start>=16 as usize{return value} let actual:usize=width if actual>16 as usize-start{actual=16 as usize-start} return bit_set_range_u64(value as u64,start,actual) as u16}
export function bit_reverse_u16(value:u16):u16{let result:u64=0 as u64 let index:usize=0 as usize while index<16 as usize{if bit_is_set_u64(value as u64,index){result=bit_set_u64(result,15 as usize-index)} index=index+1 as usize} return result as u16}
export function bit_rotate_left_u16(value:u16,count:usize):u16{let shift:usize=count%16 as usize let result:u64=0 as u64 let index:usize=0 as usize while index<16 as usize{if bit_is_set_u64(value as u64,index){result=bit_set_u64(result,(index+shift)%16 as usize)} index=index+1 as usize} return result as u16}
export function bit_rotate_right_u16(value:u16,count:usize):u16{return bit_rotate_left_u16(value,(16 as usize-count%16 as usize)%16 as usize)}
export function bit_next_power_of_two_u16(value:u16):u16{let next:u64=bit_next_power_of_two_u64(value as u64) if next>65535 as u64{return 0 as u16} return next as u16}
export function bit_previous_power_of_two_u16(value:u16):u16{return bit_previous_power_of_two_u64(value as u64) as u16}

export function bit_mask_u32(index:usize):u32{if index>=32 as usize{return 0 as u32} return bit_mask_u64(index) as u32}
export function bit_is_set_u32(value:u32,index:usize):bool{return index<32 as usize&&bit_is_set_u64(value as u64,index)}
export function bit_set_u32(value:u32,index:usize):u32{return bit_set_u64(value as u64,index) as u32}
export function bit_clear_u32(value:u32,index:usize):u32{return bit_clear_u64(value as u64,index) as u32}
export function bit_toggle_u32(value:u32,index:usize):u32{return bit_toggle_u64(value as u64,index) as u32}
export function bit_assign_u32(value:u32,index:usize,state:bool):u32{return bit_assign_u64(value as u64,index,state) as u32}
export function bit_popcount_u32(value:u32):usize{return bit_popcount_u64(value as u64)}
export function bit_parity_u32(value:u32):bool{return bit_parity_u64(value as u64)}
export function bit_is_power_of_two_u32(value:u32):bool{return bit_is_power_of_two_u64(value as u64)}
export function bit_lowest_set_u32(value:u32):isize{return bit_lowest_set_u64(value as u64)}
export function bit_highest_set_u32(value:u32):isize{return bit_highest_set_u64(value as u64)}
export function bit_trailing_zeros_u32(value:u32):usize{let at:isize=bit_lowest_set_u32(value) if at<0 as isize{return 32 as usize} return at as usize}
export function bit_leading_zeros_u32(value:u32):usize{let at:isize=bit_highest_set_u32(value) if at<0 as isize{return 32 as usize} return 31 as usize-at as usize}
export function bit_width_u32(value:u32):usize{let at:isize=bit_highest_set_u32(value) if at<0 as isize{return 0 as usize} return at as usize+1 as usize}
export function bit_extract_u32(value:u32,start:usize,width:usize):u32{return bit_extract_u64(value as u64,start,width) as u32}
export function bit_insert_u32(value:u32,start:usize,width:usize,field:u32):u32{return bit_insert_u64(value as u64,start,width,field as u64) as u32}
export function bit_clear_range_u32(value:u32,start:usize,width:usize):u32{return bit_clear_range_u64(value as u64,start,width) as u32}
export function bit_set_range_u32(value:u32,start:usize,width:usize):u32{if start>=32 as usize{return value} let actual:usize=width if actual>32 as usize-start{actual=32 as usize-start} return bit_set_range_u64(value as u64,start,actual) as u32}
export function bit_reverse_u32(value:u32):u32{let result:u64=0 as u64 let index:usize=0 as usize while index<32 as usize{if bit_is_set_u64(value as u64,index){result=bit_set_u64(result,31 as usize-index)} index=index+1 as usize} return result as u32}
export function bit_rotate_left_u32(value:u32,count:usize):u32{let shift:usize=count%32 as usize let result:u64=0 as u64 let index:usize=0 as usize while index<32 as usize{if bit_is_set_u64(value as u64,index){result=bit_set_u64(result,(index+shift)%32 as usize)} index=index+1 as usize} return result as u32}
export function bit_rotate_right_u32(value:u32,count:usize):u32{return bit_rotate_left_u32(value,(32 as usize-count%32 as usize)%32 as usize)}
export function bit_next_power_of_two_u32(value:u32):u32{let next:u64=bit_next_power_of_two_u64(value as u64) if next>4294967295 as u64{return 0 as u32} return next as u32}
export function bit_previous_power_of_two_u32(value:u32):u32{return bit_previous_power_of_two_u64(value as u64) as u32}

export function bit_byte_at_u64(value:u64,index:usize):u8{if index>=8 as usize{return 0 as u8} return bit_extract_u64(value,index*8 as usize,8 as usize) as u8}
export function bit_with_byte_u64(value:u64,index:usize,byte:u8):u64{if index>=8 as usize{return value} return bit_insert_u64(value,index*8 as usize,8 as usize,byte as u64)}
export function bit_nibble_at_u64(value:u64,index:usize):u8{if index>=16 as usize{return 0 as u8} return bit_extract_u64(value,index*4 as usize,4 as usize) as u8}
export function bit_with_nibble_u64(value:u64,index:usize,nibble:u8):u64{if index>=16 as usize{return value} return bit_insert_u64(value,index*4 as usize,4 as usize,(nibble%16 as u8) as u64)}
export function bit_bitmap_test(words:[]u64,index:usize):bool{let word:usize=index/64 as usize if word>=len(words){return false} return bit_is_set_u64(words[word],index%64 as usize)}
export function bit_bitmap_set(words:[]u64,index:usize):bool{let word:usize=index/64 as usize if word>=len(words){return false} words[word]=bit_set_u64(words[word],index%64 as usize) return true}
export function bit_bitmap_clear(words:[]u64,index:usize):bool{let word:usize=index/64 as usize if word>=len(words){return false} words[word]=bit_clear_u64(words[word],index%64 as usize) return true}
export function bit_bitmap_toggle(words:[]u64,index:usize):bool{let word:usize=index/64 as usize if word>=len(words){return false} words[word]=bit_toggle_u64(words[word],index%64 as usize) return true}
export function bit_bitmap_count(words:[]u64):usize{let count:usize=0 as usize let index:usize=0 as usize while index<len(words){count=count+bit_popcount_u64(words[index]) index=index+1 as usize} return count}
export function bit_bitmap_clear_all(words:[]u64):void{let index:usize=0 as usize while index<len(words){words[index]=0 as u64 index=index+1 as usize}}
export function bit_bitmap_set_all(words:[]u64):void{let index:usize=0 as usize while index<len(words){words[index]=18446744073709551615 as u64 index=index+1 as usize}}
export function bit_bitmap_first_set(words:[]u64):isize{let word:usize=0 as usize while word<len(words){let local:isize=bit_lowest_set_u64(words[word]) if local>=0 as isize{return(word*64 as usize+local as usize)as isize} word=word+1 as usize} return-1 as isize}
export function bit_bitmap_first_clear(words:[]u64,bitCount:usize):isize{let index:usize=0 as usize while index<bitCount{if !bit_bitmap_test(words,index){return index as isize} index=index+1 as usize} return-1 as isize}

export function bit_bitmap_set_range(words:[]u64,start:usize,count:usize):usize{let changed:usize=0 as usize let index:usize=0 as usize while index<count{let at:usize=start+index if !bit_bitmap_test(words,at)&&bit_bitmap_set(words,at){changed=changed+1 as usize} index=index+1 as usize} return changed}
export function bit_bitmap_clear_range(words:[]u64,start:usize,count:usize):usize{let changed:usize=0 as usize let index:usize=0 as usize while index<count{let at:usize=start+index if bit_bitmap_test(words,at)&&bit_bitmap_clear(words,at){changed=changed+1 as usize} index=index+1 as usize} return changed}
export function bit_bitmap_count_range(words:[]u64,start:usize,count:usize):usize{let total:usize=0 as usize let index:usize=0 as usize while index<count{if bit_bitmap_test(words,start+index){total=total+1 as usize} index=index+1 as usize} return total}
export function bit_bitmap_all_set(words:[]u64,start:usize,count:usize):bool{let index:usize=0 as usize while index<count{if !bit_bitmap_test(words,start+index){return false} index=index+1 as usize} return true}
export function bit_bitmap_any_set(words:[]u64,start:usize,count:usize):bool{let index:usize=0 as usize while index<count{if bit_bitmap_test(words,start+index){return true} index=index+1 as usize} return false}
export function bit_bitmap_capacity(words:[]u64):usize{if len(words)>18446744073709551615 as usize/64 as usize{return 18446744073709551615 as usize} return len(words)*64 as usize}
export function bit_bitmap_index_valid(words:[]u64,index:usize):bool{return index<bit_bitmap_capacity(words)}
export function bit_bitmap_set_if_clear(words:[]u64,index:usize):bool{if bit_bitmap_test(words,index){return false} return bit_bitmap_set(words,index)}
export function bit_bitmap_clear_if_set(words:[]u64,index:usize):bool{if !bit_bitmap_test(words,index){return false} return bit_bitmap_clear(words,index)}

export function bit_gray_encode_u64(value:u64):u64{let shifted:u64=value/2 as u64 let result:u64=0 as u64 let index:usize=0 as usize while index<64 as usize{let a:bool=bit_is_set_u64(value,index) let b:bool=bit_is_set_u64(shifted,index) if a!=b{result=bit_set_u64(result,index)} index=index+1 as usize} return result}
export function bit_gray_decode_u64(gray:u64):u64{let result:u64=0 as u64 let parity:bool=false let index:usize=64 as usize while index>0 as usize{index=index-1 as usize if bit_is_set_u64(gray,index){parity=!parity} if parity{result=bit_set_u64(result,index)}} return result}
export function bit_interleave16(x:u16,y:u16):u32{let result:u64=0 as u64 let index:usize=0 as usize while index<16 as usize{if bit_is_set_u16(x,index){result=bit_set_u64(result,index*2 as usize)} if bit_is_set_u16(y,index){result=bit_set_u64(result,index*2 as usize+1 as usize)} index=index+1 as usize} return result as u32}
export function bit_deinterleave16_x(value:u32):u16{let result:u16=0 as u16 let index:usize=0 as usize while index<16 as usize{if bit_is_set_u32(value,index*2 as usize){result=bit_set_u16(result,index)} index=index+1 as usize} return result}
export function bit_deinterleave16_y(value:u32):u16{let result:u16=0 as u16 let index:usize=0 as usize while index<16 as usize{if bit_is_set_u32(value,index*2 as usize+1 as usize){result=bit_set_u16(result,index)} index=index+1 as usize} return result}

export function nqBitIsSet(value:u64,index:u8):bool{return bit_is_set_u64(value,index as usize)}
export function nqBitPopcount(value:u64):u8{return bit_popcount_u64(value) as u8}
export function nqBitIsPowerOfTwo(value:u64):bool{return bit_is_power_of_two_u64(value)}
