export function algorithm_unique_sorted_u8(values:[]u8):usize{if len(values)==0 as usize{return 0 as usize} let write:usize=1 as usize let read:usize=1 as usize while read<len(values){if values[read]!=values[write-1 as usize]{values[write]=values[read] write=write+1 as usize} read=read+1 as usize} return write}
export function algorithm_partition_less_u8(values:[]u8,pivot:u8):usize{let write:usize=0 as usize let read:usize=0 as usize while read<len(values){if values[read]<pivot{let tmp:u8=values[write] values[write]=values[read] values[read]=tmp write=write+1 as usize} read=read+1 as usize} return write}
export function algorithm_clamp_u8(values:[]u8,low:u8,high:u8):usize{if high<low{return 0 as usize} let changed:usize=0 as usize let i:usize=0 as usize while i<len(values){if values[i]<low{values[i]=low changed=changed+1 as usize}else if values[i]>high{values[i]=high changed=changed+1 as usize} i=i+1 as usize} return changed}
export function algorithm_lexicographic_u8(a:[]u8,b:[]u8):int{let count:usize=len(a) if len(b)<count{count=len(b)} let i:usize=0 as usize while i<count{if a[i]<b[i]{return-1} if a[i]>b[i]{return 1} i=i+1 as usize} if len(a)<len(b){return-1} if len(a)>len(b){return 1} return 0}

export function algorithm_copy_range_u8(source:[]u8,start:usize,count:usize,destination:[]u8):usize{if start>len(source)||count>len(source)-start{return 0 as usize} let take:usize=count if len(destination)<take{take=len(destination)} let i:usize=0 as usize while i<take{destination[i]=source[start+i] i=i+1 as usize} return take}
export function algorithm_move_u8(values:[]u8,from:usize,to:usize,count:usize):bool{if from>len(values)||to>len(values)||count>len(values)-from||count>len(values)-to{return false} if count==0 as usize||from==to{return true} if to<from{let i:usize=0 as usize while i<count{values[to+i]=values[from+i] i=i+1 as usize}}else{let i:usize=count while i>0 as usize{i=i-1 as usize values[to+i]=values[from+i]}} return true}
export function algorithm_replace_u8(values:[]u8,old:u8,replacement:u8):usize{let changed:usize=0 as usize let i:usize=0 as usize while i<len(values){if values[i]==old{values[i]=replacement changed=changed+1 as usize} i=i+1 as usize} return changed}
export function algorithm_mismatch_u8(a:[]u8,b:[]u8):isize{let count:usize=len(a) if len(b)<count{count=len(b)} let i:usize=0 as usize while i<count{if a[i]!=b[i]{return i as isize} i=i+1 as usize} if len(a)!=len(b){return count as isize} return-1 as isize}
export function algorithm_prefix_match_u8(a:[]u8,b:[]u8):usize{let count:usize=len(a) if len(b)<count{count=len(b)} let i:usize=0 as usize while i<count&&a[i]==b[i]{i=i+1 as usize} return i}
export function algorithm_find_subsequence_u8(haystack:[]u8,needle:[]u8):isize{if len(needle)==0 as usize{return 0 as isize} if len(needle)>len(haystack){return-1 as isize} let start:usize=0 as usize while start<=len(haystack)-len(needle){let matched:bool=true let i:usize=0 as usize while i<len(needle){if haystack[start+i]!=needle[i]{matched=false i=len(needle)}else{i=i+1 as usize}} if matched{return start as isize} start=start+1 as usize} return-1 as isize}
export function algorithm_starts_with_u8(value:[]u8,prefix:[]u8):bool{if len(prefix)>len(value){return false} let i:usize=0 as usize while i<len(prefix){if value[i]!=prefix[i]{return false} i=i+1 as usize} return true}
export function algorithm_ends_with_u8(value:[]u8,suffix:[]u8):bool{if len(suffix)>len(value){return false} let offset:usize=len(value)-len(suffix) let i:usize=0 as usize while i<len(suffix){if value[offset+i]!=suffix[i]{return false} i=i+1 as usize} return true}
export function algorithm_all_zero_u8(values:[]u8):bool{let i:usize=0 as usize while i<len(values){if values[i]!=0 as u8{return false} i=i+1 as usize} return true}
export function algorithm_count_nonzero_u8(values:[]u8):usize{let count:usize=0 as usize let i:usize=0 as usize while i<len(values){if values[i]!=0 as u8{count=count+1 as usize} i=i+1 as usize} return count}
export function algorithm_clear_u8(values:[]u8):void{algorithm_fill_u8(values,0 as u8)}
export function algorithm_swap_u8(values:[]u8,a:usize,b:usize):bool{if a>=len(values)||b>=len(values){return false} let tmp:u8=values[a] values[a]=values[b] values[b]=tmp return true}
export function algorithm_swap_i64(values:[]i64,a:usize,b:usize):bool{if a>=len(values)||b>=len(values){return false} let tmp:i64=values[a] values[a]=values[b] values[b]=tmp return true}
export function algorithm_swap_u64(values:[]u64,a:usize,b:usize):bool{if a>=len(values)||b>=len(values){return false} let tmp:u64=values[a] values[a]=values[b] values[b]=tmp return true}

export function nqGcd(a:i64,b:i64):i64{return algorithm_gcd_i64(a,b)}
export function nqLcm(a:i64,b:i64):i64{return algorithm_lcm_i64(a,b)}
export function nqPowInt(base:i64,exponent:u32):i64{return algorithm_pow_i64(base,exponent)}
export function nqFactorial(value:u32):u64{return algorithm_factorial_u64(value)}
