export function algorithm_lower_bound_u8(values:[]u8,target:u8):usize{let low:usize=0 as usize let high:usize=len(values) while low<high{let mid:usize=low+(high-low)/2 as usize if values[mid]<target{low=mid+1 as usize}else{high=mid}} return low}
