module noqeri.std.crc

// Portable cyclic redundancy checks. Noqeri's stable surface intentionally
// keeps bitwise syntax small, so XOR is expressed arithmetically here. Native
// backends are free to strength-reduce these loops to machine instructions.
record Crc32State {
    value: u64
    bytes: usize
}

record Crc16State {
    value: u64
    bytes: usize
}

record Crc8State {
    value: u64
    bytes: usize
}

export function crc32_initial(): u64 { return 4294967295 as u64 }
export function crc32_final_xor(): u64 { return 4294967295 as u64 }
export function crc32_polynomial_reversed(): u64 { return 3988292384 as u64 }
export function crc32c_polynomial_reversed(): u64 { return 2197175160 as u64 }
export function crc16_ccitt_initial(): u64 { return 65535 as u64 }
export function crc16_ccitt_polynomial(): u64 { return 4129 as u64 }
export function crc8_polynomial(): u64 { return 7 as u64 }

function crc_xor_u64(left: u64, right: u64): u64 {
    let a: u64 = left
    let b: u64 = right
    let place: u64 = 1 as u64
    let result: u64 = 0 as u64
    let bit: int = 0
    while bit < 64 {
        if a % 2 as u64 != b % 2 as u64 { result = result + place }
        a = a / 2 as u64
        b = b / 2 as u64
        if bit < 63 { place = place * 2 as u64 }
        bit = bit + 1
    }
    return result
}

export function crc_xor32(left: u64, right: u64): u64 {
    return crc_xor_u64(left % 4294967296 as u64, right % 4294967296 as u64) % 4294967296 as u64
}

export function crc_xor16(left: u64, right: u64): u64 {
    return crc_xor_u64(left % 65536 as u64, right % 65536 as u64) % 65536 as u64
}

export function crc_xor8(left: u64, right: u64): u64 {
    return crc_xor_u64(left % 256 as u64, right % 256 as u64) % 256 as u64
}

function crc32_step(state: u64, byte: u8, polynomial: u64): u64 {
    let current: u64 = crc_xor32(state, byte as u64)
    let bit: int = 0
    while bit < 8 {
        if current % 2 as u64 == 1 as u64 {
            current = crc_xor32(current / 2 as u64, polynomial)
        } else {
            current = current / 2 as u64
        }
        bit = bit + 1
    }
    return current % 4294967296 as u64
}

export function crc32_update_byte_raw(state: u64, byte: u8): u64 {
    return crc32_step(state, byte, crc32_polynomial_reversed())
}

export function crc32c_update_byte_raw(state: u64, byte: u8): u64 {
    return crc32_step(state, byte, crc32c_polynomial_reversed())
}

export function crc32_raw(data: []u8): u64 {
    let state: u64 = crc32_initial()
    let i: usize = 0 as usize
    while i < len(data) {
        state = crc32_update_byte_raw(state, data[i])
        i = i + 1 as usize
    }
    return state
}

export function crc32(data: []u8): u64 {
    return crc_xor32(crc32_raw(data), crc32_final_xor())
}

export function crc32c_raw(data: []u8): u64 {
    let state: u64 = crc32_initial()
    let i: usize = 0 as usize
    while i < len(data) {
        state = crc32c_update_byte_raw(state, data[i])
        i = i + 1 as usize
    }
    return state
}

export function crc32c(data: []u8): u64 {
    return crc_xor32(crc32c_raw(data), crc32_final_xor())
}

export function crc32_state_init(state: *Crc32State): bool {
    if state == null { return false }
    state.value = crc32_initial()
    state.bytes = 0 as usize
    return true
}

export function crc32_state_reset(state: *Crc32State): bool { return crc32_state_init(state) }

export function crc32_state_update_byte(state: *Crc32State, byte: u8): bool {
    if state == null { return false }
    state.value = crc32_update_byte_raw(state.value, byte)
    state.bytes = state.bytes + 1 as usize
    return true
}

export function crc32_state_update(state: *Crc32State, data: []u8): bool {
    if state == null { return false }
    let i: usize = 0 as usize
    while i < len(data) {
        state.value = crc32_update_byte_raw(state.value, data[i])
        state.bytes = state.bytes + 1 as usize
        i = i + 1 as usize
    }
    return true
}

export function crc32_state_value(state: *Crc32State): u64 {
    if state == null { return 0 as u64 }
    return crc_xor32(state.value, crc32_final_xor())
}

export function crc32_state_bytes(state: *Crc32State): usize {
    if state == null { return 0 as usize }
    return state.bytes
}

export function crc32_state_copy(destination: *Crc32State, source: *Crc32State): bool {
    if destination == null || source == null { return false }
    destination.value = source.value
    destination.bytes = source.bytes
    return true
}

export function crc32_matches(data: []u8, expected: u64): bool {
    return crc32(data) == expected % 4294967296 as u64
}

export function crc32c_matches(data: []u8, expected: u64): bool {
    return crc32c(data) == expected % 4294967296 as u64
}

export function crc32_write_big_endian(value: u64, output: []u8, offset: usize): bool {
    if offset + 4 as usize > len(output) { return false }
    let n: u64 = value % 4294967296 as u64
    output[offset] = ((n / 16777216 as u64) % 256 as u64) as u8
    output[offset + 1 as usize] = ((n / 65536 as u64) % 256 as u64) as u8
    output[offset + 2 as usize] = ((n / 256 as u64) % 256 as u64) as u8
    output[offset + 3 as usize] = (n % 256 as u64) as u8
    return true
}

export function crc32_read_big_endian(input: []u8, offset: usize): u64 {
    if offset + 4 as usize > len(input) { return 0 as u64 }
    return input[offset] as u64 * 16777216 as u64 +
        input[offset + 1 as usize] as u64 * 65536 as u64 +
        input[offset + 2 as usize] as u64 * 256 as u64 + input[offset + 3 as usize] as u64
}

export function crc32_write_little_endian(value: u64, output: []u8, offset: usize): bool {
    if offset + 4 as usize > len(output) { return false }
    let n: u64 = value % 4294967296 as u64
    output[offset] = (n % 256 as u64) as u8
    output[offset + 1 as usize] = ((n / 256 as u64) % 256 as u64) as u8
    output[offset + 2 as usize] = ((n / 65536 as u64) % 256 as u64) as u8
    output[offset + 3 as usize] = ((n / 16777216 as u64) % 256 as u64) as u8
    return true
}

export function crc32_read_little_endian(input: []u8, offset: usize): u64 {
    if offset + 4 as usize > len(input) { return 0 as u64 }
    return input[offset] as u64 + input[offset + 1 as usize] as u64 * 256 as u64 +
        input[offset + 2 as usize] as u64 * 65536 as u64 + input[offset + 3 as usize] as u64 * 16777216 as u64
}

export function crc16_ccitt_update_byte_raw(state: u64, byte: u8): u64 {
    let current: u64 = crc_xor16(state, byte as u64 * 256 as u64)
    let bit: int = 0
    while bit < 8 {
        let shifted: u64 = (current * 2 as u64) % 65536 as u64
        if current >= 32768 as u64 { current = crc_xor16(shifted, crc16_ccitt_polynomial()) }
        else { current = shifted }
        bit = bit + 1
    }
    return current
}

export function crc16_ccitt(data: []u8): u64 {
    let state: u64 = crc16_ccitt_initial()
    let i: usize = 0 as usize
    while i < len(data) {
        state = crc16_ccitt_update_byte_raw(state, data[i])
        i = i + 1 as usize
    }
    return state % 65536 as u64
}

export function crc16_state_init(state: *Crc16State): bool {
    if state == null { return false }
    state.value = crc16_ccitt_initial()
    state.bytes = 0 as usize
    return true
}

export function crc16_state_update_byte(state: *Crc16State, byte: u8): bool {
    if state == null { return false }
    state.value = crc16_ccitt_update_byte_raw(state.value, byte)
    state.bytes = state.bytes + 1 as usize
    return true
}

export function crc16_state_update(state: *Crc16State, data: []u8): bool {
    if state == null { return false }
    let i: usize = 0 as usize
    while i < len(data) {
        state.value = crc16_ccitt_update_byte_raw(state.value, data[i])
        state.bytes = state.bytes + 1 as usize
        i = i + 1 as usize
    }
    return true
}

export function crc16_state_value(state: *Crc16State): u64 {
    if state == null { return 0 as u64 }
    return state.value % 65536 as u64
}

export function crc16_matches(data: []u8, expected: u64): bool {
    return crc16_ccitt(data) == expected % 65536 as u64
}

export function crc16_write_big_endian(value: u64, output: []u8, offset: usize): bool {
    if offset + 2 as usize > len(output) { return false }
    let n: u64 = value % 65536 as u64
    output[offset] = ((n / 256 as u64) % 256 as u64) as u8
    output[offset + 1 as usize] = (n % 256 as u64) as u8
    return true
}

export function crc16_read_big_endian(input: []u8, offset: usize): u64 {
    if offset + 2 as usize > len(input) { return 0 as u64 }
    return input[offset] as u64 * 256 as u64 + input[offset + 1 as usize] as u64
}

export function crc8_update_byte_raw(state: u64, byte: u8): u64 {
    let current: u64 = crc_xor8(state, byte as u64)
    let bit: int = 0
    while bit < 8 {
        let shifted: u64 = (current * 2 as u64) % 256 as u64
        if current >= 128 as u64 { current = crc_xor8(shifted, crc8_polynomial()) }
        else { current = shifted }
        bit = bit + 1
    }
    return current
}

export function crc8(data: []u8): u64 {
    let state: u64 = 0 as u64
    let i: usize = 0 as usize
    while i < len(data) {
        state = crc8_update_byte_raw(state, data[i])
        i = i + 1 as usize
    }
    return state % 256 as u64
}

export function crc8_state_init(state: *Crc8State): bool {
    if state == null { return false }
    state.value = 0 as u64
    state.bytes = 0 as usize
    return true
}

export function crc8_state_update(state: *Crc8State, data: []u8): bool {
    if state == null { return false }
    let i: usize = 0 as usize
    while i < len(data) {
        state.value = crc8_update_byte_raw(state.value, data[i])
        state.bytes = state.bytes + 1 as usize
        i = i + 1 as usize
    }
    return true
}

export function crc8_state_value(state: *Crc8State): u64 {
    if state == null { return 0 as u64 }
    return state.value % 256 as u64
}

export function crc8_matches(data: []u8, expected: u64): bool {
    return crc8(data) == expected % 256 as u64
}

// Compatibility helpers from the placeholder era.
export function crc_byte_sum(data: []u8): u64 {
    let sum: u64 = 0 as u64
    let i: usize = 0 as usize
    while i < len(data) { sum = sum + data[i] as u64 i = i + 1 as usize }
    return sum
}
export function crc_all_zero(data: []u8): bool {
    let i: usize = 0 as usize
    while i < len(data) { if data[i] != 0 as u8 { return false } i = i + 1 as usize }
    return true
}
export function crc_bounded_length(data: []u8, max: usize): bool { return len(data) <= max }
export function crc_nonempty(data: []u8): bool { return len(data) > 0 as usize }
