module noqeri.std.bloom

// Caller-owned Bloom filter built on a byte array. It uses deterministic
// arithmetic hashing so the implementation is portable across Noqeri targets.
// False positives are possible; false negatives are not expected after add().
record BloomFilter {
    data: *u8
    bit_length: usize
    byte_capacity: usize
    hash_count: usize
    inserted: usize
    seed: u64
}

export function bloom_required_bytes(bits: usize): usize {
    if bits == 0 as usize { return 0 as usize }
    return (bits + 7 as usize) / 8 as usize
}

export function bloom_init(filter: *BloomFilter, data: *u8, bits: usize, byte_capacity: usize, hash_count: usize, seed: u64): bool {
    if filter == null || hash_count == 0 as usize { return false }
    let needed: usize = bloom_required_bytes(bits)
    if needed > byte_capacity { return false }
    if needed > 0 as usize && data == null { return false }
    filter.data = data
    filter.bit_length = bits
    filter.byte_capacity = byte_capacity
    filter.hash_count = hash_count
    filter.inserted = 0 as usize
    filter.seed = seed
    return bloom_clear(filter)
}

export function bloom_invariant(filter: *BloomFilter): bool {
    if filter == null || filter.hash_count == 0 as usize { return false }
    if bloom_required_bytes(filter.bit_length) > filter.byte_capacity { return false }
    if filter.bit_length > 0 as usize && filter.data == null { return false }
    return true
}

export function bloom_bits(filter: *BloomFilter): usize { if filter == null { return 0 as usize } return filter.bit_length }
export function bloom_bytes(filter: *BloomFilter): usize { if filter == null { return 0 as usize } return bloom_required_bytes(filter.bit_length) }
export function bloom_hashes(filter: *BloomFilter): usize { if filter == null { return 0 as usize } return filter.hash_count }
export function bloom_inserted_count(filter: *BloomFilter): usize { if filter == null { return 0 as usize } return filter.inserted }
export function bloom_empty_filter(filter: *BloomFilter): bool { return filter == null || filter.inserted == 0 as usize }

function bloom_mask(offset: usize): u8 {
    let mask: u8 = 1 as u8
    let i: usize = 0 as usize
    while i < offset {
        mask = mask * 2 as u8
        i = i + 1 as usize
    }
    return mask
}

function bloom_test_bit(filter: *BloomFilter, bit: usize): bool {
    if !bloom_invariant(filter) || bit >= filter.bit_length { return false }
    let byte_index: usize = bit / 8 as usize
    let offset: usize = bit % 8 as usize
    let mask: u8 = bloom_mask(offset)
    return (filter.data[byte_index] / mask) % 2 as u8 == 1 as u8
}

function bloom_set_bit(filter: *BloomFilter, bit: usize): bool {
    if !bloom_invariant(filter) || bit >= filter.bit_length { return false }
    if bloom_test_bit(filter, bit) { return true }
    let byte_index: usize = bit / 8 as usize
    let offset: usize = bit % 8 as usize
    let mask: u8 = bloom_mask(offset)
    filter.data[byte_index] = filter.data[byte_index] + mask
    return true
}

export function bloom_clear(filter: *BloomFilter): bool {
    if filter == null { return false }
    let bytes: usize = bloom_required_bytes(filter.bit_length)
    if bytes > filter.byte_capacity || (bytes > 0 as usize && filter.data == null) { return false }
    let i: usize = 0 as usize
    while i < bytes {
        filter.data[i] = 0 as u8
        i = i + 1 as usize
    }
    filter.inserted = 0 as usize
    return true
}

// A simple 64-bit FNV-style mixer expressed with wrapping-friendly arithmetic.
export function bloom_hash_bytes(bytes: []u8, seed: u64): u64 {
    let hash: u64 = 1469598103934665603 as u64 + seed
    let i: usize = 0 as usize
    while i < len(bytes) {
        hash = hash + bytes[i] as u64 + 1099511628211 as u64
        hash = hash * 1099511628211 as u64
        hash = hash + (i as u64 * 97 as u64)
        i = i + 1 as usize
    }
    return hash
}

export function bloom_hash_u64(value: u64, seed: u64): u64 {
    let x: u64 = value + seed + 11400714819323198485 as u64
    x = x * 6364136223846793005 as u64 + 1442695040888963407 as u64
    x = x + (x / 17 as u64)
    x = x * 2862933555777941757 as u64 + 3037000493 as u64
    return x
}

function bloom_index_from_hash(filter: *BloomFilter, first: u64, second: u64, round: usize): usize {
    if filter.bit_length == 0 as usize { return 0 as usize }
    let mixed: u64 = first + second * (round as u64 + 1 as u64) + (round as u64 * round as u64 * 13 as u64)
    return (mixed % filter.bit_length as u64) as usize
}

export function bloom_add_bytes(filter: *BloomFilter, value: []u8): bool {
    if !bloom_invariant(filter) || filter.bit_length == 0 as usize { return false }
    let first: u64 = bloom_hash_bytes(value, filter.seed)
    let second: u64 = bloom_hash_bytes(value, filter.seed + 11400714819323198485 as u64)
    let round: usize = 0 as usize
    while round < filter.hash_count {
        let index: usize = bloom_index_from_hash(filter, first, second, round)
        if !bloom_set_bit(filter, index) { return false }
        round = round + 1 as usize
    }
    filter.inserted = filter.inserted + 1 as usize
    return true
}

export function bloom_might_contain_bytes(filter: *BloomFilter, value: []u8): bool {
    if !bloom_invariant(filter) || filter.bit_length == 0 as usize { return false }
    let first: u64 = bloom_hash_bytes(value, filter.seed)
    let second: u64 = bloom_hash_bytes(value, filter.seed + 11400714819323198485 as u64)
    let round: usize = 0 as usize
    while round < filter.hash_count {
        let index: usize = bloom_index_from_hash(filter, first, second, round)
        if !bloom_test_bit(filter, index) { return false }
        round = round + 1 as usize
    }
    return true
}

export function bloom_add_u64(filter: *BloomFilter, value: u64): bool {
    if !bloom_invariant(filter) || filter.bit_length == 0 as usize { return false }
    let first: u64 = bloom_hash_u64(value, filter.seed)
    let second: u64 = bloom_hash_u64(value, filter.seed + 7046029254386353131 as u64)
    let round: usize = 0 as usize
    while round < filter.hash_count {
        let index: usize = bloom_index_from_hash(filter, first, second, round)
        if !bloom_set_bit(filter, index) { return false }
        round = round + 1 as usize
    }
    filter.inserted = filter.inserted + 1 as usize
    return true
}

export function bloom_might_contain_u64(filter: *BloomFilter, value: u64): bool {
    if !bloom_invariant(filter) || filter.bit_length == 0 as usize { return false }
    let first: u64 = bloom_hash_u64(value, filter.seed)
    let second: u64 = bloom_hash_u64(value, filter.seed + 7046029254386353131 as u64)
    let round: usize = 0 as usize
    while round < filter.hash_count {
        let index: usize = bloom_index_from_hash(filter, first, second, round)
        if !bloom_test_bit(filter, index) { return false }
        round = round + 1 as usize
    }
    return true
}

export function bloom_count_set_bits(filter: *BloomFilter): usize {
    if !bloom_invariant(filter) { return 0 as usize }
    let count: usize = 0 as usize
    let i: usize = 0 as usize
    while i < filter.bit_length {
        if bloom_test_bit(filter, i) { count = count + 1 as usize }
        i = i + 1 as usize
    }
    return count
}

export function bloom_count_clear_bits(filter: *BloomFilter): usize {
    if filter == null { return 0 as usize }
    let set_bits: usize = bloom_count_set_bits(filter)
    if set_bits > filter.bit_length { return 0 as usize }
    return filter.bit_length - set_bits
}

export function bloom_fill_per_mille(filter: *BloomFilter): usize {
    if filter == null || filter.bit_length == 0 as usize { return 0 as usize }
    return bloom_count_set_bits(filter) * 1000 as usize / filter.bit_length
}

export function bloom_saturated(filter: *BloomFilter, threshold_per_mille: usize): bool {
    if threshold_per_mille > 1000 as usize { return false }
    return bloom_fill_per_mille(filter) >= threshold_per_mille
}

export function bloom_estimated_queries_before_reset(filter: *BloomFilter, target_insertions: usize): usize {
    if filter == null || filter.inserted >= target_insertions { return 0 as usize }
    return target_insertions - filter.inserted
}

export function bloom_copy_bytes(filter: *BloomFilter, out: []u8): usize {
    if !bloom_invariant(filter) { return 0 as usize }
    let count: usize = bloom_bytes(filter)
    if len(out) < count { return 0 as usize }
    let i: usize = 0 as usize
    while i < count {
        out[i] = filter.data[i]
        i = i + 1 as usize
    }
    return count
}

export function bloom_load_bytes(filter: *BloomFilter, input: []u8, inserted: usize): bool {
    if !bloom_invariant(filter) { return false }
    let count: usize = bloom_bytes(filter)
    if len(input) < count { return false }
    let i: usize = 0 as usize
    while i < count {
        filter.data[i] = input[i]
        i = i + 1 as usize
    }
    filter.inserted = inserted
    return true
}

export function bloom_equal_shape(left: *BloomFilter, right: *BloomFilter): bool {
    if !bloom_invariant(left) || !bloom_invariant(right) { return false }
    if left.bit_length != right.bit_length || left.hash_count != right.hash_count || left.seed != right.seed { return false }
    let count: usize = bloom_bytes(left)
    let i: usize = 0 as usize
    while i < count {
        if left.data[i] != right.data[i] { return false }
        i = i + 1 as usize
    }
    return true
}

export function bloom_union_into(out: *BloomFilter, left: *BloomFilter, right: *BloomFilter): bool {
    if !bloom_invariant(out) || !bloom_invariant(left) || !bloom_invariant(right) { return false }
    if out.bit_length != left.bit_length || left.bit_length != right.bit_length { return false }
    if out.hash_count != left.hash_count || left.hash_count != right.hash_count { return false }
    if out.seed != left.seed || left.seed != right.seed { return false }
    if !bloom_clear(out) { return false }
    let i: usize = 0 as usize
    while i < out.bit_length {
        if bloom_test_bit(left, i) || bloom_test_bit(right, i) {
            if !bloom_set_bit(out, i) { return false }
        }
        i = i + 1 as usize
    }
    out.inserted = left.inserted + right.inserted
    return true
}

export function bloom_intersection_into(out: *BloomFilter, left: *BloomFilter, right: *BloomFilter): bool {
    if !bloom_invariant(out) || !bloom_invariant(left) || !bloom_invariant(right) { return false }
    if out.bit_length != left.bit_length || left.bit_length != right.bit_length { return false }
    if out.hash_count != left.hash_count || left.hash_count != right.hash_count { return false }
    if out.seed != left.seed || left.seed != right.seed { return false }
    if !bloom_clear(out) { return false }
    let i: usize = 0 as usize
    while i < out.bit_length {
        if bloom_test_bit(left, i) && bloom_test_bit(right, i) {
            if !bloom_set_bit(out, i) { return false }
        }
        i = i + 1 as usize
    }
    let estimate: usize = left.inserted
    if right.inserted < estimate { estimate = right.inserted }
    out.inserted = estimate
    return true
}

export function bloom_reset_with_seed(filter: *BloomFilter, seed: u64): bool {
    if filter == null { return false }
    filter.seed = seed
    return bloom_clear(filter)
}

export function bloom_recommended_hash_count(bits: usize, expected_items: usize): usize {
    if bits == 0 as usize || expected_items == 0 as usize { return 1 as usize }
    let ratio: usize = bits / expected_items
    if ratio <= 1 as usize { return 1 as usize }
    if ratio <= 3 as usize { return 2 as usize }
    if ratio <= 5 as usize { return 3 as usize }
    if ratio <= 7 as usize { return 4 as usize }
    if ratio <= 9 as usize { return 5 as usize }
    if ratio <= 12 as usize { return 6 as usize }
    return 7 as usize
}

export function bloom_recommended_bits(expected_items: usize, bits_per_item: usize): usize {
    if expected_items == 0 as usize || bits_per_item == 0 as usize { return 0 as usize }
    return expected_items * bits_per_item
}

// Compatibility helpers retained for the former placeholder API.
export function bloom_len<T>(items: []T): usize { return len(items) }
export function bloom_is_empty<T>(items: []T): bool { return len(items) == 0 as usize }
export function bloom_first<T: Copy>(items: []T): T { return items[0 as usize] }
export function bloom_last<T: Copy>(items: []T): T { return items[len(items)-1 as usize] }
