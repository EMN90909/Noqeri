module noqeri.std.error

export function error_status_ok(status: isize): bool { return status >= 0 as isize }
export function error_status_error(status: isize): bool { return status < 0 as isize }
export function error_error_code(status: isize): isize { if status < 0 as isize { return -status } return 0 as isize }
export function error_attempt_allowed(attempt: usize, max_attempts: usize): bool { return attempt < max_attempts }
