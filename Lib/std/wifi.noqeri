// Experimental API contract only: requires OS adapters, entitlements and permissions.
// No native host implementation is linked by this change.
module noqeri.std.wifi

extern function wifiAvailable(): bool
extern function wifiConnectedSsid(): string
extern function wifiScan(): isize
extern function wifiScanResults(): string
extern function wifiConnect(ssid: string, credential: string): isize
extern function wifiDisconnect(): isize

export function wifi_available(): bool { return wifiAvailable() }
export function wifi_connected_ssid(): string { return wifiConnectedSsid() }
export function wifi_scan(): isize { return wifiScan() }
export function wifi_connect(ssid: string, credential: string): isize {
    if textLength(ssid) == 0 as usize || textLength(ssid) > 32 as usize { return -2 as isize }
    return wifiConnect(ssid, credential)
}
export function wifi_disconnect(): isize { return wifiDisconnect() }

// The scan count is returned by wifi_scan(); results are newline-separated SSIDs.
export function wifi_scan_results(): string { return wifiScanResults() }
