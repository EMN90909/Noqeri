module noqeri.std.slice_i64

export function nqSliceSumI64(values: []i64): i64 {
    let total: i64 = 0 as i64
    let index: usize = 0 as usize
    while index < len(values) {
        total = total + values[index]
        index = index + 1
    }
    return total
}

export function nqSliceContainsI64(values: []i64, target: i64): bool {
    let index: usize = 0 as usize
    while index < len(values) {
        if values[index] == target { return true }
        index = index + 1
    }
    return false
}

export function nqSliceIndexOfI64(values: []i64, target: i64): isize {
    let index: usize = 0 as usize
    while index < len(values) {
        if values[index] == target { return index as isize }
        index = index + 1
    }
    return -1
}

export function nqSliceCountI64(values: []i64, target: i64): usize {
    let count: usize = 0 as usize
    let index: usize = 0 as usize
    while index < len(values) {
        if values[index] == target { count = count + 1 }
        index = index + 1
    }
    return count
}

export function nqSliceEqualI64(left: []i64, right: []i64): bool {
    if len(left) != len(right) { return false }
    let index: usize = 0 as usize
    while index < len(left) {
        if left[index] != right[index] { return false }
        index = index + 1
    }
    return true
}

export function nqSliceFillI64(values: []i64, value: i64): void {
    let index: usize = 0 as usize
    while index < len(values) {
        values[index] = value
        index = index + 1
    }
}

export function nqSliceCopyI64(source: []i64, destination: []i64): usize {
    let count: usize = len(source)
    if len(destination) < count { count = len(destination) }
    let index: usize = 0 as usize
    while index < count {
        destination[index] = source[index]
        index = index + 1
    }
    return count
}

export function nqSliceReverseI64(values: []i64): void {
    if len(values) < 2 { return }
    let left: usize = 0 as usize
    let right: usize = len(values) - 1
    while left < right {
        let temporary: i64 = values[left]
        values[left] = values[right]
        values[right] = temporary
        left = left + 1
        right = right - 1
    }
}

export function nqSliceMinI64(values: []i64): i64 {
    if len(values) == 0 { return 0 as i64 }
    let answer: i64 = values[0]
    let index: usize = 1 as usize
    while index < len(values) {
        if values[index] < answer { answer = values[index] }
        index = index + 1
    }
    return answer
}

export function nqSliceMaxI64(values: []i64): i64 {
    if len(values) == 0 { return 0 as i64 }
    let answer: i64 = values[0]
    let index: usize = 1 as usize
    while index < len(values) {
        if values[index] > answer { answer = values[index] }
        index = index + 1
    }
    return answer
}
