module noqeri.std.int

export function nqMinI64(a: i64, b: i64): i64 {
    if a < b { return a }
    return b
}

export function nqMaxI64(a: i64, b: i64): i64 {
    if a > b { return a }
    return b
}

export function nqClampI64(value: i64, low: i64, high: i64): i64 {
    if value < low { return low }
    if value > high { return high }
    return value
}

export function nqSignI64(value: i64): i64 {
    if value < 0 { return -1 as i64 }
    if value > 0 { return 1 as i64 }
    return 0 as i64
}

export function nqAbsI64(value: i64): i64 {
    if value < 0 { return -value }
    return value
}

export function nqDistanceI64(a: i64, b: i64): i64 {
    if a >= b { return a - b }
    return b - a
}

export function nqBetweenI64(value: i64, low: i64, high: i64): bool {
    return value >= low && value <= high
}
