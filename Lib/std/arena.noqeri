module noqeri.std.arena

// Arena arithmetic and layout helpers.
// This module intentionally separates layout policy from allocation.  It can
// therefore be used by bootstrappers, embedded targets and host-backed arenas.

record ArenaMark {
    offset: usize
}

record ArenaLayout {
    offset: usize
    size: usize
    alignment: usize
    end: usize
}

export function arena_capacity_valid(length: usize, capacity: usize): bool {
    return length <= capacity
}

export function arena_empty(length: usize): bool {
    return length == 0 as usize
}

export function arena_nonempty(length: usize): bool {
    return length > 0 as usize
}

export function arena_full(length: usize, capacity: usize): bool {
    return length >= capacity
}

export function arena_remaining(length: usize, capacity: usize): usize {
    if length >= capacity { return 0 as usize }
    return capacity - length
}

export function arena_used_percent(length: usize, capacity: usize): usize {
    if capacity == 0 as usize { return 0 as usize }
    if length >= capacity { return 100 as usize }
    return length * 100 as usize / capacity
}

export function arena_is_power_of_two(value: usize): bool {
    if value == 0 as usize { return false }
    let n: usize = value
    while n > 1 as usize {
        if n % 2 as usize != 0 as usize { return false }
        n = n / 2 as usize
    }
    return true
}

export function arena_alignment_valid(alignment: usize): bool {
    return alignment > 0 as usize && arena_is_power_of_two(alignment)
}

export function arena_align_up(value: usize, alignment: usize): usize {
    if alignment <= 1 as usize { return value }
    let remainder: usize = value % alignment
    if remainder == 0 as usize { return value }
    return value + alignment - remainder
}

export function arena_align_down(value: usize, alignment: usize): usize {
    if alignment <= 1 as usize { return value }
    return value - value % alignment
}

export function arena_padding(value: usize, alignment: usize): usize {
    let aligned: usize = arena_align_up(value, alignment)
    if aligned < value { return 0 as usize }
    return aligned - value
}

export function arena_checked_add(a: usize, b: usize, limit: usize): usize {
    if a > limit { return limit }
    if b > limit - a { return limit }
    return a + b
}

export function arena_checked_end(offset: usize, length: usize, capacity: usize): bool {
    if offset > capacity { return false }
    return length <= capacity - offset
}

export function arena_range_valid(start: usize, end: usize, capacity: usize): bool {
    return start <= end && end <= capacity
}

export function arena_contains_offset(offset: usize, length: usize): bool {
    return offset < length
}

export function arena_contains_range(offset: usize, size: usize, length: usize): bool {
    if offset > length { return false }
    return size <= length - offset
}

export function arena_can_allocate(length: usize, capacity: usize, size: usize, alignment: usize): bool {
    if !arena_capacity_valid(length, capacity) { return false }
    if !arena_alignment_valid(alignment) { return false }
    let start: usize = arena_align_up(length, alignment)
    if start < length || start > capacity { return false }
    return size <= capacity - start
}

export function arena_allocation_offset(length: usize, capacity: usize, size: usize, alignment: usize): usize {
    if !arena_can_allocate(length, capacity, size, alignment) { return capacity }
    return arena_align_up(length, alignment)
}

export function arena_next_length(length: usize, capacity: usize, size: usize, alignment: usize): usize {
    let start: usize = arena_allocation_offset(length, capacity, size, alignment)
    if start > capacity || size > capacity - start { return length }
    return start + size
}

export function arena_mark(offset: usize): ArenaMark {
    let mark: ArenaMark
    mark.offset = offset
    return mark
}

export function arena_mark_valid(mark: ArenaMark, length: usize): bool {
    return mark.offset <= length
}

export function arena_rewind_length(mark: ArenaMark, length: usize): usize {
    if mark.offset > length { return length }
    return mark.offset
}

export function arena_bytes_since(mark: ArenaMark, length: usize): usize {
    if mark.offset >= length { return 0 as usize }
    return length - mark.offset
}

export function arena_layout(length: usize, capacity: usize, size: usize, alignment: usize): ArenaLayout {
    let layout: ArenaLayout
    layout.offset = length
    layout.size = 0 as usize
    layout.alignment = alignment
    layout.end = length
    if !arena_can_allocate(length, capacity, size, alignment) { return layout }
    layout.offset = arena_align_up(length, alignment)
    layout.size = size
    layout.end = layout.offset + size
    return layout
}

export function arena_layout_valid(layout: ArenaLayout, capacity: usize): bool {
    if !arena_alignment_valid(layout.alignment) { return false }
    if layout.offset % layout.alignment != 0 as usize { return false }
    if layout.end < layout.offset { return false }
    if layout.size != layout.end - layout.offset { return false }
    return layout.end <= capacity
}

export function arena_layout_empty(layout: ArenaLayout): bool {
    return layout.size == 0 as usize
}

export function arena_layout_padding(length: usize, layout: ArenaLayout): usize {
    if layout.offset < length { return 0 as usize }
    return layout.offset - length
}

export function arena_fit_count(remaining: usize, item_size: usize): usize {
    if item_size == 0 as usize { return 0 as usize }
    return remaining / item_size
}

export function arena_fit_count_aligned(length: usize, capacity: usize, item_size: usize, alignment: usize): usize {
    if item_size == 0 as usize || !arena_alignment_valid(alignment) { return 0 as usize }
    let cursor: usize = length
    let count: usize = 0 as usize
    while arena_can_allocate(cursor, capacity, item_size, alignment) {
        cursor = arena_next_length(cursor, capacity, item_size, alignment)
        count = count + 1 as usize
    }
    return count
}

export function arena_min_capacity_for(length: usize, size: usize, alignment: usize): usize {
    if !arena_alignment_valid(alignment) { return length }
    let start: usize = arena_align_up(length, alignment)
    if start < length { return length }
    return start + size
}

export function arena_grow_by(capacity: usize, extra: usize): usize {
    return capacity + extra
}

export function arena_grow_double(capacity: usize, minimum: usize): usize {
    let grown: usize = capacity
    if grown == 0 as usize { grown = 1 as usize }
    while grown < minimum {
        grown = grown * 2 as usize
    }
    return grown
}

export function arena_grow_three_halves(capacity: usize, minimum: usize): usize {
    let grown: usize = capacity
    if grown == 0 as usize { grown = 1 as usize }
    while grown < minimum {
        let step: usize = grown / 2 as usize
        if step == 0 as usize { grown = grown + 1 as usize }
        else { grown = grown + step }
    }
    return grown
}

export function arena_near_full(length: usize, capacity: usize, reserve: usize): bool {
    return arena_remaining(length, capacity) <= reserve
}

export function arena_high_water(current: usize, previous_high: usize): usize {
    if current > previous_high { return current }
    return previous_high
}

export function arena_fragment_bytes(length: usize, capacity: usize): usize {
    return arena_remaining(length, capacity)
}

export function arena_zero_capacity_valid(length: usize, capacity: usize): bool {
    if capacity == 0 as usize { return length == 0 as usize }
    return length <= capacity
}

export function arena_page_count(bytes: usize, page_size: usize): usize {
    if page_size == 0 as usize { return 0 as usize }
    if bytes == 0 as usize { return 0 as usize }
    return (bytes + page_size - 1 as usize) / page_size
}

export function arena_page_start(offset: usize, page_size: usize): usize {
    if page_size == 0 as usize { return 0 as usize }
    return offset / page_size * page_size
}

export function arena_page_offset(offset: usize, page_size: usize): usize {
    if page_size == 0 as usize { return 0 as usize }
    return offset % page_size
}

export function arena_same_page(a: usize, b: usize, page_size: usize): bool {
    if page_size == 0 as usize { return false }
    return a / page_size == b / page_size
}

export function arena_partition_valid(total: usize, first: usize, second: usize): bool {
    if first > total { return false }
    return second <= total - first
}

export function arena_partition_remaining(total: usize, first: usize, second: usize): usize {
    if !arena_partition_valid(total, first, second) { return 0 as usize }
    return total - first - second
}
