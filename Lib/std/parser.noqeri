module noqeri.std.parser

import "lexer.nqr"

// ParserCursor is intentionally grammar-neutral. It layers predictable
// lookahead, checkpoints, expectations and primitive literal parsing over the
// span tokens from std/lexer without allocating an AST for callers.
record ParserCursor {
    tokens: *LexToken
    count: usize
    index: usize
    error_index: usize
    expected_kind: int
    has_error: bool
}

export function parser_init(parser: *ParserCursor, tokens: *LexToken, count: usize): bool {
    if parser == null { return false }
    if count > 0 as usize && tokens == null { return false }
    parser.tokens = tokens
    parser.count = count
    parser.index = 0 as usize
    parser.error_index = 0 as usize
    parser.expected_kind = -1
    parser.has_error = false
    return true
}

export function parser_done(parser: *ParserCursor): bool {
    return parser == null || parser.index >= parser.count
}

export function parser_position(parser: *ParserCursor): usize {
    if parser == null { return 0 as usize }
    return parser.index
}

export function parser_remaining(parser: *ParserCursor): usize {
    if parser == null || parser.index >= parser.count { return 0 as usize }
    return parser.count - parser.index
}

export function parser_has_error(parser: *ParserCursor): bool { return parser != null && parser.has_error }

export function parser_error_index(parser: *ParserCursor): usize {
    if parser == null { return 0 as usize }
    return parser.error_index
}

export function parser_expected_kind(parser: *ParserCursor): int {
    if parser == null { return -1 }
    return parser.expected_kind
}

export function parser_peek_ref(parser: *ParserCursor, lookahead: usize): *LexToken {
    if parser == null || parser.tokens == null { return null as *LexToken }
    if lookahead > parser.count - parser.index { return null as *LexToken }
    let target: usize = parser.index + lookahead
    if target >= parser.count { return null as *LexToken }
    unsafe { return &parser.tokens[target] }
}

export function parser_current_ref(parser: *ParserCursor): *LexToken { return parser_peek_ref(parser, 0 as usize) }

export function parser_peek_kind(parser: *ParserCursor, lookahead: usize, fallback: int): int {
    let token: *LexToken = parser_peek_ref(parser, lookahead)
    if token == null { return fallback }
    unsafe { return token.kind }
}

export function parser_current_kind(parser: *ParserCursor, fallback: int): int {
    return parser_peek_kind(parser, 0 as usize, fallback)
}

export function parser_advance(parser: *ParserCursor): *LexToken {
    let token: *LexToken = parser_current_ref(parser)
    if token == null { return null as *LexToken }
    parser.index = parser.index + 1 as usize
    return token
}

export function parser_check(parser: *ParserCursor, kind: int): bool {
    return parser_current_kind(parser, -1) == kind
}

export function parser_match(parser: *ParserCursor, kind: int): bool {
    if !parser_check(parser, kind) { return false }
    parser_advance(parser)
    return true
}

export function parser_match2(parser: *ParserCursor, first: int, second: int): bool {
    if parser_peek_kind(parser, 0 as usize, -1) != first || parser_peek_kind(parser, 1 as usize, -1) != second { return false }
    parser.index = parser.index + 2 as usize
    return true
}

export function parser_expect(parser: *ParserCursor, kind: int): *LexToken {
    if parser == null { return null as *LexToken }
    if parser_check(parser, kind) { return parser_advance(parser) }
    parser.has_error = true
    parser.error_index = parser.index
    parser.expected_kind = kind
    return null as *LexToken
}

export function parser_clear_error(parser: *ParserCursor): bool {
    if parser == null { return false }
    parser.has_error = false
    parser.error_index = parser.index
    parser.expected_kind = -1
    return true
}

export function parser_mark(parser: *ParserCursor): usize {
    if parser == null { return 0 as usize }
    return parser.index
}

export function parser_restore(parser: *ParserCursor, mark: usize): bool {
    if parser == null || mark > parser.count { return false }
    parser.index = mark
    parser_clear_error(parser)
    return true
}

export function parser_skip(parser: *ParserCursor, count: usize): usize {
    if parser == null { return 0 as usize }
    let remaining: usize = parser_remaining(parser)
    let actual: usize = count
    if actual > remaining { actual = remaining }
    parser.index = parser.index + actual
    return actual
}

export function parser_skip_kind(parser: *ParserCursor, kind: int): usize {
    if parser == null { return 0 as usize }
    let start: usize = parser.index
    while parser_check(parser, kind) { parser.index = parser.index + 1 as usize }
    return parser.index - start
}

export function parser_find_kind(parser: *ParserCursor, kind: int): isize {
    if parser == null || parser.tokens == null { return -1 as isize }
    let i: usize = parser.index
    while i < parser.count {
        unsafe { if parser.tokens[i].kind == kind { return i as isize } }
        i = i + 1 as usize
    }
    return -1 as isize
}

// Recovery helper: advance until any of up to three synchronization token kinds
// is found. The sync token itself is not consumed.
export function parser_sync3(parser: *ParserCursor, a: int, b: int, c: int): usize {
    if parser == null { return 0 as usize }
    let start: usize = parser.index
    while !parser_done(parser) {
        let kind: int = parser_current_kind(parser, -1)
        if kind == a || kind == b || kind == c { return parser.index - start }
        parser.index = parser.index + 1 as usize
    }
    return parser.index - start
}

export function parser_token_span_valid(source_length: usize, token: *LexToken): bool {
    if token == null { return false }
    unsafe {
        if token.start > source_length { return false }
        return token.length <= source_length - token.start
    }
}

export function parser_token_equals(source: *u8, source_length: usize, token: *LexToken, value: []u8): bool {
    if source == null || token == null || !parser_token_span_valid(source_length, token) { return false }
    unsafe { if token.length != len(value) { return false } }
    let i: usize = 0 as usize
    while i < len(value) {
        unsafe { if source[token.start + i] != value[i] { return false } }
        i = i + 1 as usize
    }
    return true
}

function parser_digit_value(c: u8, base: u64): int {
    let value: int = -1
    if c >= 48 as u8 && c <= 57 as u8 { value = (c - 48 as u8) as int }
    else if c >= 65 as u8 && c <= 70 as u8 { value = 10 + (c - 65 as u8) as int }
    else if c >= 97 as u8 && c <= 102 as u8 { value = 10 + (c - 97 as u8) as int }
    if value < 0 || value as u64 >= base { return -1 }
    return value
}

// Parses unsigned decimal or 0x hexadecimal token text. The result is false on
// malformed digits or overflow instead of silently truncating.
export function parser_parse_u64(source: *u8, source_length: usize, token: *LexToken, out: *u64): bool {
    if source == null || token == null || out == null || !parser_token_span_valid(source_length, token) { return false }
    let start: usize = 0 as usize
    let length: usize = 0 as usize
    unsafe { start = token.start length = token.length }
    if length == 0 as usize { return false }
    let base: u64 = 10 as u64
    let i: usize = 0 as usize
    if length >= 2 as usize {
        let first: u8 = 0 as u8
        let second: u8 = 0 as u8
        unsafe { first = source[start] second = source[start + 1 as usize] }
        if first == 48 as u8 && (second == 120 as u8 || second == 88 as u8) {
            base = 16 as u64
            i = 2 as usize
            if i >= length { return false }
        }
    }
    let value: u64 = 0 as u64
    let max: u64 = 18446744073709551615 as u64
    while i < length {
        let c: u8 = 0 as u8
        unsafe { c = source[start + i] }
        let digit: int = parser_digit_value(c, base)
        if digit < 0 { return false }
        if value > (max - digit as u64) / base { return false }
        value = value * base + digit as u64
        i = i + 1 as usize
    }
    unsafe { *out = value }
    return true
}

export function parser_parse_bool(source: *u8, source_length: usize, token: *LexToken, out: *bool): bool {
    if out == null { return false }
    let true_bytes: [u8; 4] = [116 as u8,114 as u8,117 as u8,101 as u8]
    let false_bytes: [u8; 5] = [102 as u8,97 as u8,108 as u8,115 as u8,101 as u8]
    if parser_token_equals(source, source_length, token, slice(true_bytes)) { unsafe { *out = true } return true }
    if parser_token_equals(source, source_length, token, slice(false_bytes)) { unsafe { *out = false } return true }
    return false
}

export function parser_copy_token(source: *u8, source_length: usize, token: *LexToken, out: []u8): usize {
    if source == null || token == null || !parser_token_span_valid(source_length, token) { return 0 as usize }
    let count: usize = 0 as usize
    let start: usize = 0 as usize
    unsafe { count = token.length start = token.start }
    if len(out) < count { count = len(out) }
    let i: usize = 0 as usize
    while i < count {
        unsafe { out[i] = source[start + i] }
        i = i + 1 as usize
    }
    return count
}

// Compatibility helpers retained from the original placeholder.
export function parser_is_ascii_space(c: u8): bool { return lexer_is_ascii_space(c) }
export function parser_is_ascii_digit(c: u8): bool { return lexer_is_ascii_digit(c) }
export function parser_is_ascii_alpha(c: u8): bool { return lexer_is_ascii_alpha(c) }
export function parser_trim_left_count(value: []u8): usize { return lexer_trim_left_count(value) }
