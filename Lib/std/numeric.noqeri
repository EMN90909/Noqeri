module noqeri.std.numeric

// Pure, allocation-free vector helpers for every Noqeri application.
// No AI-specific syntax and no hidden native or network dependency.
export function vector_sum(values: []float): float {
    let total: float = 0.0
    let i: usize = 0 as usize
    while i < len(values) {
        total = total + values[i]
        i = i + 1 as usize
    }
    return total
}

export function vector_dot(left: []float, right: []float): float {
    if len(left) != len(right) { return 0.0 }
    let total: float = 0.0
    let i: usize = 0 as usize
    while i < len(left) {
        total = total + left[i] * right[i]
        i = i + 1 as usize
    }
    return total
}

export function vector_max_index(values: []float): usize {
    let best: usize = 0 as usize
    let i: usize = 1 as usize
    while i < len(values) {
        if values[i] > values[best] { best = i }
        i = i + 1 as usize
    }
    return best
}

export function vector_squared_error(left: []float, right: []float): float {
    if len(left) != len(right) { return 0.0 }
    let total: float = 0.0
    let i: usize = 0 as usize
    while i < len(left) {
        let delta: float = left[i] - right[i]
        total = total + delta * delta
        i = i + 1 as usize
    }
    return total
}
