module noqeri.std.sql

export function sql_is_ascii_space(c: u8): bool { return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8 }
export function sql_is_ascii_digit(c: u8): bool { return c >= 48 as u8 && c <= 57 as u8 }
export function sql_is_ascii_alpha(c: u8): bool { return (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8) }
export function sql_identifier_start(c: u8): bool { return sql_is_ascii_alpha(c) || c == 95 as u8 }
export function sql_identifier_continue(c: u8): bool { return sql_identifier_start(c) || sql_is_ascii_digit(c) }
export function sql_identifier_valid(value: []u8): bool { if len(value) == 0 as usize { return false } if !sql_identifier_start(value[0]) { return false } let i: usize = 1 as usize while i < len(value) { if !sql_identifier_continue(value[i]) { return false } i = i + 1 as usize } return true }
export function sql_trim_left_count(value: []u8): usize { let i: usize = 0 as usize while i < len(value) && sql_is_ascii_space(value[i]) { i = i + 1 as usize } return i }
export function sql_trim_right_count(value: []u8): usize { let i: usize = len(value) while i > 0 as usize && sql_is_ascii_space(value[i - 1 as usize]) { i = i - 1 as usize } return len(value) - i }
export function sql_parameter_index_valid(index: usize, count: usize): bool { return index < count }
export function sql_count_placeholders(value: []u8): usize { let count: usize = 0 as usize let quoted: bool = false let i: usize = 0 as usize while i < len(value) { let c: u8 = value[i] if c == 39 as u8 { if quoted && i + 1 as usize < len(value) && value[i + 1 as usize] == 39 as u8 { i = i + 2 as usize } else { quoted = !quoted i = i + 1 as usize } } else { if !quoted && c == 63 as u8 { count = count + 1 as usize } i = i + 1 as usize } } return count }
export function sql_has_unterminated_quote(value: []u8): bool { let quoted: bool = false let i: usize = 0 as usize while i < len(value) { if value[i] == 39 as u8 { if quoted && i + 1 as usize < len(value) && value[i + 1 as usize] == 39 as u8 { i = i + 2 as usize } else { quoted = !quoted i = i + 1 as usize } } else { i = i + 1 as usize } } return quoted }
export function sql_is_line_comment_start(value: []u8, index: usize): bool { return index + 1 as usize < len(value) && value[index] == 45 as u8 && value[index + 1 as usize] == 45 as u8 }
export function sql_is_block_comment_start(value: []u8, index: usize): bool { return index + 1 as usize < len(value) && value[index] == 47 as u8 && value[index + 1 as usize] == 42 as u8 }
export function sql_keyword_equal_ascii(value: []u8, keyword: []u8): bool { if len(value) != len(keyword) { return false } let i: usize = 0 as usize while i < len(value) { let a: u8 = value[i] let b: u8 = keyword[i] if a >= 97 as u8 && a <= 122 as u8 { a = a - 32 as u8 } if b >= 97 as u8 && b <= 122 as u8 { b = b - 32 as u8 } if a != b { return false } i = i + 1 as usize } return true }
