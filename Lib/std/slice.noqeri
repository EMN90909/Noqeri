module noqeri.std.slice

export function slice_len<T>(items: []T): usize { return len(items) }
export function slice_is_empty<T>(items: []T): bool { return len(items) == 0 as usize }

// Compatibility helpers. New code should prefer the checked/fallback forms.
export function slice_first<T>(items: []T): T { return items[0] }
export function slice_last<T>(items: []T): T { return items[len(items)-1] }

export function slice_index_valid<T>(items: []T, index: usize): bool { return index < len(items) }
export function slice_get_or<T>(items: []T, index: usize, fallback: T): T { if index >= len(items) { return fallback } return items[index] }
export function slice_first_or<T>(items: []T, fallback: T): T { if len(items) == 0 as usize { return fallback } return items[0] }
export function slice_last_or<T>(items: []T, fallback: T): T { if len(items) == 0 as usize { return fallback } return items[len(items) - 1 as usize] }
export function slice_set_checked<T>(items: []T, index: usize, value: T): bool { if index >= len(items) { return false } items[index] = value return true }

export function slice_subrange_valid<T>(items: []T, offset: usize, count: usize): bool {
    if offset > len(items) { return false }
    return count <= len(items) - offset
}

export function slice_contains<T: Eq>(items: []T, value: T): bool {
    let index: usize = 0 as usize
    while index < len(items) { if items[index] == value { return true } index = index + 1 as usize }
    return false
}

export function slice_equal<T: Eq>(left: []T, right: []T): bool {
    if len(left) != len(right) { return false }
    let index: usize = 0 as usize
    while index < len(left) { if left[index] != right[index] { return false } index = index + 1 as usize }
    return true
}

export function slice_copy<T>(source: []T, destination: []T): usize {
    let count: usize = len(source)
    if len(destination) < count { count = len(destination) }
    let index: usize = 0 as usize
    while index < count { destination[index] = source[index] index = index + 1 as usize }
    return count
}
