module noqeri.std.random

// Deterministic standard-library PRNG helpers. Cryptographic randomness belongs
// in std/crypto and must come from an OS-backed entropy source.
record Random {
    state: u64
}

export function nqRandomSeed(seed: i64): i64 {
    let normalized: i64 = seed % (2147483647 as i64)
    if normalized <= 0 { return 1 as i64 }
    return normalized
}

export function nqRandomNext(seed: i64): i64 {
    let normalized: i64 = nqRandomSeed(seed)
    return (normalized * (48271 as i64)) % (2147483647 as i64)
}

export function nqRandomRange(seed: i64, low: i64, highExclusive: i64): i64 {
    if highExclusive <= low { return low }
    let span: i64 = highExclusive - low
    return low + (nqRandomNext(seed) % span)
}

export function random_seed(state: *Random, seed: u64): void {
    if seed == 0 as u64 { state.state = 1442695040888963407 as u64 return }
    state.state = seed
}

// 64-bit LCG with a full-period odd increment. This is deterministic and fast,
// but deliberately not advertised as cryptographically secure.
export function random_next(state: u64): u64 { return state * 6364136223846793005 as u64 + 1442695040888963407 as u64 }

export function random_next_u64(state: *Random): u64 {
    state.state = random_next(state.state)
    return state.state
}

export function random_next_u32(state: *Random): u32 { return (random_next_u64(state) % 4294967296 as u64) as u32 }
export function random_bool_state(state: *Random): bool { return (random_next_u64(state) % 2 as u64) == 1 as u64 }
export function random_percent_state(state: *Random): u32 { return (random_next_u64(state) % 100 as u64) as u32 }
export function random_per_mille_state(state: *Random): u32 { return (random_next_u64(state) % 1000 as u64) as u32 }

export function random_range_u64(state: *Random, low: u64, highExclusive: u64): u64 {
    if highExclusive <= low { return low }
    let width: u64 = highExclusive - low
    return low + random_next_u64(state) % width
}

export function random_range_i64(state: *Random, low: i64, highExclusive: i64): i64 {
    if highExclusive <= low { return low }
    let width: u64 = (highExclusive - low) as u64
    return low + (random_next_u64(state) % width) as i64
}

export function random_range_inclusive_state(state: *Random, low: u64, high: u64): u64 {
    if high <= low { return low }
    let width: u64 = high - low
    return low + random_next_u64(state) % (width + 1 as u64)
}

export function random_choose_index(state: *Random, count: usize): usize {
    if count == 0 as usize { return 0 as usize }
    return (random_next_u64(state) % count as u64) as usize
}

export function random_chance_per_mille(state: *Random, probability: u32): bool {
    if probability == 0 as u32 { return false }
    if probability >= 1000 as u32 { return true }
    return random_per_mille_state(state) < probability
}

export function random_fill_u64(state: *Random, values: *u64, count: usize): bool {
    if count > 0 as usize && values == null { return false }
    let i: usize = 0 as usize
    while i < count { values[i] = random_next_u64(state) i = i + 1 as usize }
    return true
}

export function random_shuffle<T: Copy>(state: *Random, values: *T, count: usize): bool {
    if count > 0 as usize && values == null { return false }
    if count < 2 as usize { return true }
    let i: usize = count - 1 as usize
    while i > 0 as usize {
        let j: usize = random_choose_index(state, i + 1 as usize)
        let temp: T = values[i]
        values[i] = values[j]
        values[j] = temp
        i = i - 1 as usize
    }
    return true
}

// Stateless compatibility helpers.
export function random_range(state: u64, low: u64, high: u64): u64 { if high <= low { return low } return low + (random_next(state) % (high-low)) }
export function random_bool(state: u64): bool { return (random_next(state) % 2 as u64) == 1 as u64 }
export function random_percent(state: u64): u64 { return random_next(state) % 100 as u64 }
export function random_unit_per_mille(state: u64): u64 { return random_next(state) % 1000 as u64 }
export function random_range_inclusive(state: u64, low: u64, high: u64): u64 { if high <= low { return low } return low + (random_next(state) % (high-low+1 as u64)) }
