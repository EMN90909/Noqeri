module noqeri.std.file

extern function fileOpen(path: string, flags: u32): isize
extern function fileClose(handle: usize): isize
extern function fileRead(handle: usize, data: *u8, count: usize): isize
extern function fileWrite(handle: usize, data: *u8, count: usize): isize
extern function fileSeek(handle: usize, offset: i64, origin: int): isize
extern function fileFlush(handle: usize): isize
extern function fileTruncate(handle: usize, length: u64): isize

export function file_flag_read(): u32 { return 1 as u32 }
export function file_flag_write(): u32 { return 2 as u32 }
export function file_flag_create(): u32 { return 4 as u32 }
export function file_flag_truncate(): u32 { return 8 as u32 }
export function file_flag_append(): u32 { return 16 as u32 }
export function file_seek_start(): int { return 0 }
export function file_seek_current(): int { return 1 }
export function file_seek_end(): int { return 2 }

export function file_open_read(path: string): isize { return fileOpen(path, file_flag_read()) }
export function file_open_write(path: string): isize { return fileOpen(path, file_flag_write()) }
export function file_open_create(path: string): isize { return fileOpen(path, file_flag_write() + file_flag_create()) }
export function file_open_replace(path: string): isize { return fileOpen(path, file_flag_write() + file_flag_create() + file_flag_truncate()) }
export function file_open_append(path: string): isize { return fileOpen(path, file_flag_write() + file_flag_create() + file_flag_append()) }
export function file_close(handle: usize): isize { return fileClose(handle) }
export function file_flush(handle: usize): isize { return fileFlush(handle) }
export function file_truncate(handle: usize, length: u64): isize { return fileTruncate(handle, length) }
export function file_handle_valid(handle: isize): bool { return handle >= 0 as isize }

export function file_read_into(handle: usize, buffer: []u8): isize {
    if len(buffer) == 0 as usize { return 0 as isize }
    return fileRead(handle, &buffer[0 as usize], len(buffer))
}

export function file_write_from(handle: usize, buffer: []u8): isize {
    if len(buffer) == 0 as usize { return 0 as isize }
    return fileWrite(handle, &buffer[0 as usize], len(buffer))
}

export function file_read_exact(handle: usize, buffer: []u8): isize {
    let offset: usize = 0 as usize
    while offset < len(buffer) {
        let status: isize = fileRead(handle, &buffer[offset], len(buffer) - offset)
        if status < 0 as isize { return status }
        if status == 0 as isize { return -2 as isize }
        offset = offset + status as usize
    }
    return offset as isize
}

export function file_write_all(handle: usize, buffer: []u8): isize {
    let offset: usize = 0 as usize
    while offset < len(buffer) {
        let status: isize = fileWrite(handle, &buffer[offset], len(buffer) - offset)
        if status < 0 as isize { return status }
        if status == 0 as isize { return -3 as isize }
        offset = offset + status as usize
    }
    return offset as isize
}

export function file_seek(handle: usize, offset: i64, origin: int): isize {
    if origin < file_seek_start() || origin > file_seek_end() { return -4 as isize }
    return fileSeek(handle, offset, origin)
}

export function file_rewind(handle: usize): isize { return fileSeek(handle, 0 as i64, file_seek_start()) }
export function file_position(handle: usize): isize { return fileSeek(handle, 0 as i64, file_seek_current()) }
export function file_size(handle: usize): isize {
    let current: isize = file_position(handle)
    if current < 0 as isize { return current }
    let end: isize = fileSeek(handle, 0 as i64, file_seek_end())
    if end < 0 as isize { return end }
    let restored: isize = fileSeek(handle, current as i64, file_seek_start())
    if restored < 0 as isize { return restored }
    return end
}

export function file_status_ok(status: isize): bool { return status >= 0 as isize }
export function file_status_error(status: isize): bool { return status < 0 as isize }

// Convenience API with explicit caller-owned capacity and status returns.
// It is not an allocation-returning string API: decoding UTF-8 and typed
// Result<T> propagation remain explicit higher-level steps.
//
// Returns the number of bytes read, or a negative status. A file that exceeds
// the destination capacity is rejected (-5) rather than silently truncated.
export function readText(path: string, destination: []u8): isize {
    let opened: isize = file_open_read(path)
    if opened < 0 as isize { return opened }
    let used: usize = 0 as usize
    let failure: isize = 0 as isize
    while used < len(destination) && failure == 0 as isize {
        let step: isize = fileRead(opened as usize, &destination[used], len(destination) - used)
        if step < 0 as isize { failure = step }
        else if step == 0 as isize { break }
        else { used = used + step as usize }
    }
    // On an exactly-full buffer, distinguish EOF from truncated input.
    if failure == 0 as isize && used == len(destination) {
        let extra: [u8; 1]
        let step: isize = fileRead(opened as usize, &extra[0], 1 as usize)
        if step > 0 as isize { failure = -5 as isize }
        else if step < 0 as isize { failure = step }
    }
    let closed: isize = file_close(opened as usize)
    if failure < 0 as isize { return failure }
    if closed < 0 as isize { return closed }
    return used as isize
}

// Writes only the bytes supplied; no hidden encoding or newline conversion.
// Returns byte count or negative status, always attempts close. Do not use as
// a transactional replace; an interrupted write can leave a partial file.
export function writeText(path: string, contents: []u8): isize {
    let opened: isize = file_open_replace(path)
    if opened < 0 as isize { return opened }
    let written: isize = file_write_all(opened as usize, contents)
    let flushed: isize = 0 as isize
    if written >= 0 as isize { flushed = file_flush(opened as usize) }
    let closed: isize = file_close(opened as usize)
    if written < 0 as isize { return written }
    if flushed < 0 as isize { return flushed }
    if closed < 0 as isize { return closed }
    return written
}
