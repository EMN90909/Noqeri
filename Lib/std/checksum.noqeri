module noqeri.std.checksum

record ChecksumState { kind:int value:u64 auxiliary:u64 length:usize }
record FletcherState { sum1:u64 sum2:u64 modulus:u64 length:usize }
record InternetChecksumState { sum:u64 oddByte:u8 hasOdd:bool length:usize }
record ChecksumFrame { payloadLength:usize checksum:u64 kind:int }

export function checksum_kind_sum8():int{return 1}
export function checksum_kind_sum16():int{return 2}
export function checksum_kind_sum32():int{return 3}
export function checksum_kind_adler32():int{return 4}
export function checksum_kind_fletcher16():int{return 5}
export function checksum_kind_fletcher32():int{return 6}
export function checksum_kind_internet16():int{return 7}
export function checksum_kind_weighted32():int{return 8}
export function checksum_kind_valid(kind:int):bool{return kind>=checksum_kind_sum8()&&kind<=checksum_kind_weighted32()}
export function checksum_width(kind:int):usize{if kind==checksum_kind_sum8(){return 1 as usize} if kind==checksum_kind_sum16()||kind==checksum_kind_fletcher16()||kind==checksum_kind_internet16(){return 2 as usize} if kind==checksum_kind_sum32()||kind==checksum_kind_adler32()||kind==checksum_kind_fletcher32()||kind==checksum_kind_weighted32(){return 4 as usize} return 0 as usize}

export function checksum_sum8(data:[]u8):u8{let sum:u64=0 as u64 let index:usize=0 as usize while index<len(data){sum=(sum+data[index] as u64)%256 as u64 index=index+1 as usize} return sum as u8}
export function checksum_sum16(data:[]u8):u16{let sum:u64=0 as u64 let index:usize=0 as usize while index<len(data){sum=(sum+data[index] as u64)%65536 as u64 index=index+1 as usize} return sum as u16}
export function checksum_sum32(data:[]u8):u32{let sum:u64=0 as u64 let index:usize=0 as usize while index<len(data){sum=(sum+data[index] as u64)%4294967296 as u64 index=index+1 as usize} return sum as u32}
export function checksum_weighted32(data:[]u8):u32{let sum:u64=0 as u64 let index:usize=0 as usize while index<len(data){let weight:u64=(index as u64+1 as u64)%4294967296 as u64 sum=(sum+data[index] as u64*weight)%4294967296 as u64 index=index+1 as usize} return sum as u32}
export function checksum_adler32(data:[]u8):u32{let a:u32=1 as u32 let b:u32=0 as u32 let index:usize=0 as usize while index<len(data){a=(a+data[index] as u32)%65521 as u32 b=(b+a)%65521 as u32 index=index+1 as usize} return b*65536 as u32+a}
export function checksum_fletcher16(data:[]u8):u16{let sum1:u32=0 as u32 let sum2:u32=0 as u32 let index:usize=0 as usize while index<len(data){sum1=(sum1+data[index] as u32)%255 as u32 sum2=(sum2+sum1)%255 as u32 index=index+1 as usize} return(sum2*256 as u32+sum1)as u16}
export function checksum_fletcher32_words(words:[]u16):u32{let sum1:u64=0 as u64 let sum2:u64=0 as u64 let index:usize=0 as usize while index<len(words){sum1=(sum1+words[index] as u64)%65535 as u64 sum2=(sum2+sum1)%65535 as u64 index=index+1 as usize} return(sum2*65536 as u64+sum1)as u32}
export function checksum_fletcher32(data:[]u8):u32{let sum1:u64=0 as u64 let sum2:u64=0 as u64 let index:usize=0 as usize while index<len(data){let word:u64=data[index] as u64*256 as u64 if index+1 as usize<len(data){word=word+data[index+1 as usize] as u64} sum1=(sum1+word)%65535 as u64 sum2=(sum2+sum1)%65535 as u64 index=index+2 as usize} return(sum2*65536 as u64+sum1)as u32}
function checksum_fold16(sum:u64):u64{let value:u64=sum while value>65535 as u64{value=value%65536 as u64+value/65536 as u64} return value}
export function checksum_internet16(data:[]u8):u16{let sum:u64=0 as u64 let index:usize=0 as usize while index<len(data){let word:u64=data[index] as u64*256 as u64 if index+1 as usize<len(data){word=word+data[index+1 as usize] as u64} sum=checksum_fold16(sum+word) index=index+2 as usize} return(65535 as u64-sum)as u16}
export function checksum_internet16_verify(data:[]u8,expected:u16):bool{return checksum_internet16(data)==expected}

export function fletcher_state_init(out:*FletcherState,modulus:u64):bool{if out==null||modulus<2 as u64{return false} out.sum1=0 as u64 out.sum2=0 as u64 out.modulus=modulus out.length=0 as usize return true}
export function fletcher_state_update(out:*FletcherState,data:[]u8):bool{if out==null||out.modulus<2 as u64{return false} let index:usize=0 as usize while index<len(data){out.sum1=(out.sum1+data[index] as u64)%out.modulus out.sum2=(out.sum2+out.sum1)%out.modulus if out.length==18446744073709551615 as usize{return false} out.length=out.length+1 as usize index=index+1 as usize} return true}
export function fletcher_state_value16(out:*FletcherState):u16{if out==null||out.modulus!=255 as u64{return 0 as u16} return(out.sum2*256 as u64+out.sum1)as u16}
export function fletcher_state_reset(out:*FletcherState):bool{if out==null||out.modulus<2 as u64{return false} out.sum1=0 as u64 out.sum2=0 as u64 out.length=0 as usize return true}

export function internet_checksum_init(out:*InternetChecksumState):bool{if out==null{return false} out.sum=0 as u64 out.oddByte=0 as u8 out.hasOdd=false out.length=0 as usize return true}
export function internet_checksum_update(out:*InternetChecksumState,data:[]u8):bool{if out==null{return false} let index:usize=0 as usize if out.hasOdd&&len(data)>0 as usize{out.sum=checksum_fold16(out.sum+out.oddByte as u64*256 as u64+data[0] as u64) out.hasOdd=false index=1 as usize} while index+1 as usize<len(data){out.sum=checksum_fold16(out.sum+data[index] as u64*256 as u64+data[index+1 as usize] as u64) index=index+2 as usize} if index<len(data){out.oddByte=data[index] out.hasOdd=true} if len(data)>18446744073709551615 as usize-out.length{return false} out.length=out.length+len(data) return true}
export function internet_checksum_value(out:*InternetChecksumState):u16{if out==null{return 0 as u16} let sum:u64=out.sum if out.hasOdd{sum=checksum_fold16(sum+out.oddByte as u64*256 as u64)} return(65535 as u64-checksum_fold16(sum))as u16}
export function internet_checksum_reset(out:*InternetChecksumState):bool{return internet_checksum_init(out)}

export function checksum_state_init(out:*ChecksumState,kind:int):bool{if out==null||!checksum_kind_valid(kind){return false} out.kind=kind out.value=0 as u64 out.auxiliary=0 as u64 out.length=0 as usize if kind==checksum_kind_adler32(){out.value=1 as u64} return true}
export function checksum_state_reset(out:*ChecksumState):bool{if out==null{return false} return checksum_state_init(out,out.kind)}
export function checksum_state_update(out:*ChecksumState,data:[]u8):bool{if out==null||!checksum_kind_valid(out.kind){return false} if len(data)>18446744073709551615 as usize-out.length{return false} let index:usize=0 as usize while index<len(data){let byte:u64=data[index] as u64 if out.kind==checksum_kind_sum8(){out.value=(out.value+byte)%256 as u64}else if out.kind==checksum_kind_sum16(){out.value=(out.value+byte)%65536 as u64}else if out.kind==checksum_kind_sum32(){out.value=(out.value+byte)%4294967296 as u64}else if out.kind==checksum_kind_adler32(){let a:u64=out.value%65536 as u64 let b:u64=out.value/65536 as u64 a=(a+byte)%65521 as u64 b=(b+a)%65521 as u64 out.value=b*65536 as u64+a}else if out.kind==checksum_kind_fletcher16(){out.value=(out.value+byte)%255 as u64 out.auxiliary=(out.auxiliary+out.value)%255 as u64}else if out.kind==checksum_kind_weighted32(){let position:u64=out.length as u64+index as u64+1 as u64 out.value=(out.value+byte*(position%4294967296 as u64))%4294967296 as u64} index=index+1 as usize} out.length=out.length+len(data) return true}
export function checksum_state_value(out:*ChecksumState):u64{if out==null{return 0 as u64} if out.kind==checksum_kind_fletcher16(){return out.auxiliary*256 as u64+out.value} return out.value}
export function checksum_state_length(out:*ChecksumState):usize{if out==null{return 0 as usize} return out.length}
export function checksum_compute(kind:int,data:[]u8):u64{if kind==checksum_kind_internet16(){return checksum_internet16(data) as u64} if kind==checksum_kind_fletcher32(){return checksum_fletcher32(data) as u64} let state:ChecksumState if !checksum_state_init(&state,kind){return 0 as u64} if !checksum_state_update(&state,data){return 0 as u64} return checksum_state_value(&state)}
export function checksum_verify(kind:int,data:[]u8,expected:u64):bool{return checksum_compute(kind,data)==expected}
export function checksum_frame(kind:int,data:[]u8):ChecksumFrame{let out:ChecksumFrame out.kind=kind out.payloadLength=len(data) out.checksum=checksum_compute(kind,data) return out}
export function checksum_frame_valid(frame:ChecksumFrame):bool{return checksum_kind_valid(frame.kind)}
export function checksum_frame_verify(frame:ChecksumFrame,data:[]u8):bool{return checksum_frame_valid(frame)&&frame.payloadLength==len(data)&&checksum_verify(frame.kind,data,frame.checksum)}

export function checksum_write_be16(value:u16,output:[]u8,offset:usize):bool{if offset>len(output)||len(output)-offset<2 as usize{return false} output[offset]=(value as u64/256 as u64%256 as u64)as u8 output[offset+1 as usize]=(value as u64%256 as u64)as u8 return true}
export function checksum_read_be16(input:[]u8,offset:usize,out:*u16):bool{if out==null||offset>len(input)||len(input)-offset<2 as usize{return false} out[0]=(input[offset] as u64*256 as u64+input[offset+1 as usize] as u64)as u16 return true}
export function checksum_write_be32(value:u32,output:[]u8,offset:usize):bool{if offset>len(output)||len(output)-offset<4 as usize{return false} let v:u64=value as u64 output[offset]=(v/16777216 as u64%256 as u64)as u8 output[offset+1 as usize]=(v/65536 as u64%256 as u64)as u8 output[offset+2 as usize]=(v/256 as u64%256 as u64)as u8 output[offset+3 as usize]=(v%256 as u64)as u8 return true}
export function checksum_read_be32(input:[]u8,offset:usize,out:*u32):bool{if out==null||offset>len(input)||len(input)-offset<4 as usize{return false} out[0]=(input[offset] as u64*16777216 as u64+input[offset+1 as usize] as u64*65536 as u64+input[offset+2 as usize] as u64*256 as u64+input[offset+3 as usize] as u64)as u32 return true}
export function checksum_write_le16(value:u16,output:[]u8,offset:usize):bool{if offset>len(output)||len(output)-offset<2 as usize{return false} output[offset]=(value as u64%256 as u64)as u8 output[offset+1 as usize]=(value as u64/256 as u64%256 as u64)as u8 return true}
export function checksum_read_le16(input:[]u8,offset:usize,out:*u16):bool{if out==null||offset>len(input)||len(input)-offset<2 as usize{return false} out[0]=(input[offset] as u64+input[offset+1 as usize] as u64*256 as u64)as u16 return true}
export function checksum_write_le32(value:u32,output:[]u8,offset:usize):bool{if offset>len(output)||len(output)-offset<4 as usize{return false} let v:u64=value as u64 output[offset]=(v%256 as u64)as u8 output[offset+1 as usize]=(v/256 as u64%256 as u64)as u8 output[offset+2 as usize]=(v/65536 as u64%256 as u64)as u8 output[offset+3 as usize]=(v/16777216 as u64%256 as u64)as u8 return true}
export function checksum_read_le32(input:[]u8,offset:usize,out:*u32):bool{if out==null||offset>len(input)||len(input)-offset<4 as usize{return false} out[0]=(input[offset] as u64+input[offset+1 as usize] as u64*256 as u64+input[offset+2 as usize] as u64*65536 as u64+input[offset+3 as usize] as u64*16777216 as u64)as u32 return true}
export function checksum_write_be64(value:u64,output:[]u8,offset:usize):bool{if offset>len(output)||len(output)-offset<8 as usize{return false} let i:usize=0 as usize while i<8 as usize{let shiftBytes:usize=7 as usize-i let divisor:u64=1 as u64 let j:usize=0 as usize while j<shiftBytes{divisor=divisor*256 as u64 j=j+1 as usize} output[offset+i]=(value/divisor%256 as u64)as u8 i=i+1 as usize} return true}
export function checksum_read_be64(input:[]u8,offset:usize,out:*u64):bool{if out==null||offset>len(input)||len(input)-offset<8 as usize{return false} let value:u64=0 as u64 let i:usize=0 as usize while i<8 as usize{value=value*256 as u64+input[offset+i] as u64 i=i+1 as usize} out[0]=value return true}

export function checksum_byte_sum(data:[]u8):u64{let total:u64=0 as u64 let index:usize=0 as usize while index<len(data){total=total+data[index] as u64 index=index+1 as usize} return total}
export function checksum_valid_range(data:[]u8,offset:usize,count:usize):bool{return offset<=len(data)&&count<=len(data)-offset}
export function checksum_compute_range(kind:int,data:[]u8,offset:usize,count:usize):u64{if !checksum_valid_range(data,offset,count){return 0 as u64} let state:ChecksumState if !checksum_state_init(&state,kind){return 0 as u64} let index:usize=0 as usize while index<count{let one:[u8;1]=[data[offset+index]] if !checksum_state_update(&state,slice(one)){return 0 as u64} index=index+1 as usize} return checksum_state_value(&state)}
export function checksum_sum8_verify(data:[]u8,expected:u8):bool{return checksum_sum8(data)==expected}
export function checksum_sum16_verify(data:[]u8,expected:u16):bool{return checksum_sum16(data)==expected}
export function checksum_sum32_verify(data:[]u8,expected:u32):bool{return checksum_sum32(data)==expected}
export function checksum_adler32_verify(data:[]u8,expected:u32):bool{return checksum_adler32(data)==expected}
export function checksum_fletcher16_verify(data:[]u8,expected:u16):bool{return checksum_fletcher16(data)==expected}
export function checksum_fletcher32_verify(data:[]u8,expected:u32):bool{return checksum_fletcher32(data)==expected}
export function checksum_weighted32_verify(data:[]u8,expected:u32):bool{return checksum_weighted32(data)==expected}
export function checksum_append_be16(kind:int,data:[]u8,output:[]u8):isize{if len(output)<len(data)+2 as usize{return-1 as isize} let index:usize=0 as usize while index<len(data){output[index]=data[index] index=index+1 as usize} let value:u16=checksum_compute(kind,data) as u16 if !checksum_write_be16(value,output,len(data)){return-1 as isize} return(len(data)+2 as usize)as isize}
export function checksum_verify_appended_be16(kind:int,framed:[]u8):bool{if len(framed)<2 as usize{return false} let payloadLength:usize=len(framed)-2 as usize let expected:u16=0 as u16 if !checksum_read_be16(framed,payloadLength,&expected){return false} let state:ChecksumState if !checksum_state_init(&state,kind){return false} let index:usize=0 as usize while index<payloadLength{let one:[u8;1]=[framed[index]] if !checksum_state_update(&state,slice(one)){return false} index=index+1 as usize} return checksum_state_value(&state) as u16==expected}

export function checksum_modulo(data:[]u8,modulus:u64):u64{if modulus==0 as u64{return 0 as u64} let total:u64=0 as u64 let index:usize=0 as usize while index<len(data){total=(total+data[index] as u64)%modulus index=index+1 as usize} return total}
export function checksum_weighted_modulo(data:[]u8,modulus:u64):u64{if modulus==0 as u64{return 0 as u64} let total:u64=0 as u64 let index:usize=0 as usize while index<len(data){let weight:u64=(index as u64+1 as u64)%modulus total=(total+(data[index] as u64*weight)%modulus)%modulus index=index+1 as usize} return total}
export function checksum_alternating_modulo(data:[]u8,modulus:u64):u64{if modulus==0 as u64{return 0 as u64} let even:u64=0 as u64 let odd:u64=0 as u64 let index:usize=0 as usize while index<len(data){if index%2 as usize==0 as usize{even=(even+data[index] as u64)%modulus}else{odd=(odd+data[index] as u64)%modulus} index=index+1 as usize} return(even*257 as u64+odd)%modulus}
export function checksum_position_mix32(data:[]u8,seed:u32):u32{let value:u64=seed as u64 let index:usize=0 as usize while index<len(data){let position:u64=index as u64+1 as u64 value=(value*257 as u64+data[index] as u64*position)%4294967296 as u64 index=index+1 as usize} return value as u32}
export function checksum_position_mix64(data:[]u8,seed:u64):u64{let value:u64=seed let index:usize=0 as usize while index<len(data){value=(value%18446744073709551557 as u64*257 as u64+data[index] as u64+(index as u64%65521 as u64))%18446744073709551557 as u64 index=index+1 as usize} return value}
export function checksum_prefix_sum8(data:[]u8,output:[]u8):usize{let count:usize=len(data) if len(output)<count{count=len(output)} let sum:u64=0 as u64 let index:usize=0 as usize while index<count{sum=(sum+data[index] as u64)%256 as u64 output[index]=sum as u8 index=index+1 as usize} return count}
export function checksum_prefix_sum16(data:[]u8,output:[]u16):usize{let count:usize=len(data) if len(output)<count{count=len(output)} let sum:u64=0 as u64 let index:usize=0 as usize while index<count{sum=(sum+data[index] as u64)%65536 as u64 output[index]=sum as u16 index=index+1 as usize} return count}
export function checksum_prefix_sum32(data:[]u8,output:[]u32):usize{let count:usize=len(data) if len(output)<count{count=len(output)} let sum:u64=0 as u64 let index:usize=0 as usize while index<count{sum=(sum+data[index] as u64)%4294967296 as u64 output[index]=sum as u32 index=index+1 as usize} return count}
export function checksum_blocks(kind:int,data:[]u8,blockSize:usize,output:[]u64):usize{if blockSize==0 as usize{return 0 as usize} let blocks:usize=(len(data)+blockSize-1 as usize)/blockSize let count:usize=blocks if len(output)<count{count=len(output)} let block:usize=0 as usize while block<count{let start:usize=block*blockSize let remaining:usize=len(data)-start let take:usize=blockSize if remaining<take{take=remaining} output[block]=checksum_compute_range(kind,data,start,take) block=block+1 as usize} return count}
export function checksum_first_mismatching_block(kind:int,data:[]u8,blockSize:usize,expected:[]u64):isize{if blockSize==0 as usize{return-1 as isize} let block:usize=0 as usize while block<len(expected){let start:usize=block*blockSize if start>=len(data){return block as isize} let remaining:usize=len(data)-start let take:usize=blockSize if remaining<take{take=remaining} if checksum_compute_range(kind,data,start,take)!=expected[block]{return block as isize} block=block+1 as usize} let covered:usize=len(expected)*blockSize if covered<len(data){return len(expected) as isize} return-1 as isize}

export function checksum_decimal_digits_mod10(digits:[]u8):u8{let sum:u64=0 as u64 let index:usize=0 as usize while index<len(digits){if digits[index]>9 as u8{return 255 as u8} sum=sum+digits[index] as u64 index=index+1 as usize} return(sum%10 as u64)as u8}
export function checksum_luhn_digit(digits:[]u8):u8{let sum:u64=0 as u64 let parity:usize=len(digits)%2 as usize let index:usize=0 as usize while index<len(digits){if digits[index]>9 as u8{return 255 as u8} let value:u64=digits[index] as u64 if index%2 as usize==parity{value=value*2 as u64 if value>9 as u64{value=value-9 as u64}} sum=sum+value index=index+1 as usize} return((10 as u64-sum%10 as u64)%10 as u64)as u8}
export function checksum_luhn_validate(digitsWithCheck:[]u8):bool{if len(digitsWithCheck)<2 as usize{return false} let sum:u64=0 as u64 let parity:usize=len(digitsWithCheck)%2 as usize let index:usize=0 as usize while index<len(digitsWithCheck){if digitsWithCheck[index]>9 as u8{return false} let value:u64=digitsWithCheck[index] as u64 if index%2 as usize==parity{value=value*2 as u64 if value>9 as u64{value=value-9 as u64}} sum=sum+value index=index+1 as usize} return sum%10 as u64==0 as u64}
export function checksum_frame_serialized_length(kind:int):usize{let width:usize=checksum_width(kind) if width==0 as usize{return 0 as usize} return 9 as usize+width}
export function checksum_kind_name_code(kind:int):u32{if kind==checksum_kind_sum8(){return 1 as u32} if kind==checksum_kind_sum16(){return 2 as u32} if kind==checksum_kind_sum32(){return 3 as u32} if kind==checksum_kind_adler32(){return 4 as u32} if kind==checksum_kind_fletcher16(){return 5 as u32} if kind==checksum_kind_fletcher32(){return 6 as u32} if kind==checksum_kind_internet16(){return 7 as u32} if kind==checksum_kind_weighted32(){return 8 as u32} return 0 as u32}

export function checksum_chunk_count(length:usize,chunkSize:usize):usize{if chunkSize==0 as usize{return 0 as usize} return(length+chunkSize-1 as usize)/chunkSize}
export function checksum_chunk_start(chunk:usize,chunkSize:usize):usize{if chunkSize!=0 as usize&&chunk>18446744073709551615 as usize/chunkSize{return 18446744073709551615 as usize} return chunk*chunkSize}
export function checksum_chunk_length(length:usize,chunk:usize,chunkSize:usize):usize{if chunkSize==0 as usize{return 0 as usize} let start:usize=checksum_chunk_start(chunk,chunkSize) if start>=length{return 0 as usize} let remaining:usize=length-start if remaining<chunkSize{return remaining} return chunkSize}
export function checksum_can_serialize(kind:int,output:[]u8):bool{return checksum_width(kind)>0 as usize&&len(output)>=checksum_width(kind)}
export function checksum_is_16_bit(kind:int):bool{return checksum_width(kind)==2 as usize}
export function checksum_is_32_bit(kind:int):bool{return checksum_width(kind)==4 as usize}
export function checksum_streamable(kind:int):bool{return kind!=checksum_kind_fletcher32()&&kind!=checksum_kind_internet16()}
export function checksum_reference_empty(kind:int):u64{if kind==checksum_kind_adler32(){return 1 as u64} if kind==checksum_kind_internet16(){return 65535 as u64} return 0 as u64}
export function checksum_empty_matches(kind:int):bool{let empty:[u8;0]=[] return checksum_compute(kind,slice(empty))==checksum_reference_empty(kind)}

export function nqAdler32(value:[]u8):u32{return checksum_adler32(value)}
export function nqByteSum(value:[]u8):u64{return checksum_byte_sum(value)}
export function nqWeightedByteSum(value:[]u8):u64{return checksum_weighted32(value) as u64}
