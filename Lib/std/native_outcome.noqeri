export function native_ai_sgd(request: *AiSgdRequest, out: *Outcome<isize>): void {
    if out == null { return }
    let status: isize = ai_native_sgd(request)
    if status < 0 as isize { outcome_init_error(out,-1 as isize,status,"ai","native SGD update failed") }
    else { outcome_init_ok(out,status) }
}
// Typed propagation: copy an existing error to a different Outcome's value
// type without silently losing the original status, domain or message.
export function native_propagate_error<T,U>(source: *Outcome<T>, destination: *Outcome<U>, fallback: U): bool {
    if source == null || destination == null { return false }
    if outcome_is_ok(source) { return false }
    outcome_init_error(destination,fallback,outcome_error_code(source),outcome_error_domain(source),outcome_error_message(source))
    return true
}

// Additional providers share Outcome<T>, including success values that are
// zero, while retaining an explicit close/release obligation where required.
export function native_file_write(handle: usize, bytes: []u8, out: *Outcome<isize>): void {
    if out == null { return }
    let count: isize = file_write_from(handle,bytes)
    if count < 0 as isize { outcome_init_error(out,-1 as isize,count,"file","writing file failed") }
    else { outcome_init_ok(out,count) }
}
export function native_fs_remove(path: string, out: *Outcome<bool>): void {
    if out == null { return }
    let status: isize = fs_remove(path)
    if status < 0 as isize { outcome_init_error(out,false,status,"fs","removing file failed") }
    else { outcome_init_ok(out,true) }
}
export function native_fs_rename(from: string,to: string,out: *Outcome<bool>): void {
    if out == null { return }
    let status: isize = fs_rename(from,to)
    if status < 0 as isize { outcome_init_error(out,false,status,"fs","renaming file failed") }
    else { outcome_init_ok(out,true) }
}
export function native_http_request(method: string,url: string,body: string,contentType: string,timeoutMillis: i64,out: *Outcome<isize>): void {
    if out == null { return }
    let handle: isize = http_client_request(method,url,body,contentType,timeoutMillis)
    if handle < 0 as isize { outcome_init_error(out,-1 as isize,handle,"http","HTTP request failed") }
    else { outcome_init_ok(out,handle) }
}
export function native_database_commit(db: *Database,out: *Outcome<bool>): void {
    if out == null { return }
    if !database_is_open(db) {
        outcome_init_error(out,false,-1 as isize,"noesql","database is not open")
        return
    }
    if !database_commit(db) {
        outcome_init_error(out,false,-2 as isize,"noesql","could not commit native transaction")
        return
    }
    outcome_init_ok(out,true)
}
export function native_database_rollback(db: *Database,out: *Outcome<bool>): void {
    if out == null { return }
    if !database_is_open(db) {
        outcome_init_error(out,false,-1 as isize,"noesql","database is not open")
        return
    }
    if !database_rollback(db) {
        outcome_init_error(out,false,-2 as isize,"noesql","could not roll back native transaction")
        return
    }
    outcome_init_ok(out,true)
}
