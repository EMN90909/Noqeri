module noqeri.std.native_outcome
import "result.noqeri"
import "file.noqeri"
import "fs.noqeri"
import "http/client.noqeri"
import "json.noqeri"
import "noesql.noqeri"
import "../ai/native.noqeri"

// Uniform typed success/error surface over the *existing* native host ABIs.
// Every function initializes the destination on every path. Borrowed native
// handles must still be closed with the corresponding explicit close routine.
// A successful HTTP transport response can still be 4xx/5xx.
export function native_file_open_read(path: string, out: *Outcome<isize>): void {
    if out == null { return }
    let handle: isize = file_open_read(path)
    if handle < 0 as isize { outcome_init_error(out,-1 as isize,handle,"file","opening file failed") }
    else { outcome_init_ok(out,handle) }
}
export function native_file_read(handle: usize, bytes: []u8, out: *Outcome<isize>): void {
    if out == null { return }
    let count: isize = file_read_into(handle, bytes)
    if count < 0 as isize { outcome_init_error(out,-1 as isize,count,"file","reading file failed") }
    else { outcome_init_ok(out,count) }
}
export function native_file_close(handle: usize, out: *Outcome<bool>): void {
    if out == null { return }
    let status: isize = file_close(handle)
    if status < 0 as isize { outcome_init_error(out,false,status,"file","closing file failed") }
    else { outcome_init_ok(out,true) }
}
export function native_fs_mkdir(path: string, out: *Outcome<bool>): void {
    if out == null { return }
    let status: isize = fs_create_directories(path)
    if status < 0 as isize { outcome_init_error(out,false,status,"fs","creating directory failed") }
    else { outcome_init_ok(out,true) }
}
export function native_http_get(url: string, out: *Outcome<isize>): void {
    if out == null { return }
    let handle: isize = http_client_get(url)
    if handle < 0 as isize { outcome_init_error(out,-1 as isize,handle,"http","HTTP request failed") }
    else { outcome_init_ok(out,handle) }
}
export function native_http_response_status(handle: usize, out: *Outcome<int>): void {
    if out == null { return }
    let code: int = http_client_status(handle)
    // A 404 is a valid response; call http_client_response_ok to require 2xx.
    if code < 100 || code > 599 { outcome_init_error(out,0,-1 as isize,"http","HTTP status is invalid") }
    else { outcome_init_ok(out,code) }
}
export function native_json_count(bytes: []u8, out: *Outcome<isize>): void {
    if out == null { return }
    let count: isize = json_token_count(bytes)
    if count < 0 as isize { outcome_init_error(out,-1 as isize,count,"json","malformed JSON token stream") }
    else { outcome_init_ok(out,count) }
}
export function native_database_ready(db: *Database, out: *Outcome<bool>): void {
    if out == null { return }
    if !database_is_open(db) {
        outcome_init_error(out,false,-1 as isize,"noesql","database is not open")
        return
    }
    outcome_init_ok(out,true)
}
export function native_database_begin(db: *Database, out: *Outcome<bool>): void {
    if out == null { return }
    if !database_is_open(db) {
        outcome_init_error(out,false,-1 as isize,"noesql","database is not open")
        return
    }
    if !database_begin(db) {
        outcome_init_error(out,false,-2 as isize,"noesql","could not begin native transaction")
        return
    }
    outcome_init_ok(out,true)
}
