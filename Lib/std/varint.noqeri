module noqeri.std.varint

// Unsigned base-128 varints plus ZigZag signed mapping. Decoders distinguish
// malformed overflow from incomplete input so streaming protocols can ask for
// more bytes without confusing truncation with corruption.
record VarintResult {
    value: u64
    bytes: usize
    ok: bool
    incomplete: bool
    overflow: bool
}

record VarintCursor {
    offset: usize
    ok: bool
}

export function varint_max_u64_bytes(): usize { return 10 as usize }
export function varint_max_u32_bytes(): usize { return 5 as usize }
export function varint_payload_base(): u64 { return 128 as u64 }
export function varint_continuation(): u64 { return 128 as u64 }

export function varint_result_reset(result: *VarintResult): bool {
    if result == null { return false }
    result.value = 0 as u64
    result.bytes = 0 as usize
    result.ok = false
    result.incomplete = false
    result.overflow = false
    return true
}

export function varint_cursor_init(cursor: *VarintCursor, offset: usize): bool {
    if cursor == null { return false }
    cursor.offset = offset
    cursor.ok = true
    return true
}

export function varint_cursor_reset(cursor: *VarintCursor, offset: usize): bool {
    return varint_cursor_init(cursor, offset)
}

export function varint_cursor_offset(cursor: *VarintCursor): usize {
    if cursor == null { return 0 as usize }
    return cursor.offset
}

export function varint_cursor_ok(cursor: *VarintCursor): bool { return cursor != null && cursor.ok }

export function varint_u64_size(value: u64): usize {
    let current: u64 = value
    let bytes: usize = 1 as usize
    while current >= 128 as u64 {
        current = current / 128 as u64
        bytes = bytes + 1 as usize
    }
    return bytes
}

export function varint_u32_size(value: u32): usize {
    return varint_u64_size(value as u64)
}

export function varint_fits_u32(value: u64): bool {
    return value <= 4294967295 as u64
}

export function varint_encode_u64_at(output: []u8, offset: usize, value: u64): usize {
    let required: usize = varint_u64_size(value)
    if offset > len(output) || required > len(output) - offset { return 0 as usize }
    let current: u64 = value
    let written: usize = 0 as usize
    while current >= 128 as u64 {
        let payload: u64 = current % 128 as u64
        output[offset + written] = (payload + 128 as u64) as u8
        current = current / 128 as u64
        written = written + 1 as usize
    }
    output[offset + written] = current as u8
    return written + 1 as usize
}

export function varint_encode_u64(output: []u8, value: u64): usize {
    return varint_encode_u64_at(output, 0 as usize, value)
}

export function varint_encode_u32_at(output: []u8, offset: usize, value: u32): usize {
    return varint_encode_u64_at(output, offset, value as u64)
}

export function varint_encode_u32(output: []u8, value: u32): usize {
    return varint_encode_u32_at(output, 0 as usize, value)
}

export function varint_decode_u64_at(data: []u8, offset: usize, result: *VarintResult): bool {
    if result == null { return false }
    varint_result_reset(result)
    if offset > len(data) { result.incomplete = true return false }

    let value: u64 = 0 as u64
    let multiplier: u64 = 1 as u64
    let i: usize = 0 as usize
    while i < varint_max_u64_bytes() {
        let position: usize = offset + i
        if position >= len(data) {
            result.value = value
            result.bytes = i
            result.incomplete = true
            return false
        }

        let byte: u64 = data[position] as u64
        let payload: u64 = byte % 128 as u64
        // The tenth byte of a canonical u64 varint may carry only bit 0.
        if i == 9 as usize && payload > 1 as u64 {
            result.bytes = i + 1 as usize
            result.overflow = true
            return false
        }
        value = value + payload * multiplier
        if byte < 128 as u64 {
            result.value = value
            result.bytes = i + 1 as usize
            result.ok = true
            return true
        }
        if i < 9 as usize { multiplier = multiplier * 128 as u64 }
        i = i + 1 as usize
    }

    result.bytes = varint_max_u64_bytes()
    result.overflow = true
    return false
}

export function varint_decode_u64(data: []u8, result: *VarintResult): bool {
    return varint_decode_u64_at(data, 0 as usize, result)
}

export function varint_decode_u32_at(data: []u8, offset: usize, result: *VarintResult): bool {
    if !varint_decode_u64_at(data, offset, result) { return false }
    if !varint_fits_u32(result.value) {
        result.ok = false
        result.overflow = true
        return false
    }
    return true
}

export function varint_decode_u32(data: []u8, result: *VarintResult): bool {
    return varint_decode_u32_at(data, 0 as usize, result)
}

export function varint_decode_u64_or(data: []u8, offset: usize, fallback: u64): u64 {
    let result: VarintResult
    if !varint_decode_u64_at(data, offset, &result) { return fallback }
    return result.value
}

export function varint_is_canonical_u64(data: []u8, offset: usize): bool {
    let result: VarintResult
    if !varint_decode_u64_at(data, offset, &result) { return false }
    return result.bytes == varint_u64_size(result.value)
}

export function varint_encoded_length_at(data: []u8, offset: usize): usize {
    if offset >= len(data) { return 0 as usize }
    let i: usize = 0 as usize
    while i < varint_max_u64_bytes() && offset + i < len(data) {
        if data[offset + i] < 128 as u8 { return i + 1 as usize }
        i = i + 1 as usize
    }
    return 0 as usize
}

export function varint_skip_at(data: []u8, offset: usize): usize {
    let width: usize = varint_encoded_length_at(data, offset)
    if width == 0 as usize { return offset }
    return offset + width
}

export function varint_zigzag_encode_i64(value: i64): u64 {
    if value >= 0 as i64 { return value as u64 * 2 as u64 }
    // -(value + 1) is safe even for the minimum i64.
    let magnitudeMinusOne: u64 = (-(value + 1 as i64)) as u64
    return magnitudeMinusOne * 2 as u64 + 1 as u64
}

export function varint_zigzag_decode_i64(value: u64): i64 {
    let half: u64 = value / 2 as u64
    if value % 2 as u64 == 0 as u64 { return half as i64 }
    return -(half as i64) - 1 as i64
}

export function varint_i64_size(value: i64): usize {
    return varint_u64_size(varint_zigzag_encode_i64(value))
}

export function varint_encode_i64_at(output: []u8, offset: usize, value: i64): usize {
    return varint_encode_u64_at(output, offset, varint_zigzag_encode_i64(value))
}

export function varint_encode_i64(output: []u8, value: i64): usize {
    return varint_encode_i64_at(output, 0 as usize, value)
}

export function varint_decode_i64_at(data: []u8, offset: usize, out: *i64, result: *VarintResult): bool {
    if out == null || result == null { return false }
    if !varint_decode_u64_at(data, offset, result) { return false }
    *out = varint_zigzag_decode_i64(result.value)
    return true
}

export function varint_decode_i64(data: []u8, out: *i64, result: *VarintResult): bool {
    return varint_decode_i64_at(data, 0 as usize, out, result)
}

export function varint_cursor_read_u64(cursor: *VarintCursor, data: []u8, out: *u64): bool {
    if cursor == null || out == null || !cursor.ok { return false }
    let result: VarintResult
    if !varint_decode_u64_at(data, cursor.offset, &result) {
        cursor.ok = false
        return false
    }
    *out = result.value
    cursor.offset = cursor.offset + result.bytes
    return true
}

export function varint_cursor_read_u32(cursor: *VarintCursor, data: []u8, out: *u32): bool {
    if cursor == null || out == null || !cursor.ok { return false }
    let result: VarintResult
    if !varint_decode_u32_at(data, cursor.offset, &result) {
        cursor.ok = false
        return false
    }
    *out = result.value as u32
    cursor.offset = cursor.offset + result.bytes
    return true
}

export function varint_cursor_read_i64(cursor: *VarintCursor, data: []u8, out: *i64): bool {
    if cursor == null || out == null || !cursor.ok { return false }
    let result: VarintResult
    if !varint_decode_i64_at(data, cursor.offset, out, &result) {
        cursor.ok = false
        return false
    }
    cursor.offset = cursor.offset + result.bytes
    return true
}

export function varint_cursor_write_u64(cursor: *VarintCursor, output: []u8, value: u64): bool {
    if cursor == null || !cursor.ok { return false }
    let written: usize = varint_encode_u64_at(output, cursor.offset, value)
    if written == 0 as usize { cursor.ok = false return false }
    cursor.offset = cursor.offset + written
    return true
}

export function varint_cursor_write_u32(cursor: *VarintCursor, output: []u8, value: u32): bool {
    return varint_cursor_write_u64(cursor, output, value as u64)
}

export function varint_cursor_write_i64(cursor: *VarintCursor, output: []u8, value: i64): bool {
    if cursor == null || !cursor.ok { return false }
    let written: usize = varint_encode_i64_at(output, cursor.offset, value)
    if written == 0 as usize { cursor.ok = false return false }
    cursor.offset = cursor.offset + written
    return true
}

export function varint_count_values(data: []u8): usize {
    let offset: usize = 0 as usize
    let count: usize = 0 as usize
    while offset < len(data) {
        let result: VarintResult
        if !varint_decode_u64_at(data, offset, &result) { return count }
        offset = offset + result.bytes
        count = count + 1 as usize
    }
    return count
}

export function varint_sequence_valid(data: []u8): bool {
    let offset: usize = 0 as usize
    while offset < len(data) {
        let result: VarintResult
        if !varint_decode_u64_at(data, offset, &result) || !result.ok { return false }
        offset = offset + result.bytes
    }
    return true
}

export function varint_all_canonical(data: []u8): bool {
    let offset: usize = 0 as usize
    while offset < len(data) {
        let result: VarintResult
        if !varint_decode_u64_at(data, offset, &result) { return false }
        if result.bytes != varint_u64_size(result.value) { return false }
        offset = offset + result.bytes
    }
    return true
}

export function varint_copy_sequence(data: []u8, output: []u8): usize {
    if len(output) < len(data) || !varint_sequence_valid(data) { return 0 as usize }
    let i: usize = 0 as usize
    while i < len(data) { output[i] = data[i] i = i + 1 as usize }
    return len(data)
}

// Compatibility helpers from the placeholder era.
export function varint_byte_sum(data: []u8): u64 { let sum: u64 = 0 as u64 let i: usize = 0 as usize while i < len(data) { sum = sum + data[i] as u64 i = i + 1 as usize } return sum }
export function varint_all_zero(data: []u8): bool { let i: usize = 0 as usize while i < len(data) { if data[i] != 0 as u8 { return false } i = i + 1 as usize } return true }
export function varint_bounded_length(data: []u8, max: usize): bool { return len(data) <= max }
export function varint_nonempty(data: []u8): bool { return len(data) > 0 as usize }
