module noqeri.std.core

record NqIndexRange {
    start: usize
    end: usize
}

record NqByteSpan {
    start: usize
    length: usize
}

record NqI64Bounds {
    minimum: i64
    maximum: i64
}

record NqU64Bounds {
    minimum: u64
    maximum: u64
}

export function core_index_range(start: usize, end: usize): NqIndexRange {
    let out: NqIndexRange
    out.start = start
    out.end = end
    return out
}

export function core_range_valid(range: NqIndexRange): bool { return range.start <= range.end }
export function core_range_length(range: NqIndexRange): usize { if range.end < range.start { return 0 as usize } return range.end - range.start }
export function core_range_empty(range: NqIndexRange): bool { return !core_range_valid(range) || range.start == range.end }
export function core_range_contains(range: NqIndexRange, index: usize): bool { return core_range_valid(range) && index >= range.start && index < range.end }
export function core_range_contains_range(outer: NqIndexRange, inner: NqIndexRange): bool { return core_range_valid(outer) && core_range_valid(inner) && inner.start >= outer.start && inner.end <= outer.end }
export function core_range_overlaps(a: NqIndexRange, b: NqIndexRange): bool { return core_range_valid(a) && core_range_valid(b) && a.start < b.end && b.start < a.end }

export function core_range_intersection(a: NqIndexRange, b: NqIndexRange): NqIndexRange {
    let start: usize = a.start
    let end: usize = a.end
    if b.start > start { start = b.start }
    if b.end < end { end = b.end }
    if end < start { end = start }
    return core_index_range(start, end)
}

export function core_range_clamp(range: NqIndexRange, length: usize): NqIndexRange {
    let start: usize = range.start
    let end: usize = range.end
    if start > length { start = length }
    if end > length { end = length }
    if end < start { end = start }
    return core_index_range(start, end)
}

export function core_span(start: usize, length: usize): NqByteSpan {
    let out: NqByteSpan
    out.start = start
    out.length = length
    return out
}

export function core_span_end(span: NqByteSpan): usize {
    if span.length > 18446744073709551615 as usize - span.start { return 18446744073709551615 as usize }
    return span.start + span.length
}
export function core_span_valid_for(span: NqByteSpan, length: usize): bool { return span.start <= length && span.length <= length - span.start }
export function core_span_empty(span: NqByteSpan): bool { return span.length == 0 as usize }
export function core_span_contains(span: NqByteSpan, index: usize): bool { return index >= span.start && index - span.start < span.length }

export function core_min_i8(a: i8, b: i8): i8 { if a < b { return a } return b }
export function core_max_i8(a: i8, b: i8): i8 { if a > b { return a } return b }
export function core_clamp_i8(value: i8, low: i8, high: i8): i8 { if high < low { return low } if value < low { return low } if value > high { return high } return value }
export function core_between_i8(value: i8, low: i8, high: i8): bool { return high >= low && value >= low && value <= high }
export function core_equal_i8(a: i8, b: i8): bool { return a == b }
export function core_not_equal_i8(a: i8, b: i8): bool { return a != b }
