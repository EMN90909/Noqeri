export function core_checked_add_u64(a: u64, b: u64, out: *u64): bool {
    if out == null || b > 18446744073709551615 as u64 - a { return false }
    out[0] = a + b
    return true
}
export function core_checked_sub_u64(a: u64, b: u64, out: *u64): bool {
    if out == null || b > a { return false }
    out[0] = a - b
    return true
}
export function core_checked_mul_u64(a: u64, b: u64, out: *u64): bool {
    if out == null { return false }
    if a != 0 as u64 && b > 18446744073709551615 as u64 / a { return false }
    out[0] = a * b
    return true
}
export function core_saturating_add_u64(a: u64, b: u64): u64 { let out: u64 = 0 as u64 if !core_checked_add_u64(a,b,&out) { return 18446744073709551615 as u64 } return out }
export function core_saturating_sub_u64(a: u64, b: u64): u64 { if b > a { return 0 as u64 } return a - b }
export function core_saturating_mul_u64(a: u64, b: u64): u64 { let out: u64 = 0 as u64 if !core_checked_mul_u64(a,b,&out) { return 18446744073709551615 as u64 } return out }

export function core_checked_add_usize(a: usize, b: usize, out: *usize): bool {
    if out == null || b > 18446744073709551615 as usize - a { return false }
    out[0] = a + b
    return true
}
export function core_checked_sub_usize(a: usize, b: usize, out: *usize): bool {
