}
export function core_saturating_add_usize(a: usize, b: usize): usize { let out: usize = 0 as usize if !core_checked_add_usize(a,b,&out) { return 18446744073709551615 as usize } return out }
export function core_saturating_sub_usize(a: usize, b: usize): usize { if b > a { return 0 as usize } return a - b }
export function core_saturating_mul_usize(a: usize, b: usize): usize { let out: usize = 0 as usize if !core_checked_mul_usize(a,b,&out) { return 18446744073709551615 as usize } return out }

export function core_align_down(value: usize, alignment: usize): usize {
    if alignment == 0 as usize { return value }
    return value - value % alignment
}
export function core_align_up(value: usize, alignment: usize): usize {
    if alignment == 0 as usize { return value }
    let remainder: usize = value % alignment
    if remainder == 0 as usize { return value }
    let delta: usize = alignment - remainder
    return core_saturating_add_usize(value, delta)
}
export function core_is_aligned(value: usize, alignment: usize): bool { return alignment != 0 as usize && value % alignment == 0 as usize }

export function core_slice_range_valid<T>(values: []T, range: NqIndexRange): bool { return core_range_valid(range) && range.end <= len(values) }
export function core_slice_span_valid<T>(values: []T, span: NqByteSpan): bool { return core_span_valid_for(span, len(values)) }
export function core_copy_u8(source: []u8, destination: []u8): usize {
    let count: usize = core_min_usize(len(source), len(destination))
    let index: usize = 0 as usize
    while index < count { destination[index] = source[index] index = index + 1 as usize }
    return count
}
export function core_fill_u8(values: []u8, value: u8): void { let index: usize = 0 as usize while index < len(values) { values[index] = value index = index + 1 as usize } }
export function core_zero_u8(values: []u8): void { core_fill_u8(values, 0 as u8) }
export function core_equal_u8_slice(a: []u8, b: []u8): bool {
    if len(a) != len(b) { return false }
    let index: usize = 0 as usize
    while index < len(a) { if a[index] != b[index] { return false } index = index + 1 as usize }
    return true
}
export function core_prefix_equal_u8(a: []u8, b: []u8, count: usize): bool {
    if count > len(a) || count > len(b) { return false }
    let index: usize = 0 as usize
    while index < count { if a[index] != b[index] { return false } index = index + 1 as usize }
    return true
}
export function core_swap_u8(values: []u8, a: usize, b: usize): bool {
    if a >= len(values) || b >= len(values) { return false }
    let tmp: u8 = values[a]
    values[a] = values[b]
    values[b] = tmp
    return true
}
export function core_swap_i64(values: []i64, a: usize, b: usize): bool {
    if a >= len(values) || b >= len(values) { return false }
    let tmp: i64 = values[a]
    values[a] = values[b]
    values[b] = tmp
    return true
}
export function core_swap_u64(values: []u64, a: usize, b: usize): bool {
    if a >= len(values) || b >= len(values) { return false }
    let tmp: u64 = values[a]
    values[a] = values[b]
    values[b] = tmp
    return true
}

export function core_i64_bounds(values: []i64, out: *NqI64Bounds): bool {
    if out == null || len(values) == 0 as usize { return false }
    let minimum: i64 = values[0]
    let maximum: i64 = values[0]
    let index: usize = 1 as usize
    while index < len(values) {
        if values[index] < minimum { minimum = values[index] }
        if values[index] > maximum { maximum = values[index] }
        index = index + 1 as usize
    }
    out.minimum = minimum
    out.maximum = maximum
    return true
}
export function core_u64_bounds(values: []u64, out: *NqU64Bounds): bool {
    if out == null || len(values) == 0 as usize { return false }
    let minimum: u64 = values[0]
    let maximum: u64 = values[0]
    let index: usize = 1 as usize
    while index < len(values) {
        if values[index] < minimum { minimum = values[index] }
        if values[index] > maximum { maximum = values[index] }
        index = index + 1 as usize
    }
    out.minimum = minimum
    out.maximum = maximum
    return true
}

export function core_index_advance(index: usize, amount: usize, limit: usize): usize {
    if index >= limit { return limit }
    let remaining: usize = limit - index
    if amount >= remaining { return limit }
    return index + amount
}
export function core_index_retreat(index: usize, amount: usize): usize { if amount >= index { return 0 as usize } return index - amount }
export function core_capacity_remaining(length: usize, capacity: usize): usize { if length >= capacity { return 0 as usize } return capacity - length }
export function core_capacity_can_fit(length: usize, capacity: usize, additional: usize): bool { return length <= capacity && additional <= capacity - length }

export function core_sum_i64(values: []i64): i64 {
    let total: i64 = 0 as i64
    let index: usize = 0 as usize
    while index < len(values) { total = total + values[index] index = index + 1 as usize }
    return total
}
export function core_product_i64(values: []i64): i64 {
    let total: i64 = 1 as i64
    let index: usize = 0 as usize
    while index < len(values) { total = total * values[index] index = index + 1 as usize }
    return total
}
export function core_count_equal_i64(values: []i64, target: i64): usize {
    let count: usize = 0 as usize
    let index: usize = 0 as usize
    while index < len(values) { if values[index] == target { count = count + 1 as usize } index = index + 1 as usize }
    return count
}
export function core_find_i64(values: []i64, target: i64): isize {
    let index: usize = 0 as usize
    while index < len(values) { if values[index] == target { return index as isize } index = index + 1 as usize }
    return -1 as isize
}
export function core_all_equal_i64(values: []i64, target: i64): bool {
    let index: usize = 0 as usize
    while index < len(values) { if values[index] != target { return false } index = index + 1 as usize }
    return true
}
export function core_any_equal_i64(values: []i64, target: i64): bool { return core_find_i64(values, target) >= 0 as isize }

