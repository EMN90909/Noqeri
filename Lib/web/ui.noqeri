// Bundled Noqeri-authored UI components: no React, JSX, TypeScript or npm.
module noqeri.web.ui

component Heading(label: string) {
    h1 class: "nq-title" { label }
}

component Lead(message: string) {
    p class: "nq-lead" { message }
}

component Card(title: string, description: string) {
    article class: "nq-card" {
        h2 class: "nq-card-title" { title }
        p { description }
    }
}

component Badge(label: string) {
    span class: "nq-badge" { label }
}

component Notice(message: string) {
    aside class: "nq-alert" role: "status" { message }
}

component Button(label: string) {
    button type: "button" class: "nq-button" { label }
}

component LinkButton(label: string, href: string) {
    a class: "nq-button" href: href { label }
}

component NavLink(label: string, href: string) {
    a href: href { label }
}

component TextField(labelText: string, fieldId: string, hint: string) {
    div class: "nq-field" {
        label for: fieldId { labelText }
        input id: fieldId name: fieldId type: "text" placeholder: hint {}
    }
}

component Statistic(label: string, value: string) {
    div class: "nq-card" {
        p class: "nq-stat-value" { value }
        p class: "nq-stat-label" { label }
    }
}

component PageHeader(eyebrow: string, title: string, summary: string) {
    header class: "nq-page-header" {
        p class: "nq-eyebrow" { eyebrow }
        h1 class: "nq-title" { title }
        p class: "nq-lead" { summary }
    }
}

component SectionHeading(title: string, subtitle: string) {
    header class: "nq-section-header" {
        h2 class: "nq-section-title" { title }
        p class: "nq-muted" { subtitle }
    }
}

component Panel(title: string, detail: string) {
    section class: "nq-panel" {
        h2 class: "nq-section-title" { title }
        p { detail }
    }
}

component EmptyState(title: string, message: string) {
    section class: "nq-empty" role: "status" {
        h2 class: "nq-section-title" { title }
        p class: "nq-muted" { message }
    }
}

component FieldHint(message: string) {
    small class: "nq-field-help" { message }
}

component FieldError(message: string) {
    p class: "nq-field-error" role: "alert" { message }
}

component SecondaryLink(label: string, href: string) {
    a class: "nq-button nq-button-secondary" href: href { label }
}

component FooterNote(message: string) {
    footer class: "nq-footer" { message }
}

component SubmitButton(label: string) {
    button type: "submit" class: "nq-button" { label }
}

component TextAreaField(labelText: string, fieldId: string, hint: string) {
    div class: "nq-field" {
        label for: fieldId { labelText }
        textarea id: fieldId name: fieldId placeholder: hint {}
    }
}
