module noqeri.game.math.vec3

// Allocation-free 3D vector operations. Coordinates use a right-handed
// convention. This module does not imply that native floating-point codegen
// or any graphics backend has passed release qualification.
record Vec3 {
    x: f64
    y: f64
    z: f64
}

export function vec3Set(out: *Vec3, x: f64, y: f64, z: f64): void {
    out.x = x
    out.y = y
    out.z = z
}

export function vec3Add(out: *Vec3, a: *Vec3, b: *Vec3): void {
    let x: f64 = a.x + b.x
    let y: f64 = a.y + b.y
    let z: f64 = a.z + b.z
    vec3Set(out, x, y, z)
}

export function vec3Subtract(out: *Vec3, a: *Vec3, b: *Vec3): void {
    let x: f64 = a.x - b.x
    let y: f64 = a.y - b.y
    let z: f64 = a.z - b.z
    vec3Set(out, x, y, z)
}

export function vec3Scale(out: *Vec3, a: *Vec3, factor: f64): void {
    let x: f64 = a.x * factor
    let y: f64 = a.y * factor
    let z: f64 = a.z * factor
    vec3Set(out, x, y, z)
}

export function vec3Dot(a: *Vec3, b: *Vec3): f64 {
    return a.x * b.x + a.y * b.y + a.z * b.z
}

export function vec3Cross(out: *Vec3, a: *Vec3, b: *Vec3): void {
    let x: f64 = a.y * b.z - a.z * b.y
    let y: f64 = a.z * b.x - a.x * b.z
    let z: f64 = a.x * b.y - a.y * b.x
    vec3Set(out, x, y, z)
}

export function vec3LengthSquared(a: *Vec3): f64 {
    return vec3Dot(a, a)
}

export function vec3DistanceSquared(a: *Vec3, b: *Vec3): f64 {
    let x: f64 = a.x - b.x
    let y: f64 = a.y - b.y
    let z: f64 = a.z - b.z
    return x * x + y * y + z * z
}

export function vec3Lerp(out: *Vec3, a: *Vec3, b: *Vec3, t: f64): void {
    let x: f64 = a.x + (b.x - a.x) * t
    let y: f64 = a.y + (b.y - a.y) * t
    let z: f64 = a.z + (b.z - a.z) * t
    vec3Set(out, x, y, z)
}
