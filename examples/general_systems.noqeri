module examples.general

function identity<T>(value: T): T {
    return value
}

export function exercise(): isize {
    let values: [u32; 4] = [1 as u32, 2 as u32, 3 as u32, 4 as u32]
    let view: []u32 = slice(values)
    let first: u32 = view[0]
    let counter: u64 = 1
    let ptr: *u64 = &counter
    atomic.store(ptr, 2)
    let observed: u64 = atomic.load(ptr)
    unsafe {
        intrinsic("x86.pause")
        asm("nop")
    }
    return identity((first as isize) + (observed as isize) + (len(view) as isize))
}
