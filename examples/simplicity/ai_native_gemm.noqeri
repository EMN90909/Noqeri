// Native-AOT only: build with scripts/native-build.mjs --ai-framework.
// No raw pointer dereference is needed by application code; the FFI boundary
// checks shapes, capacities, backends, and numerical domain.
import "../../Lib/ai/native.noqeri"
function verify(): int {
    let a: [float; 4] = [1.0, 2.0, 3.0, 4.0]
    let b: [float; 4] = [5.0, 6.0, 7.0, 8.0]
    let result: [float; 4]
    let req: AiGemmRequest
    req.left = &a[0]
    req.left_rows = 2 as usize
    req.left_cols = 2 as usize
    req.right = &b[0]
    req.right_rows = 2 as usize
    req.right_cols = 2 as usize
    req.output = &result[0]
    req.output_capacity = 4 as usize
    req.backend = 3 as u32
    let rc: isize = ai_native_gemm(&req)
    if rc != 0 as isize { return 1 }
    if result[0] != 19.0 { return 2 }
    if result[1] != 22.0 { return 3 }
    if result[2] != 43.0 { return 4 }
    if result[3] != 50.0 { return 5 }
    return 0
}
print(verify())

function softmaxTest(): int {
    let values: [float; 4] = [0.0, 0.0, 1.0, 1.0]
    let output: [float; 4]
    let req: AiSoftmaxRequest
    req.input = &values[0]
    req.rows = 2 as usize
    req.cols = 2 as usize
    req.output = &output[0]
    req.output_capacity = 4 as usize
    req.causal = 0 as u32
    if ai_native_softmax(&req) != 0 as isize { return 1 }
    if output[0] != 0.5 || output[1] != 0.5 ||
       output[2] != 0.5 || output[3] != 0.5 { return 2 }
    return 0
}
function sgdTest(): int {
    let p: [float; 2] = [1.0, 2.0]
    let g: [float; 2] = [2.0, -4.0]
    let output: [float; 2]
    let req: AiSgdRequest
    req.parameters = &p[0]
    req.gradients = &g[0]
    req.count = 2 as usize
    req.learning_rate = 0.1
    req.gradient_clip = 1.0
    req.output = &output[0]
    req.output_capacity = 2 as usize
    if ai_native_sgd(&req) != 0 as isize { return 1 }
    if output[0] < 0.89 || output[0] > 0.91 ||
       output[1] < 2.09 || output[1] > 2.11 { return 2 }
    return 0
}
if softmaxTest() != 0 { print(1) }
if sgdTest() != 0 { print(1) }
