// Syntax sugar for a statically typed single-expression function.
// There is no dynamic typing and both Stage-0 and Stage-2 parse this form.
function add(a: int, b: int): int = a + b
function triple(x: int): int = x * 3

function checkShortFunctions(): int {
if add(5, 3) != 8 { return 1 }
if triple(7) != 21 { return 2 }
return 0
}
if checkShortFunctions() == 0 { print("SHORT_FUNCTIONS_PASS") } else { print("SHORT_FUNCTIONS_FAIL") }
