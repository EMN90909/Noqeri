import "../../Lib/std/numeric.noqeri"

function checkScores(): int {
let scores: [int; 5] = [78,42,91,65,30]
let passed: [int; 5]
let howMany: isize = filter_at_least(slice(scores),50,slice(passed))
if howMany != 3 as isize { return 1 }
let total: int = sum(slice(passed,howMany as usize))
if total != 234 { return 2 }
let checked: int = 0
if !sum_checked(slice(scores),&checked) || checked != 306 { return 3 }
let average: float = average_or(slice(passed,howMany as usize),0.0)
if average != 78.0 { return 4 }
if count_at_least(slice(scores),50) != 3 as usize { return 5 }
return 0
}
if checkScores() == 0 { print("NUMERIC_SIMPLICITY_PASS") } else { print("NUMERIC_SIMPLICITY_FAIL") }
