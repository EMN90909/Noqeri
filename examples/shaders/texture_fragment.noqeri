module examples.shaders.texture_fragment

// Group 0 binding 0: sampled RGBA8 texture, binding 1: filtering sampler.
// The app should supply a 256 x 256 texture to match normalized coordinates.
export function shade(x: float, y: float): Vec4 {
    const uv: Vec2 = vec2(x / 256.0, y / 256.0)
    const pixel: Vec4 = textureSample(uv)
    const tint: Vec4 = vec4(1.0, 0.85, 0.75, 1.0)
    return pixel * tint
}
