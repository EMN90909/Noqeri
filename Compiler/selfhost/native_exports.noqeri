module noqeri.compiler.selfhost.native_exports
import "pipeline.noqeri"
import "targets.noqeri"
import "ast.noqeri"
import "nir.noqeri"
import "elf_native_writer.noqeri"

export function stage2CompileToNativeObject(source: []u8, target: int, debug: bool, unsafeAllowed: bool, out: []u8): isize {
    if target != nqTargetLinuxX64() { return nqElfNativeUnsupported() }
    let nodes: [NqAstNode; 131072]
    let instructions: [NqNirInstruction; 262144]
    let functions: [NqNirFunction; 8192]
    let result: NqCompileResult
    let status: isize = nqPipelineCompileToNir(source, target, debug, unsafeAllowed, slice(nodes), slice(instructions), slice(functions), &result)
    if status < 0 as isize { return status }
    return nqElfNativeWriteObject(source, slice(functions, result.functionCount), slice(instructions, result.instructionCount), target, out)
}
