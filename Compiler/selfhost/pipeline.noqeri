module noqeri.compiler.selfhost.pipeline
import "parser.nqr"
import "parser_stmt.nqr"
import "ast.nqr"
import "zero_init.nqr"
import "semantics.nqr"
import "semantic_program.nqr"
import "nir.nqr"
import "lower.nqr"
import "optimizer.nqr"
import "targets.nqr"
import "backend.nqr"
import "linker.nqr"
import "security.nqr"

record NqCompilePlan {
    target: int
    optimization: int
    linkKind: int
    unsafeAllowed: bool
    sourceBytes: usize
}

record NqCompileResult {
    status: isize
    firstAst: isize
    astCount: usize
    instructionCount: usize
    functionCount: usize
    optimizerChanges: usize
}

export function nqPipelineWorkspaceAstMinimum(): usize { return 4096 as usize }
export function nqPipelineWorkspaceNirMinimum(): usize { return 8192 as usize }
export function nqPipelineWorkspaceFunctionMinimum(): usize { return 512 as usize }

export function nqPipelineSyntaxCheck(source: []u8): isize {
    let policy: NqSecurityPolicy
    nqSecurityProductionPolicy(&policy)
    if !nqSecuritySourceAllowed(&policy, len(source)) { return nqSecurityLimitExceeded() }
    let nodes: [NqAstNode; 4096]
    let count: usize = 0 as usize
    let first: isize = nqAstNoNode()
    return nqParserParseProgram(source, slice(nodes), &count, &first)
}

// `check` is source-local and therefore performs the complete grammar pass.
// Semantic compilation is intentionally done after imports are dependency-first
// merged, matching the seed's ModuleGraph::mergedProgram contract.
export function nqPipelineCheck(source: []u8): isize { return nqPipelineSyntaxCheck(source) }

export function nqPipelineSemanticCheckMerged(source: []u8, unsafeAllowed: bool): isize {
    let policy: NqSecurityPolicy
    nqSecurityProductionPolicy(&policy)
    if !nqSecuritySourceAllowed(&policy, len(source)) { return nqSecurityLimitExceeded() }
    let nodes: [NqAstNode; 4096]
    let count: usize = 0 as usize
    let first: isize = nqAstNoNode()
    let parseStatus: isize = nqParserParseProgram(source, slice(nodes), &count, &first)
    if parseStatus < 0 as isize { return parseStatus }
    let zeroStatus: isize = nqZeroInitNormalize(source, slice(nodes), &count, first)
    if zeroStatus < 0 as isize { return zeroStatus }
    return nqSemanticAnalyzeProgram(source, slice(nodes), &count, first, unsafeAllowed)
}

export function nqPipelineTargetCheck(target: int): isize { if !nqBackendTargetReady(target) { return nqBackendUnsupportedTarget() } return 0 }
export function nqPipelineCompileReady(source: []u8, target: int): bool { return nqPipelineCheck(source) == 0 && nqPipelineTargetCheck(target) == 0 }
export function nqPipelineDefaultOptimization(debug: bool): int { if debug { return nqOptLevelNone() } return nqOptLevelSpeed() }
export function nqPipelineDefaultLinkKind(): int { return nqLinkExecutable() }

export function nqPipelinePlan(source: []u8, target: int, debug: bool, unsafeAllowed: bool, out: *NqCompilePlan): isize {
    if out == null { return -500 }
    let targetStatus: isize = nqPipelineTargetCheck(target)
    if targetStatus < 0 { return targetStatus }
    let policy: NqSecurityPolicy
    nqSecurityProductionPolicy(&policy)
    policy.allowUnsafe = unsafeAllowed
    policy.allowInlineAsm = unsafeAllowed
    if !nqSecuritySourceAllowed(&policy, len(source)) { return nqSecurityLimitExceeded() }
    out.target = target
    out.optimization = nqPipelineDefaultOptimization(debug)
    out.linkKind = nqPipelineDefaultLinkKind()
    out.unsafeAllowed = unsafeAllowed
    out.sourceBytes = len(source)
    return 0
}

export function nqPipelineOptimizeAndValidate(instructions: []NqNirInstruction, plan: *NqCompilePlan): isize {
    if plan == null || !nqTargetValid(plan.target) { return nqBackendUnsupportedTarget() }
    let policy: NqSecurityPolicy
    nqSecurityProductionPolicy(&policy)
    policy.allowUnsafe = plan.unsafeAllowed
    policy.allowInlineAsm = plan.unsafeAllowed
    let securityStatus: isize = nqSecurityProgramCheck(&policy, plan.target, instructions)
    if securityStatus < 0 { return securityStatus }
    nqOptimizerRun(instructions, plan.optimization)
    return nqBackendProgramValid(plan.target, instructions, plan.unsafeAllowed)
}

export function nqPipelineCompileToNir(source: []u8, target: int, debug: bool, unsafeAllowed: bool, nodes: []NqAstNode, instructions: []NqNirInstruction, functions: []NqNirFunction, out: *NqCompileResult): isize {
    if out == null || len(nodes) < nqPipelineWorkspaceAstMinimum() || len(instructions) < nqPipelineWorkspaceNirMinimum() || len(functions) < nqPipelineWorkspaceFunctionMinimum() { return nqLowerCapacity() }
    out.status = 0 as isize
    out.firstAst = nqAstNoNode()
    out.astCount = 0 as usize
    out.instructionCount = 0 as usize
    out.functionCount = 0 as usize
    out.optimizerChanges = 0 as usize
    let plan: NqCompilePlan
    let planStatus: isize = nqPipelinePlan(source, target, debug, unsafeAllowed, &plan)
    if planStatus < 0 as isize { out.status = planStatus return planStatus }
    let first: isize = nqAstNoNode()
    let astCount: usize = 0 as usize
    let parseStatus: isize = nqParserParseProgram(source, nodes, &astCount, &first)
    if parseStatus < 0 as isize { out.status = parseStatus return parseStatus }
    let zeroStatus: isize = nqZeroInitNormalize(source, nodes, &astCount, first)
    if zeroStatus < 0 as isize { out.status = zeroStatus return zeroStatus }
    let semanticStatus: isize = nqSemanticAnalyzeProgram(source, nodes, &astCount, first, unsafeAllowed)
    if semanticStatus < 0 as isize { out.status = semanticStatus return semanticStatus }
    let instructionCount: usize = 0 as usize
    let functionCount: usize = 0 as usize
    let lowerStatus: isize = nqLowerProgram(source, nodes, first, instructions, functions, &instructionCount, &functionCount)
    if lowerStatus < 0 as isize { out.status = lowerStatus return lowerStatus }
    let policy: NqSecurityPolicy
    nqSecurityProductionPolicy(&policy)
    policy.allowUnsafe = unsafeAllowed
    policy.allowInlineAsm = unsafeAllowed
    if !nqSecurityInstructionCountAllowed(&policy, instructionCount) { out.status = nqSecurityLimitExceeded() return out.status }
    let active: []NqNirInstruction = slice(instructions, instructionCount)
    let securityStatus: isize = nqSecurityProgramCheck(&policy, target, active)
    if securityStatus < 0 as isize { out.status = securityStatus return securityStatus }
    out.optimizerChanges = nqOptimizerRun(active, plan.optimization)
    let backendStatus: isize = nqBackendProgramValid(target, active, unsafeAllowed)
    if backendStatus < 0 as isize { out.status = backendStatus return backendStatus }
    let fi: usize = 0 as usize
    while fi < functionCount {
        if !nqNirFunctionValid(&functions[fi], instructionCount) { out.status = nqBackendInvalidNir() return out.status }
        fi = fi + 1 as usize
    }
    out.firstAst = first
    out.astCount = astCount
    out.instructionCount = instructionCount
    out.functionCount = functionCount
    out.status = 0 as isize
    return 0 as isize
}

export function nqPipelineCompileCheck(source: []u8, target: int, unsafeAllowed: bool): isize {
    let nodes: [NqAstNode; 4096]
    let instructions: [NqNirInstruction; 8192]
    let functions: [NqNirFunction; 512]
    let result: NqCompileResult
    return nqPipelineCompileToNir(source, target, true, unsafeAllowed, slice(nodes), slice(instructions), slice(functions), &result)
}
