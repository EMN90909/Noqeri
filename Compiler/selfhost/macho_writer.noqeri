module noqeri.compiler.selfhost.macho_writer
import "targets.nqr"
import "object_formats.nqr"

export function nqMachHeaderBytes64(): usize { return 32 as usize }
export function nqMachSegmentCommandBytes64(): usize { return 72 as usize }
export function nqMachSectionBytes64(): usize { return 80 as usize }
export function nqMachNlistBytes64(): usize { return 16 as usize }
export function nqMachRelocBytes(): usize { return 8 as usize }
export function nqMachTargetValid(target: int): bool { return target == nqTargetMacX64() || target == nqTargetMacArm64() }
export function nqMachCpu(target: int): u32 { if target == nqTargetMacArm64() { return nqMachCpuArm64() } if target == nqTargetMacX64() { return nqMachCpuX64() } return 0 as u32 }
export function nqMachRelocBranch(target: int): u32 { if target == nqTargetMacX64() { return 2 as u32 } if target == nqTargetMacArm64() { return 2 as u32 } return 0 as u32 }
export function nqMachRelocUnsigned(target: int): u32 { if nqMachTargetValid(target) { return 0 as u32 } return 0 as u32 }
export function nqMachPageAlignment(target: int): usize { if target == nqTargetMacArm64() { return 16384 as usize } if target == nqTargetMacX64() { return 4096 as usize } return 0 as usize }

export function nqMachCpuSubtype(target: int): u32 {
    if target == nqTargetMacX64() { return 3 as u32 }
    if target == nqTargetMacArm64() { return 0 as u32 }
    return 0 as u32
}

// Emit mach_header_64 for MH_OBJECT. Load commands are appended separately.
export function nqMachWriteHeader64(buffer: []u8, offset: usize, target: int, commandCount: usize, commandBytes: usize, flags: u32): isize {
    if !nqMachTargetValid(target) { return -1 }
    if commandCount > 65535 as usize || commandBytes > 0xffffffff as usize { return -1 }
    if !nqObjectRangeValid(buffer, offset, nqMachHeaderBytes64()) { return -2 }
    if !nqObjectZero(buffer, offset, nqMachHeaderBytes64()) { return -2 }
    if !nqObjectWriteU32LE(buffer, offset, nqMachOMagic64()) { return -2 }
    if !nqObjectWriteU32LE(buffer, offset + 4 as usize, nqMachCpu(target)) { return -2 }
    if !nqObjectWriteU32LE(buffer, offset + 8 as usize, nqMachCpuSubtype(target)) { return -2 }
    if !nqObjectWriteU32LE(buffer, offset + 12 as usize, 1 as u32) { return -2 } // MH_OBJECT
    if !nqObjectWriteU32LE(buffer, offset + 16 as usize, commandCount as u32) { return -2 }
    if !nqObjectWriteU32LE(buffer, offset + 20 as usize, commandBytes as u32) { return -2 }
    if !nqObjectWriteU32LE(buffer, offset + 24 as usize, flags) { return -2 }
    return nqMachHeaderBytes64() as isize
}
