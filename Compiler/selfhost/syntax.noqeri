module noqeri.compiler.selfhost.syntax

export function nqCompilerSyntaxCheck(source: []u8): isize {
    let braces: int = 0
    let brackets: int = 0
    let parens: int = 0
    let index: usize = 0 as usize
    let inString: bool = false
    let inLineComment: bool = false
    let inBlockComment: bool = false

    while index < len(source) {
        let value: u8 = source[index]
        let next: u8 = 0 as u8
        if index + 1 < len(source) { next = source[index + 1] }

        if inLineComment {
            if value == 10 as u8 { inLineComment = false }
            index = index + 1
        } else if inBlockComment {
            if value == 42 as u8 && next == 47 as u8 {
                inBlockComment = false
                index = index + 2
            } else { index = index + 1 }
        } else if inString {
            if value == 92 as u8 {
                index = index + 2
            } else {
                if value == 34 as u8 { inString = false }
                index = index + 1
            }
        } else {
            if value == 47 as u8 && next == 47 as u8 {
                inLineComment = true
                index = index + 2
            } else if value == 47 as u8 && next == 42 as u8 {
                inBlockComment = true
                index = index + 2
            } else if value == 34 as u8 {
                inString = true
                index = index + 1
            } else {
                if value == 123 as u8 { braces = braces + 1 }
                if value == 125 as u8 { braces = braces - 1 }
                if value == 91 as u8 { brackets = brackets + 1 }
                if value == 93 as u8 { brackets = brackets - 1 }
                if value == 40 as u8 { parens = parens + 1 }
                if value == 41 as u8 { parens = parens - 1 }
                if braces < 0 { return -22 }
                if brackets < 0 { return -21 }
                if parens < 0 { return -20 }
                index = index + 1
            }
        }
    }

    if inString { return -10 }
    if inBlockComment { return -11 }
    if parens != 0 { return -20 }
    if brackets != 0 { return -21 }
    if braces != 0 { return -22 }
    return 0
}

export function nqCompilerSyntaxOk(source: []u8): bool {
    return nqCompilerSyntaxCheck(source) == 0
}
