module noqeri.compiler.selfhost.generics
import "types.nqr"
import "semantics.nqr"

export function nqGenericUnbound(): int { return -1 }
export function nqGenericConcrete(): int { return -2 }
export function nqGenericMaxParameters(): usize { return 16 as usize }
export function nqGenericInferenceMismatch(): isize { return -300 }
export function nqGenericInferenceCapacity(): isize { return -301 }

// parameterSlots parallels a function's parameters. -2 means the parameter is
// concrete; 0..N identify a generic type variable. bindings is caller-owned and
// initialized to nqAstTypeUnknown(). This keeps inference deterministic and
// avoids a trait solver for ordinary container/function generics.
export function nqGenericInfer(parameterTypes: []int, parameterSlots: []int, argumentTypes: []int, bindings: []int): isize {
    if len(parameterTypes) != len(parameterSlots) || len(argumentTypes) != len(parameterTypes) { return nqGenericInferenceMismatch() }
    let index: usize = 0 as usize
    while index < len(parameterTypes) {
        let slot: int = parameterSlots[index]
        let argument: int = argumentTypes[index]
        if slot == nqGenericConcrete() {
            if !nqSemanticAssignable(argument, parameterTypes[index]) { return nqGenericInferenceMismatch() }
        } else {
            if slot < 0 || slot as usize >= len(bindings) { return nqGenericInferenceCapacity() }
            if bindings[slot as usize] == nqAstTypeUnknown() { bindings[slot as usize] = argument }
            else if bindings[slot as usize] != argument { return nqGenericInferenceMismatch() }
        }
        index = index + 1 as usize
    }
    return 0
}

export function nqGenericBindingsComplete(bindings: []int, count: usize): bool {
    if count > len(bindings) { return false }
    let index: usize = 0 as usize
    while index < count { if bindings[index] == nqAstTypeUnknown() { return false } index = index + 1 as usize }
    return true
}

// Stable overflow-safe cache key. The modulus keeps every intermediate below
// 2^63 even when checked arithmetic is enabled, so monomorphisation itself can
// never introduce an overflow trap.
export function nqGenericMonomorphKey(bindings: []int, count: usize): u64 {
    if count > len(bindings) { count = len(bindings) }
    let modulus: u64 = 1000000007 as u64
    let hash: u64 = 17 as u64
    let index: usize = 0 as usize
    while index < count {
        let component: u64 = (bindings[index] as u64 + 257 as u64) % modulus
        hash = ((hash * 131 as u64) % modulus + component) % modulus
        index = index + 1 as usize
    }
    return hash
}

export function nqGenericConstraintEq(typeCode: int): bool {
    return nqCompilerTypeIsInteger(typeCode) || typeCode == nqAstTypeBool() || typeCode == nqAstTypeFloat() || typeCode == nqAstTypeString() || typeCode == nqAstTypePointer()
}

export function nqGenericConstraintOrdered(typeCode: int): bool { return nqCompilerTypeIsNumeric(typeCode) || typeCode == nqAstTypeString() }
export function nqGenericConstraintNumeric(typeCode: int): bool { return nqCompilerTypeIsNumeric(typeCode) }
