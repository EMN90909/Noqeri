module noqeri.compiler.selfhost.backend
import "nir.nqr"
import "targets.nqr"
import "object_formats.nqr"
import "abi.nqr"

record NqBackendPlan {
    target: NqTargetInfo
    abi: NqAbiInfo
    objectMachine: u32
    codeAlignment: usize
    dataAlignment: usize
}

export function nqBackendOk(): isize { return 0 }
export function nqBackendUnsupportedTarget(): isize { return -400 }
export function nqBackendUnsupportedOpcode(): isize { return -401 }
export function nqBackendInvalidAbi(): isize { return -402 }
export function nqBackendInvalidNir(): isize { return -403 }
export function nqBackendUnsafeOpcode(): isize { return -404 }

export function nqBackendClassNone(): int { return 0 }
export function nqBackendClassConstant(): int { return 1 }
export function nqBackendClassMove(): int { return 2 }
export function nqBackendClassMemory(): int { return 3 }
export function nqBackendClassArithmetic(): int { return 4 }
export function nqBackendClassControl(): int { return 5 }
export function nqBackendClassCall(): int { return 6 }
export function nqBackendClassAtomic(): int { return 7 }
export function nqBackendClassIntrinsic(): int { return 8 }
export function nqBackendClassUnsafeAsm(): int { return 9 }
export function nqBackendClassErrorFlow(): int { return 10 }
export function nqBackendClassSafetyCheck(): int { return 11 }
export function nqBackendClassAbi(): int { return 12 }

export function nqBackendTargetReady(target: int): bool { return nqTargetValid(target) && nqTargetPointerBytes(target) == 8 as usize }
export function nqBackendOpcodeReady(opcode: int): bool { return nqNirOpcodeValid(opcode) }
export function nqBackendValidate(target: int, opcode: int): isize { if !nqBackendTargetReady(target) { return nqBackendUnsupportedTarget() } if !nqBackendOpcodeReady(opcode) { return nqBackendUnsupportedOpcode() } return nqBackendOk() }
export function nqBackendPrologueStackAlign(target: int): usize { return nqTargetStackAlignment(target) }
export function nqBackendNeedsShadowSpace(target: int): bool { return nqTargetAbi(target) == nqAbiWin64() }
export function nqBackendShadowSpaceBytes(target: int): usize { if nqBackendNeedsShadowSpace(target) { return 32 as usize } return 0 as usize }
export function nqBackendRedZoneBytes(target: int): usize { if nqTargetAbi(target) == nqAbiSysV64() && nqTargetArchitecture(target) == nqArchX64() { return 128 as usize } return 0 as usize }

export function nqBackendOpcodeClass(opcode: int): int {
    if opcode == nqNirNop() || opcode == nqNirLabel() { return nqBackendClassNone() }
    if opcode == nqNirConstI64() || opcode == nqNirConstF64() || opcode == nqNirConstString() { return nqBackendClassConstant() }
    if opcode == nqNirMove() || opcode == nqNirCast() { return nqBackendClassMove() }
    if opcode == nqNirLoad() || opcode == nqNirStore() || opcode == nqNirAddr() || opcode == nqNirPtrAdd() || opcode == nqNirStackAlloc() || opcode == nqNirLoadMemory() || opcode == nqNirStoreMemory() || opcode == nqNirSliceData() || opcode == nqNirSliceLen() || opcode == nqNirMakeSlice() { return nqBackendClassMemory() }
    if nqNirIsPureArithmetic(opcode) || opcode == nqNirNeg() || opcode == nqNirNot() { return nqBackendClassArithmetic() }
    if opcode == nqNirJump() || opcode == nqNirBranch() || opcode == nqNirReturn() || opcode == nqNirPhi() { return nqBackendClassControl() }
    if opcode == nqNirCall() || opcode == nqNirCallArg() { return nqBackendClassCall() }
    if opcode == nqNirParameter() { return nqBackendClassAbi() }
    if opcode >= nqNirAtomicLoad() && opcode <= nqNirFence() { return nqBackendClassAtomic() }
    if opcode == nqNirIntrinsic() { return nqBackendClassIntrinsic() }
    if opcode == nqNirAsm() { return nqBackendClassUnsafeAsm() }
    if opcode == nqNirTry() || opcode == nqNirThrow() { return nqBackendClassErrorFlow() }
    if opcode == nqNirBoundsCheck() || opcode == nqNirOverflowCheck() { return nqBackendClassSafetyCheck() }
    return nqBackendClassNone()
}

export function nqBackendPlanInit(target: int, out: *NqBackendPlan): isize {
    if out == null || !nqBackendTargetReady(target) { return nqBackendUnsupportedTarget() }
    if !nqTargetDescribe(target, &out.target) { return nqBackendUnsupportedTarget() }
    if !nqAbiDescribe(target, &out.abi) { return nqBackendInvalidAbi() }
    out.objectMachine = nqObjectMachine(target)
    out.codeAlignment = nqObjectSectionAlignment(target, true)
    out.dataAlignment = nqObjectSectionAlignment(target, false)
    if out.objectMachine == 0 as u32 || out.codeAlignment == 0 as usize { return nqBackendUnsupportedTarget() }
    return nqBackendOk()
}

export function nqBackendInstructionValid(target: int, instruction: *NqNirInstruction, unsafeAllowed: bool): isize {
    if !nqBackendTargetReady(target) { return nqBackendUnsupportedTarget() }
    if !nqNirInstructionValid(instruction) { return nqBackendInvalidNir() }
    if nqBackendOpcodeClass(instruction.opcode) == nqBackendClassNone() && instruction.opcode != nqNirNop() && instruction.opcode != nqNirLabel() { return nqBackendUnsupportedOpcode() }
    if instruction.opcode == nqNirAsm() && !unsafeAllowed { return nqBackendUnsafeOpcode() }
    if (instruction.flags / nqNirFlagUnsafe()) % 2 as u32 == 1 as u32 && !unsafeAllowed { return nqBackendUnsafeOpcode() }
    return nqBackendOk()
}

export function nqBackendProgramValid(target: int, instructions: []NqNirInstruction, unsafeAllowed: bool): isize {
    let index: usize = 0 as usize
    while index < len(instructions) {
        let status: isize = nqBackendInstructionValid(target, &instructions[index], unsafeAllowed)
        if status < 0 { return status }
        index = index + 1 as usize
    }
    return nqBackendOk()
}
