                if !nqX64Put8(slice(textBuf), &textPos, 0x0f as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x84 as u8) { return -2 as isize }
                if jumpPatchCount >= 16384 as usize { return -46 as isize }
                jumpPatches[jumpPatchCount].codeOffset = textPos
                jumpPatches[jumpPatchCount].targetLocalPc = (ins.immediate as usize) - firstPc
                jumpPatchCount = jumpPatchCount + 1 as usize
                if !nqX64PutI32(slice(textBuf), &textPos, 0 as i64) { return -2 as isize }
            } else if op == nqNirCallArg() {
                let aIdx: usize = ins.immediate as usize
                if aIdx >= 64 as usize { return -47 as isize }
                pendingArgRegs[aIdx] = ins.left
                if aIdx + 1 as usize > pendingCount { pendingCount = aIdx + 1 as usize }
            } else if op == nqNirCall() {
                let arity: usize = ins.width
                if ins.symbol == symLenId && arity == 1 as usize {
                    let argR: isize = pendingArgRegs[0]
                    if regArrayLen[argR as usize] > 0 as usize {
                        if !nqX64EmitMovImm64(slice(textBuf), &textPos, 0, regArrayLen[argR as usize] as i64) { return -2 as isize }
                    } else {
                        if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (argR as usize) * 8 as usize) { return -2 as isize }
                        if !nqX64Put8(slice(textBuf), &textPos, 0x48 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x8b as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x40 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x08 as u8) { return -2 as isize }
                    }
                    if ins.dest >= 0 as isize {
                        if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
                    }
                    pendingCount = 0 as usize
                } else if ins.symbol == symSliceId && (arity == 1 as usize || arity == 2 as usize) {
                    let argR: isize = pendingArgRegs[0]
                    let sDisp: usize = nextSliceDisp + 16 as usize
                    nextSliceDisp = nextSliceDisp + 16 as usize
                    if regArrayLen[argR as usize] > 0 as usize {
                        if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (argR as usize) * 8 as usize) { return -2 as isize }
                        if !nqX64EmitStoreRbp(slice(textBuf), &textPos, sDisp, 0) { return -2 as isize }
                        if arity == 2 as usize {
                            if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (pendingArgRegs[1] as usize) * 8 as usize) { return -2 as isize }
                        } else {
                            if !nqX64EmitMovImm64(slice(textBuf), &textPos, 0, regArrayLen[argR as usize] as i64) { return -2 as isize }
                        }
                        if !nqX64EmitStoreRbp(slice(textBuf), &textPos, sDisp - 8 as usize, 0) { return -2 as isize }
                    } else {
                        if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (argR as usize) * 8 as usize) { return -2 as isize }
                        if arity == 2 as usize && fn.symbol == symNativeMainId {
                            // rcx = rax (raw pointer from nqNativeMainCompile sourcePtr/outPtr)
                            if !nqX64EmitMovRR(slice(textBuf), &textPos, 1, 0) { return -2 as isize }
                        } else {
                            // rcx = [rax] (dereference slice descriptor data pointer)
                            if !nqX64Put8(slice(textBuf), &textPos, 0x48 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x8b as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x08 as u8) { return -2 as isize }
                        }
                        if !nqX64EmitStoreRbp(slice(textBuf), &textPos, sDisp, 1) { return -2 as isize }
                        if arity == 2 as usize {
                            if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (pendingArgRegs[1] as usize) * 8 as usize) { return -2 as isize }
                        } else {
                            // rax = [rax + 8]
                            if !nqX64Put8(slice(textBuf), &textPos, 0x48 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x8b as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x40 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x08 as u8) { return -2 as isize }
                        }
                        if !nqX64EmitStoreRbp(slice(textBuf), &textPos, sDisp - 8 as usize, 0) { return -2 as isize }
                    }
                    if !nqX64EmitLeaRbp(slice(textBuf), &textPos, 0, sDisp) { return -2 as isize }
                    if ins.dest >= 0 as isize {
                        if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
                        regIsSlice[ins.dest as usize] = true
                    }
                    pendingCount = 0 as usize
                } else {
                    // Check if internal function
                    let targetFnIdx: isize = -1 as isize
                    let fi2: usize = 0 as usize
                    while fi2 < len(functions) {
                        if functions[fi2].symbol == ins.symbol { targetFnIdx = fi2 as isize break }
                        fi2 = fi2 + 1 as usize
                    }
                    if targetFnIdx < 0 as isize && arity == 0 as usize && ins.sourceEnd > ins.sourceStart {
                        // Zero-init call!
                        let zk: int = 0
                        let zc: usize = 0 as usize
                        let zsz: usize = nqX64ResolveTypeSize(source, ins.sourceStart, ins.sourceEnd, slice(recCache), &recCount, &zk, &zc)
                        if zk == 0 {
                            if !nqX64EmitMovImm64(slice(textBuf), &textPos, 0, 0 as i64) { return -2 as isize }
                            if ins.dest >= 0 as isize {
                                if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
                            }
                        } else if zk == 1 {
                            let sDisp: usize = nextSliceDisp + 16 as usize
                            nextSliceDisp = nextSliceDisp + 16 as usize
                            if !nqX64EmitMovImm64(slice(textBuf), &textPos, 0, 0 as i64) { return -2 as isize }
                            if !nqX64EmitStoreRbp(slice(textBuf), &textPos, sDisp, 0) { return -2 as isize }
                            if !nqX64EmitStoreRbp(slice(textBuf), &textPos, sDisp - 8 as usize, 0) { return -2 as isize }
                            if !nqX64EmitLeaRbp(slice(textBuf), &textPos, 0, sDisp) { return -2 as isize }
                            if ins.dest >= 0 as isize {
                                if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
                                regIsSlice[ins.dest as usize] = true
                            }
                        } else {
                            if zc > 0 as usize { regArrayLen[ins.dest as usize] = zc }
                            else { regArrayLen[ins.dest as usize] = 1 as usize }
                            if zsz > 4096 as usize {
                                if symArenaAlloc < 0 as isize {
                                    symArenaAlloc = nqX64FindOrAddExtern(slice(syms), &symCount, slice(strtabBuf), &strtabPos, slice(rtAllocName), 0 as u64)
                                    if symArenaAlloc < 0 as isize { return -3 as isize }
                                }
                                if !nqX64EmitMovImm64(slice(textBuf), &textPos, 7, zsz as i64) { return -2 as isize }
                                if !nqX64Put8(slice(textBuf), &textPos, 0xe8 as u8) { return -2 as isize }
                                if !nqX64AddRela(slice(textRelas), &textRelaCount, textPos as u64, symArenaAlloc as u32, 4 as u32, -4 as i64) { return -3 as isize }
                                if !nqX64PutI32(slice(textBuf), &textPos, 0 as i64) { return -2 as isize }
                                if ins.dest >= 0 as isize {
                                    if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
                                }
                            } else {
                                if zsz == 0 as usize { zsz = 8 as usize }
                                let alignedZsz: usize = nqX64AlignUp(zsz, 16 as usize)
                                nextAllocDisp = nextAllocDisp + alignedZsz
                                let disp: usize = nextAllocDisp
                                if !nqX64EmitLeaRbp(slice(textBuf), &textPos, 7, disp) { return -2 as isize }
                                if !nqX64Put8(slice(textBuf), &textPos, 0x31 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0xc0 as u8) { return -2 as isize }
                                if !nqX64EmitMovImm64(slice(textBuf), &textPos, 1, (alignedZsz / 8 as usize) as i64) { return -2 as isize }
                                if !nqX64Put8(slice(textBuf), &textPos, 0xf3 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x48 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0xab as u8) { return -2 as isize }
                                if !nqX64EmitLeaRbp(slice(textBuf), &textPos, 0, disp) { return -2 as isize }
                                if ins.dest >= 0 as isize {
                                    if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
                                }
                            }
                        }
                        pendingCount = 0 as usize
                    } else {
                        // Normal ABI call
                        let stackArgs: usize = 0 as usize
                        if arity > 6 as usize { stackArgs = arity - 6 as usize }
                        let stackPad: usize = 0 as usize
                        if stackArgs % 2 as usize == 1 as usize {
                            stackPad = 8 as usize
                            if !nqX64EmitSubRsp32(slice(textBuf), &textPos, 8 as usize) { return -2 as isize }
                        }
                        let ai: usize = arity
                        while ai > 6 as usize {
                            ai = ai - 1 as usize
                            if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (pendingArgRegs[ai] as usize) * 8 as usize) { return -2 as isize }
                            if !nqX64EmitPushReg(slice(textBuf), &textPos, 0) { return -2 as isize }
                        }
                        let regArgs: usize = arity
                        if regArgs > 6 as usize { regArgs = 6 as usize }
                        ai = 0 as usize
                        while ai < regArgs {
                            if !nqX64EmitLoadRbp(slice(textBuf), &textPos, nqX64AbiArgReg(ai), regBaseOff + (pendingArgRegs[ai] as usize) * 8 as usize) { return -2 as isize }
                            ai = ai + 1 as usize
                        }
                        let callSym: isize = 0 as isize
                        if ins.symbol == symPrintId {
                            if symPrintInt < 0 as isize {
                                symPrintInt = nqX64FindOrAddExtern(slice(syms), &symCount, slice(strtabBuf), &strtabPos, slice(rtPrintName), 0 as u64)
                                if symPrintInt < 0 as isize { return -3 as isize }
                            }
                            callSym = symPrintInt
                        } else if targetFnIdx >= 0 as isize {
                            callSym = fnLocalSymIdx[targetFnIdx as usize] as isize
                        } else {
                            let nameLen: usize = ins.sourceEnd - ins.sourceStart
                            let nameBuf: [u8; 256]
                            if nameLen > 255 as usize { nameLen = 255 as usize }
                            let k: usize = 0 as usize
                            while k < nameLen { nameBuf[k] = source[ins.sourceStart + k] k = k + 1 as usize }
                            callSym = nqX64FindOrAddExtern(slice(syms), &symCount, slice(strtabBuf), &strtabPos, slice(nameBuf, nameLen), ins.symbol)
                            if callSym < 0 as isize { return -3 as isize }
                        }
                        if !nqX64Put8(slice(textBuf), &textPos, 0xe8 as u8) { return -2 as isize }
                        if !nqX64AddRela(slice(textRelas), &textRelaCount, textPos as u64, callSym as u32, 4 as u32, -4 as i64) { return -3 as isize }
                        if !nqX64PutI32(slice(textBuf), &textPos, 0 as i64) { return -2 as isize }
                        if stackArgs > 0 as usize || stackPad > 0 as usize {
                            if !nqX64EmitAddRsp32(slice(textBuf), &textPos, stackArgs * 8 as usize + stackPad) { return -2 as isize }
                        }
                        if ins.dest >= 0 as isize {
                            if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
                        }
                        pendingCount = 0 as usize
                    }
                }
            } else if op == nqNirReturn() {
                if ins.left >= 0 as isize {
                    if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (ins.left as usize) * 8 as usize) { return -2 as isize }
                } else {
                    if !nqX64EmitMovImm64(slice(textBuf), &textPos, 0, 0 as i64) { return -2 as isize }
                }
                if usesArena {
                    if symArenaReset < 0 as isize {
                        symArenaReset = nqX64FindOrAddExtern(slice(syms), &symCount, slice(strtabBuf), &strtabPos, slice(rtResetName), 0 as u64)
                        if symArenaReset < 0 as isize { return -3 as isize }
                    }
                    if !nqX64EmitPushReg(slice(textBuf), &textPos, 0) { return -2 as isize }
                    if !nqX64EmitSubRsp32(slice(textBuf), &textPos, 8 as usize) { return -2 as isize }
                    if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 7, arenaMarkDisp) { return -2 as isize }
                    if !nqX64Put8(slice(textBuf), &textPos, 0xe8 as u8) { return -2 as isize }
                    if !nqX64AddRela(slice(textRelas), &textRelaCount, textPos as u64, symArenaReset as u32, 4 as u32, -4 as i64) { return -3 as isize }
                    if !nqX64PutI32(slice(textBuf), &textPos, 0 as i64) { return -2 as isize }
                    if !nqX64EmitAddRsp32(slice(textBuf), &textPos, 8 as usize) { return -2 as isize }
                    if !nqX64EmitPopReg(slice(textBuf), &textPos, 0) { return -2 as isize }
                }
                if !nqX64Put8(slice(textBuf), &textPos, 0xc9 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0xc3 as u8) { return -2 as isize }
            } else if op == nqNirTry() {
                if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (ins.left as usize) * 8 as usize) { return -2 as isize }
                // test rax, rax; jns +2; leave; ret -> 48 85 c0 79 02 c9 c3
                if !nqX64Put8(slice(textBuf), &textPos, 0x48 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x85 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0xc0 as u8) { return -2 as isize }
                if !nqX64Put8(slice(textBuf), &textPos, 0x79 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x02 as u8) { return -2 as isize }
                if !nqX64Put8(slice(textBuf), &textPos, 0xc9 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0xc3 as u8) { return -2 as isize }
                if !nqX64EmitStoreRbp(slice(textBuf), &textPos, regBaseOff + (ins.dest as usize) * 8 as usize, 0) { return -2 as isize }
            } else if op == nqNirThrow() {
                if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 0, regBaseOff + (ins.left as usize) * 8 as usize) { return -2 as isize }
                if !nqX64Put8(slice(textBuf), &textPos, 0xc9 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0xc3 as u8) { return -2 as isize }
            } else if op == nqNirOverflowCheck() {
                // Overflow checks are handled inline or no-op
            } else {
                return -1 as isize
            }
            pc = pc + 1 as usize
        }

        instrOffsets[countPc] = textPos
        if !nqX64EmitMovImm64(slice(textBuf), &textPos, 0, 0 as i64) { return -2 as isize }
        if usesArena {
            if symArenaReset < 0 as isize {
                symArenaReset = nqX64FindOrAddExtern(slice(syms), &symCount, slice(strtabBuf), &strtabPos, slice(rtResetName), 0 as u64)
                if symArenaReset < 0 as isize { return -3 as isize }
            }
            if !nqX64EmitPushReg(slice(textBuf), &textPos, 0) { return -2 as isize }
            if !nqX64EmitSubRsp32(slice(textBuf), &textPos, 8 as usize) { return -2 as isize }
            if !nqX64EmitLoadRbp(slice(textBuf), &textPos, 7, arenaMarkDisp) { return -2 as isize }
            if !nqX64Put8(slice(textBuf), &textPos, 0xe8 as u8) { return -2 as isize }
            if !nqX64AddRela(slice(textRelas), &textRelaCount, textPos as u64, symArenaReset as u32, 4 as u32, -4 as i64) { return -3 as isize }
            if !nqX64PutI32(slice(textBuf), &textPos, 0 as i64) { return -2 as isize }
            if !nqX64EmitAddRsp32(slice(textBuf), &textPos, 8 as usize) { return -2 as isize }
            if !nqX64EmitPopReg(slice(textBuf), &textPos, 0) { return -2 as isize }
        }
        if !nqX64Put8(slice(textBuf), &textPos, 0xc9 as u8) || !nqX64Put8(slice(textBuf), &textPos, 0xc3 as u8) { return -2 as isize }

        // Emit cold bounds-check trap stub if needed
        if hasBoundsCheck {
            if symBoundsTrap < 0 as isize {
                symBoundsTrap = nqX64FindOrAddExtern(slice(syms), &symCount, slice(strtabBuf), &strtabPos, slice(rtBoundsName), 0 as u64)
                if symBoundsTrap < 0 as isize { return -3 as isize }
            }
            let trapOff: usize = textPos
            if !nqX64Put8(slice(textBuf), &textPos, 0xe8 as u8) { return -2 as isize }
            if !nqX64AddRela(slice(textRelas), &textRelaCount, textPos as u64, symBoundsTrap as u32, 4 as u32, -4 as i64) { return -3 as isize }
            if !nqX64PutI32(slice(textBuf), &textPos, 0 as i64) { return -2 as isize }
            if !nqX64Put8(slice(textBuf), &textPos, 0x0f as u8) || !nqX64Put8(slice(textBuf), &textPos, 0x0b as u8) { return -2 as isize } // ud2
            let bi: usize = 0 as usize
            while bi < boundsFailCount {
                let pOff: usize = boundsFailPatches[bi]
                if !nqX64PatchI32(slice(textBuf), pOff, trapOff as i64 - (pOff as i64 + 4 as i64)) { return -3 as isize }
                bi = bi + 1 as usize
            }
        }

        // Patch all internal jumps/branches in this function
        let ji: usize = 0 as usize
        while ji < jumpPatchCount {
            let pOff: usize = jumpPatches[ji].codeOffset
            let targetPc: usize = jumpPatches[ji].targetLocalPc
            if targetPc > countPc { return -31 as isize }
            let targetAddr: usize = instrOffsets[targetPc]
            if !nqX64PatchI32(slice(textBuf), pOff, targetAddr as i64 - (pOff as i64 + 4 as i64)) { return -3 as isize }
            ji = ji + 1 as usize
        }

        syms[fnLocalSymIdx[fIdx]].size = (textPos - fnCodeStart) as u64
        fIdx = fIdx + 1 as usize
    }

    // Build .shstrtab: "\0.text\0.rodata\0.data\0.rela.text\0.rela.data\0.symtab\0.strtab\0.shstrtab\0"
    let shstrtab: [u8; 71] = [
        0 as u8,
        46 as u8, 116 as u8, 101 as u8, 120 as u8, 116 as u8, 0 as u8,
        46 as u8, 114 as u8, 111 as u8, 100 as u8, 97 as u8, 116 as u8, 97 as u8, 0 as u8,
        46 as u8, 100 as u8, 97 as u8, 116 as u8, 97 as u8, 0 as u8,
        46 as u8, 114 as u8, 101 as u8, 108 as u8, 97 as u8, 46 as u8, 116 as u8, 101 as u8, 120 as u8, 116 as u8, 0 as u8,
        46 as u8, 114 as u8, 101 as u8, 108 as u8, 97 as u8, 46 as u8, 100 as u8, 97 as u8, 116 as u8, 97 as u8, 0 as u8,
        46 as u8, 115 as u8, 121 as u8, 109 as u8, 116 as u8, 97 as u8, 98 as u8, 0 as u8,
        46 as u8, 115 as u8, 116 as u8, 114 as u8, 116 as u8, 97 as u8, 98 as u8, 0 as u8,
        46 as u8, 115 as u8, 104 as u8, 115 as u8, 116 as u8, 114 as u8, 116 as u8, 97 as u8, 98 as u8, 0 as u8,
        0 as u8, 0 as u8
    ]
    let shstrtabLen: usize = 69 as usize

    // Compute file layout:
    // 64 bytes ELF header + 9 * 64 = 576 bytes section headers -> 640 bytes
    let textStart: usize = 640 as usize
    let rodataStart: usize = nqX64AlignUp(textStart + textPos, 16 as usize)
    let dataStart: usize = nqX64AlignUp(rodataStart + rodataPos, 16 as usize)
    let relaTextStart: usize = nqX64AlignUp(dataStart + dataPos, 8 as usize)
    let relaTextBytes: usize = textRelaCount * 24 as usize
    let relaDataStart: usize = nqX64AlignUp(relaTextStart + relaTextBytes, 8 as usize)
    let relaDataBytes: usize = dataRelaCount * 24 as usize
    let symtabStart: usize = nqX64AlignUp(relaDataStart + relaDataBytes, 8 as usize)
    let symtabBytes: usize = symCount * 24 as usize
    let strtabStart: usize = symtabStart + symtabBytes
    let shstrtabStart: usize = strtabStart + strtabPos
    let totalBytes: usize = shstrtabStart + shstrtabLen

    if len(buffer) < totalBytes { return -2 as isize }
    if !nqObjectZero(buffer, 0 as usize, totalBytes) { return -2 as isize }
    if nqElfWriteHeader64(buffer, 0 as usize, target, 64 as u64, 9 as usize, 8 as usize) != 64 as isize { return -3 as isize }

    // Section 1: .text (nameOff=1, SHT_PROGBITS=1, SHF_ALLOC|SHF_EXECINSTR=6)
    if !nqElfWriteSectionHeader64(buffer, 128 as usize, 1 as u32, 1 as u32, 6 as u64, textStart as u64, textPos as u64, 0 as u32, 0 as u32, 16 as u64, 0 as u64) { return -3 as isize }
    // Section 2: .rodata (nameOff=7, SHT_PROGBITS=1, SHF_ALLOC=2)
    if !nqElfWriteSectionHeader64(buffer, 192 as usize, 7 as u32, 1 as u32, 2 as u64, rodataStart as u64, rodataPos as u64, 0 as u32, 0 as u32, 16 as u64, 0 as u64) { return -3 as isize }
    // Section 3: .data (nameOff=15, SHT_PROGBITS=1, SHF_ALLOC|SHF_WRITE=3)
    if !nqElfWriteSectionHeader64(buffer, 256 as usize, 15 as u32, 1 as u32, 3 as u64, dataStart as u64, dataPos as u64, 0 as u32, 0 as u32, 8 as u64, 0 as u64) { return -3 as isize }
    // Section 4: .rela.text (nameOff=21, SHT_RELA=4, link=6 (.symtab), info=1 (.text))
    if !nqElfWriteSectionHeader64(buffer, 320 as usize, 21 as u32, 4 as u32, 0x40 as u64, relaTextStart as u64, relaTextBytes as u64, 6 as u32, 1 as u32, 8 as u64, 24 as u64) { return -3 as isize }
    // Section 5: .rela.data (nameOff=32, SHT_RELA=4, link=6 (.symtab), info=3 (.data))
    if !nqElfWriteSectionHeader64(buffer, 384 as usize, 32 as u32, 4 as u32, 0x40 as u64, relaDataStart as u64, relaDataBytes as u64, 6 as u32, 3 as u32, 8 as u64, 24 as u64) { return -3 as isize }
    // Section 6: .symtab (nameOff=43, SHT_SYMTAB=2, link=7 (.strtab), info=firstGlobalSym)
    if !nqElfWriteSectionHeader64(buffer, 448 as usize, 43 as u32, 2 as u32, 0 as u64, symtabStart as u64, symtabBytes as u64, 7 as u32, firstGlobalSym as u32, 8 as u64, 24 as u64) { return -3 as isize }
    // Section 7: .strtab (nameOff=51, SHT_STRTAB=3)
    if !nqElfWriteSectionHeader64(buffer, 512 as usize, 51 as u32, 3 as u32, 0 as u64, strtabStart as u64, strtabPos as u64, 0 as u32, 0 as u32, 1 as u64, 0 as u64) { return -3 as isize }
    // Section 8: .shstrtab (nameOff=59, SHT_STRTAB=3)
    if !nqElfWriteSectionHeader64(buffer, 576 as usize, 59 as u32, 3 as u32, 0 as u64, shstrtabStart as u64, shstrtabLen as u64, 0 as u32, 0 as u32, 1 as u64, 0 as u64) { return -3 as isize }

    // Copy section bytes
    let ci: usize = 0 as usize
    while ci < textPos { buffer[textStart + ci] = textBuf[ci] ci = ci + 1 as usize }
    ci = 0 as usize
    while ci < rodataPos { buffer[rodataStart + ci] = rodataBuf[ci] ci = ci + 1 as usize }
    ci = 0 as usize
    while ci < dataPos { buffer[dataStart + ci] = dataBuf[ci] ci = ci + 1 as usize }
    ci = 0 as usize
    while ci < strtabPos { buffer[strtabStart + ci] = strtabBuf[ci] ci = ci + 1 as usize }
    ci = 0 as usize
    while ci < shstrtabLen { buffer[shstrtabStart + ci] = shstrtab[ci] ci = ci + 1 as usize }

    // Write .rela.text & .rela.data (Elf64_Rela: r_offset(8), r_info(8 = (sym<<32)|type), r_addend(8))
    let rPos: usize = relaTextStart
    ci = 0 as usize
    while ci < textRelaCount {
        if !nqX64PutU64(buffer, &rPos, textRelas[ci].offset) { return -3 as isize }
        if !nqX64Put32(buffer, &rPos, textRelas[ci].relocType) { return -3 as isize }
        if !nqX64Put32(buffer, &rPos, textRelas[ci].symIndex) { return -3 as isize }
        if !nqX64PutI64(buffer, &rPos, textRelas[ci].addend) { return -3 as isize }
        ci = ci + 1 as usize
    }
    rPos = relaDataStart
    ci = 0 as usize
    while ci < dataRelaCount {
        if !nqX64PutU64(buffer, &rPos, dataRelas[ci].offset) { return -3 as isize }
        if !nqX64Put32(buffer, &rPos, dataRelas[ci].relocType) { return -3 as isize }
        if !nqX64Put32(buffer, &rPos, dataRelas[ci].symIndex) { return -3 as isize }
        if !nqX64PutI64(buffer, &rPos, dataRelas[ci].addend) { return -3 as isize }
        ci = ci + 1 as usize
    }

    // Write .symtab (Elf64_Sym: st_name(4), st_info(1), st_other(1), st_shndx(2), st_value(8), st_size(8))
    let sPos: usize = symtabStart
    ci = 0 as usize
    while ci < symCount {
        if !nqX64Put32(buffer, &sPos, syms[ci].nameOff) { return -3 as isize }
        if !nqX64Put8(buffer, &sPos, syms[ci].info) { return -3 as isize }
        if !nqX64Put8(buffer, &sPos, syms[ci].other) { return -3 as isize }
        if !nqX64Put16(buffer, &sPos, syms[ci].shndx) { return -3 as isize }
        if !nqX64PutU64(buffer, &sPos, syms[ci].value) { return -3 as isize }
        if !nqX64PutU64(buffer, &sPos, syms[ci].size) { return -3 as isize }
        ci = ci + 1 as usize
    }

    return totalBytes as isize
}
