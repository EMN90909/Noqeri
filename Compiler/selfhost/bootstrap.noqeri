export function stage1VersionMajor(): int { return nqCompilerVersionMajor() }
export function stage1VersionMinor(): int { return nqCompilerVersionMinor() }
export function stage1VersionPatch(): int { return nqCompilerVersionPatch() }
export function stage1CheckSource(source: []u8): isize { return nqPipelineCheck(source) }
export function stage1TokenCount(source: []u8): usize { return nqCompilerSourceTokenCount(source) }
export function stage1Fingerprint(source: []u8): u32 { return nqCompilerSourceFingerprint(source) }
export function stage1CanImplicitWiden(fromCode: int, toCode: int): bool { return nqCompilerCanImplicitWiden(fromCode, toCode) }
export function stage1PackageCoordinateValid(value: []u8): bool { return nqPackageCoordinateValid(value) }
export function stage1PackageArchiveLimitsValid(files: usize, bytes: usize): bool { return nqPackageArchiveLimitsValid(files, bytes) }
export function stage1TargetValid(target: int): bool { return nqTargetValid(target) }
export function stage1TargetObjectFormat(target: int): int { return nqTargetObjectFormat(target) }
export function stage1TargetAbi(target: int): int { return nqTargetAbi(target) }
export function stage1CompileReady(source: []u8, target: int): bool { return nqPipelineCompileReady(source, target) }
export function stage1NirOpcodeValid(opcode: int): bool { return nqNirOpcodeValid(opcode) }
export function stage1AbiIntegerArgRegisters(target: int): int { return nqAbiIntegerArgRegisters(target) }
export function stage1ProfileOptimization(profile: int): int { return nqProfileOptimization(profile) }
export function stage1CoffTargetValid(target: int): bool { return nqCoffTargetValid(target) }
export function stage1ElfTargetValid(target: int): bool { return nqElfTargetValid(target) }
export function stage1MachTargetValid(target: int): bool { return nqMachTargetValid(target) }

// Stage-2-facing entry points keep parsing, generic inference, lowering,
// optimisation, diagnostics instrumentation and portable module emission in Noqeri.
export function stage2Plan(source: []u8, target: int, debug: bool, unsafeAllowed: bool, out: *NqCompilePlan): isize { return nqPipelinePlan(source, target, debug, unsafeAllowed, out) }
export function stage2SyntaxErrorOffset(source: []u8): usize { return nqParserFirstErrorOffset(source) }
export function stage2ParseExpression(source: []u8, nodes: []NqAstNode, count: *usize, outEnd: *usize): isize { return nqParserParseExpression(source, 0 as usize, nodes, count, outEnd) }
export function stage2ParseProgram(source: []u8, nodes: []NqAstNode, count: *usize, first: *isize): isize { return nqParserParseProgram(source, nodes, count, first) }
export function stage2SemanticCheck(source: []u8, unsafeAllowed: bool): isize { return nqPipelineSemanticCheckMerged(source, unsafeAllowed) }
export function stage2SemanticErrorOffset(source: []u8, unsafeAllowed: bool): usize { return nqPipelineSemanticErrorOffset(source, unsafeAllowed) }
export function stage2InferGenerics(parameterTypes: []int, parameterSlots: []int, argumentTypes: []int, bindings: []int): isize { return nqGenericInfer(parameterTypes, parameterSlots, argumentTypes, bindings) }
export function stage2LowerExpression(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState): isize { return nqLowerExpression(source, nodes, nodeIndex, instructions, state) }
export function stage2CompileToNir(source: []u8, target: int, debug: bool, unsafeAllowed: bool, nodes: []NqAstNode, instructions: []NqNirInstruction, functions: []NqNirFunction, out: *NqCompileResult): isize { return nqPipelineCompileToNir(source, target, debug, unsafeAllowed, nodes, instructions, functions, out) }
export function stage2CompileToNqri(source: []u8, target: int, debug: bool, unsafeAllowed: bool, out: []u8): isize {
    let nodes: [NqAstNode; 131072]
    let instructions: [NqNirInstruction; 262144]
    let functions: [NqNirFunction; 8192]
    let result: NqCompileResult
    let status: isize = nqPipelineCompileToNir(source, target, debug, unsafeAllowed, slice(nodes), slice(instructions), slice(functions), &result)
    if status < 0 as isize { return status }
    return nqNqriWrite(source, slice(functions, result.functionCount), slice(instructions, result.instructionCount), out)
}
export function stage2NqriRequiredBytes(sourceBytes: usize, functionCount: usize, instructionCount: usize, out: *usize): isize { return nqNqriRequiredBytes(sourceBytes, functionCount, instructionCount, out) }
export function stage2WriteNqri(source: []u8, functions: []NqNirFunction, instructions: []NqNirInstruction, out: []u8): isize { return nqNqriWrite(source, functions, instructions, out) }
export function stage2Optimize(instructions: []NqNirInstruction, level: int): usize { return nqOptimizerRun(instructions, level) }
export function stage2ValidateNir(target: int, instructions: []NqNirInstruction, unsafeAllowed: bool): isize { return nqBackendProgramValid(target, instructions, unsafeAllowed) }
export function stage2RaceInstrumentable(instructions: []NqNirInstruction): bool { return nqRaceProgramInstrumentable(instructions) }
export function stage2ProofStatus(proof: *NqStage2Proof): isize { return nqStage2GateStatus(proof) }
export function stage2Verified(proof: *NqStage2Proof): bool { return nqStage2ProofValid(proof) }
