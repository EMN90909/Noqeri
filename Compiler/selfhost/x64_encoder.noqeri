            let ai: usize = 0 as usize
            while ai < argc {
                if nqX64IsFloat(argTypes[ai]) {
                    stackFlags[ai] = floatSeen >= 8 as usize
                    floatSeen = floatSeen + 1 as usize
                } else {
                    stackFlags[ai] = intSeen >= 6 as usize
                    intSeen = intSeen + 1 as usize
                }
                if stackFlags[ai] { stackCount = stackCount + 1 as usize }
                ai = ai + 1 as usize
            }
            let pad: usize = 0 as usize
            if stackCount % 2 as usize == 1 as usize { pad = 8 as usize }
            if pad > 0 as usize { if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x83 as u8)||!nqX64Put8(out,cursor,0xec as u8)||!nqX64Put8(out,cursor,0x08 as u8) { return nqX64Capacity() } }
            let ri: usize = argc
            while ri > 0 as usize {
                let idx: usize = ri - 1 as usize
                if stackFlags[idx] {
                    let argOffset: usize = nqX64CallArgOffset(regCount,variableCount,idx)
                    if !nqX64EmitLoadRaxSlot(out,cursor,argOffset)||!nqX64Put8(out,cursor,0x50 as u8) { return nqX64Capacity() }
                }
                ri = idx
            }
            intSeen = 0 as usize
            floatSeen = 0 as usize
            ai = 0 as usize
            while ai < argc {
                if !stackFlags[ai] {
                    let argOffset: usize = nqX64CallArgOffset(regCount,variableCount,ai)
                    if nqX64IsFloat(argTypes[ai]) { if !nqX64EmitLoadFloatArg(out,cursor,floatSeen,argOffset) { return nqX64Capacity() } floatSeen = floatSeen + 1 as usize }
                    else { if !nqX64EmitLoadIntegerArg(out,cursor,intSeen,argOffset) { return nqX64Capacity() } intSeen = intSeen + 1 as usize }
                } else {
                    if nqX64IsFloat(argTypes[ai]) { floatSeen = floatSeen + 1 as usize } else { intSeen = intSeen + 1 as usize }
                }
                ai = ai + 1 as usize
            }
            if ins.symbol == nqX64BuiltinTextLengthSymbol() {
                if !nqX64Put8(out,cursor,0xe8 as u8) { return nqX64Capacity() }
                let patch: usize = cursor[0]
                if !nqX64Put32(out,cursor,0 as u32)||!nqX64PatchRel32(out,patch,textLengthOffset) { return nqX64Capacity() }
            } else {
                let targetIndex: isize = nqX64FunctionIndex(functions,ins.symbol)
                if targetIndex < 0 as isize || nqX64Extern(&functions[targetIndex as usize]) { return nqX64External() }
                if !nqX64Put8(out,cursor,0xe8 as u8) { return nqX64Capacity() }
                let patch: usize = cursor[0]
                if !nqX64Put32(out,cursor,0 as u32)||!nqX64AddFixup(fixups,fixupCount,2,patch,0 as usize,ins.symbol,0 as usize,0 as usize) { return nqX64Capacity() }
            }
            let cleanup: usize = stackCount * 8 as usize + pad
            if cleanup > 0 as usize {
                if cleanup <= 127 as usize { if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x83 as u8)||!nqX64Put8(out,cursor,0xc4 as u8)||!nqX64Put8(out,cursor,cleanup as u8) { return nqX64Capacity() } }
                else { if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x81 as u8)||!nqX64Put8(out,cursor,0xc4 as u8)||!nqX64Put32(out,cursor,cleanup as u32) { return nqX64Capacity() } }
            }
            if destOffset > 0 as usize {
                if nqX64IsFloat(ins.typeCode) {
                    if !nqX64Put8(out,cursor,0x66 as u8)||!nqX64Put8(out,cursor,0x0f as u8)||!nqX64Put8(out,cursor,0xd6 as u8)||!nqX64Put8(out,cursor,0x85 as u8)||!nqX64PutDisp32(out,cursor,destOffset) { return nqX64Capacity() }
                } else if !nqX64EmitStoreRaxSlot(out,cursor,destOffset) { return nqX64Capacity() }
            }
        }
        else if ins.opcode == nqNirJump() {
            if ins.immediate < 0 as i64 || !nqX64EmitJumpFixup(out,cursor,fixups,fixupCount,-1,ins.immediate as usize) { return nqX64InvalidAt(index,ins.opcode) }
        }
        else if ins.opcode == nqNirBranch() {
            if leftOffset == 0 as usize || ins.immediate < 0 as i64 || !nqX64EmitLoadRaxSlot(out,cursor,leftOffset) { return nqX64InvalidAt(index,ins.opcode) }
            if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x85 as u8)||!nqX64Put8(out,cursor,0xc0 as u8)||!nqX64EmitJumpFixup(out,cursor,fixups,fixupCount,0x84,ins.immediate as usize) { return nqX64Capacity() }
        }
        else if ins.opcode == nqNirReturn() {
            if ins.left >= 0 as isize {
                if leftOffset == 0 as usize { return nqX64InvalidAt(index,ins.opcode) }
                let returnType: int = 0
                let local: usize = (ins.left - minReg) as usize
                if local < regCount { returnType = regTypes[local] }
                if nqX64IsFloat(returnType) {
                    if !nqX64Put8(out,cursor,0xf2 as u8)||!nqX64Put8(out,cursor,0x0f as u8)||!nqX64Put8(out,cursor,0x10 as u8)||!nqX64Put8(out,cursor,0x85 as u8)||!nqX64PutDisp32(out,cursor,leftOffset) { return nqX64Capacity() }
                } else if !nqX64EmitLoadRaxSlot(out,cursor,leftOffset) { return nqX64Capacity() }
            } else { if !nqX64Put8(out,cursor,0x31 as u8)||!nqX64Put8(out,cursor,0xc0 as u8) { return nqX64Capacity() } }
            if !nqX64Put8(out,cursor,0xc9 as u8)||!nqX64Put8(out,cursor,0xc3 as u8) { return nqX64Capacity() }
        }
        else if ins.opcode == nqNirTry() {
            if leftOffset == 0 as usize || destOffset == 0 as usize || !nqX64EmitLoadRaxSlot(out,cursor,leftOffset) { return nqX64InvalidAt(index,ins.opcode) }
            if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x85 as u8)||!nqX64Put8(out,cursor,0xc0 as u8)||!nqX64Put8(out,cursor,0x79 as u8)||!nqX64Put8(out,cursor,0x02 as u8)||!nqX64Put8(out,cursor,0xc9 as u8)||!nqX64Put8(out,cursor,0xc3 as u8)||!nqX64EmitStoreRaxSlot(out,cursor,destOffset) { return nqX64Capacity() }
        }
        else if ins.opcode == nqNirThrow() {
            if leftOffset == 0 as usize || !nqX64EmitLoadRaxSlot(out,cursor,leftOffset) { return nqX64InvalidAt(index,ins.opcode) }
            if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x85 as u8)||!nqX64Put8(out,cursor,0xc0 as u8)||!nqX64Put8(out,cursor,0x78 as u8)||!nqX64Put8(out,cursor,0x07 as u8)||!nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0xf7 as u8)||!nqX64Put8(out,cursor,0xd8 as u8)||!nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x83 as u8)||!nqX64Put8(out,cursor,0xe8 as u8)||!nqX64Put8(out,cursor,0x01 as u8)||!nqX64Put8(out,cursor,0xc9 as u8)||!nqX64Put8(out,cursor,0xc3 as u8) { return nqX64Capacity() }
        }
        else if ins.opcode == nqNirPhi() {
            if leftOffset == 0 as usize || destOffset == 0 as usize || !nqX64EmitLoadRaxSlot(out,cursor,leftOffset)||!nqX64EmitStoreRaxSlot(out,cursor,destOffset) { return nqX64InvalidAt(index,ins.opcode) }
        }
        else if ins.opcode >= nqNirAtomicLoad() && ins.opcode <= nqNirFence() { return nqX64Unsupported() }
        else if ins.opcode == nqNirIntrinsic() || ins.opcode == nqNirAsm() || ins.opcode == nqNirOverflowCheck() { return nqX64Unsupported() }
        else { return nqX64Unsupported() }

        index = index + 1 as usize
    }
    functionSizes[functionIndex] = cursor[0] - functionStart
    return nqX64Ok()
}

export function nqX64EncodeProgram(source: []u8, functions: []NqNirFunction, instructions: []NqNirInstruction, out: []u8, textOffset: usize, functionOffsets: []usize, functionSizes: []usize, outTextEnd: *usize): isize {
    if outTextEnd == null || len(functionOffsets) < len(functions) || len(functionSizes) < len(functions) || textOffset >= len(out) { return nqX64Capacity() }
    let cursor: usize = textOffset
    let instructionOffsets: [usize; 262144]
    if len(instructions) > 262144 as usize { return nqX64Capacity() }
    let fixups: [NqX64Fixup; 262144]
    let fixupCount: usize = 0 as usize

    let helperStatus: isize = nqX64EmitTextLengthHelper(out,&cursor)
    if helperStatus < 0 as isize { return helperStatus }
    let textLengthOffset: usize = helperStatus as usize

    let fi: usize = 0 as usize
    while fi < len(functions) {
        let status: isize = nqX64EmitFunction(source,functions,fi,instructions,out,&cursor,slice(instructionOffsets),slice(fixups),&fixupCount,functionOffsets,functionSizes,textLengthOffset)
        if status < 0 as isize { return status }
        fi = fi + 1 as usize
    }

    let stringFixup: usize = 0 as usize
    while stringFixup < fixupCount {
        if fixups[stringFixup].kind == 3 {
            let target: usize = cursor
            if !nqX64DecodeString(source,fixups[stringFixup].sourceStart,fixups[stringFixup].sourceEnd,out,&cursor) { return nqX64Capacity() }
            if !nqX64PatchRel32(out,fixups[stringFixup].patchOffset,target) { return nqX64Range() }
        }
        stringFixup = stringFixup + 1 as usize
    }

    let fx: usize = 0 as usize
    while fx < fixupCount {
        let fix: *NqX64Fixup = &fixups[fx]
        if fix.kind == 1 {
            if fix.targetInstruction >= len(instructions) { return nqX64Invalid() }
            let target: usize = instructionOffsets[fix.targetInstruction]
            if target == 0 as usize || !nqX64PatchRel32(out,fix.patchOffset,target) { return nqX64Range() }
        } else if fix.kind == 2 {
            let targetIndex: isize = nqX64FunctionIndex(functions,fix.targetSymbol)
            if targetIndex < 0 as isize || functionOffsets[targetIndex as usize] == 0 as usize { return nqX64External() }
            if !nqX64PatchRel32(out,fix.patchOffset,functionOffsets[targetIndex as usize]) { return nqX64Range() }
        }
        fx = fx + 1 as usize
    }

    outTextEnd[0] = cursor
    return (cursor - textOffset) as isize
}
