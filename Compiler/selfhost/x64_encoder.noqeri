module noqeri.compiler.selfhost.x64_encoder
import "nir.noqeri"
import "ast.noqeri"
import "object_formats.noqeri"

record NqX64Fixup {
    kind: int
    patchOffset: usize
    targetInstruction: usize
    targetSymbol: u64
    sourceStart: usize
    sourceEnd: usize
}

export function nqX64Ok(): isize { return 0 as isize }
export function nqX64Unsupported(): isize { return -900 as isize }
export function nqX64Capacity(): isize { return -901 as isize }
export function nqX64Invalid(): isize { return -902 as isize }
export function nqX64Range(): isize { return -903 as isize }
export function nqX64External(): isize { return -904 as isize }
function nqX64InvalidAt(index: usize, opcode: int): isize {
    if index > 10000000 as usize || opcode < 0 || opcode > 63 { return nqX64Invalid() }
    return (0 as isize - 1000000 as isize) - (index as isize * 64 as isize) - opcode as isize
}

function nqX64Align8(value: usize): usize { return nqObjectAlignUp(value, 8 as usize) }
function nqX64Align16(value: usize): usize { return nqObjectAlignUp(value, 16 as usize) }
function nqX64IsFloat(code: int): bool { return code == nqAstTypeFloat() }
function nqX64IsUnsigned(code: int): bool { return code == nqAstTypeU8() || code == nqAstTypeU16() || code == nqAstTypeU32() || code == nqAstTypeU64() || code == nqAstTypeUsize() }

function nqX64Put8(out: []u8, cursor: *usize, value: u8): bool {
    if cursor == null || cursor[0] >= len(out) { return false }
    out[cursor[0]] = value
    cursor[0] = cursor[0] + 1 as usize
    return true
}
function nqX64Put32(out: []u8, cursor: *usize, value: u32): bool {
    if cursor == null || !nqObjectRangeValid(out, cursor[0], 4 as usize) { return false }
    if !nqObjectWriteU32LE(out, cursor[0], value) { return false }
    cursor[0] = cursor[0] + 4 as usize
    return true
}
function nqX64Put64(out: []u8, cursor: *usize, value: u64): bool {
    if cursor == null || !nqObjectRangeValid(out, cursor[0], 8 as usize) { return false }
    if !nqObjectWriteU64LE(out, cursor[0], value) { return false }
    cursor[0] = cursor[0] + 8 as usize
    return true
}
function nqX64PatchRel32(out: []u8, patchOffset: usize, targetOffset: usize): bool {
    if !nqObjectRangeValid(out, patchOffset, 4 as usize) { return false }
    let delta: i64 = targetOffset as i64 - (patchOffset + 4 as usize) as i64
    if delta < -2147483648 as i64 || delta > 2147483647 as i64 { return false }
    return nqObjectWriteU32LE(out, patchOffset, delta as u32)
}
function nqX64PutDisp32(out: []u8, cursor: *usize, offset: usize): bool {
    if offset > 2147483647 as usize { return false }
    return nqX64Put32(out, cursor, (0 as i64 - offset as i64) as u32)
}
function nqX64PutPositiveDisp32(out: []u8, cursor: *usize, offset: usize): bool {
    if offset > 2147483647 as usize { return false }
    return nqX64Put32(out, cursor, offset as u32)
}
function nqX64FloatBits(value: *float): u64 {
    if value == null { return 0 as u64 }
    let bits: *u64 = value as *u64
    return bits[0]
}

function nqX64RegOffset(reg: isize, minReg: isize, regCount: usize): usize {
    if reg < minReg || regCount == 0 as usize { return 0 as usize }
    let index: usize = (reg - minReg) as usize
    if index >= regCount { return 0 as usize }
    return (index + 1 as usize) * 8 as usize
}
function nqX64VariableIndex(symbols: []u64, count: usize, symbol: u64): isize {
    let index: usize = 0 as usize
    while index < count {
        if symbols[index] == symbol { return index as isize }
        index = index + 1 as usize
    }
    return -1 as isize
}
function nqX64VariableOffset(symbols: []u64, count: usize, regCount: usize, symbol: u64): usize {
    let index: isize = nqX64VariableIndex(symbols, count, symbol)
    if index < 0 as isize { return 0 as usize }
    return (regCount + index as usize + 1 as usize) * 8 as usize
}
function nqX64CallArgOffset(regCount: usize, variableCount: usize, argument: usize): usize {
    return (regCount + variableCount + argument + 1 as usize) * 8 as usize
}
function nqX64AddVariable(symbols: []u64, count: *usize, symbol: u64): bool {
    if count == null || symbol == 0 as u64 { return false }
    if nqX64VariableIndex(symbols, count[0], symbol) >= 0 as isize { return true }
    if count[0] >= len(symbols) { return false }
    symbols[count[0]] = symbol
    count[0] = count[0] + 1 as usize
    return true
}
function nqX64FunctionIndex(functions: []NqNirFunction, symbol: u64): isize {
    let index: usize = 0 as usize
    while index < len(functions) {
        if functions[index].symbol == symbol { return index as isize }
        index = index + 1 as usize
    }
    return -1 as isize
}
function nqX64Exported(function: *NqNirFunction): bool { return function != null && (function.flags / 1 as u32) % 2 as u32 == 1 as u32 }
function nqX64Extern(function: *NqNirFunction): bool { return function != null && (function.flags / 2 as u32) % 2 as u32 == 1 as u32 }

function nqX64EmitLoadRaxSlot(out: []u8, cursor: *usize, offset: usize): bool {
    return nqX64Put8(out,cursor,0x48 as u8) && nqX64Put8(out,cursor,0x8b as u8) && nqX64Put8(out,cursor,0x85 as u8) && nqX64PutDisp32(out,cursor,offset)
}
function nqX64EmitLoadR10Slot(out: []u8, cursor: *usize, offset: usize): bool {
    return nqX64Put8(out,cursor,0x4c as u8) && nqX64Put8(out,cursor,0x8b as u8) && nqX64Put8(out,cursor,0x95 as u8) && nqX64PutDisp32(out,cursor,offset)
}
function nqX64EmitStoreRaxSlot(out: []u8, cursor: *usize, offset: usize): bool {
    return nqX64Put8(out,cursor,0x48 as u8) && nqX64Put8(out,cursor,0x89 as u8) && nqX64Put8(out,cursor,0x85 as u8) && nqX64PutDisp32(out,cursor,offset)
}
function nqX64EmitStoreR10Slot(out: []u8, cursor: *usize, offset: usize): bool {
    return nqX64Put8(out,cursor,0x4c as u8) && nqX64Put8(out,cursor,0x89 as u8) && nqX64Put8(out,cursor,0x95 as u8) && nqX64PutDisp32(out,cursor,offset)
}
function nqX64EmitLeaRaxSlot(out: []u8, cursor: *usize, offset: usize): bool {
    return nqX64Put8(out,cursor,0x48 as u8) && nqX64Put8(out,cursor,0x8d as u8) && nqX64Put8(out,cursor,0x85 as u8) && nqX64PutDisp32(out,cursor,offset)
}
function nqX64EmitLeaR11Slot(out: []u8, cursor: *usize, offset: usize): bool {
    return nqX64Put8(out,cursor,0x4c as u8) && nqX64Put8(out,cursor,0x8d as u8) && nqX64Put8(out,cursor,0x9d as u8) && nqX64PutDisp32(out,cursor,offset)
}

function nqX64EmitLoadIntegerArg(out: []u8, cursor: *usize, registerIndex: usize, slotOffset: usize): bool {
    if registerIndex == 0 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0xbd as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 1 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0xb5 as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 2 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0x95 as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 3 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0x8d as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 4 as usize { return nqX64Put8(out,cursor,0x4c as u8)&&nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0x85 as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 5 as usize { return nqX64Put8(out,cursor,0x4c as u8)&&nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0x8d as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    return false
}
function nqX64EmitStoreIntegerParam(out: []u8, cursor: *usize, registerIndex: usize, slotOffset: usize): bool {
    if registerIndex == 0 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0xbd as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 1 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0xb5 as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 2 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0x95 as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 3 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0x8d as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 4 as usize { return nqX64Put8(out,cursor,0x4c as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0x85 as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    if registerIndex == 5 as usize { return nqX64Put8(out,cursor,0x4c as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0x8d as u8)&&nqX64PutDisp32(out,cursor,slotOffset) }
    return false
}
function nqX64EmitLoadFloatArg(out: []u8, cursor: *usize, registerIndex: usize, slotOffset: usize): bool {
    if registerIndex >= 8 as usize { return false }
    if !nqX64Put8(out,cursor,0xf3 as u8)||!nqX64Put8(out,cursor,0x0f as u8)||!nqX64Put8(out,cursor,0x7e as u8) { return false }
    if !nqX64Put8(out,cursor,(0x85 as usize + registerIndex * 8 as usize) as u8) { return false }
    return nqX64PutDisp32(out,cursor,slotOffset)
}
function nqX64EmitStoreFloatParam(out: []u8, cursor: *usize, registerIndex: usize, slotOffset: usize): bool {
    if registerIndex >= 8 as usize { return false }
    if !nqX64Put8(out,cursor,0x66 as u8)||!nqX64Put8(out,cursor,0x0f as u8)||!nqX64Put8(out,cursor,0xd6 as u8) { return false }
    if !nqX64Put8(out,cursor,(0x85 as usize + registerIndex * 8 as usize) as u8) { return false }
    return nqX64PutDisp32(out,cursor,slotOffset)
}

function nqX64EmitLoadMemory(out: []u8, cursor: *usize, width: usize, typeCode: int): bool {
    if width == 1 as usize {
        if nqX64IsUnsigned(typeCode) { return nqX64Put8(out,cursor,0x0f as u8)&&nqX64Put8(out,cursor,0xb6 as u8)&&nqX64Put8(out,cursor,0x00 as u8) }
        return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x0f as u8)&&nqX64Put8(out,cursor,0xbe as u8)&&nqX64Put8(out,cursor,0x00 as u8)
    }
    if width == 2 as usize {
        if nqX64IsUnsigned(typeCode) { return nqX64Put8(out,cursor,0x0f as u8)&&nqX64Put8(out,cursor,0xb7 as u8)&&nqX64Put8(out,cursor,0x00 as u8) }
        return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x0f as u8)&&nqX64Put8(out,cursor,0xbf as u8)&&nqX64Put8(out,cursor,0x00 as u8)
    }
    if width == 4 as usize {
        if nqX64IsUnsigned(typeCode) { return nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0x00 as u8) }
        return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x63 as u8)&&nqX64Put8(out,cursor,0x00 as u8)
    }
    if width == 8 as usize { return nqX64Put8(out,cursor,0x48 as u8)&&nqX64Put8(out,cursor,0x8b as u8)&&nqX64Put8(out,cursor,0x00 as u8) }
    return false
}
function nqX64EmitStoreMemory(out: []u8, cursor: *usize, width: usize): bool {
    if width == 1 as usize { return nqX64Put8(out,cursor,0x44 as u8)&&nqX64Put8(out,cursor,0x88 as u8)&&nqX64Put8(out,cursor,0x10 as u8) }
    if width == 2 as usize { return nqX64Put8(out,cursor,0x66 as u8)&&nqX64Put8(out,cursor,0x44 as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0x10 as u8) }
    if width == 4 as usize { return nqX64Put8(out,cursor,0x44 as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0x10 as u8) }
    if width == 8 as usize { return nqX64Put8(out,cursor,0x4c as u8)&&nqX64Put8(out,cursor,0x89 as u8)&&nqX64Put8(out,cursor,0x10 as u8) }
    return false
}

function nqX64EmitCheckedTrap(out: []u8, cursor: *usize): bool {
    return nqX64Put8(out,cursor,0x0f as u8)&&nqX64Put8(out,cursor,0x81 as u8)&&nqX64Put32(out,cursor,2 as u32)&&nqX64Put8(out,cursor,0x0f as u8)&&nqX64Put8(out,cursor,0x0b as u8)
}

function nqX64BuildLayout(function: *NqNirFunction, instructions: []NqNirInstruction, variableSymbols: []u64, variableCount: *usize, outMinReg: *isize, outRegCount: *usize, outCallArgs: *usize, outFrame: *usize): isize {
    if function == null || variableCount == null || outMinReg == null || outRegCount == null || outCallArgs == null || outFrame == null { return nqX64Invalid() }
    variableCount[0] = 0 as usize
    let minReg: isize = 9223372036854775807 as isize
    let maxReg: isize = -1 as isize
    let maxCallArgs: usize = 0 as usize
    let fixedBytes: usize = 0 as usize
    let index: usize = function.firstInstruction
    let end: usize = function.firstInstruction + function.instructionCount
    while index < end {
        let ins: *NqNirInstruction = &instructions[index]
        if ins.dest >= 0 as isize { if ins.dest < minReg { minReg = ins.dest } if ins.dest > maxReg { maxReg = ins.dest } }
        if (ins.opcode == nqNirLoad() || ins.opcode == nqNirStore() || ins.opcode == nqNirAddr() || ins.opcode == nqNirParameter()) && ins.symbol != 0 as u64 {
            if !nqX64AddVariable(variableSymbols, variableCount, ins.symbol) { return nqX64Capacity() }
        }
        if ins.opcode == nqNirCallArg() && ins.immediate >= 0 as i64 {
            let needed: usize = ins.immediate as usize + 1 as usize
            if needed > maxCallArgs { maxCallArgs = needed }
        }
        if ins.opcode == nqNirStackAlloc() { fixedBytes = fixedBytes + nqX64Align8(ins.width) }
        else if ins.opcode == nqNirMakeSlice() { fixedBytes = fixedBytes + 16 as usize }
        index = index + 1 as usize
    }
    let regCount: usize = 0 as usize
    if maxReg >= minReg && minReg >= 0 as isize { regCount = (maxReg - minReg + 1 as isize) as usize }
    let base: usize = (regCount + variableCount[0] + maxCallArgs) * 8 as usize
    outMinReg[0] = minReg
    if regCount == 0 as usize { outMinReg[0] = 0 as isize }
    outRegCount[0] = regCount
    outCallArgs[0] = maxCallArgs
    outFrame[0] = nqX64Align16(base + fixedBytes)
    return nqX64Ok()
}

function nqX64AddFixup(fixups: []NqX64Fixup, count: *usize, kind: int, patchOffset: usize, targetInstruction: usize, targetSymbol: u64, sourceStart: usize, sourceEnd: usize): bool {
    if count == null || count[0] >= len(fixups) { return false }
    fixups[count[0]].kind = kind
    fixups[count[0]].patchOffset = patchOffset
    fixups[count[0]].targetInstruction = targetInstruction
    fixups[count[0]].targetSymbol = targetSymbol
    fixups[count[0]].sourceStart = sourceStart
    fixups[count[0]].sourceEnd = sourceEnd
    count[0] = count[0] + 1 as usize
    return true
}

function nqX64EmitJumpFixup(out: []u8, cursor: *usize, fixups: []NqX64Fixup, fixupCount: *usize, opcode2: int, target: usize): bool {
    if opcode2 < 0 {
        if !nqX64Put8(out,cursor,0xe9 as u8) { return false }
    } else {
        if !nqX64Put8(out,cursor,0x0f as u8)||!nqX64Put8(out,cursor,opcode2 as u8) { return false }
    }
    let patch: usize = cursor[0]
    if !nqX64Put32(out,cursor,0 as u32) { return false }
    return nqX64AddFixup(fixups,fixupCount,1,patch,target,0 as u64,0 as usize,0 as usize)
}

function nqX64DecodeString(source: []u8, start: usize, end: usize, out: []u8, cursor: *usize): bool {
    if start >= end || end > len(source) || cursor == null { return false }
    let i: usize = start
    let limit: usize = end
    if source[i] == 34 as u8 { i = i + 1 as usize }
    if limit > i && source[limit - 1 as usize] == 34 as u8 { limit = limit - 1 as usize }
    while i < limit {
        let b: u8 = source[i]
        if b == 92 as u8 && i + 1 as usize < limit {
            i = i + 1 as usize
            let e: u8 = source[i]
            if e == 110 as u8 { if !nqX64Put8(out,cursor,10 as u8) { return false } }
            else if e == 114 as u8 { if !nqX64Put8(out,cursor,13 as u8) { return false } }
            else if e == 116 as u8 { if !nqX64Put8(out,cursor,9 as u8) { return false } }
            else if e == 48 as u8 { if !nqX64Put8(out,cursor,0 as u8) { return false } }
            else { if !nqX64Put8(out,cursor,e) { return false } }
        } else { if !nqX64Put8(out,cursor,b) { return false } }
        i = i + 1 as usize
    }
    return nqX64Put8(out,cursor,0 as u8)
}

function nqX64BuiltinTextLengthSymbol(): u64 {
    let name: [u8; 10] = [116 as u8,101 as u8,120 as u8,116 as u8,76 as u8,101 as u8,110 as u8,103 as u8,116 as u8,104 as u8]
    return nqNirSymbolId(slice(name),0 as usize,10 as usize)
}

function nqX64EmitTextLengthHelper(out: []u8, cursor: *usize): isize {
    let start: usize = cursor[0]
    if !nqX64Put8(out,cursor,0x31 as u8)||!nqX64Put8(out,cursor,0xc0 as u8) { return nqX64Capacity() }
    if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x85 as u8)||!nqX64Put8(out,cursor,0xff as u8) { return nqX64Capacity() }
    if !nqX64Put8(out,cursor,0x74 as u8)||!nqX64Put8(out,cursor,0x0b as u8) { return nqX64Capacity() }
    if !nqX64Put8(out,cursor,0x80 as u8)||!nqX64Put8(out,cursor,0x3c as u8)||!nqX64Put8(out,cursor,0x07 as u8)||!nqX64Put8(out,cursor,0x00 as u8) { return nqX64Capacity() }
    if !nqX64Put8(out,cursor,0x74 as u8)||!nqX64Put8(out,cursor,0x05 as u8) { return nqX64Capacity() }
    if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0xff as u8)||!nqX64Put8(out,cursor,0xc0 as u8) { return nqX64Capacity() }
    if !nqX64Put8(out,cursor,0xeb as u8)||!nqX64Put8(out,cursor,0xf5 as u8) { return nqX64Capacity() }
    if !nqX64Put8(out,cursor,0xc3 as u8) { return nqX64Capacity() }
    return start as isize
}

function nqX64EmitFunction(source: []u8, functions: []NqNirFunction, functionIndex: usize, instructions: []NqNirInstruction, out: []u8, cursor: *usize, instructionOffsets: []usize, fixups: []NqX64Fixup, fixupCount: *usize, functionOffsets: []usize, functionSizes: []usize, textLengthOffset: usize): isize {
    let fn: *NqNirFunction = &functions[functionIndex]
    if nqX64Extern(fn) { functionOffsets[functionIndex] = 0 as usize functionSizes[functionIndex] = 0 as usize return nqX64Ok() }

    let variableSymbols: [u64; 8192]
    let variableCount: usize = 0 as usize
    let minReg: isize = 0 as isize
    let regCount: usize = 0 as usize
    let callArgCount: usize = 0 as usize
    let frameBytes: usize = 0 as usize
    let layoutStatus: isize = nqX64BuildLayout(fn,instructions,slice(variableSymbols),&variableCount,&minReg,&regCount,&callArgCount,&frameBytes)
    if layoutStatus < 0 as isize { return layoutStatus }

    let regTypes: [int; 65536]
    if regCount > 65536 as usize { return nqX64Capacity() }
    let scan: usize = fn.firstInstruction
    let scanEnd: usize = fn.firstInstruction + fn.instructionCount
    while scan < scanEnd {
        let ins: *NqNirInstruction = &instructions[scan]
        if ins.dest >= minReg && ins.dest >= 0 as isize {
            let local: usize = (ins.dest - minReg) as usize
            if local < regCount { regTypes[local] = ins.typeCode }
        }
        scan = scan + 1 as usize
    }

    let functionStart: usize = cursor[0]
    functionOffsets[functionIndex] = functionStart
    if !nqX64Put8(out,cursor,0x55 as u8)||!nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x89 as u8)||!nqX64Put8(out,cursor,0xe5 as u8) { return nqX64Capacity() }
    if frameBytes > 0 as usize {
        if frameBytes > 2147483647 as usize { return nqX64Range() }
        if !nqX64Put8(out,cursor,0x48 as u8)||!nqX64Put8(out,cursor,0x81 as u8)||!nqX64Put8(out,cursor,0xec as u8)||!nqX64Put32(out,cursor,frameBytes as u32) { return nqX64Capacity() }
    }

    let storageCursor: usize = (regCount + variableCount + callArgCount) * 8 as usize
    let argTypes: [int; 256]
    let paramInt: usize = 0 as usize
    let paramFloat: usize = 0 as usize
    let paramStack: usize = 0 as usize
    let index: usize = fn.firstInstruction
    let end: usize = fn.firstInstruction + fn.instructionCount
    while index < end {
        if index >= len(instructionOffsets) { return nqX64Capacity() }
