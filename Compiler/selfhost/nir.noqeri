module noqeri.compiler.selfhost.nir

// Stable, host-independent NIR. Registers are integer arena ids; -1 means
// "no value". New operations are appended so existing opcode ids stay stable.
record NqNirInstruction {
    opcode: int
    dest: isize
    left: isize
    right: isize
    immediate: i64
    floatImmediate: float
    symbol: u64
    width: usize
    sourceStart: usize
    sourceEnd: usize
    typeCode: int
    flags: u32
}

record NqNirFunction {
    symbol: u64
    nameStart: usize
    nameEnd: usize
    firstInstruction: usize
    instructionCount: usize
    parameterCount: usize
    flags: u32
}

export function nqNirNoValue(): isize { return -1 as isize }
export function nqNirFlagVolatile(): u32 { return 1 as u32 }
export function nqNirFlagChecked(): u32 { return 2 as u32 }
export function nqNirFlagUnsigned(): u32 { return 4 as u32 }
export function nqNirFlagUnsafe(): u32 { return 8 as u32 }

export function nqNirNop(): int { return 0 }
export function nqNirConstI64(): int { return 1 }
export function nqNirConstF64(): int { return 2 }
export function nqNirMove(): int { return 3 }
export function nqNirLoad(): int { return 4 }
export function nqNirStore(): int { return 5 }
export function nqNirAdd(): int { return 6 }
export function nqNirSub(): int { return 7 }
export function nqNirMul(): int { return 8 }
export function nqNirDiv(): int { return 9 }
export function nqNirMod(): int { return 10 }
export function nqNirNeg(): int { return 11 }
export function nqNirNot(): int { return 12 }
export function nqNirEq(): int { return 13 }
export function nqNirNe(): int { return 14 }
export function nqNirLt(): int { return 15 }
export function nqNirLe(): int { return 16 }
export function nqNirGt(): int { return 17 }
export function nqNirGe(): int { return 18 }
export function nqNirJump(): int { return 19 }
export function nqNirBranch(): int { return 20 }
export function nqNirCall(): int { return 21 }
export function nqNirReturn(): int { return 22 }
export function nqNirPhi(): int { return 23 }
export function nqNirAddr(): int { return 24 }
export function nqNirPtrAdd(): int { return 25 }
export function nqNirAtomicLoad(): int { return 26 }
export function nqNirAtomicStore(): int { return 27 }
export function nqNirAtomicExchange(): int { return 28 }
export function nqNirCmpXchg(): int { return 29 }
export function nqNirFence(): int { return 30 }
export function nqNirIntrinsic(): int { return 31 }
export function nqNirAsm(): int { return 32 }
export function nqNirTry(): int { return 33 }
export function nqNirThrow(): int { return 34 }
export function nqNirBoundsCheck(): int { return 35 }
export function nqNirOverflowCheck(): int { return 36 }
export function nqNirStackAlloc(): int { return 37 }
export function nqNirLoadMemory(): int { return 38 }
export function nqNirStoreMemory(): int { return 39 }
export function nqNirSliceData(): int { return 40 }
export function nqNirSliceLen(): int { return 41 }
export function nqNirMakeSlice(): int { return 42 }
export function nqNirCast(): int { return 43 }
export function nqNirLabel(): int { return 44 }
export function nqNirConstString(): int { return 45 }
export function nqNirCallArg(): int { return 46 }
export function nqNirParameter(): int { return 47 }

export function nqNirOpcodeValid(opcode: int): bool { return opcode >= nqNirNop() && opcode <= nqNirParameter() }
export function nqNirHasSideEffect(opcode: int): bool {
    return opcode == nqNirStore() || opcode == nqNirStoreMemory() || opcode == nqNirCall() || opcode == nqNirCallArg() || opcode == nqNirParameter() || opcode == nqNirReturn() || opcode == nqNirJump() || opcode == nqNirBranch() || opcode == nqNirTry() || opcode == nqNirThrow() || opcode == nqNirBoundsCheck() || opcode == nqNirOverflowCheck() || (opcode >= nqNirAtomicStore() && opcode <= nqNirAsm())
}
export function nqNirIsTerminator(opcode: int): bool { return opcode == nqNirJump() || opcode == nqNirBranch() || opcode == nqNirReturn() || opcode == nqNirThrow() }
export function nqNirIsPureArithmetic(opcode: int): bool { return opcode >= nqNirAdd() && opcode <= nqNirGe() }
export function nqNirDefinesValue(opcode: int): bool {
    return opcode == nqNirConstI64() || opcode == nqNirConstF64() || opcode == nqNirConstString() || opcode == nqNirMove() || opcode == nqNirLoad() || nqNirIsPureArithmetic(opcode) || opcode == nqNirNeg() || opcode == nqNirNot() || opcode == nqNirPhi() || opcode == nqNirAddr() || opcode == nqNirPtrAdd() || opcode == nqNirAtomicLoad() || opcode == nqNirAtomicExchange() || opcode == nqNirCmpXchg() || opcode == nqNirIntrinsic() || opcode == nqNirTry() || opcode == nqNirStackAlloc() || opcode == nqNirLoadMemory() || opcode == nqNirSliceData() || opcode == nqNirSliceLen() || opcode == nqNirMakeSlice() || opcode == nqNirCast() || opcode == nqNirParameter()
}

export function nqNirInstructionInit(out: *NqNirInstruction, opcode: int, dest: isize): void {
    out.opcode = opcode
    out.dest = dest
    out.left = nqNirNoValue()
    out.right = nqNirNoValue()
    out.immediate = 0 as i64
    out.floatImmediate = 0.0
    out.symbol = 0 as u64
    out.width = 0 as usize
    out.sourceStart = 0 as usize
    out.sourceEnd = 0 as usize
    out.typeCode = 0
    out.flags = 0 as u32
}

export function nqNirInstructionValid(instruction: *NqNirInstruction): bool {
    if instruction == null || !nqNirOpcodeValid(instruction.opcode) { return false }
    if instruction.sourceEnd < instruction.sourceStart { return false }
    if nqNirDefinesValue(instruction.opcode) && instruction.dest < 0 as isize { return false }
    if instruction.opcode == nqNirMove() && instruction.left < 0 as isize { return false }
    if nqNirIsPureArithmetic(instruction.opcode) && (instruction.left < 0 as isize || instruction.right < 0 as isize) { return false }
    if instruction.opcode == nqNirTry() && instruction.left < 0 as isize { return false }
    if instruction.opcode == nqNirBoundsCheck() && (instruction.left < 0 as isize || instruction.right < 0 as isize) { return false }
    if instruction.opcode == nqNirStore() && (instruction.symbol == 0 as u64 || instruction.left < 0 as isize) { return false }
    if instruction.opcode == nqNirLoad() && instruction.symbol == 0 as u64 { return false }
    if instruction.opcode == nqNirAddr() && instruction.symbol == 0 as u64 { return false }
    if instruction.opcode == nqNirLoadMemory() && instruction.left < 0 as isize { return false }
    if instruction.opcode == nqNirStoreMemory() && (instruction.left < 0 as isize || instruction.right < 0 as isize) { return false }
    if instruction.opcode == nqNirPtrAdd() && (instruction.left < 0 as isize || instruction.right < 0 as isize) { return false }
    if instruction.opcode == nqNirMakeSlice() && (instruction.left < 0 as isize || instruction.right < 0 as isize) { return false }
    if instruction.opcode == nqNirBranch() && instruction.left < 0 as isize { return false }
    if instruction.opcode == nqNirCall() && instruction.symbol == 0 as u64 { return false }
    if instruction.opcode == nqNirCallArg() && instruction.left < 0 as isize { return false }
    if instruction.opcode == nqNirParameter() && instruction.symbol == 0 as u64 { return false }
    return true
}

export function nqNirInstructionUses(instruction: *NqNirInstruction, value: isize): bool {
    if instruction == null || value < 0 as isize { return false }
    return instruction.left == value || instruction.right == value
}

export function nqNirProgramValid(instructions: []NqNirInstruction): bool {
    let index: usize = 0 as usize
    while index < len(instructions) {
        if !nqNirInstructionValid(&instructions[index]) { return false }
        index = index + 1 as usize
    }
    return true
}

export function nqNirFunctionValid(function: *NqNirFunction, instructionCount: usize): bool {
    if function == null || function.symbol == 0 as u64 || function.nameEnd <= function.nameStart || function.firstInstruction > instructionCount { return false }
    return function.instructionCount <= instructionCount - function.firstInstruction
}

export function nqNirMakeConst(out: *NqNirInstruction, dest: isize, value: i64, typeCode: int): void {
    nqNirInstructionInit(out, nqNirConstI64(), dest)
    out.immediate = value
    out.typeCode = typeCode
}

export function nqNirMakeBinary(out: *NqNirInstruction, opcode: int, dest: isize, left: isize, right: isize, typeCode: int): void {
    nqNirInstructionInit(out, opcode, dest)
    out.left = left
    out.right = right
    out.typeCode = typeCode
}

export function nqNirSymbolId(source: []u8, start: usize, end: usize): u64 {
    if start >= end || end > len(source) { return 0 as u64 }
    let hash: u64 = 2166136261 as u64
    let index: usize = start
    while index < end {
        hash = (hash * 16777619 as u64 + source[index] as u64 + 1 as u64) % 4294967291 as u64
        index = index + 1 as usize
    }
    return hash + 1 as u64
}
