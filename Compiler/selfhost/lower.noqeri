module noqeri.compiler.selfhost.lower
import "ast.noqeri"
import "nir.noqeri"
import "types.noqeri"

record NqLowerState {
    instructionCount: usize
    nextRegister: isize
    loopDepth: usize
    loopStart: usize
    breakHead: isize
}

export function nqLowerOk(): isize { return 0 }
export function nqLowerUnsupported(): isize { return -600 }
export function nqLowerCapacity(): isize { return -601 }
export function nqLowerBadLiteral(): isize { return -602 }
export function nqLowerBadAst(): isize { return -603 }
export function nqLowerBadTarget(): isize { return -604 }

export function nqLowerStateInit(out: *NqLowerState): void {
    out.instructionCount = 0 as usize
    out.nextRegister = 0 as isize
    out.loopDepth = 0 as usize
    out.loopStart = 0 as usize
    out.breakHead = nqNirNoValue()
}

function nqLowerAllocRegister(state: *NqLowerState): isize {
    let result: isize = state.nextRegister
    state.nextRegister = result + 1 as isize
    return result
}

function nqLowerEmit(instructions: []NqNirInstruction, state: *NqLowerState, opcode: int, dest: isize): isize {
    if state == null || state.instructionCount >= len(instructions) { return nqLowerCapacity() }
    let index: usize = state.instructionCount
    nqNirInstructionInit(&instructions[index], opcode, dest)
    state.instructionCount = index + 1 as usize
    return index as isize
}

function nqLowerHexDigit(c: u8): int {
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as int }
    if c >= 65 as u8 && c <= 70 as u8 { return (c - 65 as u8) as int + 10 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c - 97 as u8) as int + 10 }
    return -1
}

export function nqLowerParseI64(source: []u8, start: usize, end: usize, out: *i64): bool {
    if out == null || start >= end || end > len(source) { return false }
    let base: u64 = 10 as u64
    let index: usize = start
    if end - start > 2 as usize && source[start] == 48 as u8 && (source[start + 1 as usize] == 120 as u8 || source[start + 1 as usize] == 88 as u8) { base = 16 as u64 index = start + 2 as usize }
    if index >= end { return false }
    // Use two 32-bit limbs: the portable VM transports integers as i64
    // and does not yet perform unsigned comparisons even for u64 types.
    // Splitting into limbs avoids overflowing signed intermediate values.
    let limbBase: i64 = 4294967296 as i64
    let high: i64 = 0 as i64
    let low: i64 = 0 as i64
    while index < end {
        let digit: int = nqLowerHexDigit(source[index])
        if digit < 0 || digit as u64 >= base { return false }
        let accumulator: i64 = low * base as i64 + digit as i64
        let carry: i64 = accumulator / limbBase
        low = accumulator % limbBase
        let nextHigh: i64 = high * base as i64 + carry
        if nextHigh > 4294967295 as i64 { return false }
        high = nextHigh
        index = index + 1 as usize
    }
    let signedHigh: i64 = high
    if high >= 2147483648 as i64 { signedHigh = high - limbBase }
    out[0] = signedHigh * limbBase + low
    return true
}

export function nqLowerParseFloat(source: []u8, start: usize, end: usize, out: *float): bool {
    if out == null || start >= end || end > len(source) { return false }
    let index: usize = start
    let value: float = 0.0
    let digits: usize = 0 as usize
    while index < end && source[index] >= 48 as u8 && source[index] <= 57 as u8 {
        value = value * 10.0 + (source[index] - 48 as u8) as float
        digits = digits + 1 as usize
        index = index + 1 as usize
    }
    if digits == 0 as usize || index >= end || source[index] != 46 as u8 { return false }
    index = index + 1 as usize
    let scale: float = 0.1
    let fractionDigits: usize = 0 as usize
    while index < end && source[index] >= 48 as u8 && source[index] <= 57 as u8 {
        value = value + (source[index] - 48 as u8) as float * scale
        scale = scale * 0.1
        fractionDigits = fractionDigits + 1 as usize
        index = index + 1 as usize
    }
    if index != end || fractionDigits == 0 as usize { return false }
    out[0] = value
    return true
}

function nqLowerBinaryOpcode(encoded: u32): int {
    if encoded == 43 as u32 { return nqNirAdd() }
    if encoded == 45 as u32 { return nqNirSub() }
    if encoded == 42 as u32 { return nqNirMul() }
    if encoded == 47 as u32 { return nqNirDiv() }
    if encoded == 37 as u32 { return nqNirMod() }
    if encoded == 61 as u32 * 256 as u32 + 61 as u32 { return nqNirEq() }
    if encoded == 33 as u32 * 256 as u32 + 61 as u32 { return nqNirNe() }
    if encoded == 60 as u32 { return nqNirLt() }
    if encoded == 60 as u32 * 256 as u32 + 61 as u32 { return nqNirLe() }
    if encoded == 62 as u32 { return nqNirGt() }
    if encoded == 62 as u32 * 256 as u32 + 61 as u32 { return nqNirGe() }
    return -1
}

function nqLowerNodeSymbol(source: []u8, nodes: []NqAstNode, index: isize): u64 {
    if index < 0 as isize || index as usize >= len(nodes) { return 0 as u64 }
    return nqNirSymbolId(source, nodes[index as usize].start, nodes[index as usize].end)
}

function nqLowerNodeWidth(node: *NqAstNode): usize {
    if node == null { return 8 as usize }
    // Semantic layout sets storageBytes for record index/member expressions.
    // Falling back to a pointer-width stride for a record corrupts arrays of
    // AST nodes, parser nodes and user-defined data structures.
    if node.storageBytes > 0 as usize { return node.storageBytes }
    let width: usize = nqCompilerPrimitiveTypeWidth(node.typeCode)
    if width == 0 as usize { return 8 as usize }
    return width
}

function nqLowerEmitConst(instructions: []NqNirInstruction, state: *NqLowerState, value: i64, typeCode: int): isize {
    let reg: isize = nqLowerAllocRegister(state)
    let emitted: isize = nqLowerEmit(instructions, state, nqNirConstI64(), reg)
    if emitted < 0 as isize { return emitted }
    instructions[emitted as usize].immediate = value
    instructions[emitted as usize].typeCode = typeCode
    return reg
}

function nqLowerExpressionInternal(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState): isize

function nqLowerAddress(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState): isize {
    if nodeIndex < 0 as isize || nodeIndex as usize >= len(nodes) { return nqLowerBadAst() }
    let node: *NqAstNode = &nodes[nodeIndex as usize]
    if node.tag == nqAstName() {
        let symbol: u64 = nqLowerNodeSymbol(source, nodes, nodeIndex)
        if symbol == 0 as u64 { return nqLowerBadAst() }
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, nqNirAddr(), reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].symbol = symbol
        instructions[emitted as usize].sourceStart = node.start
        instructions[emitted as usize].sourceEnd = node.end
        return reg
    }
    if node.tag == nqAstUnary() && node.flags == 42 as u32 { return nqLowerExpressionInternal(source, nodes, node.left, instructions, state) }
    if node.tag == nqAstIndex() {
        let base: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if base < 0 as isize { return base }
        let indexValue: isize = nqLowerExpressionInternal(source, nodes, node.right, instructions, state)
        if indexValue < 0 as isize { return indexValue }
        let baseNode: *NqAstNode = &nodes[node.left as usize]
        let pointer: isize = base
        if baseNode.typeCode == nqAstTypeSlice() {
            let lengthReg: isize = nqLowerAllocRegister(state)
            let lenOp: isize = nqLowerEmit(instructions, state, nqNirSliceLen(), lengthReg)
            if lenOp < 0 as isize { return lenOp }
            instructions[lenOp as usize].left = base
            let check: isize = nqLowerEmit(instructions, state, nqNirBoundsCheck(), nqNirNoValue())
            if check < 0 as isize { return check }
            instructions[check as usize].left = indexValue
            instructions[check as usize].right = lengthReg
            let dataReg: isize = nqLowerAllocRegister(state)
            let dataOp: isize = nqLowerEmit(instructions, state, nqNirSliceData(), dataReg)
            if dataOp < 0 as isize { return dataOp }
            instructions[dataOp as usize].left = base
            pointer = dataReg
        } else if baseNode.tag == nqAstArray() {
            let lengthReg: isize = nqLowerEmitConst(instructions, state, baseNode.extra as i64, nqAstTypeUsize())
            if lengthReg < 0 as isize { return lengthReg }
            let check: isize = nqLowerEmit(instructions, state, nqNirBoundsCheck(), nqNirNoValue())
            if check < 0 as isize { return check }
            instructions[check as usize].left = indexValue
            instructions[check as usize].right = lengthReg
        }
        let address: isize = nqLowerAllocRegister(state)
        let offset: isize = nqLowerEmit(instructions, state, nqNirPtrAdd(), address)
        if offset < 0 as isize { return offset }
        instructions[offset as usize].left = pointer
        instructions[offset as usize].right = indexValue
        instructions[offset as usize].width = nqLowerNodeWidth(node)
        return address
    }
    if node.tag == nqAstMember() {
        let base: isize = nqLowerAddress(source, nodes, node.left, instructions, state)
        if base < 0 as isize { return base }
        let member: isize = node.right
        // The index register must be initialized before pointer arithmetic
        // executes. Emitting its constant afterward causes undefined-register
        // traps in the rebuilt compiler when accessing record members.
        let zeroIndex: isize = nqLowerEmitConst(instructions, state, 0 as i64, nqAstTypeUsize())
        if zeroIndex < 0 as isize { return zeroIndex }
        let address: isize = nqLowerAllocRegister(state)
        let offset: isize = nqLowerEmit(instructions, state, nqNirPtrAdd(), address)
        if offset < 0 as isize { return offset }
        instructions[offset as usize].left = base
        instructions[offset as usize].right = zeroIndex
        instructions[offset as usize].immediate = node.extra as i64
        instructions[offset as usize].symbol = nqLowerNodeSymbol(source, nodes, member)
        instructions[offset as usize].width = nqLowerNodeWidth(node)
        return address
    }
    return nqLowerBadTarget()
}

function nqLowerLogical(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState, isAnd: bool): isize {
    let node: *NqAstNode = &nodes[nodeIndex as usize]
    let left: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
    if left < 0 as isize { return left }
    let tempSymbol: u64 = 4294967293 as u64 + (nodeIndex as u64 % 1000003 as u64)
    let storeLeft: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
    if storeLeft < 0 as isize { return storeLeft }
    instructions[storeLeft as usize].symbol = tempSymbol
    instructions[storeLeft as usize].left = left
    let branch: isize = nqLowerEmit(instructions, state, nqNirBranch(), nqNirNoValue())
    if branch < 0 as isize { return branch }
    instructions[branch as usize].left = left
    if isAnd {
        let right: isize = nqLowerExpressionInternal(source, nodes, node.right, instructions, state)
        if right < 0 as isize { return right }
        let storeRight: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
        if storeRight < 0 as isize { return storeRight }
        instructions[storeRight as usize].symbol = tempSymbol
        instructions[storeRight as usize].left = right
        instructions[branch as usize].immediate = state.instructionCount as i64
    } else {
        let skip: isize = nqLowerEmit(instructions, state, nqNirJump(), nqNirNoValue())
        if skip < 0 as isize { return skip }
        instructions[branch as usize].immediate = state.instructionCount as i64
        let right: isize = nqLowerExpressionInternal(source, nodes, node.right, instructions, state)
        if right < 0 as isize { return right }
        let storeRight: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
        if storeRight < 0 as isize { return storeRight }
        instructions[storeRight as usize].symbol = tempSymbol
        instructions[storeRight as usize].left = right
        instructions[skip as usize].immediate = state.instructionCount as i64
    }
    let result: isize = nqLowerAllocRegister(state)
    let load: isize = nqLowerEmit(instructions, state, nqNirLoad(), result)
    if load < 0 as isize { return load }
    instructions[load as usize].symbol = tempSymbol
    instructions[load as usize].typeCode = nqAstTypeBool()
    return result
}

function nqLowerExpressionInternal(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState): isize {
    if state == null || nodeIndex < 0 as isize || nodeIndex as usize >= len(nodes) { return nqLowerBadAst() }
    let node: *NqAstNode = &nodes[nodeIndex as usize]
    if !nqAstNodeValid(node, len(source)) { return nqLowerBadAst() }

    if node.tag == nqAstInteger() {
        let literal: i64 = 0 as i64
        if !nqLowerParseI64(source, node.start, node.end, &literal) { return nqLowerBadLiteral() }
        return nqLowerEmitConst(instructions, state, literal, nqAstTypeI64())
    }
    if node.tag == nqAstFloat() {
        let literal: float = 0.0
        if !nqLowerParseFloat(source, node.start, node.end, &literal) { return nqLowerBadLiteral() }
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, nqNirConstF64(), reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].floatImmediate = literal
        instructions[emitted as usize].typeCode = nqAstTypeFloat()
        return reg
    }
    if node.tag == nqAstString() {
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, nqNirConstString(), reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].sourceStart = node.start
        instructions[emitted as usize].sourceEnd = node.end
        instructions[emitted as usize].symbol = nqNirSymbolId(source, node.start, node.end)
        instructions[emitted as usize].typeCode = nqAstTypeString()
        return reg
    }
    if node.tag == nqAstBool() {
        let value: i64 = 0 as i64
        if node.end - node.start == 4 as usize { value = 1 as i64 }
        return nqLowerEmitConst(instructions, state, value, nqAstTypeBool())
    }
    if node.tag == nqAstNull() { return nqLowerEmitConst(instructions, state, 0 as i64, nqAstTypeNull()) }
    if node.tag == nqAstName() {
        let symbol: u64 = nqLowerNodeSymbol(source, nodes, nodeIndex)
        if symbol == 0 as u64 { return nqLowerBadAst() }
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, nqNirLoad(), reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].symbol = symbol
        instructions[emitted as usize].sourceStart = node.start
        instructions[emitted as usize].sourceEnd = node.end
        instructions[emitted as usize].typeCode = node.typeCode
        return reg
    }
    if node.tag == nqAstBinary() {
        let andCode: u32 = 38 as u32 * 256 as u32 + 38 as u32
        let orCode: u32 = 124 as u32 * 256 as u32 + 124 as u32
        if node.flags == andCode { return nqLowerLogical(source, nodes, nodeIndex, instructions, state, true) }
        if node.flags == orCode { return nqLowerLogical(source, nodes, nodeIndex, instructions, state, false) }
        let left: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if left < 0 as isize { return left }
        let right: isize = nqLowerExpressionInternal(source, nodes, node.right, instructions, state)
        if right < 0 as isize { return right }
        let opcode: int = nqLowerBinaryOpcode(node.flags)
        if opcode < 0 { return nqLowerUnsupported() }
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, opcode, reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].left = left
        instructions[emitted as usize].right = right
        instructions[emitted as usize].typeCode = node.typeCode
        if opcode == nqNirAdd() || opcode == nqNirSub() || opcode == nqNirMul() { instructions[emitted as usize].flags = instructions[emitted as usize].flags + nqNirFlagChecked() }
        return reg
    }
    if node.tag == nqAstUnary() {
        if node.flags == 38 as u32 { return nqLowerAddress(source, nodes, node.left, instructions, state) }
        if node.flags == 42 as u32 {
            let address: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
            if address < 0 as isize { return address }
            let reg: isize = nqLowerAllocRegister(state)
            let emitted: isize = nqLowerEmit(instructions, state, nqNirLoadMemory(), reg)
            if emitted < 0 as isize { return emitted }
            instructions[emitted as usize].left = address
            instructions[emitted as usize].width = nqLowerNodeWidth(node)
            instructions[emitted as usize].typeCode = node.typeCode
            return reg
        }
        let operand: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if operand < 0 as isize { return operand }
        let opcode: int = -1
        if node.flags == 45 as u32 { opcode = nqNirNeg() }
        else if node.flags == 33 as u32 { opcode = nqNirNot() }
        else if node.flags == 43 as u32 { return operand }
        else if node.flags == 0x747279 as u32 { opcode = nqNirTry() }
        else { return nqLowerUnsupported() }
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, opcode, reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].left = operand
        instructions[emitted as usize].typeCode = node.typeCode
        return reg
    }
    if node.tag == nqAstCast() {
        let sourceValue: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if sourceValue < 0 as isize { return sourceValue }
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, nqNirCast(), reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].left = sourceValue
        instructions[emitted as usize].typeCode = node.typeCode
        instructions[emitted as usize].sourceStart = node.extra as usize
        instructions[emitted as usize].sourceEnd = node.end
        return reg
    }
    if node.tag == nqAstAssign() {
        let value: isize = nqLowerExpressionInternal(source, nodes, node.right, instructions, state)
        if value < 0 as isize { return value }
        let target: *NqAstNode = &nodes[node.left as usize]
        if target.tag == nqAstName() {
            let store: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
            if store < 0 as isize { return store }
            instructions[store as usize].symbol = nqLowerNodeSymbol(source, nodes, node.left)
            instructions[store as usize].left = value
            return value
        }
        let address: isize = nqLowerAddress(source, nodes, node.left, instructions, state)
        if address < 0 as isize { return address }
        let store: isize = nqLowerEmit(instructions, state, nqNirStoreMemory(), nqNirNoValue())
        if store < 0 as isize { return store }
        instructions[store as usize].left = address
        instructions[store as usize].right = value
        instructions[store as usize].width = nqLowerNodeWidth(target)
        return value
    }
    if node.tag == nqAstIndex() || node.tag == nqAstMember() {
        let address: isize = nqLowerAddress(source, nodes, nodeIndex, instructions, state)
        if address < 0 as isize { return address }
        let reg: isize = nqLowerAllocRegister(state)
        let load: isize = nqLowerEmit(instructions, state, nqNirLoadMemory(), reg)
        if load < 0 as isize { return load }
        instructions[load as usize].left = address
        instructions[load as usize].width = nqLowerNodeWidth(node)
        instructions[load as usize].typeCode = node.typeCode
        return reg
    }
    if node.tag == nqAstArray() {
        let count: usize = node.extra as usize
        // An array literal is typed as Array; its own type width is not the
        // element stride. For [u8, ...] a fallback eight-byte stride inserts
        // seven zeroes between characters and breaks parser keyword matching.
        let elementWidth: usize = nqCompilerPrimitiveTypeWidth(node.elementTypeCode)
        if elementWidth == 0 as usize { elementWidth = nqLowerNodeWidth(node) }
        if elementWidth == 0 as usize || count > 9223372036854775807 as usize / elementWidth { return nqLowerCapacity() }
        let bytes: usize = count * elementWidth
        let base: isize = nqLowerAllocRegister(state)
        let alloc: isize = nqLowerEmit(instructions, state, nqNirStackAlloc(), base)
        if alloc < 0 as isize { return alloc }
        instructions[alloc as usize].width = bytes
        instructions[alloc as usize].flags = nqNirFlagArrayLength()
        instructions[alloc as usize].immediate = count as i64
        let element: isize = node.right
        let index: usize = 0 as usize
        while element >= 0 as isize && index < count {
            let value: isize = nqLowerExpressionInternal(source, nodes, element, instructions, state)
            if value < 0 as isize { return value }
            let indexReg: isize = nqLowerEmitConst(instructions, state, index as i64, nqAstTypeUsize())
            if indexReg < 0 as isize { return indexReg }
            let address: isize = nqLowerAllocRegister(state)
            let offset: isize = nqLowerEmit(instructions, state, nqNirPtrAdd(), address)
            if offset < 0 as isize { return offset }
            instructions[offset as usize].left = base
            instructions[offset as usize].right = indexReg
            instructions[offset as usize].width = elementWidth
            let store: isize = nqLowerEmit(instructions, state, nqNirStoreMemory(), nqNirNoValue())
            if store < 0 as isize { return store }
            instructions[store as usize].left = address
            instructions[store as usize].right = value
            instructions[store as usize].width = elementWidth
            element = nodes[element as usize].next
            index = index + 1 as usize
        }
        return base
    }
    if node.tag == nqAstCall() {
        let callee: *NqAstNode = &nodes[node.left as usize]
        let symbol: u64 = nqNirSymbolId(source, callee.start, callee.end)
        if symbol == 0 as u64 { return nqLowerBadAst() }
        // Evaluate all arguments before pushing any call-argument instruction.
        // Nested calls consume the VM's pending argument slots. Emitting each
        // slot immediately after evaluating its expression lets a nested call
        // erase or overwrite previously evaluated arguments of the outer call.
        let argumentRegisters: [isize; 256]
        let argument: isize = node.right
        let argumentIndex: usize = 0 as usize
        while argument >= 0 as isize && argumentIndex < node.extra as usize {
            if argumentIndex >= 256 as usize { return nqLowerCapacity() }
            let value: isize = nqLowerExpressionInternal(source, nodes, argument, instructions, state)
            if value < 0 as isize { return value }
            argumentRegisters[argumentIndex] = value
            argument = nodes[argument as usize].next
            argumentIndex = argumentIndex + 1 as usize
        }
        let emitIndex: usize = 0 as usize
        while emitIndex < argumentIndex {
            let arg: isize = nqLowerEmit(instructions, state, nqNirCallArg(), nqNirNoValue())
            if arg < 0 as isize { return arg }
            instructions[arg as usize].left = argumentRegisters[emitIndex]
            instructions[arg as usize].immediate = emitIndex as i64
            emitIndex = emitIndex + 1 as usize
        }
        let reg: isize = nqLowerAllocRegister(state)
        let call: isize = nqLowerEmit(instructions, state, nqNirCall(), reg)
        if call < 0 as isize { return call }
        instructions[call as usize].symbol = symbol
        instructions[call as usize].sourceStart = callee.start
        instructions[call as usize].sourceEnd = callee.end
        instructions[call as usize].width = argumentIndex
        instructions[call as usize].typeCode = node.typeCode
        return reg
    }
    return nqLowerUnsupported()
}

export function nqLowerExpression(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState): isize {
    return nqLowerExpressionInternal(source, nodes, nodeIndex, instructions, state)
}

export function nqLowerStatement(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState): isize {
    if nodeIndex < 0 as isize || nodeIndex as usize >= len(nodes) { return nqLowerBadAst() }
    let node: *NqAstNode = &nodes[nodeIndex as usize]
    if node.tag == nqAstExpressionStatement() { let value: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state) if value < 0 as isize { return value } return nqLowerOk() }
    if node.tag == nqAstBinding() {
        let value: isize = nqLowerExpressionInternal(source, nodes, node.right, instructions, state)
        if value < 0 as isize { return value }
        let store: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
        if store < 0 as isize { return store }
        instructions[store as usize].symbol = nqLowerNodeSymbol(source, nodes, node.left)
        instructions[store as usize].left = value
        instructions[store as usize].flags = node.flags
        return nqLowerOk()
    }
    if node.tag == nqAstReturn() {
        let value: isize = nqNirNoValue()
        if node.left >= 0 as isize { value = nqLowerExpressionInternal(source, nodes, node.left, instructions, state) if value < 0 as isize { return value } }
        let emitted: isize = nqLowerEmit(instructions, state, nqNirReturn(), nqNirNoValue())
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].left = value
        return nqLowerOk()
    }
    if node.tag == nqAstThrow() {
        let value: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if value < 0 as isize { return value }
        let emitted: isize = nqLowerEmit(instructions, state, nqNirThrow(), nqNirNoValue())
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].left = value
        return nqLowerOk()
    }
    if node.tag == nqAstBlock() {
        let cursor: isize = node.left
        while cursor >= 0 as isize {
            let status: isize = nqLowerStatement(source, nodes, cursor, instructions, state)
            if status < 0 as isize { return status }
            cursor = nodes[cursor as usize].next
        }
        return nqLowerOk()
    }
    if node.tag == nqAstBreak() || node.tag == nqAstContinue() {
        if state.loopDepth == 0 as usize { return nqLowerUnsupported() }
        let jump: isize = nqLowerEmit(instructions, state, nqNirJump(), nqNirNoValue())
        if jump < 0 as isize { return jump }
        if node.tag == nqAstContinue() {
            instructions[jump as usize].immediate = state.loopStart as i64
        } else {
            // Link unresolved breaks through the currently unused jump left
            // operand, then clear it before NIR validation/serialization.
            instructions[jump as usize].left = state.breakHead
            state.breakHead = jump
        }
        return nqLowerOk()
    }
    if node.tag == nqAstIf() {
        let condition: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if condition < 0 as isize { return condition }
        let branch: isize = nqLowerEmit(instructions, state, nqNirBranch(), nqNirNoValue())
        if branch < 0 as isize { return branch }
        instructions[branch as usize].left = condition
        let thenStatus: isize = nqLowerStatement(source, nodes, node.right, instructions, state)
        if thenStatus < 0 as isize { return thenStatus }
        if node.extra >= 0 as isize {
            let jump: isize = nqLowerEmit(instructions, state, nqNirJump(), nqNirNoValue())
            if jump < 0 as isize { return jump }
            instructions[branch as usize].immediate = state.instructionCount as i64
            let elseStatus: isize = nqLowerStatement(source, nodes, node.extra, instructions, state)
            if elseStatus < 0 as isize { return elseStatus }
            instructions[jump as usize].immediate = state.instructionCount as i64
        } else { instructions[branch as usize].immediate = state.instructionCount as i64 }
        return nqLowerOk()
    }
    if node.tag == nqAstRepeat() {
        // The synthetic slot has a distinct 64-bit namespace from ordinary
        // hashed source identifiers. Neither its spelling nor address can
        // be provided by a user program.
        let slot: u64 = 18446744069414584320 as u64 + nodeIndex as u64
        let rawCount: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if rawCount < 0 as isize { return rawCount }
        let countValue: isize = nqLowerAllocRegister(state)
        let cast: isize = nqLowerEmit(instructions, state, nqNirCast(), countValue)
        if cast < 0 as isize { return cast }
        instructions[cast as usize].left = rawCount
        instructions[cast as usize].typeCode = nqAstTypeInt()
        let initial: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
        if initial < 0 as isize { return initial }
        instructions[initial as usize].symbol = slot
        instructions[initial as usize].left = countValue

        let loopStart: usize = state.instructionCount
        let remaining: isize = nqLowerAllocRegister(state)
        let load: isize = nqLowerEmit(instructions, state, nqNirLoad(), remaining)
        if load < 0 as isize { return load }
        instructions[load as usize].symbol = slot
        instructions[load as usize].typeCode = nqAstTypeInt()
        let zero: isize = nqLowerEmitConst(instructions, state, 0 as i64, nqAstTypeInt())
        if zero < 0 as isize { return zero }
        let condition: isize = nqLowerAllocRegister(state)
        let greater: isize = nqLowerEmit(instructions, state, nqNirGt(), condition)
        if greater < 0 as isize { return greater }
        instructions[greater as usize].left = remaining
        instructions[greater as usize].right = zero
        instructions[greater as usize].typeCode = nqAstTypeBool()
        let branch: isize = nqLowerEmit(instructions, state, nqNirBranch(), nqNirNoValue())
        if branch < 0 as isize { return branch }
        instructions[branch as usize].left = condition

        // Decrement before the body: continue jumps back to the condition
        // and cannot skip the decrement. Protect against INT_MIN by reaching
        // this point only when remaining > 0.
        let one: isize = nqLowerEmitConst(instructions, state, 1 as i64, nqAstTypeInt())
        if one < 0 as isize { return one }
        let nextValue: isize = nqLowerAllocRegister(state)
        let minus: isize = nqLowerEmit(instructions, state, nqNirSub(), nextValue)
        if minus < 0 as isize { return minus }
        instructions[minus as usize].left = remaining
        instructions[minus as usize].right = one
        instructions[minus as usize].typeCode = nqAstTypeInt()
        let decrement: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
        if decrement < 0 as isize { return decrement }
        instructions[decrement as usize].symbol = slot
        instructions[decrement as usize].left = nextValue

        let savedStart: usize = state.loopStart
        let savedBreakHead: isize = state.breakHead
        state.loopDepth = state.loopDepth + 1 as usize
        state.loopStart = loopStart
        state.breakHead = nqNirNoValue()
        let bodyStatus: isize = nqLowerStatement(source, nodes, node.right, instructions, state)
        if bodyStatus < 0 as isize { return bodyStatus }
        let jump: isize = nqLowerEmit(instructions, state, nqNirJump(), nqNirNoValue())
        if jump < 0 as isize { return jump }
        instructions[jump as usize].immediate = loopStart as i64
        let ending: usize = state.instructionCount
        instructions[branch as usize].immediate = ending as i64
        let pending: isize = state.breakHead
        while pending >= 0 as isize {
            let nextPending: isize = instructions[pending as usize].left
            instructions[pending as usize].left = nqNirNoValue()
            instructions[pending as usize].immediate = ending as i64
            pending = nextPending
        }
        state.breakHead = savedBreakHead
        state.loopStart = savedStart
        state.loopDepth = state.loopDepth - 1 as usize
        return nqLowerOk()
    }
    if node.tag == nqAstWhile() {
        let loopStart: usize = state.instructionCount
        let condition: isize = nqLowerExpressionInternal(source, nodes, node.left, instructions, state)
        if condition < 0 as isize { return condition }
        let branch: isize = nqLowerEmit(instructions, state, nqNirBranch(), nqNirNoValue())
        if branch < 0 as isize { return branch }
        instructions[branch as usize].left = condition
        // Nested loops maintain independent pending-break chains.
        let savedStart: usize = state.loopStart
        let savedBreakHead: isize = state.breakHead
        state.loopDepth = state.loopDepth + 1 as usize
        state.loopStart = loopStart
        state.breakHead = nqNirNoValue()
        let bodyStatus: isize = nqLowerStatement(source, nodes, node.right, instructions, state)
        if bodyStatus < 0 as isize { return bodyStatus }
        let jump: isize = nqLowerEmit(instructions, state, nqNirJump(), nqNirNoValue())
        if jump < 0 as isize { return jump }
        instructions[jump as usize].immediate = loopStart as i64
        let end: usize = state.instructionCount
        instructions[branch as usize].immediate = end as i64
        let pending: isize = state.breakHead
        while pending >= 0 as isize {
            let nextPending: isize = instructions[pending as usize].left
            instructions[pending as usize].left = nqNirNoValue()
            instructions[pending as usize].immediate = end as i64
            pending = nextPending
        }
        state.breakHead = savedBreakHead
        state.loopStart = savedStart
        state.loopDepth = state.loopDepth - 1 as usize
        return nqLowerOk()
    }
    return nqLowerUnsupported()
}

export function nqLowerFunction(source: []u8, nodes: []NqAstNode, nodeIndex: isize, instructions: []NqNirInstruction, state: *NqLowerState, out: *NqNirFunction): isize {
    if out == null || nodeIndex < 0 as isize || nodeIndex as usize >= len(nodes) { return nqLowerBadAst() }
    let node: *NqAstNode = &nodes[nodeIndex as usize]
    if node.tag != nqAstFunction() || node.left < 0 as isize { return nqLowerBadAst() }
    let name: *NqAstNode = &nodes[node.left as usize]
    out.symbol = nqNirSymbolId(source, name.start, name.end)
    out.nameStart = name.start
    out.nameEnd = name.end
    out.firstInstruction = state.instructionCount
    out.instructionCount = 0 as usize
    out.parameterCount = 0 as usize
    out.flags = node.flags
    let parameter: isize = node.right
    let parameterIndex: usize = 0 as usize
    while parameter >= 0 as isize {
        let param: *NqAstNode = &nodes[parameter as usize]
        let paramName: *NqAstNode = &nodes[param.left as usize]
        let reg: isize = nqLowerAllocRegister(state)
        let emitted: isize = nqLowerEmit(instructions, state, nqNirParameter(), reg)
        if emitted < 0 as isize { return emitted }
        instructions[emitted as usize].symbol = nqNirSymbolId(source, paramName.start, paramName.end)
        instructions[emitted as usize].immediate = parameterIndex as i64
        instructions[emitted as usize].sourceStart = paramName.start
        instructions[emitted as usize].sourceEnd = paramName.end
        let store: isize = nqLowerEmit(instructions, state, nqNirStore(), nqNirNoValue())
        if store < 0 as isize { return store }
        instructions[store as usize].symbol = instructions[emitted as usize].symbol
        instructions[store as usize].left = reg
        parameterIndex = parameterIndex + 1 as usize
        parameter = param.next
    }
    out.parameterCount = parameterIndex
    if node.extra >= 0 as isize {
        let status: isize = nqLowerStatement(source, nodes, node.extra, instructions, state)
        if status < 0 as isize { return status }
    }
    if state.instructionCount == out.firstInstruction || !nqNirIsTerminator(instructions[state.instructionCount - 1 as usize].opcode) {
        let ret: isize = nqLowerEmit(instructions, state, nqNirReturn(), nqNirNoValue())
        if ret < 0 as isize { return ret }
    }
    out.instructionCount = state.instructionCount - out.firstInstruction
    return nqLowerOk()
}

export function nqLowerProgram(source: []u8, nodes: []NqAstNode, first: isize, instructions: []NqNirInstruction, functions: []NqNirFunction, outInstructionCount: *usize, outFunctionCount: *usize): isize {
    if outInstructionCount == null || outFunctionCount == null { return nqLowerCapacity() }
    let state: NqLowerState
    nqLowerStateInit(&state)
    let functionCount: usize = 0 as usize
    let cursor: isize = first
    while cursor >= 0 as isize {
        if cursor as usize >= len(nodes) { return nqLowerBadAst() }
        let node: *NqAstNode = &nodes[cursor as usize]
        if node.tag == nqAstFunction() {
            if functionCount >= len(functions) { return nqLowerCapacity() }
            let status: isize = nqLowerFunction(source, nodes, cursor, instructions, &state, &functions[functionCount])
            if status < 0 as isize { return status }
            functionCount = functionCount + 1 as usize
        } else if node.tag != nqAstModule() && node.tag != nqAstImport() && node.tag != nqAstRecord() {
            if functionCount == 0 as usize || functions[functionCount - 1 as usize].symbol != 4294967296 as u64 {
                if functionCount >= len(functions) { return nqLowerCapacity() }
                functions[functionCount].symbol = 4294967296 as u64
                functions[functionCount].nameStart = 0 as usize
                functions[functionCount].nameEnd = 1 as usize
                functions[functionCount].firstInstruction = state.instructionCount
                functions[functionCount].instructionCount = 0 as usize
                functions[functionCount].parameterCount = 0 as usize
                functions[functionCount].flags = 0 as u32
                functionCount = functionCount + 1 as usize
            }
            let status: isize = nqLowerStatement(source, nodes, cursor, instructions, &state)
            if status < 0 as isize { return status }
            functions[functionCount - 1 as usize].instructionCount = state.instructionCount - functions[functionCount - 1 as usize].firstInstruction
        }
        cursor = node.next
    }
    outInstructionCount[0] = state.instructionCount
    outFunctionCount[0] = functionCount
    return nqLowerOk()
}
