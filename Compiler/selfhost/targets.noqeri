module noqeri.compiler.selfhost.targets

record NqTargetInfo {
    target: int
    architecture: int
    objectFormat: int
    abi: int
    pointerBytes: usize
    stackAlignment: usize
    pageAlignment: usize
    littleEndian: bool
}

export function nqTargetWindowsX64(): int { return 1 }
export function nqTargetWindowsArm64(): int { return 2 }
export function nqTargetLinuxX64(): int { return 3 }
export function nqTargetLinuxArm64(): int { return 4 }
export function nqTargetMacX64(): int { return 5 }
export function nqTargetMacArm64(): int { return 6 }
export function nqObjectCoff(): int { return 1 }
export function nqObjectElf(): int { return 2 }
export function nqObjectMachO(): int { return 3 }
export function nqArchX64(): int { return 1 }
export function nqArchArm64(): int { return 2 }
export function nqAbiWin64(): int { return 1 }
export function nqAbiSysV64(): int { return 2 }
export function nqAbiAapcs64(): int { return 3 }
export function nqAbiAppleArm64(): int { return 4 }

export function nqTargetValid(target: int): bool { return target >= nqTargetWindowsX64() && target <= nqTargetMacArm64() }
export function nqTargetObjectFormat(target: int): int { if !nqTargetValid(target) { return 0 } if target <= nqTargetWindowsArm64() { return nqObjectCoff() } if target <= nqTargetLinuxArm64() { return nqObjectElf() } return nqObjectMachO() }
export function nqTargetArchitecture(target: int): int { if !nqTargetValid(target) { return 0 } if target == nqTargetWindowsArm64() || target == nqTargetLinuxArm64() || target == nqTargetMacArm64() { return nqArchArm64() } return nqArchX64() }
export function nqTargetAbi(target: int): int { if !nqTargetValid(target) { return 0 } if target == nqTargetWindowsX64() || target == nqTargetWindowsArm64() { return nqAbiWin64() } if target == nqTargetLinuxX64() { return nqAbiSysV64() } if target == nqTargetLinuxArm64() { return nqAbiAapcs64() } if target == nqTargetMacArm64() { return nqAbiAppleArm64() } return nqAbiSysV64() }
export function nqTargetPointerBytes(target: int): usize { if nqTargetValid(target) { return 8 as usize } return 0 as usize }
export function nqTargetStackAlignment(target: int): usize { if nqTargetValid(target) { return 16 as usize } return 0 as usize }
export function nqTargetLittleEndian(target: int): bool { return nqTargetValid(target) }
export function nqTargetSupportsShared(target: int): bool { return nqTargetValid(target) }
export function nqTargetSupportsStatic(target: int): bool { return nqTargetValid(target) }
export function nqTargetSupportsDebug(target: int): bool { return nqTargetValid(target) }
export function nqTargetPageAlignment(target: int): usize { if target == nqTargetMacArm64() { return 16384 as usize } if nqTargetValid(target) { return 4096 as usize } return 0 as usize }

export function nqTargetDescribe(target: int, out: *NqTargetInfo): bool {
    if out == null || !nqTargetValid(target) { return false }
    out.target = target
    out.architecture = nqTargetArchitecture(target)
    out.objectFormat = nqTargetObjectFormat(target)
    out.abi = nqTargetAbi(target)
    out.pointerBytes = nqTargetPointerBytes(target)
    out.stackAlignment = nqTargetStackAlignment(target)
    out.pageAlignment = nqTargetPageAlignment(target)
    out.littleEndian = nqTargetLittleEndian(target)
    return true
}

export function nqTargetInfoValid(info: *NqTargetInfo): bool {
    if info == null || !nqTargetValid(info.target) { return false }
    return info.architecture == nqTargetArchitecture(info.target) && info.objectFormat == nqTargetObjectFormat(info.target) && info.abi == nqTargetAbi(info.target) && info.pointerBytes == nqTargetPointerBytes(info.target) && info.stackAlignment == nqTargetStackAlignment(info.target)
}
