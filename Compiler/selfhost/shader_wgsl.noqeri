                    } else { return -954 as isize }
                }
            } else if t.first == 40 as u8 {
                parens = parens + 1
                if !nqS2Write(out,&written,slice([40 as u8, 32 as u8])) { return -955 as isize }
            } else if t.first == 41 as u8 {
                parens = parens - 1
                if parens < 0 { return -956 as isize }
                if !nqS2Write(out,&written,slice([41 as u8, 32 as u8])) { return -957 as isize }
            } else if t.end == t.start + 1 as usize && (t.first == 43 as u8 || t.first == 45 as u8 || t.first == 42 as u8 || t.first == 47 as u8 || t.first == 37 as u8) {
                if written + 2 as usize > len(out) { return -958 as isize }
                out[written] = t.first
