module noqeri.compiler.selfhost.shader_wgsl
import "lexer.noqeri"
import "syntax.noqeri"

// Pure Noqeri Stage-2 WGSL compiler, executed from NQRI bytecode.
// Deliberately restricted to u32 shader functions with one pure return
// expression. VecN and texture parity are still Stage-0-only.
function nqS2Expect(src: []u8, pos: *usize, expected: []u8): bool {
    let token: NqToken
    nqCompilerNextToken(src,pos[0],&token)
    if !nqTokenTextEqual(src,&token,expected) { return false }
    pos[0] = token.end
    return true
}
function nqS2Name(src: []u8, pos: *usize, start: *usize, finish: *usize): bool {
    let token: NqToken
    nqCompilerNextToken(src,pos[0],&token)
    if token.kind != nqTokenIdentifier() { return false }
    start[0] = token.start
    finish[0] = token.end
    pos[0] = token.end
    return true
}
function nqS2Write(out: []u8, at: *usize, bytes: []u8): bool {
    if at[0] > len(out) || len(bytes) > len(out) - at[0] { return false }
    let i: usize = 0 as usize
    while i < len(bytes) {
        out[at[0] + i] = bytes[i]
        i = i + 1 as usize
    }
    at[0] = at[0] + len(bytes)
    return true
}
function nqS2Span(out: []u8, at: *usize, src: []u8, start: usize, end: usize): bool {
    if end < start || end > len(src) { return false }
    if at[0] > len(out) || end - start > len(out) - at[0] { return false }
    let i: usize = start
    while i < end {
        out[at[0]] = src[i]
        at[0] = at[0] + 1 as usize
        i = i + 1 as usize
    }
    return true
}
function nqS2SpanEquals(src: []u8, a: usize, b: usize, c: usize, d: usize): bool {
    if b < a || d < c || b - a != d - c { return false }
    let i: usize = 0 as usize
    while i < b - a {
        if src[a + i] != src[c + i] { return false }
        i = i + 1 as usize
    }
    return true
}
function nqS2Same(src: []u8, from: usize, to: usize, token: *NqToken): bool {
    if token == null || to < from || token.end - token.start != to - from { return false }
    let i: usize = 0 as usize
    while i < to - from {
        if src[from + i] != src[token.start + i] { return false }
        i = i + 1 as usize
    }
    return true
}
export function nqShaderS2Compile(src: []u8, stage: int, workgroup: int, out: []u8): isize {
    if len(src) > 4096 as usize || stage < 1 || stage > 2 { return -920 as isize }
    if workgroup != 32 && workgroup != 64 && workgroup != 128 && workgroup != 256 { return -921 as isize }
    if nqCompilerSyntaxCheck(src) != 0 as isize { return -922 as isize }
    let pos: usize = 0 as usize
    let first: NqToken
    nqCompilerNextToken(src,pos,&first)
    if nqTokenTextEqual(src,&first,slice([109 as u8, 111 as u8, 100 as u8, 117 as u8, 108 as u8, 101 as u8])) {
        pos = first.end
        let b: usize = 0 as usize
        let e: usize = 0 as usize
        if !nqS2Name(src,&pos,&b,&e) { return -923 as isize }
        let scanning: bool = true
        while scanning {
            let dot: NqToken
            nqCompilerNextToken(src,pos,&dot)
            if dot.first == 46 as u8 && dot.end == dot.start + 1 as usize {
                pos = dot.end
                if !nqS2Name(src,&pos,&b,&e) { return -924 as isize }
            } else { scanning = false }
        }
    }
    if !nqS2Expect(src,&pos,slice([101 as u8, 120 as u8, 112 as u8, 111 as u8, 114 as u8, 116 as u8])) { return -925 as isize }
    if !nqS2Expect(src,&pos,slice([102 as u8, 117 as u8, 110 as u8, 99 as u8, 116 as u8, 105 as u8, 111 as u8, 110 as u8])) { return -926 as isize }
    if !nqS2Expect(src,&pos,slice([115 as u8, 104 as u8, 97 as u8, 100 as u8, 101 as u8])) { return -927 as isize }
