        if !nqS2Write(out,&written,slice([102 as u8, 110 as u8, 32 as u8, 110 as u8, 111 as u8, 113 as u8, 101 as u8, 114 as u8, 105 as u8, 95 as u8, 115 as u8, 104 as u8, 97 as u8, 100 as u8, 101 as u8, 40 as u8, 110 as u8, 113 as u8, 95 as u8, 97 as u8, 114 as u8, 103 as u8, 48 as u8, 58 as u8, 32 as u8, 117 as u8, 51 as u8, 50 as u8, 41 as u8, 32 as u8, 45 as u8, 62 as u8, 32 as u8, 117 as u8, 51 as u8, 50 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8])) { return -942 as isize }
    } else {
        if !nqS2Write(out,&written,slice([102 as u8, 110 as u8, 32 as u8, 110 as u8, 111 as u8, 113 as u8, 101 as u8, 114 as u8, 105 as u8, 95 as u8, 115 as u8, 104 as u8, 97 as u8, 100 as u8, 101 as u8, 40 as u8, 110 as u8, 113 as u8, 95 as u8, 97 as u8, 114 as u8, 103 as u8, 48 as u8, 58 as u8, 32 as u8, 117 as u8, 51 as u8, 50 as u8, 44 as u8, 32 as u8, 110 as u8, 113 as u8, 95 as u8, 97 as u8, 114 as u8, 103 as u8, 49 as u8, 58 as u8, 32 as u8, 117 as u8, 51 as u8, 50 as u8, 41 as u8, 32 as u8, 45 as u8, 62 as u8, 32 as u8, 117 as u8, 51 as u8, 50 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8])) { return -943 as isize }
    }
    let parens: int = 0
    let count: usize = 0 as usize
    let done: bool = false
    while !done {
        let t: NqToken
        nqCompilerNextToken(src,pos,&t)
        if t.kind == nqTokenInvalid() || t.kind == nqTokenEof() { return -944 as isize }
        if t.first == 125 as u8 || t.first == 59 as u8 { done = true }
        else {
            if count >= 256 as usize { return -945 as isize }
            count = count + 1 as usize
            if t.kind == nqTokenInteger() {
                if t.end - t.start > 10 as usize { return -946 as isize }
                let i: usize = t.start
                let value: u64 = 0 as u64
                while i < t.end {
                    if src[i] < 48 as u8 || src[i] > 57 as u8 { return -947 as isize }
                    value = value * 10 as u64 + ((src[i] - 48 as u8) as u64)
                    if value > 4294967295 as u64 { return -948 as isize }
                    i = i + 1 as usize
                }
                if !nqS2Span(out,&written,src,t.start,t.end) { return -949 as isize }
                if !nqS2Write(out,&written,slice([117 as u8, 32 as u8])) { return -950 as isize }
            } else if t.kind == nqTokenIdentifier() {
                if nqTokenTextEqual(src,&t,slice([97 as u8, 115 as u8])) {
                    pos = t.end
                    if !nqS2Expect(src,&pos,slice([117 as u8, 51 as u8, 50 as u8])) { return -951 as isize }
                } else {
