module noqeri.compiler.selfhost.shader_wgsl
import "ast.noqeri"
import "lexer.noqeri"
import "parser.noqeri"
import "parser_stmt.noqeri"

// Experimental Noqeri-written Stage-2 GPU emitter. This currently accepts
// pure single-return u32 compute functions. It is standalone and does not
// alter the checksum-pinned trusted Stage-1 seed. The Stage-0 GPU v3 backend
// retains a broader vec/texture surface until full parity is qualified.
function nqGpuAppend(out: []u8, offset: *usize, bytes: []u8): bool {
    if offset == null || offset[0] > len(out) { return false }
    if len(bytes) > len(out) - offset[0] { return false }
    let index: usize = 0 as usize
    while index < len(bytes) {
        out[offset[0] + index] = bytes[index]
        index = index + 1 as usize
    }
    offset[0] = offset[0] + len(bytes)
    return true
}
function nqGpuByte(out: []u8, offset: *usize, value: u8): bool {
    if offset == null || offset[0] >= len(out) { return false }
    out[offset[0]] = value
    offset[0] = offset[0] + 1 as usize
    return true
}
function nqGpuRange(out: []u8, offset: *usize, source: []u8, first: usize, end: usize): bool {
    if first >= end || end > len(source) || offset == null { return false }
    if offset[0] > len(out) || end - first > len(out) - offset[0] { return false }
    let at: usize = first
    while at < end {
        if !nqGpuByte(out, offset, source[at]) { return false }
        at = at + 1 as usize
    }
    return true
}
function nqGpuEqual(source: []u8, first: usize, end: usize, word: []u8): bool {
    if first > end || end > len(source) || end - first != len(word) { return false }
    let i: usize = 0 as usize
    while i < len(word) {
        if source[first + i] != word[i] { return false }
        i = i + 1 as usize
    }
    return true
}
function nqGpuSameName(source: []u8, aStart: usize, aEnd: usize, bStart: usize, bEnd: usize): bool {
    if aStart > aEnd || bStart > bEnd || aEnd > len(source) ||
       bEnd > len(source) || aEnd - aStart != bEnd - bStart { return false }
    let i: usize = 0 as usize
    while i < aEnd - aStart {
        if source[aStart + i] != source[bStart + i] { return false }
        i = i + 1 as usize
    }
    return true
}
function nqGpuIntegerValid(source: []u8, first: usize, end: usize): bool {
    if first >= end || end > len(source) { return false }
    let value: u64 = 0 as u64
    let at: usize = first
    while at < end {
        let c: u8 = source[at]
        if c < 48 as u8 || c > 57 as u8 { return false }
        let digit: u64 = (c - 48 as u8) as u64
        if value > (4294967295 as u64 - digit) / 10 as u64 { return false }
        value = value * 10 as u64 + digit
        at = at + 1 as usize
    }
    return true
}
function nqGpuComputeExpression(source: []u8, nodes: []NqAstNode, index: isize,
            parameter: isize, expected: int, out: []u8, cursor: *usize, depth: usize): int {
    if index < 0 as isize || index as usize >= len(nodes) || depth > 48 as usize { return -1 }
    let node: NqAstNode = nodes[index as usize]
    if node.tag == nqAstName() {
        if parameter < 0 as isize || parameter as usize >= len(nodes) { return -1 }
        let name: NqAstNode = nodes[parameter as usize]
        if !nqGpuSameName(source, node.start, node.end, name.start, name.end) { return -1 }
        if !nqGpuAppend(out, cursor, slice([110 as u8, 113 as u8, 95 as u8, 97 as u8, 114 as u8, 103 as u8, 48 as u8])) { return -1 }
        return expected
    }
    if node.tag == nqAstInteger() {
        if !nqGpuIntegerValid(source, node.start, node.end) { return -1 }
        if !nqGpuRange(out, cursor, source, node.start, node.end) { return -1 }
        if !nqGpuByte(out, cursor, 117 as u8) { return -1 }
        return 1
    }
    if node.tag == nqAstFloat() {
        if !nqGpuRange(out, cursor, source, node.start, node.end) { return -1 }
        if !nqGpuByte(out, cursor, 102 as u8) { return -1 }
        return 2
    }
    if node.tag == nqAstCast() {
        if node.extra < 0 as isize { return -1 }
        let token: NqToken
        nqCompilerNextToken(source, node.extra as usize, &token)
        let kind: int = 0
        if nqTokenTextEqual(source, &token, slice([117 as u8, 51 as u8, 50 as u8])) { kind = 1 }
        if nqTokenTextEqual(source, &token, slice([102 as u8, 108 as u8, 111 as u8, 97 as u8, 116 as u8])) { kind = 2 }
        if kind == 0 { return -1 }
        if kind == 1 { if !nqGpuAppend(out, cursor, slice([117 as u8, 51 as u8, 50 as u8, 40 as u8])) { return -1 } }
        else { if !nqGpuAppend(out, cursor, slice([102 as u8, 51 as u8, 50 as u8, 40 as u8])) { return -1 } }
        let sourceKind: int = nqGpuComputeExpression(source, nodes, node.left, parameter, expected, out, cursor, depth + 1 as usize)
        if sourceKind != 1 && sourceKind != 2 { return -1 }
        if !nqGpuByte(out, cursor, 41 as u8) { return -1 }
        return kind
    }
    if node.tag == nqAstBinary() {
        let code: u32 = node.flags
        if code != 43 as u32 && code != 45 as u32 &&
           code != 42 as u32 && code != 47 as u32 && code != 37 as u32 { return -1 }
        if !nqGpuByte(out, cursor, 40 as u8) { return -1 }
        let left: int = nqGpuComputeExpression(source, nodes, node.left, parameter, expected, out, cursor, depth + 1 as usize)
        if left < 0 { return -1 }
        if !nqGpuByte(out, cursor, 32 as u8) || !nqGpuByte(out, cursor, code as u8) ||
           !nqGpuByte(out, cursor, 32 as u8) { return -1 }
        let right: int = nqGpuComputeExpression(source, nodes, node.right, parameter, expected, out, cursor, depth + 1 as usize)
        if right != left || (left == 2 && code == 37 as u32) { return -1 }
        if !nqGpuByte(out, cursor, 41 as u8) { return -1 }
        return left
    }
    return -1
}

// Returns written WGSL bytes, or a negative error. The source is fully parsed
// using the Noqeri-owned Stage-2 AST parser before any output is accepted.
export function nqStage2ShaderComputeWgsl(source: []u8, out: []u8): isize {
    if len(source) == 0 as usize || len(source) > 16384 as usize ||
       len(out) < 256 as usize { return -1 }
    let nodes: [NqAstNode; 2048]
    let count: usize = 0 as usize
    let first: isize = nqAstNoNode()
    if nqParserParseProgram(source, slice(nodes), &count, &first) < 0 as isize { return -2 }
    let functionIndex: isize = nqAstNoNode()
    let cursor: isize = first
    while cursor >= 0 as isize {
        if cursor as usize >= count { return -3 }
        let node: NqAstNode = nodes[cursor as usize]
        if node.tag == nqAstFunction() {
            if functionIndex >= 0 as isize { return -4 }
            functionIndex = cursor
        } else { if node.tag != nqAstModule() { return -5 } }
        cursor = node.next
    }
    if functionIndex < 0 as isize { return -6 }
    let fn: NqAstNode = nodes[functionIndex as usize]
    if fn.flags != nqAstFlagExport() || fn.left < 0 as isize ||
       fn.right < 0 as isize || fn.extra < 0 as isize { return -7 }
    let fnName: NqAstNode = nodes[fn.left as usize]
    if !nqGpuEqual(source, fnName.start, fnName.end, slice([115 as u8, 104 as u8, 97 as u8, 100 as u8, 101 as u8])) { return -8 }
    let param: NqAstNode = nodes[fn.right as usize]
    if param.next >= 0 as isize || param.left < 0 as isize || param.extra < 0 as isize { return -9 }
    let parameterName: isize = param.left
    let paramType: NqToken
    nqCompilerNextToken(source, param.extra as usize, &paramType)
    let scalar: int = 0
    if nqTokenTextEqual(source, &paramType, slice([117 as u8, 51 as u8, 50 as u8])) { scalar = 1 }
    if nqTokenTextEqual(source, &paramType, slice([102 as u8, 108 as u8, 111 as u8, 97 as u8, 116 as u8])) { scalar = 2 }
    if scalar == 0 { return -10 }
    let close: NqToken
    nqCompilerNextToken(source, param.end, &close)
    if close.kind != nqTokenPunctuation() || close.first != 41 as u8 { return -11 }
    let colon: NqToken
    nqCompilerNextToken(source, close.end, &colon)
    if colon.kind != nqTokenPunctuation() || colon.first != 58 as u8 { return -12 }
    let returnType: NqToken
    nqCompilerNextToken(source, colon.end, &returnType)
    if scalar == 1 && !nqTokenTextEqual(source, &returnType, slice([117 as u8, 51 as u8, 50 as u8])) { return -13 }
    if scalar == 2 && !nqTokenTextEqual(source, &returnType, slice([102 as u8, 108 as u8, 111 as u8, 97 as u8, 116 as u8])) { return -14 }
    let block: NqAstNode = nodes[fn.extra as usize]
    if block.tag != nqAstBlock() || block.left < 0 as isize { return -15 }
    let returnNode: NqAstNode = nodes[block.left as usize]
    if returnNode.tag != nqAstReturn() || returnNode.next >= 0 as isize ||
       returnNode.left < 0 as isize { return -16 }
    let written: usize = 0 as usize
    if scalar == 1 {
       if !nqGpuAppend(out, &written, slice([102 as u8, 110 as u8, 32 as u8, 110 as u8, 111 as u8, 113 as u8, 101 as u8, 114 as u8, 105 as u8, 95 as u8, 115 as u8, 104 as u8, 97 as u8, 100 as u8, 101 as u8, 40 as u8, 110 as u8, 113 as u8, 95 as u8, 97 as u8, 114 as u8, 103 as u8, 48 as u8, 58 as u8, 32 as u8, 117 as u8, 51 as u8, 50 as u8, 41 as u8, 32 as u8, 45 as u8, 62 as u8, 32 as u8, 117 as u8, 51 as u8, 50 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8])) { return -17 }
    } else {
       if !nqGpuAppend(out, &written, slice([102 as u8, 110 as u8, 32 as u8, 110 as u8, 111 as u8, 113 as u8, 101 as u8, 114 as u8, 105 as u8, 95 as u8, 115 as u8, 104 as u8, 97 as u8, 100 as u8, 101 as u8, 40 as u8, 110 as u8, 113 as u8, 95 as u8, 97 as u8, 114 as u8, 103 as u8, 48 as u8, 58 as u8, 32 as u8, 102 as u8, 51 as u8, 50 as u8, 41 as u8, 32 as u8, 45 as u8, 62 as u8, 32 as u8, 102 as u8, 51 as u8, 50 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 32 as u8])) { return -17 }
    }
    let expressionType: int = nqGpuComputeExpression(source, slice(nodes, count),
                        returnNode.left, parameterName, scalar, out, &written, 0 as usize)
    if expressionType != scalar { return -18 }
    if !nqGpuAppend(out, &written, slice([59 as u8, 32 as u8, 125 as u8, 10 as u8])) { return -19 }
    if scalar == 1 {
        if !nqGpuAppend(out, &written, slice([64 as u8, 103 as u8, 114 as u8, 111 as u8, 117 as u8, 112 as u8, 40 as u8, 48 as u8, 41 as u8, 32 as u8, 64 as u8, 98 as u8, 105 as u8, 110 as u8, 100 as u8, 105 as u8, 110 as u8, 103 as u8, 40 as u8, 48 as u8, 41 as u8, 32 as u8, 118 as u8, 97 as u8, 114 as u8, 60 as u8, 115 as u8, 116 as u8, 111 as u8, 114 as u8, 97 as u8, 103 as u8, 101 as u8, 44 as u8, 32 as u8, 114 as u8, 101 as u8, 97 as u8, 100 as u8, 62 as u8, 32 as u8, 105 as u8, 110 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 58 as u8, 32 as u8, 97 as u8, 114 as u8, 114 as u8, 97 as u8, 121 as u8, 60 as u8, 117 as u8, 51 as u8, 50 as u8, 62 as u8, 59 as u8, 10 as u8, 64 as u8, 103 as u8, 114 as u8, 111 as u8, 117 as u8, 112 as u8, 40 as u8, 48 as u8, 41 as u8, 32 as u8, 64 as u8, 98 as u8, 105 as u8, 110 as u8, 100 as u8, 105 as u8, 110 as u8, 103 as u8, 40 as u8, 49 as u8, 41 as u8, 32 as u8, 118 as u8, 97 as u8, 114 as u8, 60 as u8, 115 as u8, 116 as u8, 111 as u8, 114 as u8, 97 as u8, 103 as u8, 101 as u8, 44 as u8, 32 as u8, 114 as u8, 101 as u8, 97 as u8, 100 as u8, 95 as u8, 119 as u8, 114 as u8, 105 as u8, 116 as u8, 101 as u8, 62 as u8, 32 as u8, 111 as u8, 117 as u8, 116 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 58 as u8, 32 as u8, 97 as u8, 114 as u8, 114 as u8, 97 as u8, 121 as u8, 60 as u8, 117 as u8, 51 as u8, 50 as u8, 62 as u8, 59 as u8, 10 as u8])) { return -20 }
    } else {
        if !nqGpuAppend(out, &written, slice([64 as u8, 103 as u8, 114 as u8, 111 as u8, 117 as u8, 112 as u8, 40 as u8, 48 as u8, 41 as u8, 32 as u8, 64 as u8, 98 as u8, 105 as u8, 110 as u8, 100 as u8, 105 as u8, 110 as u8, 103 as u8, 40 as u8, 48 as u8, 41 as u8, 32 as u8, 118 as u8, 97 as u8, 114 as u8, 60 as u8, 115 as u8, 116 as u8, 111 as u8, 114 as u8, 97 as u8, 103 as u8, 101 as u8, 44 as u8, 32 as u8, 114 as u8, 101 as u8, 97 as u8, 100 as u8, 62 as u8, 32 as u8, 105 as u8, 110 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 58 as u8, 32 as u8, 97 as u8, 114 as u8, 114 as u8, 97 as u8, 121 as u8, 60 as u8, 102 as u8, 51 as u8, 50 as u8, 62 as u8, 59 as u8, 10 as u8, 64 as u8, 103 as u8, 114 as u8, 111 as u8, 117 as u8, 112 as u8, 40 as u8, 48 as u8, 41 as u8, 32 as u8, 64 as u8, 98 as u8, 105 as u8, 110 as u8, 100 as u8, 105 as u8, 110 as u8, 103 as u8, 40 as u8, 49 as u8, 41 as u8, 32 as u8, 118 as u8, 97 as u8, 114 as u8, 60 as u8, 115 as u8, 116 as u8, 111 as u8, 114 as u8, 97 as u8, 103 as u8, 101 as u8, 44 as u8, 32 as u8, 114 as u8, 101 as u8, 97 as u8, 100 as u8, 95 as u8, 119 as u8, 114 as u8, 105 as u8, 116 as u8, 101 as u8, 62 as u8, 32 as u8, 111 as u8, 117 as u8, 116 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 58 as u8, 32 as u8, 97 as u8, 114 as u8, 114 as u8, 97 as u8, 121 as u8, 60 as u8, 102 as u8, 51 as u8, 50 as u8, 62 as u8, 59 as u8, 10 as u8])) { return -20 }
    }
    if !nqGpuAppend(out, &written, slice([64 as u8, 99 as u8, 111 as u8, 109 as u8, 112 as u8, 117 as u8, 116 as u8, 101 as u8, 32 as u8, 64 as u8, 119 as u8, 111 as u8, 114 as u8, 107 as u8, 103 as u8, 114 as u8, 111 as u8, 117 as u8, 112 as u8, 95 as u8, 115 as u8, 105 as u8, 122 as u8, 101 as u8, 40 as u8, 54 as u8, 52 as u8, 41 as u8, 10 as u8, 102 as u8, 110 as u8, 32 as u8, 109 as u8, 97 as u8, 105 as u8, 110 as u8, 40 as u8, 64 as u8, 98 as u8, 117 as u8, 105 as u8, 108 as u8, 116 as u8, 105 as u8, 110 as u8, 40 as u8, 103 as u8, 108 as u8, 111 as u8, 98 as u8, 97 as u8, 108 as u8, 95 as u8, 105 as u8, 110 as u8, 118 as u8, 111 as u8, 99 as u8, 97 as u8, 116 as u8, 105 as u8, 111 as u8, 110 as u8, 95 as u8, 105 as u8, 100 as u8, 41 as u8, 32 as u8, 105 as u8, 100 as u8, 58 as u8, 32 as u8, 118 as u8, 101 as u8, 99 as u8, 51 as u8, 60 as u8, 117 as u8, 51 as u8, 50 as u8, 62 as u8, 41 as u8, 32 as u8, 123 as u8, 10 as u8, 32 as u8, 32 as u8, 108 as u8, 101 as u8, 116 as u8, 32 as u8, 105 as u8, 32 as u8, 61 as u8, 32 as u8, 105 as u8, 100 as u8, 46 as u8, 120 as u8, 59 as u8, 10 as u8, 32 as u8, 32 as u8, 105 as u8, 102 as u8, 32 as u8, 40 as u8, 105 as u8, 32 as u8, 62 as u8, 61 as u8, 32 as u8, 97 as u8, 114 as u8, 114 as u8, 97 as u8, 121 as u8, 76 as u8, 101 as u8, 110 as u8, 103 as u8, 116 as u8, 104 as u8, 40 as u8, 38 as u8, 105 as u8, 110 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 41 as u8, 32 as u8, 124 as u8, 124 as u8, 32 as u8, 105 as u8, 32 as u8, 62 as u8, 61 as u8, 32 as u8, 97 as u8, 114 as u8, 114 as u8, 97 as u8, 121 as u8, 76 as u8, 101 as u8, 110 as u8, 103 as u8, 116 as u8, 104 as u8, 40 as u8, 38 as u8, 111 as u8, 117 as u8, 116 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 41 as u8, 41 as u8, 32 as u8, 123 as u8, 32 as u8, 114 as u8, 101 as u8, 116 as u8, 117 as u8, 114 as u8, 110 as u8, 59 as u8, 32 as u8, 125 as u8, 10 as u8, 32 as u8, 32 as u8, 111 as u8, 117 as u8, 116 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 91 as u8, 105 as u8, 93 as u8, 32 as u8, 61 as u8, 32 as u8, 110 as u8, 111 as u8, 113 as u8, 101 as u8, 114 as u8, 105 as u8, 95 as u8, 115 as u8, 104 as u8, 97 as u8, 100 as u8, 101 as u8, 40 as u8, 105 as u8, 110 as u8, 112 as u8, 117 as u8, 116 as u8, 95 as u8, 112 as u8, 105 as u8, 120 as u8, 101 as u8, 108 as u8, 115 as u8, 91 as u8, 105 as u8, 93 as u8, 41 as u8, 59 as u8, 10 as u8, 125 as u8, 10 as u8])) { return -21 }
    return written as isize
}
