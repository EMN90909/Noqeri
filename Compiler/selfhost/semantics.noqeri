module noqeri.compiler.selfhost.semantics
import "ast.nqr"
import "types.nqr"
import "symbols.nqr"

export function nqSemanticOk(): isize { return 0 }
export function nqSemanticTypeMismatch(): isize { return -200 }
export function nqSemanticInvalidCondition(): isize { return -201 }
export function nqSemanticInvalidReturn(): isize { return -202 }
export function nqSemanticConstWrite(): isize { return -203 }
export function nqSemanticInvalidPointer(): isize { return -204 }
export function nqSemanticInvalidCast(): isize { return -205 }
export function nqSemanticInvalidIndex(): isize { return -206 }
export function nqSemanticInvalidBinary(): isize { return -207 }
export function nqSemanticInvalidUnary(): isize { return -208 }
export function nqSemanticUnsafeRequired(): isize { return -209 }
export function nqSemanticInvalidArrayElement(): isize { return -210 }
export function nqSemanticUnknownName(): isize { return -211 }
export function nqSemanticDuplicateName(): isize { return -212 }

export function nqSemanticOpAdd(): int { return 1 }
export function nqSemanticOpSub(): int { return 2 }
export function nqSemanticOpMul(): int { return 3 }
export function nqSemanticOpDiv(): int { return 4 }
export function nqSemanticOpMod(): int { return 5 }
export function nqSemanticOpEq(): int { return 6 }
export function nqSemanticOpNe(): int { return 7 }
export function nqSemanticOpLt(): int { return 8 }
export function nqSemanticOpLe(): int { return 9 }
export function nqSemanticOpGt(): int { return 10 }
export function nqSemanticOpGe(): int { return 11 }
export function nqSemanticOpAnd(): int { return 12 }
export function nqSemanticOpOr(): int { return 13 }

export function nqSemanticConditionTypeValid(typeCode: int): bool { return typeCode == nqAstTypeBool() }

export function nqSemanticAssignable(fromCode: int, toCode: int): bool {
    if fromCode == nqAstTypeUnknown() || toCode == nqAstTypeUnknown() || fromCode == nqAstTypeGeneric() || toCode == nqAstTypeGeneric() { return true }
    if fromCode == toCode { return true }
    if nqCompilerTypeIsInteger(fromCode) && nqCompilerTypeIsInteger(toCode) { return nqCompilerCanImplicitWiden(fromCode, toCode) }
    if toCode == nqAstTypeFloat() && nqCompilerTypeIsInteger(fromCode) { return true }
    if toCode == nqAstTypePointer() && fromCode == nqAstTypeNull() { return true }
    return false
}

export function nqSemanticExplicitCastValid(fromCode: int, toCode: int): bool {
    if fromCode == toCode { return true }
    if nqCompilerTypeIsNumeric(fromCode) && nqCompilerTypeIsNumeric(toCode) { return true }
    if fromCode == nqAstTypePointer() && toCode == nqAstTypePointer() { return true }
    if fromCode == nqAstTypePointer() && toCode == nqAstTypeUsize() { return true }
    if fromCode == nqAstTypeUsize() && toCode == nqAstTypePointer() { return true }
    return false
}

export function nqSemanticCastRequiresUnsafe(fromCode: int, toCode: int): bool {
    return (fromCode == nqAstTypePointer() && toCode == nqAstTypeUsize()) || (fromCode == nqAstTypeUsize() && toCode == nqAstTypePointer())
}

export function nqSemanticReturnValid(actual: int, expected: int): bool {
    if expected == nqAstTypeVoid() { return actual == nqAstTypeVoid() }
    return nqSemanticAssignable(actual, expected)
}

export function nqSemanticIndexValid(containerType: int, indexType: int): bool { return nqCompilerTypeIsIndexable(containerType) && nqCompilerTypeIsInteger(indexType) }
export function nqSemanticArrayElementValid(elementType: int, valueType: int): bool { return nqSemanticAssignable(valueType, elementType) }

export function nqSemanticBinaryResult(op: int, left: int, right: int): int {
    if op == nqSemanticOpAnd() || op == nqSemanticOpOr() {
        if left == nqAstTypeBool() && right == nqAstTypeBool() { return nqAstTypeBool() }
        return nqAstTypeUnknown()
    }
    if op >= nqSemanticOpEq() && op <= nqSemanticOpGe() {
        if left == right { return nqAstTypeBool() }
        if nqCompilerTypeIsNumeric(left) && nqCompilerTypeIsNumeric(right) { return nqAstTypeBool() }
        if left == nqAstTypePointer() && right == nqAstTypeNull() { return nqAstTypeBool() }
        if right == nqAstTypePointer() && left == nqAstTypeNull() { return nqAstTypeBool() }
        return nqAstTypeUnknown()
    }
    if op >= nqSemanticOpAdd() && op <= nqSemanticOpMod() {
        if left == right && nqCompilerTypeIsNumeric(left) { return left }
        if nqCompilerTypeIsFloat(left) && nqCompilerTypeIsInteger(right) { return nqAstTypeFloat() }
        if nqCompilerTypeIsFloat(right) && nqCompilerTypeIsInteger(left) { return nqAstTypeFloat() }
        if nqCompilerTypeIsInteger(left) && nqCompilerTypeIsInteger(right) {
            if nqSemanticAssignable(left, right) { return right }
            if nqSemanticAssignable(right, left) { return left }
        }
    }
    return nqAstTypeUnknown()
}

export function nqSemanticUnaryResult(operatorCode: int, operand: int): int {
    if operatorCode == 33 { if operand == nqAstTypeBool() { return nqAstTypeBool() } return nqAstTypeUnknown() }
    if operatorCode == 45 || operatorCode == 43 { if nqCompilerTypeIsNumeric(operand) { return operand } return nqAstTypeUnknown() }
    if operatorCode == 38 { if operand != nqAstTypeVoid() && operand != nqAstTypeUnknown() { return nqAstTypePointer() } return nqAstTypeUnknown() }
    if operatorCode == 42 { if operand == nqAstTypePointer() { return nqAstTypeUnknown() } }
    return nqAstTypeUnknown()
}

export function nqSemanticResolveName(source: []u8, symbols: []NqSymbol, symbolCount: usize, start: usize, end: usize, scopeDepth: usize): isize {
    let symbol: isize = nqSymbolsLookup(source, symbols, symbolCount, start, end, scopeDepth)
    if symbol < 0 as isize { return nqSemanticUnknownName() }
    return symbol
}

export function nqSemanticCanWriteSymbol(symbol: *NqSymbol): isize {
    if symbol == null { return nqSemanticUnknownName() }
    if nqSymbolConst(symbol) { return nqSemanticConstWrite() }
    return nqSemanticOk()
}
