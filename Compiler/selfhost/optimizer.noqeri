module noqeri.compiler.selfhost.optimizer
import "nir.noqeri"
import "types.noqeri"

export function nqOptLevelNone(): int { return 0 }
export function nqOptLevelSize(): int { return 1 }
export function nqOptLevelSpeed(): int { return 2 }
export function nqOptLevelAggressive(): int { return 3 }
export function nqOptimizerLevelValid(level: int): bool { return level >= nqOptLevelNone() && level <= nqOptLevelAggressive() }
export function nqOptimizerCanFold(opcode: int): bool { return nqNirIsPureArithmetic(opcode) }
export function nqOptimizerCanEliminate(opcode: int, resultUsed: bool): bool { return !resultUsed && !nqNirHasSideEffect(opcode) }
export function nqOptimizerShouldInline(instructions: usize, level: int): bool { if level == nqOptLevelNone() { return false } if level == nqOptLevelSize() { return instructions <= 6 as usize } if level == nqOptLevelSpeed() { return instructions <= 24 as usize } return instructions <= 64 as usize }
export function nqOptimizerPassBudget(level: int): int { if level <= 0 { return 0 } if level == 1 { return 2 } if level == 2 { return 5 } return 8 }

function nqOptimizerI64Max(): i64 { return 9223372036854775807 as i64 }
function nqOptimizerI64Min(): i64 { return -9223372036854775807 as i64 - 1 as i64 }

function nqOptimizerSafeAdd(a: i64, b: i64): bool {
    if b > 0 as i64 && a > nqOptimizerI64Max() - b { return false }
    if b < 0 as i64 && a < nqOptimizerI64Min() - b { return false }
    return true
}
function nqOptimizerSafeSub(a: i64, b: i64): bool {
    if b < 0 as i64 && a > nqOptimizerI64Max() + b { return false }
    if b > 0 as i64 && a < nqOptimizerI64Min() + b { return false }
    return true
}
function nqOptimizerSafeMul(a: i64, b: i64): bool {
    if a == 0 as i64 || b == 0 as i64 { return true }
    if a == -1 as i64 { return b != nqOptimizerI64Min() }
    if b == -1 as i64 { return a != nqOptimizerI64Min() }
    if a > 0 as i64 {
        if b > 0 as i64 { return a <= nqOptimizerI64Max() / b }
        return b >= nqOptimizerI64Min() / a
    }
    if b > 0 as i64 { return a >= nqOptimizerI64Min() / b }
    return a >= nqOptimizerI64Max() / b
}

// Returns 1 when folded and writes the result; 0 means "leave it for runtime".
export function nqOptimizerFoldI64(opcode: int, a: i64, b: i64, out: *i64): isize {
    if out == null { return 0 }
    if opcode == nqNirAdd() { if !nqOptimizerSafeAdd(a, b) { return 0 } out[0] = a + b return 1 }
    if opcode == nqNirSub() { if !nqOptimizerSafeSub(a, b) { return 0 } out[0] = a - b return 1 }
    if opcode == nqNirMul() { if !nqOptimizerSafeMul(a, b) { return 0 } out[0] = a * b return 1 }
    if opcode == nqNirDiv() { if b == 0 as i64 || (a == nqOptimizerI64Min() && b == -1 as i64) { return 0 } out[0] = a / b return 1 }
    if opcode == nqNirMod() { if b == 0 as i64 || (a == nqOptimizerI64Min() && b == -1 as i64) { return 0 } out[0] = a % b return 1 }
    if opcode == nqNirEq() { if a == b { out[0] = 1 as i64 } else { out[0] = 0 as i64 } return 1 }
    if opcode == nqNirNe() { if a != b { out[0] = 1 as i64 } else { out[0] = 0 as i64 } return 1 }
    if opcode == nqNirLt() { if a < b { out[0] = 1 as i64 } else { out[0] = 0 as i64 } return 1 }
    if opcode == nqNirLe() { if a <= b { out[0] = 1 as i64 } else { out[0] = 0 as i64 } return 1 }
    if opcode == nqNirGt() { if a > b { out[0] = 1 as i64 } else { out[0] = 0 as i64 } return 1 }
    if opcode == nqNirGe() { if a >= b { out[0] = 1 as i64 } else { out[0] = 0 as i64 } return 1 }
    return 0
}

function nqOptimizerFindConstBefore(instructions: []NqNirInstruction, before: usize, value: isize, out: *i64): bool {
    if value < 0 as isize || out == null || before == 0 as usize { return false }
    let cursor: isize = before as isize - 1 as isize
    while cursor >= 0 as isize {
        let item: *NqNirInstruction = &instructions[cursor as usize]
        if item.dest == value {
            if item.opcode == nqNirConstI64() { out[0] = item.immediate return true }
            return false
        }
        cursor = cursor - 1 as isize
    }
    return false
}

function nqOptimizerValueUsedAfter(instructions: []NqNirInstruction, after: usize, value: isize): bool {
    let index: usize = after + 1 as usize
    while index < len(instructions) {
        if nqNirInstructionUses(&instructions[index], value) { return true }
        // A redefinition closes this value's live range in the simple Stage-2 SSA form.
        if instructions[index].dest == value { return false }
        index = index + 1 as usize
    }
    return false
}

export function nqOptimizerConstantFold(instructions: []NqNirInstruction): usize {
    let changes: usize = 0 as usize
    let index: usize = 0 as usize
    while index < len(instructions) {
        let item: *NqNirInstruction = &instructions[index]
        if nqOptimizerCanFold(item.opcode) && item.dest >= 0 as isize {
            let leftValue: i64 = 0 as i64
            let rightValue: i64 = 0 as i64
            if nqOptimizerFindConstBefore(instructions, index, item.left, &leftValue) && nqOptimizerFindConstBefore(instructions, index, item.right, &rightValue) {
                let folded: i64 = 0 as i64
                if nqOptimizerFoldI64(item.opcode, leftValue, rightValue, &folded) > 0 {
                    item.opcode = nqNirConstI64()
                    item.left = nqNirNoValue()
                    item.right = nqNirNoValue()
                    item.immediate = folded
                    changes = changes + 1 as usize
                }
            }
        } else if item.opcode == nqNirMove() && item.dest >= 0 as isize {
            let moved: i64 = 0 as i64
            if nqOptimizerFindConstBefore(instructions, index, item.left, &moved) {
                item.opcode = nqNirConstI64()
                item.left = nqNirNoValue()
                item.immediate = moved
                changes = changes + 1 as usize
            }
        }
        index = index + 1 as usize
    }
    return changes
}

export function nqOptimizerAlgebraicSimplify(instructions: []NqNirInstruction): usize {
    let changes: usize = 0 as usize
    let index: usize = 0 as usize
    while index < len(instructions) {
        let item: *NqNirInstruction = &instructions[index]
        if item.opcode == nqNirMove() && item.dest == item.left { item.opcode = nqNirNop() changes = changes + 1 as usize }
        else if (item.opcode == nqNirAdd() || item.opcode == nqNirSub() || item.opcode == nqNirMul() || item.opcode == nqNirDiv()) && item.dest >= 0 as isize {
            let rightValue: i64 = 0 as i64
            if nqOptimizerFindConstBefore(instructions, index, item.right, &rightValue) {
                if (item.opcode == nqNirAdd() || item.opcode == nqNirSub()) && rightValue == 0 as i64 { item.opcode = nqNirMove() item.right = nqNirNoValue() changes = changes + 1 as usize }
                else if (item.opcode == nqNirMul() || item.opcode == nqNirDiv()) && rightValue == 1 as i64 { item.opcode = nqNirMove() item.right = nqNirNoValue() changes = changes + 1 as usize }
                else if item.opcode == nqNirMul() && rightValue == 0 as i64 { item.opcode = nqNirConstI64() item.left = nqNirNoValue() item.right = nqNirNoValue() item.immediate = 0 as i64 changes = changes + 1 as usize }
            }
        }
        index = index + 1 as usize
    }
    return changes
}

// Stage-2's own bounded register-SSA local GVN. No Phi, branch, exception,
// checked or volatile operation can enter this pass. Unlike Stage-0's NIR,
// this IR has a Move opcode, so redundant results retain their register ids.
export function nqOptimizerLocalGvn(instructions: []NqNirInstruction): usize {
    let count: usize = len(instructions)
    if count > 512 as usize { return 0 as usize }
    // Prove one straight-line region and unique virtual definitions first.
    let index: usize = 0 as usize
    while index < count {
        let current: *NqNirInstruction = &instructions[index]
        if nqNirIsTerminator(current.opcode) && index + 1 as usize < count { return 0 as usize }
        if current.opcode == nqNirJump() || current.opcode == nqNirBranch() ||
           current.opcode == nqNirPhi() || current.opcode == nqNirLabel() ||
           current.opcode == nqNirTry() || current.opcode == nqNirThrow() ||
           current.opcode == nqNirAsm() { return 0 as usize }
        if current.dest >= 0 as isize && nqNirDefinesValue(current.opcode) {
            let previous: usize = 0 as usize
            while previous < index {
                if instructions[previous].dest == current.dest &&
                   nqNirDefinesValue(instructions[previous].opcode) { return 0 as usize }
                previous = previous + 1 as usize
            }
        }
        index = index + 1 as usize
    }
    let changes: usize = 0 as usize
    index = 0 as usize
    while index < count {
        let current: *NqNirInstruction = &instructions[index]
        let eligible: bool = (current.opcode == nqNirAdd() ||
            current.opcode == nqNirSub() || current.opcode == nqNirMul()) &&
            current.flags == 0 as u32 && nqCompilerTypeIsInteger(current.typeCode) &&
            current.immediate == 0 as i64 && current.width == 0 as usize &&
            current.symbol == 0 as u64 && current.dest >= 0 as isize &&
            current.left >= 0 as isize && current.right >= 0 as isize
        if eligible {
            let previous: usize = 0 as usize
            let found: bool = false
            while previous < index && !found {
                let other: *NqNirInstruction = &instructions[previous]
                if other.opcode == current.opcode && other.flags == 0 as u32 &&
                   other.immediate == 0 as i64 && other.width == 0 as usize &&
                   other.symbol == 0 as u64 && other.dest >= 0 as isize &&
                   other.typeCode == current.typeCode {
                    let same: bool = other.left == current.left && other.right == current.right
                    if (current.opcode == nqNirAdd() || current.opcode == nqNirMul()) &&
                       other.left == current.right && other.right == current.left { same = true }
                    if same {
                        current.opcode = nqNirMove()
                        current.left = other.dest
                        current.right = nqNirNoValue()
                        changes = changes + 1 as usize
                        found = true
                    }
                }
                previous = previous + 1 as usize
            }
        }
        index = index + 1 as usize
    }
    return changes
}

export function nqOptimizerDeadCodeEliminate(instructions: []NqNirInstruction): usize {
    // One reverse liveness traversal replaces a quadratic forward search for
    // every defined register. Registers are monotone and SSA-like in the
    // self-hosted lowerer; the arena is bounded by the NIR instruction cap.
    let live: [u8; 262144]
    let changes: usize = 0 as usize
    let index: usize = len(instructions)
    while index > 0 as usize {
        index = index - 1 as usize
        let item: *NqNirInstruction = &instructions[index]
        let keep: bool = true
        if item.dest >= 0 as isize {
            let dest: usize = item.dest as usize
            let resultUsed: bool = dest >= len(live)
            if dest < len(live) && live[dest] != 0 as u8 { resultUsed = true }
            if nqOptimizerCanEliminate(item.opcode, resultUsed) {
                item.opcode = nqNirNop()
                item.left = nqNirNoValue()
                item.right = nqNirNoValue()
                changes = changes + 1 as usize
                keep = false
            } else if dest < len(live) { live[dest] = 0 as u8 }
        }
        if keep {
            if item.left >= 0 as isize && item.left as usize < len(live) { live[item.left as usize] = 1 as u8 }
            if item.right >= 0 as isize && item.right as usize < len(live) { live[item.right as usize] = 1 as u8 }
        }
    }
    return changes
}

export function nqOptimizerRun(instructions: []NqNirInstruction, level: int): usize {
    if !nqOptimizerLevelValid(level) || level == nqOptLevelNone() { return 0 as usize }
    let total: usize = 0 as usize
    let round: int = 0
    let budget: int = nqOptimizerPassBudget(level)
    while round < budget {
        let changed: usize = nqOptimizerConstantFold(instructions)
        changed = changed + nqOptimizerAlgebraicSimplify(instructions)
        if level >= nqOptLevelSpeed() { changed = changed + nqOptimizerLocalGvn(instructions) }
        changed = changed + nqOptimizerDeadCodeEliminate(instructions)
        total = total + changed
        if changed == 0 as usize { return total }
        round = round + 1
    }
    return total
}
