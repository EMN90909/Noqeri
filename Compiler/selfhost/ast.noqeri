module noqeri.compiler.selfhost.ast

record NqAstNode {
    tag: int
    typeCode: int
    typeSymbol: u64
    elementTypeCode: int
    elementTypeSymbol: u64
    arrayLength: usize
    storageBytes: usize
    start: usize
    end: usize
    left: isize
    right: isize
    extra: isize
    next: isize
    genericFirst: isize
    genericCount: usize
    flags: u32
}

export function nqAstNoNode(): isize { return -1 as isize }
export function nqAstFlagExport(): u32 { return 1 as u32 }
export function nqAstFlagExtern(): u32 { return 2 as u32 }
export function nqAstFlagConst(): u32 { return 4 as u32 }
export function nqAstFlagUnsafe(): u32 { return 8 as u32 }
export function nqAstFlagGeneric(): u32 { return 16 as u32 }

export function nqAstInvalid(): int { return 0 }
export function nqAstModule(): int { return 1 }
export function nqAstImport(): int { return 2 }
export function nqAstFunction(): int { return 3 }
export function nqAstRecord(): int { return 4 }
export function nqAstBinding(): int { return 5 }
export function nqAstBlock(): int { return 6 }
export function nqAstIf(): int { return 7 }
export function nqAstWhile(): int { return 8 }
export function nqAstReturn(): int { return 9 }
export function nqAstThrow(): int { return 10 }
export function nqAstAssign(): int { return 11 }
export function nqAstCall(): int { return 12 }
export function nqAstBinary(): int { return 13 }
export function nqAstUnary(): int { return 14 }
export function nqAstCast(): int { return 15 }
export function nqAstIndex(): int { return 16 }
export function nqAstMember(): int { return 17 }
export function nqAstName(): int { return 18 }
export function nqAstInteger(): int { return 19 }
export function nqAstFloat(): int { return 20 }
export function nqAstString(): int { return 21 }
export function nqAstBool(): int { return 22 }
export function nqAstArray(): int { return 23 }
export function nqAstParameter(): int { return 24 }
export function nqAstField(): int { return 25 }
export function nqAstExpressionStatement(): int { return 26 }
export function nqAstNull(): int { return 27 }

export function nqAstNodeTagValid(tag: int): bool { return tag >= nqAstModule() && tag <= nqAstNull() }
export function nqAstIsStatement(tag: int): bool { return tag == nqAstBinding() || tag == nqAstBlock() || tag == nqAstIf() || tag == nqAstWhile() || tag == nqAstReturn() || tag == nqAstThrow() || tag == nqAstExpressionStatement() }
export function nqAstIsExpression(tag: int): bool { return (tag >= nqAstAssign() && tag <= nqAstArray()) || tag == nqAstNull() }
export function nqAstIsLiteral(tag: int): bool { return (tag >= nqAstInteger() && tag <= nqAstArray()) || tag == nqAstNull() }
export function nqAstIsDeclaration(tag: int): bool { return tag == nqAstModule() || tag == nqAstImport() || tag == nqAstFunction() || tag == nqAstRecord() || tag == nqAstBinding() }

export function nqAstTypeUnknown(): int { return 0 }
export function nqAstTypeVoid(): int { return 1 }
export function nqAstTypeBool(): int { return 2 }
export function nqAstTypeInt(): int { return 3 }
export function nqAstTypeFloat(): int { return 4 }
export function nqAstTypeString(): int { return 5 }
export function nqAstTypeI8(): int { return 6 }
export function nqAstTypeU8(): int { return 7 }
export function nqAstTypeI16(): int { return 8 }
export function nqAstTypeU16(): int { return 9 }
export function nqAstTypeI32(): int { return 10 }
export function nqAstTypeU32(): int { return 11 }
export function nqAstTypeI64(): int { return 12 }
export function nqAstTypeU64(): int { return 13 }
export function nqAstTypeIsize(): int { return 14 }
export function nqAstTypeUsize(): int { return 15 }
export function nqAstTypePointer(): int { return 16 }
export function nqAstTypeSlice(): int { return 17 }
export function nqAstTypeArray(): int { return 18 }
export function nqAstTypeRecord(): int { return 19 }
export function nqAstTypeNull(): int { return 20 }
export function nqAstTypeGeneric(): int { return 21 }

export function nqAstTypeScalar(code: int): bool { return code >= nqAstTypeBool() && code <= nqAstTypeUsize() }
export function nqAstTypeInteger(code: int): bool { return code == nqAstTypeInt() || (code >= nqAstTypeI8() && code <= nqAstTypeUsize()) }
export function nqAstTypeAggregate(code: int): bool { return code == nqAstTypeSlice() || code == nqAstTypeArray() || code == nqAstTypeRecord() }

export function nqAstNodeInit(out: *NqAstNode, tag: int, start: usize, end: usize): void {
    out.tag = tag
    out.typeCode = nqAstTypeUnknown()
    out.typeSymbol = 0 as u64
    out.elementTypeCode = nqAstTypeUnknown()
    out.elementTypeSymbol = 0 as u64
    out.arrayLength = 0 as usize
    out.storageBytes = 0 as usize
    out.start = start
    out.end = end
    out.left = nqAstNoNode()
    out.right = nqAstNoNode()
    out.extra = nqAstNoNode()
    out.next = nqAstNoNode()
    out.genericFirst = nqAstNoNode()
    out.genericCount = 0 as usize
    out.flags = 0 as u32
}

export function nqAstNodeValid(node: *NqAstNode, sourceBytes: usize): bool {
    if node == null || !nqAstNodeTagValid(node.tag) { return false }
    if node.start > node.end || node.end > sourceBytes { return false }
    return true
}

export function nqAstArenaPush(nodes: []NqAstNode, count: *usize, tag: int, start: usize, end: usize): isize {
    if count == null || count[0] >= len(nodes) || start > end { return nqAstNoNode() }
    let index: usize = count[0]
    nqAstNodeInit(&nodes[index], tag, start, end)
    count[0] = index + 1 as usize
    return index as isize
}

export function nqAstApplyType(out: *NqAstNode, code: int, symbol: u64, elementCode: int, elementSymbol: u64, arrayLength: usize): void {
    if out == null { return }
    out.typeCode = code
    out.typeSymbol = symbol
    out.elementTypeCode = elementCode
    out.elementTypeSymbol = elementSymbol
    out.arrayLength = arrayLength
}

export function nqAstAppend(nodes: []NqAstNode, first: *isize, last: *isize, node: isize): bool {
    if first == null || last == null || node < 0 as isize || node as usize >= len(nodes) { return false }
    if first[0] < 0 as isize { first[0] = node }
    else {
        if last[0] < 0 as isize || last[0] as usize >= len(nodes) { return false }
        nodes[last[0] as usize].next = node
    }
    last[0] = node
    return true
}

export function nqAstChainCount(nodes: []NqAstNode, first: isize): usize {
    let count: usize = 0 as usize
    let cursor: isize = first
    while cursor >= 0 as isize {
        if cursor as usize >= len(nodes) { return count }
        count = count + 1 as usize
        cursor = nodes[cursor as usize].next
    }
    return count
}
