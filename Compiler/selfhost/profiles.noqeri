module noqeri.compiler.selfhost.profiles
import "optimizer.nqr"
export function nqProfileDebug(): int { return 1 }
export function nqProfileRelease(): int { return 2 }
export function nqProfileSize(): int { return 3 }
export function nqProfileSpeed(): int { return 4 }
export function nqProfileValid(profile: int): bool { return profile >= nqProfileDebug() && profile <= nqProfileSpeed() }
export function nqProfileOptimization(profile: int): int { if profile == nqProfileDebug() { return nqOptLevelNone() } if profile == nqProfileSize() { return nqOptLevelSize() } if profile == nqProfileSpeed() { return nqOptLevelAggressive() } return nqOptLevelSpeed() }
export function nqProfileDebugSymbols(profile: int): bool { return profile == nqProfileDebug() || profile == nqProfileRelease() }
export function nqProfileStrip(profile: int): bool { return profile == nqProfileSize() }
export function nqProfileLto(profile: int): bool { return profile == nqProfileRelease() || profile == nqProfileSpeed() }
