module noqeri.compiler.selfhost.zero_init
import "ast.nqr"
import "parser.nqr"

// Internal-only AST marker. Typed declarations without an explicit initializer
// are safe-zero-initialized; const declarations are rejected earlier by parser.
export function nqZeroInitFlag(): u32 { return 32 as u32 }
export function nqZeroInitOk(): isize { return 0 as isize }
export function nqZeroInitCapacity(): isize { return -330 as isize }
export function nqZeroInitMalformed(): isize { return -331 as isize }

export function nqZeroInitNormalize(source: []u8, nodes: []NqAstNode, count: *usize, first: isize): isize {
    if count == null { return nqZeroInitCapacity() }
    let cursor: isize = first
    while cursor >= 0 as isize {
        if cursor as usize >= len(nodes) { return nqZeroInitMalformed() }
        let node: *NqAstNode = &nodes[cursor as usize]
        if node.tag == nqAstBinding() && node.right < 0 as isize {
            if node.extra < 0 as isize { return nqZeroInitMalformed() }
            let typeStart: usize = node.extra as usize
            let typeEnd: usize = nqParserScanType(source, typeStart)
            if typeEnd <= typeStart { return nqZeroInitMalformed() }
            let typeName: isize = nqAstArenaPush(nodes, count, nqAstName(), typeStart, typeEnd)
            if typeName < 0 as isize { return nqZeroInitCapacity() }
            let zeroCall: isize = nqAstArenaPush(nodes, count, nqAstCall(), typeStart, typeEnd)
            if zeroCall < 0 as isize { return nqZeroInitCapacity() }
            nodes[zeroCall as usize].left = typeName
            nodes[zeroCall as usize].right = nqAstNoNode()
            nodes[zeroCall as usize].extra = 0 as isize
            nodes[zeroCall as usize].flags = nqZeroInitFlag()
            node.right = zeroCall
            node.flags = node.flags + nqZeroInitFlag()
        }
        cursor = node.next
    }
    return nqZeroInitOk()
}
