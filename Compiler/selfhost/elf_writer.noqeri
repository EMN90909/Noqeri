module noqeri.compiler.selfhost.elf_writer
import "targets.nqr"
import "object_formats.nqr"

export function nqElfHeaderBytes64(): usize { return 64 as usize }
export function nqElfSectionHeaderBytes64(): usize { return 64 as usize }
export function nqElfProgramHeaderBytes64(): usize { return 56 as usize }
export function nqElfSymbolBytes64(): usize { return 24 as usize }
export function nqElfRelocBytes64(): usize { return 24 as usize }
export function nqElfSectionCountValid(count: usize): bool { return count > 0 as usize && count < 65280 as usize }
export function nqElfTargetValid(target: int): bool { return target == nqTargetLinuxX64() || target == nqTargetLinuxArm64() }
export function nqElfMachine(target: int): u16 { if target == nqTargetLinuxX64() { return nqElfMachineX64() } if target == nqTargetLinuxArm64() { return nqElfMachineArm64() } return 0 as u16 }
export function nqElfRelocPc32(target: int): u32 { if target == nqTargetLinuxX64() { return 2 as u32 } if target == nqTargetLinuxArm64() { return 261 as u32 } return 0 as u32 }
export function nqElfRelocAbs64(target: int): u32 { if target == nqTargetLinuxX64() { return 1 as u32 } if target == nqTargetLinuxArm64() { return 257 as u32 } return 0 as u32 }
export function nqElfPageAlignment(): usize { return 4096 as usize }

// Emit the ELF64 relocatable-file header directly in Noqeri.
export function nqElfWriteHeader64(buffer: []u8, offset: usize, target: int, sectionHeaderOffset: u64, sectionCount: usize, stringTableIndex: usize): isize {
    if !nqElfTargetValid(target) || !nqElfSectionCountValid(sectionCount) || stringTableIndex >= sectionCount { return -1 }
    if !nqObjectRangeValid(buffer, offset, nqElfHeaderBytes64()) { return -2 }
    if !nqObjectZero(buffer, offset, nqElfHeaderBytes64()) { return -2 }
    buffer[offset] = 0x7f as u8
    buffer[offset + 1 as usize] = 69 as u8
    buffer[offset + 2 as usize] = 76 as u8
    buffer[offset + 3 as usize] = 70 as u8
    buffer[offset + 4 as usize] = 2 as u8 // ELFCLASS64
    buffer[offset + 5 as usize] = 1 as u8 // little endian
    buffer[offset + 6 as usize] = 1 as u8 // ELF version
    if !nqObjectWriteU16LE(buffer, offset + 16 as usize, 1 as u16) { return -2 } // ET_REL
    if !nqObjectWriteU16LE(buffer, offset + 18 as usize, nqElfMachine(target)) { return -2 }
    if !nqObjectWriteU32LE(buffer, offset + 20 as usize, 1 as u32) { return -2 }
    if !nqObjectWriteU64LE(buffer, offset + 40 as usize, sectionHeaderOffset) { return -2 }
    if !nqObjectWriteU16LE(buffer, offset + 52 as usize, nqElfHeaderBytes64() as u16) { return -2 }
    if !nqObjectWriteU16LE(buffer, offset + 54 as usize, nqElfProgramHeaderBytes64() as u16) { return -2 }
    if !nqObjectWriteU16LE(buffer, offset + 58 as usize, nqElfSectionHeaderBytes64() as u16) { return -2 }
    if !nqObjectWriteU16LE(buffer, offset + 60 as usize, sectionCount as u16) { return -2 }
    if !nqObjectWriteU16LE(buffer, offset + 62 as usize, stringTableIndex as u16) { return -2 }
    return nqElfHeaderBytes64() as isize
}

export function nqElfObjectHeaderSize(sections: usize): usize {
    if !nqElfSectionCountValid(sections) { return 0 as usize }
    return nqElfHeaderBytes64() + sections * nqElfSectionHeaderBytes64()
}
