module noqeri.compiler.selfhost.nqri_writer
import "nir.noqeri"

// NQRI is the portable bootstrap module format. It stores the original source,
// the stable NIR function table and fixed-width NIR instructions. The format is
// deliberately simple and little-endian so Stage 1 and Stage 2 can produce
// byte-identical compiler modules without depending on a C++ object writer.
//
// Header (32 bytes): magic/version/counts/record sizes/flags.
// Function record (40 bytes): symbol/name span/instruction span/params/flags.
// Instruction record (96 bytes): opcode/type/flags, SSA operands/immediate,
// symbol/width/source span, exact IEEE-754 float bits and reserved bytes.

export function nqNqriMagic0(): u8 { return 78 as u8 }
export function nqNqriMagic1(): u8 { return 81 as u8 }
export function nqNqriMagic2(): u8 { return 82 as u8 }
export function nqNqriMagic3(): u8 { return 73 as u8 }
export function nqNqriVersion(): u32 { return 2 as u32 }
export function nqNqriHeaderBytes(): usize { return 32 as usize }
export function nqNqriFunctionBytes(): usize { return 40 as usize }
export function nqNqriInstructionBytes(): usize { return 96 as usize }
export function nqNqriInvalid(): isize { return -800 as isize }
export function nqNqriCapacity(): isize { return -801 as isize }
export function nqNqriOverflow(): isize { return -802 as isize }

function nqNqriUsizeMax(): usize { return 9223372036854775807 as usize }

function nqNqriCanWrite(out: []u8, offset: usize, bytes: usize): bool {
    if offset > len(out) { return false }
    return bytes <= len(out) - offset
}

function nqNqriWriteU32(out: []u8, offset: usize, value: u32): bool {
    if !nqNqriCanWrite(out, offset, 4 as usize) { return false }
    out[offset] = (value % 256 as u32) as u8
    out[offset + 1 as usize] = ((value / 256 as u32) % 256 as u32) as u8
    out[offset + 2 as usize] = ((value / 65536 as u32) % 256 as u32) as u8
    out[offset + 3 as usize] = ((value / 16777216 as u32) % 256 as u32) as u8
    return true
}

function nqNqriWriteU64(out: []u8, offset: usize, value: u64): bool {
    if !nqNqriCanWrite(out, offset, 8 as usize) { return false }
    let current: u64 = value
    let index: usize = 0 as usize
    while index < 8 as usize {
        out[offset + index] = (current % 256 as u64) as u8
        current = current / 256 as u64
        index = index + 1 as usize
    }
    return true
}

function nqNqriWriteI64(out: []u8, offset: usize, value: i64): bool {
    if !nqNqriCanWrite(out, offset, 8 as usize) { return false }
    let current: i64 = value
    let index: usize = 0 as usize
    while index < 8 as usize {
        let byte: i64 = current % 256 as i64
        if byte < 0 as i64 { byte = byte + 256 as i64 }
        out[offset + index] = byte as u8
        current = (current - byte) / 256 as i64
        index = index + 1 as usize
    }
    return true
}

function nqNqriFloatBits(value: *float): u64 {
    if value == null { return 0 as u64 }
    let bits: *u64 = value as *u64
    return bits[0]
}

function nqNqriCheckedAdd(a: usize, b: usize, out: *usize): bool {
    if out == null || b > nqNqriUsizeMax() - a { return false }
    out[0] = a + b
    return true
}

function nqNqriCheckedMul(a: usize, b: usize, out: *usize): bool {
    if out == null { return false }
    if a == 0 as usize || b == 0 as usize { out[0] = 0 as usize return true }
    if a > nqNqriUsizeMax() / b { return false }
    out[0] = a * b
    return true
}

export function nqNqriRequiredBytes(sourceBytes: usize, functionCount: usize, instructionCount: usize, out: *usize): isize {
    if out == null { return nqNqriInvalid() }
    let functionBytes: usize = 0 as usize
    let instructionBytes: usize = 0 as usize
    let total: usize = nqNqriHeaderBytes()
    if !nqNqriCheckedMul(functionCount, nqNqriFunctionBytes(), &functionBytes) { return nqNqriOverflow() }
    if !nqNqriCheckedMul(instructionCount, nqNqriInstructionBytes(), &instructionBytes) { return nqNqriOverflow() }
    if !nqNqriCheckedAdd(total, sourceBytes, &total) { return nqNqriOverflow() }
    if !nqNqriCheckedAdd(total, functionBytes, &total) { return nqNqriOverflow() }
    if !nqNqriCheckedAdd(total, instructionBytes, &total) { return nqNqriOverflow() }
    out[0] = total
    return total as isize
}

export function nqNqriWrite(source: []u8, functions: []NqNirFunction, instructions: []NqNirInstruction, out: []u8): isize {
    if len(source) > 4294967295 as usize || len(functions) > 4294967295 as usize || len(instructions) > 4294967295 as usize { return nqNqriOverflow() }
    let required: usize = 0 as usize
    let status: isize = nqNqriRequiredBytes(len(source), len(functions), len(instructions), &required)
    if status < 0 as isize { return status }
    if len(out) < required { return nqNqriCapacity() }
    out[0] = nqNqriMagic0()
    out[1] = nqNqriMagic1()
    out[2] = nqNqriMagic2()
    out[3] = nqNqriMagic3()
    if !nqNqriWriteU32(out, 4 as usize, nqNqriVersion()) { return nqNqriCapacity() }
    if !nqNqriWriteU32(out, 8 as usize, len(source) as u32) { return nqNqriCapacity() }
    if !nqNqriWriteU32(out, 12 as usize, len(functions) as u32) { return nqNqriCapacity() }
    if !nqNqriWriteU32(out, 16 as usize, len(instructions) as u32) { return nqNqriCapacity() }
    if !nqNqriWriteU32(out, 20 as usize, nqNqriFunctionBytes() as u32) { return nqNqriCapacity() }
    if !nqNqriWriteU32(out, 24 as usize, nqNqriInstructionBytes() as u32) { return nqNqriCapacity() }
    if !nqNqriWriteU32(out, 28 as usize, 0 as u32) { return nqNqriCapacity() }

    let offset: usize = nqNqriHeaderBytes()
    let sourceIndex: usize = 0 as usize
    while sourceIndex < len(source) { out[offset + sourceIndex] = source[sourceIndex] sourceIndex = sourceIndex + 1 as usize }
    offset = offset + len(source)

    let functionIndex: usize = 0 as usize
    while functionIndex < len(functions) {
        let function: *NqNirFunction = &functions[functionIndex]
        if !nqNirFunctionValid(function, len(instructions)) || function.nameEnd > len(source) { return nqNqriInvalid() }
        if function.nameStart > 4294967295 as usize || function.nameEnd > 4294967295 as usize || function.firstInstruction > 4294967295 as usize || function.instructionCount > 4294967295 as usize || function.parameterCount > 4294967295 as usize { return nqNqriOverflow() }
        if !nqNqriWriteU64(out, offset, function.symbol) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 8 as usize, function.nameStart as u32) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 12 as usize, function.nameEnd as u32) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 16 as usize, function.firstInstruction as u32) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 20 as usize, function.instructionCount as u32) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 24 as usize, function.parameterCount as u32) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 28 as usize, function.flags) { return nqNqriCapacity() }
        if !nqNqriWriteU64(out, offset + 32 as usize, 0 as u64) { return nqNqriCapacity() }
        offset = offset + nqNqriFunctionBytes()
        functionIndex = functionIndex + 1 as usize
    }

    let instructionIndex: usize = 0 as usize
    while instructionIndex < len(instructions) {
        let instruction: *NqNirInstruction = &instructions[instructionIndex]
        if !nqNirInstructionValid(instruction) || instruction.sourceEnd > len(source) { return nqNqriInvalid() }
        if !nqNqriWriteU32(out, offset, instruction.opcode as u32) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 4 as usize, instruction.typeCode as u32) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 8 as usize, instruction.flags) { return nqNqriCapacity() }
        if !nqNqriWriteU32(out, offset + 12 as usize, 0 as u32) { return nqNqriCapacity() }
        if !nqNqriWriteI64(out, offset + 16 as usize, instruction.dest as i64) { return nqNqriCapacity() }
        if !nqNqriWriteI64(out, offset + 24 as usize, instruction.left as i64) { return nqNqriCapacity() }
        if !nqNqriWriteI64(out, offset + 32 as usize, instruction.right as i64) { return nqNqriCapacity() }
        if !nqNqriWriteI64(out, offset + 40 as usize, instruction.immediate) { return nqNqriCapacity() }
        if !nqNqriWriteU64(out, offset + 48 as usize, instruction.symbol) { return nqNqriCapacity() }
        if !nqNqriWriteU64(out, offset + 56 as usize, instruction.width as u64) { return nqNqriCapacity() }
        if !nqNqriWriteU64(out, offset + 64 as usize, instruction.sourceStart as u64) { return nqNqriCapacity() }
        if !nqNqriWriteU64(out, offset + 72 as usize, instruction.sourceEnd as u64) { return nqNqriCapacity() }
        let floatBits: u64 = 0 as u64
        if instruction.opcode == nqNirConstF64() { floatBits = nqNqriFloatBits(&instruction.floatImmediate) }
        if !nqNqriWriteU64(out, offset + 80 as usize, floatBits) { return nqNqriCapacity() }
        if !nqNqriWriteU64(out, offset + 88 as usize, 0 as u64) { return nqNqriCapacity() }
        offset = offset + nqNqriInstructionBytes()
        instructionIndex = instructionIndex + 1 as usize
    }
    return offset as isize
}
