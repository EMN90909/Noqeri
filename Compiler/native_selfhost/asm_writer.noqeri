module noqeri.compiler.native_selfhost.asm_writer

export function nqAsmPut(out: []u8, cursor: *usize, value: u8): bool {
    if cursor == null || cursor[0] >= len(out) { return false }
    out[cursor[0]] = value
    cursor[0] = cursor[0] + 1 as usize
    return true
}

export function nqAsmAppend(out: []u8, cursor: *usize, value: []u8): bool {
    if cursor == null || cursor[0] > len(out) || len(value) > len(out) - cursor[0] { return false }
    let i: usize = 0 as usize
    while i < len(value) { out[cursor[0] + i] = value[i] i = i + 1 as usize }
    cursor[0] = cursor[0] + len(value)
    return true
}

export function nqAsmAppendSpan(out: []u8, cursor: *usize, source: []u8, start: usize, ending: usize): bool {
    if start > ending || ending > len(source) { return false }
    let i: usize = start
    while i < ending { if !nqAsmPut(out, cursor, source[i]) { return false } i = i + 1 as usize }
    return true
}

export function nqAsmAppendUsize(out: []u8, cursor: *usize, value: usize): bool {
    let digits: [u8; 32]
    let count: usize = 0 as usize
    let current: usize = value
    if current == 0 as usize { return nqAsmPut(out, cursor, 48 as u8) }
    while current > 0 as usize { digits[count] = (48 as usize + current % 10 as usize) as u8 count = count + 1 as usize current = current / 10 as usize }
    while count > 0 as usize { count = count - 1 as usize if !nqAsmPut(out, cursor, digits[count]) { return false } }
    return true
}

export function nqAsmAppendI64(out: []u8, cursor: *usize, value: i64): bool {
    let digits: [u8; 32]
    let count: usize = 0 as usize
    let current: i64 = value
    if current == 0 as i64 { return nqAsmPut(out, cursor, 48 as u8) }
    if current < 0 as i64 { if !nqAsmPut(out, cursor, 45 as u8) { return false } }
    while current != 0 as i64 { let remainder: i64 = current % 10 as i64 if remainder < 0 as i64 { remainder = -remainder } digits[count] = (48 as i64 + remainder) as u8 count = count + 1 as usize current = current / 10 as i64 }
    while count > 0 as usize { count = count - 1 as usize if !nqAsmPut(out, cursor, digits[count]) { return false } }
    return true
}

export function nqAsmAppendU64Small(out: []u8, cursor: *usize, value: u64): bool { return nqAsmAppendI64(out, cursor, value as i64) }

