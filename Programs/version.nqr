module noqeri.programs.version

export function nqLanguageVersionMajor(): int { return 0 }
export function nqLanguageVersionMinor(): int { return 7 }
export function nqAbiVersion(): int { return 2 }

export function nqVersionCompatible(requiredMajor: int, actualMajor: int): bool {
    return requiredMajor == actualMajor
}
